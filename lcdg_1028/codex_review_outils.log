\&quot;logprob\&quot;: -0.124,\n      \&quot;speaker_id\&quot;: \&quot;speaker_1\&quot;,\n      \&quot;start\&quot;: 
0,\n      \&quot;text\&quot;: \&quot;Hello\&quot;,\n      \&quot;type\&quot;: \&quot;word\&quot;\n    }\n  
