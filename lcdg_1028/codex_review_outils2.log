---render.py---
   1: """
   2: Etape 2 : montage.
   3: 
   4:     python scripts/render.py episodes/2026-08-05-violences-cabinet
   5: 
   6: Normalise les B-rolls, rend l'habillage, puis controle le fichier de sortie par
   7: mesure de pixels. Le reel sort sans piste audio : la musique est posee ensuite, a part.
   8: """
   9: import sys
  10: # la console Windows est en cp1252 par defaut : les accents y provoqueraient une
  11: # UnicodeEncodeError.
  12: if hasattr(sys.stdout, "reconfigure"):
  13:     sys.stdout.reconfigure(encoding="utf-8", errors="replace")
  14: 
  15: import json, shutil, sys, time
  16: from pathlib import Path
  17: sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
  18: try:
  19:     from dotenv import load_dotenv
  20:     load_dotenv(Path(__file__).resolve().parent.parent / ".env")
  21: except ImportError:
  22:     pass
  23: from config import charte as C
  24: from lcdg import binaires as B, montage, controles, son, voix
  25: 
  26: 
  27: def main(dossier: str):
  28:     B.exiger()
  29:     episode = Path(dossier).resolve()
  30:     ep = json.loads((episode / "script.json").read_text(encoding="utf-8"))
  31:     t0 = time.time()
  32: 
  33:     print("\n1/3  normalisation des B-rolls")
  34:     montage.verifier(ep)              # avant d'encoder le moindre plan
  35:     # la voix off fixe la duree de chaque plan : elle passe avant la base
  36:     piste = voix.preparer(episode, ep) if voix.active(ep) else None
  37:     _, bornes, total = montage.base(episode, ep["blocs"])
  38:     print(f"     {len(bornes)} plans, {total:.2f} s")
  39: 
  40:     print("2/3  rendu de l'habillage")
  41:     muet = montage.habiller(episode, ep, bornes, total)
  42:     audio = son.bande(episode, ep, bornes, total, piste)   # voix, musique, bruitages
  43:     sortie = montage.finaliser(muet, episode / f"reel_{ep['slug']}.mp4", audio)
  44:     if piste:                         # voix seule, pour le montage final en musique
  45:         shutil.copy(piste, episode / piste.name)
  46: 
  47:     couv = montage.couverture(sortie)            # avant la coupe : l'accroche est en place
  48:     decalage = 0.0
  49:     if C.ACCROCHE_COUVERTURE:
  50:         decalage = bornes[1][0]
  51:         montage.couper_accroche(sortie, decalage)
  52: 
  53:     print("3/3  controles")
  54:     # sur le fichier livre, apres la coupe ; l'accroche coupee se controle sur la couverture
  55:     conforme = controles.rapport(sortie, ep, bornes, decalage, couv[0])
  56: 
  57:     print(f"\n{sortie}\n" + "\n".join(map(str, couv)) + f"   ({time.time()-t0:.0f} s)")
  58:     sys.exit(0 if conforme else 2)
  59: 
  60: 
  61: if __name__ == "__main__":
  62:     if len(sys.argv) < 2:
  63:         raise SystemExit("usage : python scripts/render.py episodes/<dossier>")
  64:     main(sys.argv[1])
---render_carre.py---
   1: """
   2: Declinaison carree 1080x1080 d'un episode, pour LinkedIn.
   3: 
   4:     python scripts/render_carre.py episodes/2026-09-18-arrets-de-travail
   5: 
   6: Reprend script.json et les B-rolls de l'episode, avec la mise en page de charte.CARRE.
   7: Un plan compose pour le 9:16 (photo posee en bandeau au-dessus du texte) peut avoir sa
   8: version carree dans broll_carre/, sous le meme nom : elle est prise a la place.
   9: Sortie : reel_<slug>_carre.mp4, controlee comme le reel (code retour 2 si non conforme).
  10: """
  11: import sys
  12: # la console Windows est en cp1252 par defaut
  13: if hasattr(sys.stdout, "reconfigure"):
  14:     sys.stdout.reconfigure(encoding="utf-8", errors="replace")
  15: 
  16: import json, os, shutil, time
  17: from pathlib import Path
  18: sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
  19: # avant lcdg.binaires, qui lit FFMPEG_BIN et FFPROBE_BIN a l'import (cf. render.py)
  20: try:
  21:     from dotenv import load_dotenv
  22:     load_dotenv(Path(__file__).resolve().parent.parent / ".env")
  23: except ImportError:
  24:     pass
  25: from config import charte as C
  26: 
  27: # avant tout import de lcdg/habillage : il fige W, H et les positions par defaut a l'import
  28: for cle, valeur in C.CARRE.items():
  29:     setattr(C, cle, valeur)
  30: 
  31: from lcdg import binaires as B, montage, controles, son, voix
  32: 
  33: 
  34: def preparer(episode: Path, ep: dict) -> Path:
  35:     """Dossier de travail carre/ : B-rolls de l'episode, versions carrees prioritaires."""
  36:     travail = episode / "carre"
  37:     (travail / "broll").mkdir(parents=True, exist_ok=True)
  38:     for bl in ep["blocs"]:
  39:         src = episode / "broll_carre" / bl["fichier"]
  40:         if not src.exists():
  41:             src = episode / "broll" / bl["fichier"]
  42:         dst = travail / "broll" / bl["fichier"]
  43:         dst.unlink(missing_ok=True)
  44:         if src.exists():
  45:             try:
  46:                 os.link(src, dst)          # pas de copie de plusieurs centaines de Mo
  47:             except OSError:
  48:                 shutil.copy(src, dst)
  49:     return travail
  50: 
  51: 
  52: def main(dossier: str):
  53:     B.exiger()
  54:     episode = Path(dossier).resolve()
  55:     ep = json.loads((episode / "script.json").read_text(encoding="utf-8"))
  56:     travail = preparer(episode, ep)
  57:     t0 = time.time()
  58: 
  59:     print(f"\n{ep['label']} — carre {C.LARGEUR}x{C.HAUTEUR}")
  60:     print("1/3  normalisation des B-rolls")
  61:     montage.verifier(ep)              # avant d'encoder le moindre plan
  62:     # la voix off fixe la duree de chaque plan : elle passe avant la base
  63:     piste = voix.preparer(episode, ep) if voix.active(ep) else None
  64:     _, bornes, total = montage.base(travail, ep["blocs"])
  65:     print(f"     {len(bornes)} plans, {total:.2f} s")
  66:     print("2/3  rendu de l'habillage")
  67:     muet = montage.habiller(travail, ep, bornes, total)
  68:     audio = son.bande(episode, ep, bornes, total, piste)   # voix, musique, bruitages
  69:     final = montage.finaliser(muet, episode / f"reel_{ep['slug']}_carre.mp4", audio)
  70:     couv = montage.couverture(final)             # avant la coupe : l'accroche est en place
  71:     decalage = 0.0
  72:     if C.ACCROCHE_COUVERTURE:
  73:         decalage = bornes[1][0]
  74:         montage.couper_accroche(final, decalage)
  75:     print("3/3  controles")
  76:     # sur le fichier livre, apres la coupe ; l'accroche coupee se controle sur la couverture
  77:     conforme = controles.rapport(final, ep, bornes, decalage, couv[0])
  78:     print(f"\n{final}\n" + "\n".join(map(str, couv)) + f"   ({time.time()-t0:.0f} s)")
  79:     sys.exit(0 if conforme else 2)
  80: 
  81: 
  82: if __name__ == "__main__":
  83:     if len(sys.argv) < 2:
  84:         raise SystemExit("usage : python scripts/render_carre.py episodes/<dossier>")
  85:     main(sys.argv[1])
