  90: pos, p = [], 0
  91: for t in tv:
  92:     pos.append(p)
  93:     p += len(t) + 1
  94: 
  95: 
  96: def lettres(a, z):
  97:     """Premier et dernier caractere alphanumerique de [a, z) hors indications de jeu."""
  98:     dans, idx = False, []
  99:     for i in range(a, z):
 100:         c = texte_src[i]
 101:         if c == "[":
 102:             dans = True
 103:         elif c == "]":
 104:             dans = False
 105:         elif not dans and c.isalnum():
 106:             idx.append(i)
 107:     return idx[0], idx[-1]
 108: 
 109: 
 110: def raccord(fin_a, debut_b):
 111:     """Point le plus calme du blanc entre deux phrases."""
 112:     a, z = fin_a + C.VOIX_RACCORD_GARDE, debut_b - C.VOIX_RACCORD_GARDE
 113:     n = int(C.VOIX_RACCORD_PAS * TAUX)
 114:     i0, i1 = int(a * TAUX), min(int(z * TAUX), len(son))
 115:     if i1 - i0 < 2 * n:
 116:         raise SystemExit(f"[!] pas de blanc entre {fin_a:.2f} s et {debut_b:.2f} s")
 117:     f = son[i0:i1 - (i1 - i0) % n].reshape(-1, n)
 118:     db = 10 * np.log10((f ** 2).mean(axis=1) + 1e-12)
 119:     k = int(np.argmin(db))
 120:     return (i0 + k * n + n // 2) / TAUX
 121: 
 122: 
 123: def coupe(fin_texte, debut_texte):
 124:     """Raccord entre le texte qui finit a fin_texte (exclu) et celui qui commence a debut_texte."""
 125:     _, der = lettres(max(0, fin_texte - 200), fin_texte)
 126:     pre, _ = lettres(debut_texte, len(texte_src))
 127:     return raccord(fin[der], deb[pre])
 128: 
 129: 
 130: # segments : suites de blocs parlants consecutifs, (debut, fin exclue) dans le texte du reel
 131: suites = []
 132: for k in [k for k in garder if k > 0]:
 133:     if suites and k == suites[-1][-1] + 1:
 134:         suites[-1].append(k)
 135:     else:
 136:         suites.append([k])
 137: segments = [(pos[s[0] - 1], pos[s[-1] - 1] + len(tv[s[-1] - 1])) for s in suites]
 138: bornes = []
 139: for k, (a, z) in enumerate(segments):
 140:     t0 = 0.0 if a == 0 else coupe(a - 1, a)
 141:     t1 = len(son) / TAUX if z == len(texte_src) else coupe(z, z + 1)
 142:     bornes.append((t0, t1))
 143:     print(f"  segment {k} (blocs {suites[k]}) : {t0:6.2f} -> {t1:6.2f} s  « {texte_src[a:z][:60]}… »")
 144: 
 145: morceaux, car, debs, fins_, n = [], [], [], [], 0
 146: for k, ((a, z), (t0, t1)) in enumerate(zip(segments, bornes)):
 147:     i0, i1 = int(round(t0 * TAUX)), int(round(t1 * TAUX))
 148:     m = son[i0:i1].copy()
 149:     if k > 0:
 150:         m[:int(FONDU * TAUX)] *= np.linspace(0, 1, int(FONDU * TAUX), dtype=np.float32)
 151:     if k < len(segments) - 1:
 152:         m[-int(FONDU * TAUX):] *= np.linspace(1, 0, int(FONDU * TAUX), dtype=np.float32)
 153:     decal = n / TAUX - i0 / TAUX
 154:     if k > 0:                                   # l'espace entre deux segments : le blanc
 155:         car.append(" ")
 156:         debs.append(fins_[-1])
 157:         fins_.append(max(fins_[-1], deb[a] + decal))
 158:     for q in range(a, z):
 159:         car.append(texte_src[q])
 160:         debs.append(max(0.0, deb[q] + decal))
 161:         fins_.append(max(0.0, fin[q] + decal))
 162:     morceaux.append(m)
 163:     n += len(m)
 164: 
 165: _, m_pub = voix.textes(pub)
 166: texte_pub = " ".join(t for t, _ in m_pub)
 167: assert "".join(car) == texte_pub, ("".join(car)[:200], texte_pub[:200])
 168: mp3_p, js_p = voix.chemins(texte_pub, vx["id"], DST / "voix", vx.get("modele"), vx.get("reglages"))
 169: mp3_p.parent.mkdir(parents=True, exist_ok=True)
 170: tmp = mp3_p.with_name(mp3_p.stem + ".tmp.mp3")
 171: r = subprocess.run([B.FFMPEG, "-v", "error", "-f", "f32le", "-ar", str(TAUX), "-ac", "1", "-i", "-",
 172:                     "-c:a", "libmp3lame", "-b:a", "192k", "-f", "mp3", str(tmp), "-y"],
 173:                    input=np.concatenate(morceaux).astype("<f4").tobytes(), capture_output=True)
 174: if r.returncode:
 175:     raise SystemExit(r.stderr.decode("utf-8", "replace")[-600:])
 176: js_p.write_text(json.dumps({"characters": car,
 177:                             "character_start_times_seconds": [round(x, 4) for x in debs],
 178:                             "character_end_times_seconds": [round(x, 4) for x in fins_]},
 179:                            ensure_ascii=False), encoding="utf-8")
 180: os.replace(tmp, mp3_p)
 181: print(f"narration de la publicite : {n / TAUX:.2f} s, en cache sous {mp3_p.name}")
 182: print(f"script : {DST / 'script.json'}  -> python scripts/livrer.py {DST.relative_to(R)}")
### scripts/verifier.py
   1: """
   2: Controle d'un script sans rien rendre (quelques secondes), a lancer apres chaque modification du texte :
   3: 
   4:     python scripts/verifier.py episodes/<dossier> [...]
   5: 
   6: 1. Nombre de lignes de chaque temps de texte, coupe comme le moteur le coupe : trois au plus (regle du
   7:    CLAUDE.md ; montage.verifier ne controle que la zone sure, pas ce nombre).
   8: 2. Mise en page complete (textes, surlignages, inserts, pastille, bandeau) en 9:16 ET en carre : la charte
   9:    CARRE s'applique avant l'import de lcdg (comme render_carre.py), d'ou un sous-processus par format.
  10: """
  11: import sys
  12: if hasattr(sys.stdout, "reconfigure"):
  13:     sys.stdout.reconfigure(encoding="utf-8", errors="replace")
  14: 
  15: import json
  16: import subprocess
  17: from pathlib import Path
  18: 
  19: R = Path(__file__).resolve().parent.parent
  20: sys.path.insert(0, str(R))
  21: from lcdg import habillage as hb
  22: from lcdg import texte as T
  23: 
  24: LIGNES_MAX = 3
  25: VERIF = r'''
  26: import json, sys
  27: if hasattr(sys.stdout, "reconfigure"):
  28:     sys.stdout.reconfigure(encoding="utf-8", errors="replace")
  29: sys.path.insert(0, sys.argv[1])
  30: from config import charte as C
  31: if sys.argv[3] == "1":
  32:     for cle, valeur in C.CARRE.items():
  33:         setattr(C, cle, valeur)
  34: from lcdg import montage
  35: montage.verifier(json.loads(open(sys.argv[2], encoding="utf-8").read()))
  36: print("mise en page conforme")
  37: '''
  38: 
  39: 
  40: def lignes(ep):
  41:     trop = 0
  42:     for k, b in enumerate(ep["blocs"]):
  43:         if not b.get("texte") or b.get("type") == "chiffre":
  44:             continue
  45:         for i, temps in enumerate(b["texte"].split("|")):
  46:             temps = temps.strip()
  47:             if b.get("type") == "phrase":
  48:                 _, n = hb.style_ajuste(temps)
  49:             else:
  50:                 st = hb.style_bloc()
  51:                 n = len(T.equilibrer(temps, T.mesureur(st), st["largeur"]))
  52:             if n > LIGNES_MAX:
  53:                 trop += 1
  54:                 print(f"  [!] B{k}.{i} : {n} lignes (3 au plus) : {temps}")
  55:     return trop
  56: 
  57: 
  58: if len(sys.argv) < 2:
  59:     raise SystemExit(__doc__)
  60: ok = True
  61: for d in sys.argv[1:]:
  62:     script = (R / d / "script.json").resolve()
  63:     ep = json.loads(script.read_text(encoding="utf-8"))
  64:     print(f"== {Path(d).name}")
  65:     ok &= lignes(ep) == 0
  66:     for nom, carre in (("9:16", "0"), ("carre", "1")):
  67:         r = subprocess.run([sys.executable, "-c", VERIF, str(R), str(script), carre], capture_output=True,
  68:                            text=True, encoding="utf-8", errors="replace", cwd=R)
  69:         sortie = (r.stdout + r.stderr).strip().splitlines()
  70:         print(f"  {nom:6} " + ("\n    ".join(sortie[-6:]) if r.returncode else (sortie[-1] if sortie else "?")))
  71:         ok &= r.returncode == 0
  72: sys.exit(0 if ok else 1)

