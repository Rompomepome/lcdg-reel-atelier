### scripts/apercu.py
   1: """
   2: Apercu sans voix d'un episode, pour valider texte, plans et inserts avant de payer la voix.
   3: 
   4:     python scripts/apercu.py episodes/<dossier> [...] [--carre]
   5: 
   6: Copie l'episode dans episodes/_apercu-<slug> (plans compris), retire les champs "voix" (chaque plan dure
   7: alors son champ "duree"), puis lance render.py, et render_carre.py avec --carre. Aucun credit ElevenLabs.
   8: Les dossiers _apercu-* ne se commitent pas : supprime-les une fois l'apercu valide.
   9: """
  10: import sys
  11: if hasattr(sys.stdout, "reconfigure"):
  12:     sys.stdout.reconfigure(encoding="utf-8", errors="replace")
  13: 
  14: import json
  15: import shutil
  16: import subprocess
  17: from pathlib import Path
  18: 
  19: R = Path(__file__).resolve().parent.parent
  20: 
  21: carre = "--carre" in sys.argv
  22: dossiers = [a for a in sys.argv[1:] if not a.startswith("--")]
  23: if not dossiers:
  24:     raise SystemExit(__doc__)
  25: ok = True
  26: for d in dossiers:
  27:     src = (R / d).resolve()
  28:     ep = json.loads((src / "script.json").read_text(encoding="utf-8"))
  29:     slug = "apercu-" + ep["slug"]
  30:     dst = R / "episodes" / f"_{slug}"
  31:     (dst / "broll").mkdir(parents=True, exist_ok=True)
  32:     for b in ep["blocs"]:
  33:         b.pop("voix", None)
  34:         shutil.copyfile(src / "broll" / b["fichier"], dst / "broll" / b["fichier"])
  35:         carre = src / "broll_carre" / b["fichier"]          # version carree propre a ce plan
  36:         if carre.exists():
  37:             (dst / "broll_carre").mkdir(exist_ok=True)
  38:             shutil.copyfile(carre, dst / "broll_carre" / b["fichier"])
  39:     ep["slug"] = slug
  40:     (dst / "script.json").write_text(json.dumps(ep, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
  41:     for script in ["render.py"] + (["render_carre.py"] if carre else []):
  42:         r = subprocess.run([sys.executable, f"scripts/{script}", str(dst)], cwd=R)
  43:         ok &= r.returncode == 0
  44:         print(f"{src.name} {script} : {'OK' if r.returncode == 0 else 'ECHEC'}", flush=True)
  45:     print(f"apercu : {dst / f'reel_{slug}.mp4'}")
  46: sys.exit(0 if ok else 1)
### scripts/controle_voix.py
   1: """
   2: Controle de la narration d'un episode, sans pouvoir l'ecouter :
   3: 
   4:     python scripts/controle_voix.py episodes/<dossier> ["passage a risque" ...]
   5: 
   6: 1. Debit de chaque bloc, blancs de plus de 0,9 s, et indication de jeu peut-etre prononcee (une [indication]
   7:    qui dure plus de 0,4 s dans l'horodatage).
   8: 2. Transcription Scribe (ElevenLabs, incluse dans le compte gratuit) comparee au texte lu : un mot deforme
   9:    ressort (« bandette » pour « bandelette »). Les sigles epeles (« C.S.M.F. ») et les nombres en lettres
  10:    s'ecrivent autrement : ces ecarts-la sont normaux. Scribe « corrige » parfois une mauvaise prononciation
  11:    (« consulpation » transcrit « consultation », 28/10/2026) : il ne remplace pas l'ecoute.
  12: 3. Avec des passages en argument : un extrait sonore de ces passages (noms de medicaments, sigles, mots longs),
  13:    episodes/<dossier>/final/extrait_voix_mots_difficiles.mp3, a faire ecouter a Romain avec chaque nouvelle voix.
  14: """
  15: import sys
  16: if hasattr(sys.stdout, "reconfigure"):
  17:     sys.stdout.reconfigure(encoding="utf-8", errors="replace")
  18: 
  19: import difflib
  20: import json
  21: import os
  22: import re
  23: import subprocess
  24: import unicodedata
  25: from pathlib import Path
  26: 
  27: import requests
  28: 
  29: R = Path(__file__).resolve().parent.parent
  30: sys.path.insert(0, str(R))
  31: try:
  32:     from dotenv import load_dotenv
  33:     load_dotenv(R / ".env")
  34: except ImportError:
  35:     pass
  36: from config import charte as C
  37: from lcdg import binaires as B, voix
  38: 
  39: if len(sys.argv) < 2:
  40:     raise SystemExit(__doc__)
  41: D = (R / sys.argv[1]).resolve()
  42: passages = sys.argv[2:]
  43: ep = json.loads((D / "script.json").read_text(encoding="utf-8"))
  44: _, morceaux = voix.textes(ep)
  45: tv = [t for t, _ in morceaux]
  46: texte = " ".join(tv)
  47: v = voix.choix(ep)
  48: # sans voix_off, la voix par defaut de la charte (comme voix.preparer)
  49: mp3, js = voix.chemins(texte, v.get("id") or C.VOIX_ID, D / "voix", v.get("modele"), v.get("reglages"))
  50: if not mp3.exists():
  51:     raise SystemExit("[!] narration absente du cache : lance d'abord render.py")
  52: al = json.loads(js.read_text(encoding="utf-8"))
  53: deb, fin = al["character_start_times_seconds"], al["character_end_times_seconds"]
  54: print(f"{mp3.name} : {fin[-1]:.1f} s pour {len(texte)} caracteres")
  55: 
  56: 
  57: def lisible(i0, i1):
  58:     """Index des caracteres lus (hors indications entre crochets) de [i0, i1)."""
  59:     out, dans = [], False
  60:     for i in range(i0, i1):
  61:         c = texte[i]
  62:         if c == "[":
  63:             dans = True
  64:         elif c == "]":
  65:             dans = False
  66:         elif not dans and c.strip():
  67:             out.append(i)
  68:     return out
  69: 
  70: 
  71: # 1. debit, blancs, indications
  72: p = 0
  73: for k, t in enumerate(tv, 1):
  74:     idx = lisible(p, p + len(t))
  75:     a, z = deb[idx[0]], fin[idx[-1]]
  76:     lu = len(re.sub(r"\[[^\]]*\]", "", t))
  77:     print(f"  B{k:<2} {a:6.2f}-{z:6.2f} s  {z - a:5.2f} s  {lu / (z - a):5.1f} car/s")
  78:     p += len(t) + 1
  79: blancs = []
  80: idx = lisible(0, len(texte))
  81: for i, j in zip(idx, idx[1:]):
  82:     if deb[j] - fin[i] > 0.9:
  83:         blancs.append((deb[j] - fin[i], texte[max(0, i - 30):i + 1]))
  84: for g, ctx in sorted(blancs, reverse=True)[:6]:
  85:     print(f"  blanc de {g:.2f} s apres « …{ctx} »")
  86: for m in re.finditer(r"\[[^\]]*\]", texte):
  87:     if fin[m.end() - 1] - deb[m.start()] > 0.4:
  88:         print(f"  [!] indication {m.group()} : {fin[m.end() - 1] - deb[m.start()]:.2f} s, peut-etre prononcee")
  89: 
  90: # 2. transcription comparee au texte lu
  91: cache = mp3.with_suffix(".transcription.json")
  92: if not cache.exists():
  93:     with open(mp3, "rb") as f:
  94:         r = requests.post("https://api.elevenlabs.io/v1/speech-to-text",
  95:                           headers={"xi-api-key": os.environ["ELEVENLABS_API_KEY"]},
  96:                           data={"model_id": "scribe_v1", "language_code": "fra", "tag_audio_events": "false"},
  97:                           files={"file": (mp3.name, f, "audio/mpeg")}, timeout=300)
  98:     if not r.ok:
  99:         raise SystemExit(f"[!] transcription refusee ({r.status_code}) : {r.text[:200]}")
 100:     cache.write_text(json.dumps(r.json(), ensure_ascii=False), encoding="utf-8")
 101: 
 102: 
 103: def mots(s):
 104:     s = re.sub(r"\[[^\]]*\]", " ", s)
 105:     s = unicodedata.normalize("NFKD", s.lower().replace("’", "'"))
 106:     s = "".join(c for c in s if not unicodedata.combining(c))
 107:     return re.findall(r"[a-z0-9]+", s)
 108: 
 109: 
 110: attendu, entendu = mots(texte), mots(json.loads(cache.read_text(encoding="utf-8"))["text"])
 111: print(f"transcription : {len(attendu)} mots attendus, {len(entendu)} transcrits")
 112: for op, a0, a1, b0, b1 in difflib.SequenceMatcher(None, attendu, entendu, autojunk=False).get_opcodes():
 113:     if op != "equal":
 114:         print(f"  {op:8} attendu « {' '.join(attendu[a0:a1])} »  entendu « {' '.join(entendu[b0:b1])} »")
 115: 
 116: # 3. extrait sonore des passages a risque
 117: segments = []
 118: for ps in passages:
 119:     i = texte.find(ps)
 120:     if i < 0:
 121:         print(f"  [!] passage introuvable dans le texte lu : « {ps} »")
 122:         continue
 123:     segments.append((max(0.0, deb[i] - 0.3), fin[i + len(ps) - 1] + 0.35))
 124: if segments:
 125:     filtres = [f"[0:a]atrim={a:.2f}:{z:.2f},asetpts=PTS-STARTPTS,apad=pad_dur=0.5[s{k}]"
 126:                for k, (a, z) in enumerate(segments)]
 127:     filtres.append("".join(f"[s{k}]" for k in range(len(segments))) +
 128:                    f"concat=n={len(segments)}:v=0:a=1,loudnorm=I=-16:TP=-1.5")
 129:     (D / "final").mkdir(exist_ok=True)
 130:     sortie = D / "final" / "extrait_voix_mots_difficiles.mp3"
 131:     subprocess.run([B.FFMPEG, "-v", "error", "-y", "-i", str(mp3), "-filter_complex", ";".join(filtres),
 132:                     "-c:a", "libmp3lame", "-b:a", "192k", str(sortie)], check=True)
 133:     print(f"extrait : {sortie} ({len(segments)} passages)")
### scripts/livrer.py
   1: """
   2: Rendu final d'un ou plusieurs episodes : render.py (9:16), puis render_carre.py, puis les livrables sous
   3: leurs noms habituels dans episodes/<dossier>/final/.
   4: 
   5:     python scripts/livrer.py episodes/<dossier> [episodes/<dossier>-pub ...]
   6: 
   7: S'arrete au premier rendu non conforme. Environ 10 min par reel et par format.
   8: """
   9: import sys
  10: if hasattr(sys.stdout, "reconfigure"):
  11:     sys.stdout.reconfigure(encoding="utf-8", errors="replace")
  12: 
  13: import json
  14: import shutil
  15: import subprocess
  16: from pathlib import Path
  17: 
  18: R = Path(__file__).resolve().parent.parent
  19: GARDER = ("OK", "[!]", "conforme", "Traceback", "Error")
  20: 
  21: if len(sys.argv) < 2:
  22:     raise SystemExit(__doc__)
  23: for d in sys.argv[1:]:
  24:     ep_dir = (R / d).resolve()
  25:     for script in ("render.py", "render_carre.py"):
  26:         print(f"== {ep_dir.name} : {script}", flush=True)
  27:         r = subprocess.run([sys.executable, f"scripts/{script}", str(ep_dir.relative_to(R))], cwd=R,
  28:                            capture_output=True, text=True, encoding="utf-8", errors="replace")
  29:         lignes = (r.stdout + r.stderr).strip().splitlines()
  30:         print("\n".join(l for l in lignes if any(g in l for g in GARDER))[-1500:], flush=True)
  31:         if r.returncode:
  32:             print("\n".join(lignes[-15:]))
  33:             sys.exit(f"[!] {ep_dir.name} : {script} a echoue")
  34:     slug = json.loads((ep_dir / "script.json").read_text(encoding="utf-8"))["slug"]
  35:     final = ep_dir / "final"
  36:     final.mkdir(exist_ok=True)
  37:     for src, dst in {f"reel_{slug}.mp4": f"reel_{slug}_9x16.mp4", f"reel_{slug}_carre.mp4": f"reel_{slug}_1x1.mp4",
  38:                      f"couverture_{slug}.jpg": f"couverture_{slug}_9x16.jpg",
  39:                      f"couverture_{slug}_4x5.jpg": f"couverture_{slug}_4x5.jpg",
  40:                      f"couverture_{slug}_carre.jpg": f"couverture_{slug}_1x1.jpg"}.items():
  41:         shutil.copyfile(ep_dir / src, final / dst)
  42:     print(f"{ep_dir.name} : livrables dans {final}", flush=True)
  43: print("FINI", flush=True)
### scripts/proto_inserts.py
   1: """Banc d'essai des inserts : dessine un insert seul, à plusieurs instants, sur une image de fond,
   2: sans rendre de reel (quelques secondes au lieu de cinq minutes).
   3: 
   4:     python scripts/proto_inserts.py <spec.json> <sortie.png> [--temps 0,2.5] [--bas 980] [--fond image.jpg]
   5:         [--instants 0.3,0.8,1.5,3,6]
   6: 
   7: spec.json : un insert (objet) ou plusieurs (liste, comme le champ "insert" d'un bloc).
   8: --temps : début de chaque temps du bloc, en secondes (0 = début du bloc)."""
   9: import argparse
  10: import json
  11: import sys
  12: from pathlib import Path
  13: 
  14: from PIL import Image, ImageDraw, ImageFont
  15: 
  16: R = Path(__file__).resolve().parent.parent
  17: sys.path.insert(0, str(R))
  18: from config import charte as C
  19: from lcdg import inserts as I
  20: 
  21: a = argparse.ArgumentParser()
  22: a.add_argument("spec"), a.add_argument("sortie")
  23: a.add_argument("--temps", default="0,3")
  24: a.add_argument("--bas", type=float, default=990)
  25: a.add_argument("--fond")
  26: a.add_argument("--instants", default="0.3,0.7,1.2,2,3,3.6,4.5,7")
  27: args = a.parse_args()
  28: 
  29: 
  30: class Part:
  31:     def __init__(self, debut):
  32:         self.debut = debut
  33: 
  34:     def _sortie(self, t):
  35:         return 0.0
  36: 
  37: 
  38: class Scene:
  39:     def __init__(self, temps):
  40:         self.debut, self.fin = temps[0], temps[-1] + 10
  41:         self.parts = [Part(x) for x in temps]
  42: 
  43: 
  44: specs = json.loads(Path(args.spec).read_text(encoding="utf-8"))
  45: specs = [specs] if isinstance(specs, dict) else specs
  46: scene = Scene([float(x) for x in args.temps.split(",")])
  47: objs, premier = [], None
  48: for sp in specs:
  49:     o = I.TYPES[sp["type"]]("essai", sp, scene, args.bas - C.INSERT_ECART)
  50:     if sp.get("sur") and premier is not None:
  51:         o.x = premier.x + (premier.w - o.w) / 2
  52:         o.y = premier.y + (premier.h - o.h) / 2
  53:     premier = premier or o
  54:     objs.append(o)
  55: print("échelles :", [round(o.s, 2) for o in objs], "tailles :", [(o.w, o.h) for o in objs])
  56: fond = Image.open(args.fond).convert("RGBA").resize((C.LARGEUR, C.HAUTEUR)) if args.fond else \
  57:     Image.new("RGBA", (C.LARGEUR, C.HAUTEUR), (70, 80, 96, 255))
  58: haut = int(min(o.y for o in objs) - 60)
  59: bas = int(args.bas + 140)
  60: vignettes = []
  61: for t in [float(x) for x in args.instants.split(",")] + ["final"]:
  62:     im = fond.copy()
  63:     for o in objs:
  64:         o.dessiner(im, 0 if t == "final" else t, final=t == "final")
  65:     im = im.crop((0, max(0, haut), C.LARGEUR, min(C.HAUTEUR, bas)))
  66:     d = ImageDraw.Draw(im)
  67:     d.text((16, 10), f"t = {t}", fill=(255, 255, 0, 255), font=ImageFont.truetype("arial.ttf", 34))
  68:     vignettes.append(im.resize((im.width // 2, im.height // 2), Image.LANCZOS))
  69: cols = 3
  70: w, h = vignettes[0].size
  71: planche = Image.new("RGB", (cols * w + (cols + 1) * 6, ((len(vignettes) + cols - 1) // cols) * (h + 6) + 6), (230, 230, 236))
  72: for i, v in enumerate(vignettes):
  73:     planche.paste(v, (6 + (i % cols) * (w + 6), 6 + (i // cols) * (h + 6)))
  74: planche.save(args.sortie)
  75: print(args.sortie, planche.size)
  76: print("sons :", [(round(x, 2), s) for o in objs for x, s in o.sons()])
### scripts/pub.py
   1: """
   2: Version publicite d'un reel (environ 35 a 45 s), decoupee dans le reel complet, sans credit ElevenLabs :
   3: 
   4:     python scripts/pub.py episodes/<dossier> 0,1,2,8,9 [--badge "Vaccins au cabinet"]
   5:     python scripts/livrer.py episodes/<dossier>-pub
   6: 
   7: Les blocs gardes (le bloc 0, la couverture, en tete) reprennent texte, plan et animation du reel complet. La
   8: narration n'est pas relue : elle est decoupee dans celle du reel complet, dans les silences entre les phrases
   9: (meme prise, meme intonation), puis entre dans le cache de lcdg/voix.py sous la cle du texte de la pub :
  10: render.py la reprend comme une narration ordinaire. Rendre d'abord le reel complet (sa narration en cache).
  11: 
  12: Choisir les blocs : le fait fort, le probleme, une question ouverte, l'appel final. Un bloc qui commence par
  13: « Mais » ou « Et » repond au precedent : il ne se garde pas seul. --badge remplace la pastille d'ouverture :
  14: pas de vocabulaire reglementaire (decret, loi) dans la pub, Meta refuse en Europe les publicites qu'il classe
  15: comme politiques (refus du reel « minimum de patients », 10/2026).
  16: """
  17: import sys
  18: if hasattr(sys.stdout, "reconfigure"):
  19:     sys.stdout.reconfigure(encoding="utf-8", errors="replace")
  20: 
  21: import json
  22: import os
  23: import shutil
  24: import subprocess
  25: from pathlib import Path
  26: 
  27: import numpy as np
  28: 
  29: R = Path(__file__).resolve().parent.parent
  30: sys.path.insert(0, str(R))
  31: from config import charte as C
  32: from lcdg import binaires as B, voix
  33: 
  34: TAUX = 44100
  35: FONDU = 0.01
  36: 
  37: args = [a for a in sys.argv[1:]]
  38: if len(args) < 2:
  39:     raise SystemExit(__doc__)
  40: SRC = (R / args[0]).resolve()
  41: garder = [int(x) for x in args[1].split(",")]
  42: if garder[0] != 0:
  43:     raise SystemExit("[!] la pub commence par le bloc 0 (la couverture) : 0,1,...")
  44: autres = {}
  45: if "--badge" in args:
  46:     autres["badge"] = args[args.index("--badge") + 1]
  47: DST = SRC.with_name(SRC.name + "-pub")
  48: 
  49: 
  50: def pcm(f):
  51:     r = subprocess.run([B.FFMPEG, "-v", "error", "-i", str(f), "-f", "f32le", "-ac", "1", "-ar", str(TAUX), "-"],
  52:                        capture_output=True, check=True)
  53:     return np.frombuffer(r.stdout, dtype="<f4").copy()
  54: 
  55: 
  56: # ---------------------------------------------------------------- script de la publicite
  57: ep = json.loads((SRC / "script.json").read_text(encoding="utf-8"))
  58: b = ep["blocs"]
  59: pub = {k: v for k, v in ep.items() if k != "blocs"}
  60: pub["slug"] = f"{ep['slug']}-pub"
  61: pub.update(autres)
  62: blocs = []
  63: (DST / "broll").mkdir(parents=True, exist_ok=True)
  64: for k, src in enumerate(garder):
  65:     bl = json.loads(json.dumps(b[src]))
  66:     bl.pop("temps", None)
  67:     bl["fichier"] = f"B{k}.mp4"
