  69:     carre = SRC / "broll_carre" / b[src]["fichier"]        # version carree propre a ce plan
  70:     if carre.exists():
  71:         (DST / "broll_carre").mkdir(exist_ok=True)
  72:         shutil.copyfile(carre, DST / "broll_carre" / bl["fichier"])
  73:     blocs.append(bl)
  74: pub["blocs"] = blocs
  75: (DST / "script.json").write_text(json.dumps(pub, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
  76: 
  77: # ---------------------------------------------------------------- narration decoupee
  78: vx = dict(voix.choix(ep))
  79: vx["id"] = vx.get("id") or C.VOIX_ID              # sans voix_off, la voix par defaut de la charte
  80: _, m_src = voix.textes(ep)
  81: tv = [t for t, _ in m_src]                       # tv[i] : texte lu du bloc i + 1
  82: texte_src = " ".join(tv)
  83: mp3_s, js_s = voix.chemins(texte_src, vx["id"], SRC / "voix", vx.get("modele"), vx.get("reglages"))
  84: if not (mp3_s.exists() and js_s.exists()):
  85:     raise SystemExit("[!] narration du reel complet absente du cache : rends-le d'abord")
  86: al = json.loads(js_s.read_text(encoding="utf-8"))
  87: assert "".join(al["characters"]) == texte_src
  88: deb, fin = al["character_start_times_seconds"], al["character_end_times_seconds"]
