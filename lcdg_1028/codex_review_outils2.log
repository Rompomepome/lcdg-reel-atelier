2568: # ---------------------------------------------------------------- carte
2569: class Carte(_Insert):
2570:     """Une carte CPS au nom de son titulaire, a cote du lecteur ; au temps "temps" (sinon un instant
2571:     apres son arrivee), elle glisse dans la fente et l'ecran repond : une coche ("ok"), ou une croix,
2572:     et la carte refusee tremble."""
2573: 
2574:     def taille_nominale(self):
2575:         return C.TEXTE_LARGEUR, C.CARTE_H
2576: 
2577:     def __init__(self, *a):
2578:         super().__init__(*a)
2579:         g = C.CARTE_GEO
2580:         self.ok = self.spec.get("ok", True)
2581:         self.carte = _ombre_marge(self._carte(), self.s)
2582:         self.lecteur = _ombre_marge(self._lecteur(), self.s)
2583:         self.verdict = _icone_choix(self.ok, self.px(g["resultat"]), self.px(g["trait"]), self.rubrique)
2584:         cw, lw = self.px(g["carte"][0]), self.px(g["lecteur"][0])
2585:         self.lx = self.m + self.w - self.px(g["pad"]) - lw / 2           # centre du lecteur
2586:         self.x0 = self.m + self.px(g["pad"]) + cw / 2                     # la carte posee a gauche
2587:         self.x1 = self.lx - lw / 2 + cw * (g["profondeur"] - 0.5)         # engagee dans la fente
2588:         self.cy = self.m + self.h / 2
2589: 
2590:     def _carte(self):
2591:         g = C.CARTE_GEO
2592:         w, h, ra = self.px(g["carte"][0]), self.px(g["carte"][1]), self.px(g["rayon"])
2593:         pw, ph = self.px(g["puce"][0]), self.px(g["puce"][1])
2594:         px0, py0 = self.px(g["puce_xy"][0]), self.px(g["puce_xy"][1])
2595:         cl, ce, pad = self.px(g["croix"][0]), self.px(g["croix"][1]), self.px(g["pad"])
2596:         rub = tuple(self.rubrique)
2597:         im = _net(w, h, lambda d, k: d.rounded_rectangle([0, 0, w * k - 1, h * k - 1], radius=ra * k,
2598:                                                          fill=rub + (255,)))
2599:         reflet = _net(w, h, lambda d, k: d.ellipse([w * k * 0.5, h * k * 0.3, w * k * 1.4, h * k * 1.7],
2600:                                                    fill=_teinte(rub, 0.16) + (255,)))
2601:         reflet.putalpha(ImageChops.multiply(reflet.getchannel("A"), im.getchannel("A")))
2602:         im.alpha_composite(reflet)
2603: 
2604:         def puce(d, k):
2605:             d.rounded_rectangle([0, 0, pw * k - 1, ph * k - 1], radius=ph * k * 0.22, fill=C.INSERT_GRIS + (255,))
2606:             trait, filet = max(1, int(ph * k * 0.07)), _teinte(rub, 0.45) + (255,)
2607:             for y in (ph * k / 3, ph * k * 2 / 3):
2608:                 d.line([(0, y), (pw * k * 0.36, y)], fill=filet, width=trait)
2609:                 d.line([(pw * k * 0.64, y), (pw * k, y)], fill=filet, width=trait)
2610:             d.rounded_rectangle([pw * k * 0.36, ph * k * 0.2, pw * k * 0.64, ph * k * 0.8], radius=ph * k * 0.08,
2611:                                 outline=filet, width=trait)
2612:         im.alpha_composite(_net(pw, ph, puce), (px0, py0))
2613:         d = ImageDraw.Draw(im)
2614:         cx, cyc = w - pad - cl / 2, pad + cl / 2                          # la croix du soin
2615:         d.rectangle([cx - cl / 2, cyc - ce / 2, cx + cl / 2, cyc + ce / 2], fill=C.BLANC + (255,))
2616:         d.rectangle([cx - ce / 2, cyc - cl / 2, cx + ce / 2, cyc + cl / 2], fill=C.BLANC + (255,))
2617:         _ecrire(d, (pad, pad), "CARTE CPS", self.px(g["titre_px"]), C.INSERT_GRAISSE_FORTE, C.BLANC + (255,))
2618:         # le nom tient dans la part de la carte qui reste visible une fois engagee dans le lecteur
2619:         nom, px = T.normaliser(self.spec.get("titulaire", "")), self.px(g["nom_px"])
2620:         visible = w * (1 - g["profondeur"]) - 2 * pad
2621:         while px > self.px(g["nom_px_min"]) and T.largeur(nom, px, C.INSERT_GRAISSE_FORTE, 0) > visible:
2622:             px -= 1
2623:         _ecrire(d, (pad, h - pad), nom, px, C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "ls")
2624:         return im
2625: 
2626:     def _lecteur(self):
2627:         g = C.CARTE_GEO
2628:         w, h, ra = self.px(g["lecteur"][0]), self.px(g["lecteur"][1]), self.px(g["lecteur_rayon"])
2629:         ew, eh, ey = self.px(g["ecran"][0]), self.px(g["ecran"][1]), self.px(g["ecran_y"])
2630:         tr, ty, tp = self.px(g["touche"]), self.px(g["touches_y"]), self.px(g["touches_pas"])
2631:         fw, fh = self.px(g["fente"][0]), self.px(g["fente"][1])
2632: 
2633:         def dessin(d, k):
2634:             d.rounded_rectangle([0, 0, w * k - 1, h * k - 1], radius=ra * k, fill=C.NAVY + (255,))
2635:             d.rounded_rectangle([(w - ew) / 2 * k, ey * k, (w + ew) / 2 * k, (ey + eh) * k], radius=ra * k * 0.4,
2636:                                 fill=(8, 5, 26, 255))
2637:             for rang in range(2):
2638:                 for col in (-1, 0, 1):
2639:                     x, y = (w / 2 + col * tp) * k, (ty + rang * tp) * k
2640:                     d.ellipse([x - tr * k / 2, y - tr * k / 2, x + tr * k / 2, y + tr * k / 2],
2641:                               fill=_teinte(C.NAVY, 0.3) + (255,))
2642:             d.rounded_rectangle([0, (h - fh) / 2 * k, fw * k, (h + fh) / 2 * k], radius=fw * k / 2,
2643:                                 fill=(8, 5, 26, 255))                     # la fente, sur le bord gauche
2644:         return _net(w, h, dessin)
2645: 
2646:     def _t_glisse(self):
2647:         if "temps" in self.spec:
2648:             return self.t0(self.spec["temps"])
2649:         return self.t0() + C.CARTE_GEO["attente"]
2650: 
2651:     def image(self, t, final):
2652:         g = C.CARTE_GEO
2653:         k, a = _entree(t, self.t0(), final)
2654:         if a <= 0:
2655:             return None
2656:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
2657:         tg, tv = self._t_glisse(), self._t_glisse() + g["course"]
2658:         p = 1.0 if final else T.lisse((t - tg) / g["course"])
2659:         x = self.x0 + (self.x1 - self.x0) * p
2660:         if not final:                                    # la carte arrive de la gauche
2661:             x -= self.px(g["glisse"]) * (1 - T.lisse((t - self.t0()) / C.INSERT_ENTREE))
2662:             v = (t - tv) / g["refus"][1]
2663:             if not self.ok and 0 < v < 1:                # refusee : elle tremble
2664:                 x += self.px(g["refus"][0]) * math.sin(2 * math.pi * 4 * v) * (1 - v)
2665:         _poser(out, self.carte, x, self.cy, k, a)
2666:         _poser(out, self.lecteur, self.lx, self.cy, k, a)   # le lecteur passe devant la carte engagee
2667:         v = 1.0 if final else (t - tv) / C.INSERT_ENTREE
2668:         if v > 0:
2669:             kk = C.CHOIX_GEO["icone_depart"] + (1 - C.CHOIX_GEO["icone_depart"]) * (1.0 if final else T.rebond(v))
2670:             ey = self.cy - self.px(g["lecteur"][1]) / 2 + self.px(g["ecran_y"]) + self.px(g["ecran"][1]) / 2
2671:             _poser(out, self.verdict, self.lx, ey, kk, 1.0 if final else T.lisse(v * C.INSERT_FONDU))
2672:         return out
2673: 
2674:     def sons(self):
2675:         tv = self._t_glisse() + C.CARTE_GEO["course"]
2676:         return [(self.t0(), "souffle"), (self._t_glisse(), "souffle"), (tv, "clic" if self.ok else "impact")]
2677: 
2678: 
2679: # ---------------------------------------------------------------- compteur
2680: class Compteur(_Insert):
2681:     """Un compteur a rouleaux : les chiffres defilent, puis s'arretent un a un sur « ? » au temps
2682:     "temps" ; une pilule rouge claque dessous (« Aucun chiffre officiel »). Aucun nombre n'y reste :
2683:     le compteur dit que personne ne le publie."""
2684: 
2685:     def taille_nominale(self):
2686:         return C.TEXTE_LARGEUR, C.COMPTEUR_H
2687: 
2688:     def __init__(self, *a):
2689:         super().__init__(*a)
2690:         g = C.COMPTEUR_GEO
2691:         self.n = self.spec.get("chiffres", 4)
2692:         self.cw, self.ch = self.px(g["case"][0]), self.px(g["case"][1])
2693:         ra, pad = self.px(g["rayon"]), self.px(g["pad"])
2694:         self.case = _net(self.cw, self.ch, lambda d, k: d.rounded_rectangle(
2695:             [0, 0, self.cw * k - 1, self.ch * k - 1], radius=ra * k, fill=C.NAVY + (255,)))
2696:         px = self.px(g["chiffre_px"])
2697:         self.glyphes = {c: self._glyphe(c, px, C.BLANC) for c in "0123456789"}
2698:         self.glyphes["?"] = self._glyphe("?", px, _teinte(self.rubrique, 0.4))
2699:         carte = _cadre(self.w, self.h, self.s, marge=self.m)
2700:         d = ImageDraw.Draw(carte)
2701:         tp = self.px(g["titre_px"])
2702:         _ecrire(d, (self.m + pad, self.m + pad), T.normaliser(self.spec.get("titre", "")).upper(), tp,
2703:                 C.INSERT_GRAISSE_FORTE, C.INSERT_GRIS_TEXTE + (255,))
2704:         _ecrire(d, (self.m + self.w - pad, self.m + pad), self.spec.get("date", ""), tp, C.INSERT_GRAISSE_TEXTE,
2705:                 C.INSERT_GRIS_TEXTE + (255,), "ra")
2706:         self.carte = _ombre(carte, self.s)
2707:         largeur = self.n * self.cw + (self.n - 1) * self.px(g["ecart"])
2708:         self.xs = [self.m + (self.w - largeur) / 2 + i * (self.cw + self.px(g["ecart"])) for i in range(self.n)]
2709:         self.yc = self.m + self.px(g["case_y"])
2710:         self.pilule = None
2711:         if self.spec.get("pilule"):
2712:             self.pilule = _ombre_marge(_bulle(self.spec["pilule"], self.px(g["pilule_px"]), self.px(g["pilule_h"]),
2713:                                               self.px(g["pilule_pad"]), C.INSERT_ROUGE, queue=False), self.s)
2714: 
2715:     def _glyphe(self, c, px, couleur):
2716:         im = Image.new("RGBA", (self.cw, self.ch), (0, 0, 0, 0))
2717:         _ecrire(ImageDraw.Draw(im), (self.cw / 2, self.ch / 2), c, px, C.INSERT_GRAISSE_CHIFFRE, couleur + (255,), "mm")
2718:         return im
2719: 
2720:     def _t_arret(self, i):
2721:         return self.t0(self.spec.get("temps", 1)) + C.INSERT_DELAI + i * C.COMPTEUR_GEO["arret"]
2722: 
2723:     def _t_pilule(self):
2724:         g = C.COMPTEUR_GEO
2725:         return self._t_arret(self.n - 1) + g["chute"] + g["pilule_delai"]
2726: 
2727:     def _rouleau(self, i, t, final):
2728:         g = C.COMPTEUR_GEO
2729:         couche = Image.new("RGBA", (self.cw, self.ch), (0, 0, 0, 0))
2730:         ta = self._t_arret(i)
2731:         if final or t >= ta + g["chute"]:
2732:             couche.alpha_composite(self.glyphes["?"])
2733:         else:
2734:             v = g["vitesse"] * (max(self.t0(), min(t, ta)) - self.t0()) + i * 3.7
2735:             chiffre, f = int(v) % 10, v - int(v)
2736:             if t < ta:                                   # le rouleau tourne : le chiffre suivant monte
2737:                 _coller_coupe(couche, self.glyphes[str(chiffre)], 0, -f * self.ch)
2738:                 _coller_coupe(couche, self.glyphes[str((chiffre + 1) % 10)], 0, (1 - f) * self.ch)
2739:             else:                                        # il s'arrete : le « ? » tombe a sa place
2740:                 q = T.rebond((t - ta) / g["chute"])
2741:                 _coller_coupe(couche, self.glyphes[str(chiffre)], 0, q * self.ch)
2742:                 _coller_coupe(couche, self.glyphes["?"], 0, (q - 1) * self.ch)
2743:         couche.putalpha(ImageChops.multiply(couche.getchannel("A"), self.case.getchannel("A")))
2744:         im = self.case.copy()
2745:         im.alpha_composite(couche)
2746:         return im
2747: 
2748:     def image(self, t, final):
2749:         g = C.COMPTEUR_GEO
2750:         k, a = _entree(t, self.t0(), final)
2751:         if a <= 0:
2752:             return None
2753:         cal = self.carte.copy()
2754:         for i, x in enumerate(self.xs):
2755:             cal.alpha_composite(self._rouleau(i, t, final), (int(x), int(self.yc)))
2756:         if self.pilule is not None:
2757:             kk, aa = _frappe(t, self._t_pilule(), final)
2758:             if aa > 0:
2759:                 _poser(cal, self.pilule, self.m + self.w / 2,
2760:                        self.m + self.h - self.px(g["pilule_dy"]) - self.px(g["pilule_h"]) / 2, kk, aa, -3)
2761:         out = Image.new("RGBA", cal.size, (0, 0, 0, 0))
2762:         _poser(out, cal, cal.width / 2, cal.height / 2, k, a)
2763:         return out
2764: 
2765:     def sons(self):
2766:         out = [(self.t0(), "compteur")] + [(self._t_arret(i), "clic") for i in range(self.n)]
2767:         if self.pilule is not None:
2768:             out.append((self._t_pilule() + C.TAMPON_FRAPPE, "impact"))
2769:         return out
2770: 
2771: 
2772: # ---------------------------------------------------------------- bouclier
2773: _BOUCLIER = [(0.5, 0.0), (0.95, 0.12), (0.95, 0.48), (0.89, 0.68), (0.76, 0.85), (0.5, 1.0), (0.24, 0.85),
2774:              (0.11, 0.68), (0.05, 0.48), (0.05, 0.12)]
2775: 
2776: 
2777: class Bouclier(_Pilules, _Insert):
2778:     """Un bouclier qui couvre une silhouette (le docteur junior) ; au temps "temps", son contour se
2779:     defait en pointilles et un « ? » se balance : on ne sait pas s'il le couvre. A droite, les
2780:     pilules du texte."""
2781: 
2782:     def taille_nominale(self):
2783:         return C.TEXTE_LARGEUR, C.BOUCLIER_H
2784: 
2785:     def __init__(self, *a):
2786:         super().__init__(*a)
2787:         g = C.BOUCLIER_GEO
2788:         bw, bh = self.px(g["bouclier"][0]), self.px(g["bouclier"][1])
2789:         tr = self.px(g["trait"])
2790:         navy, rub = C.NAVY + (255,), tuple(self.rubrique) + (255,)
2791: 
2792:         def pts(k, retrait=0):
2793:             cx, cy = bw * k / 2, bh * k * 0.48
2794:             fx, fy = 1 - 2 * retrait / bw, 1 - 2 * retrait / bh
2795:             return [(cx + (x * bw * k - cx) * fx, cy + (y * bh * k - cy) * fy) for x, y in _BOUCLIER]
2796: 
2797:         def fond(d, k):
2798:             d.polygon(pts(k), fill=C.BLANC + (255,))
2799:             r, (lb, hb_) = self.px(g["tete"]) * k, (self.px(g["buste"][0]) * k, self.px(g["buste"][1]) * k)
2800:             cx, cy = bw * k / 2, bh * k * 0.5
2801:             d.ellipse([cx - r, cy - r * 2.4, cx + r, cy - r * 0.4], fill=rub)
2802:             d.rounded_rectangle([cx - lb / 2, cy - r * 0.1, cx + lb / 2, cy - r * 0.1 + hb_], radius=hb_ * 0.45, fill=rub)
2803:             cl, ce = self.px(g["croix"][0]) * k, self.px(g["croix"][1]) * k
2804:             yc = cy - r * 0.1 + hb_ * 0.48
2805:             d.rectangle([cx - cl / 2, yc - ce / 2, cx + cl / 2, yc + ce / 2], fill=C.BLANC + (255,))
2806:             d.rectangle([cx - ce / 2, yc - cl / 2, cx + ce / 2, yc + cl / 2], fill=C.BLANC + (255,))
2807: 
2808:         def anneau(d, k):
2809:             d.polygon(pts(k), fill=navy)
2810:             d.polygon(pts(k, tr), fill=(0, 0, 0, 0))
2811:         self.fond = _ombre_marge(_net(bw, bh, fond), self.s)
2812:         plein = _net(bw, bh, anneau)
2813:         periode, trace = (self.px(v) for v in g["pointilles"])
2814:         self.anneaux = [_ombre_marge(plein, self.s), _ombre_marge(_pointilles(plein, periode, trace), self.s)]
2815:         self.badge = _icone_choix(None, self.px(g["badge"]), self.px(C.CHOIX_GEO["trait"]), self.rubrique)
2816:         self.bx, self.by = self.m + bw / 2, self.m + self.h / 2
2817:         self.bw, self.bh = bw, bh
2818:         self._preparer_pilules(g, self.m + bw + self.px(g["ecart"]), self.by)
2819: 
2820:     def _t_doute(self):
2821:         return self.t0(self.spec.get("temps", 1)) + C.INSERT_DELAI
2822: 
2823:     def image(self, t, final):
2824:         g = C.BOUCLIER_GEO
2825:         k, a = _entree(t, self.t0(), final)
2826:         if a <= 0:
2827:             return None
2828:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
2829:         q = 1.0 if final else T.lisse((t - self._t_doute()) / g["bascule"])
2830:         _poser(out, self.fond, self.bx, self.by, k, a)
2831:         _poser(out, self.anneaux[0], self.bx, self.by, k, a * (1 - q))
2832:         _poser(out, self.anneaux[1], self.bx, self.by, k, a * q)
2833:         v = 1.0 if final else (t - self._t_doute() - g["bascule"] * 0.5) / C.INSERT_ENTREE
2834:         if v > 0:
2835:             amp, freq = C.CHOIX_GEO["balance"]
2836:             angle = 0.0 if final or v < 1 else amp * math.sin(2 * math.pi * freq * (t - self._t_doute()))
2837:             kk = 0.3 + 0.7 * (1.0 if final else T.rebond(v))
2838:             _poser(out, self.badge, self.bx + self.bw * 0.4, self.by - self.bh * 0.4, kk,
2839:                    1.0 if final else T.lisse(v * 2), angle)
2840:         self._pilules(out, t, final)
2841:         return out
2842: 
2843:     def sons(self):
2844:         return [(self.t0(), "souffle"), (self._t_doute(), "clic")] + self._sons_pilules()
2845: 
2846: 
2847: # ---------------------------------------------------------------- departements
2848: class Departements(_Insert):
2849:     """Les departements concernes : des tuiles (numero, nom) qui se retournent l'une apres l'autre."""
2850: 
2851:     def taille_nominale(self):
2852:         g = C.DEPARTEMENTS_GEO
2853:         rangs = -(-len(self.spec["liste"]) // g["colonnes"])
2854:         return C.TEXTE_LARGEUR, rangs * g["case_h"] + (rangs - 1) * g["ecart"]
2855: 
2856:     def __init__(self, *a):
2857:         super().__init__(*a)
2858:         g = C.DEPARTEMENTS_GEO
2859:         self.ecart = self.px(g["ecart"])
2860:         self.cw = (self.w - (g["colonnes"] - 1) * self.ecart) // g["colonnes"]
2861:         self.ch = self.px(g["case_h"])
2862:         self.tuiles = []
2863:         for dep in self.spec["liste"]:
2864:             im = _cadre(self.cw, self.ch, self.s, marge=self.m)
2865:             d = ImageDraw.Draw(im)
2866:             _ecrire(d, (self.m + self.cw / 2, self.m + self.ch * g["numero_y"]), dep["numero"],
2867:                     self.px(g["numero_px"]), C.INSERT_GRAISSE_FORTE, tuple(self.rubrique) + (255,), "mm")
2868:             _ecrire(d, (self.m + self.cw / 2, self.m + self.ch * g["nom_y"]), dep["nom"], self.px(g["nom_px"]),
2869:                     C.INSERT_GRAISSE_FORTE, C.NAVY + (255,), "mm")
2870:             self.tuiles.append(_ombre(im, self.s))
2871: 
2872:     def _t(self, i):
2873:         return self.t0(self.spec.get("temps", 0)) + i * C.DEPARTEMENTS_GEO["decalage"]
2874: 
2875:     def image(self, t, final):
2876:         g = C.DEPARTEMENTS_GEO
2877:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
2878:         for i, tuile in enumerate(self.tuiles):
2879:             p = 1.0 if final else (t - self._t(i)) / g["retourne"]
2880:             if p <= 0:
2881:                 continue
2882:             ky = 1.0 if final else max(0.02, T.rebond(p))     # la tuile se retourne : elle s'ouvre en hauteur
2883:             im = tuile.resize((tuile.width, max(1, int(tuile.height * ky))), Image.BICUBIC)
2884:             col, rang = i % g["colonnes"], i // g["colonnes"]
2885:             cx = self.m + col * (self.cw + self.ecart) + self.cw / 2
2886:             cy = self.m + rang * (self.ch + self.ecart) + self.ch / 2
2887:             T.coller(out, im, (cx - im.width / 2, cy - im.height / 2), 1.0 if final else T.lisse(p * C.INSERT_FONDU))
2888:         return out
2889: 
2890:     def sons(self):
2891:         return [(self._t(i), "clic") for i in range(len(self.tuiles))]
2892: 
2893: 
2894: # ---------------------------------------------------------------- ordonnance
2895: class Ordonnance(_Insert):
2896:     """Une ordonnance qui s'ecrit : chaque ligne (le traitement, puis sa condition en gris) se trace
2897:     de gauche a droite, un stylo au bout du trait ; une pilule rouge claque au pied ("pied")."""
2898: 
2899:     def _mise_en_page(self, s):
2900:         """Lignes de texte de chaque prescription et hauteur totale, a l'echelle s."""
2901:         g = C.ORDONNANCE_GEO
2902:         p = lambda v: max(1, int(round(v * s)))
2903:         utile = p(g["w"]) - 2 * p(g["pad"])
2904:         blocs = [(_couper(l["label"], p(g["label_px"]), C.INSERT_GRAISSE_FORTE, utile),
2905:                   _couper(l.get("note", ""), p(g["note_px"]), C.INSERT_GRAISSE_TEXTE, utile) if l.get("note") else [])
2906:                  for l in self.spec["lignes"]]
2907:         hauteurs = [len(a) * p(g["label_px"]) * g["interligne"] + len(b) * p(g["note_px"]) * g["interligne"]
2908:                     for a, b in blocs]
2909:         h = p(g["tete"]) + p(g["pad"]) + sum(hauteurs) + (len(blocs) - 1) * p(g["ligne_ecart"]) + p(g["pad"])
2910:         if self.spec.get("pied"):
2911:             h += p(g["pilule_h"]) + p(g["pad"]) * 0.6
2912:         return blocs, hauteurs, h
2913: 
2914:     def taille_nominale(self):
2915:         return C.ORDONNANCE_GEO["w"], int(self._mise_en_page(1.0)[2])
2916: 
2917:     def __init__(self, *a):
2918:         super().__init__(*a)
2919:         g = C.ORDONNANCE_GEO
2920:         blocs, hauteurs, _ = self._mise_en_page(self.s)
2921:         pad, tete = self.px(g["pad"]), self.px(g["tete"])
2922:         rub = tuple(self.rubrique)
2923:         papier = _cadre(self.w, self.h, self.s, marge=self.m)
2924:         bande = _net(self.w, tete, lambda d, k: (
2925:             d.rounded_rectangle([0, 0, self.w * k - 1, tete * k * 1.5], radius=self.px(C.INSERT_RAYON) * k,
2926:                                 fill=_teinte(rub, 0.88) + (255,)),
2927:             d.rectangle([0, (tete - self.px(g["filet"])) * k, self.w * k, tete * k], fill=rub + (255,))))
2928:         bande.putalpha(ImageChops.multiply(bande.getchannel("A"),
2929:                                            papier.crop((self.m, self.m, self.m + self.w, self.m + tete)).getchannel("A")))
2930:         papier.alpha_composite(bande, (self.m, self.m))
2931:         d = ImageDraw.Draw(papier)
2932:         _ecrire(d, (self.m + pad, self.m + tete / 2), T.normaliser(self.spec.get("titre", "Ordonnance")).upper(),
2933:                 self.px(g["titre_px"]), C.INSERT_GRAISSE_FORTE, rub + (255,), "lm")
2934:         if self.spec.get("marque"):
2935:             marque = _bulle(self.spec["marque"], self.px(g["marque_px"]), self.px(g["marque_h"]),
2936:                             self.px(g["marque_pad"]), rub, queue=False)
2937:             papier.alpha_composite(marque, (int(self.m + self.w - pad - marque.width),
2938:                                             int(self.m + (tete - marque.height) / 2)))
2939:         self.papier = _ombre(papier, self.s)
2940:         self.lignes, self.ly = [], []
2941:         y = self.m + tete + pad
2942:         for (labels, notes), hh in zip(blocs, hauteurs):
2943:             im = Image.new("RGBA", (self.w - 2 * pad, int(hh) + 2), (0, 0, 0, 0))
2944:             dl = ImageDraw.Draw(im)
2945:             yy, lp, np_ = 0, self.px(g["label_px"]), self.px(g["note_px"])
2946:             for l in labels:
2947:                 _ecrire(dl, (0, yy), l, lp, C.INSERT_GRAISSE_FORTE, C.NAVY + (255,))
2948:                 yy += lp * g["interligne"]
2949:             for l in notes:
2950:                 _ecrire(dl, (0, yy), l, np_, C.INSERT_GRAISSE_TEXTE, C.INSERT_GRIS_TEXTE + (255,))
2951:                 yy += np_ * g["interligne"]
2952:             self.lignes.append(im)
2953:             self.ly.append(y)
2954:             y += hh + self.px(g["ligne_ecart"])
2955:         self.pied = None
2956:         if self.spec.get("pied"):
2957:             self.pied = _ombre_marge(_bulle(self.spec["pied"], self.px(g["pilule_px"]), self.px(g["pilule_h"]),
2958:                                             self.px(g["pilule_pad"]), C.INSERT_ROUGE, queue=False), self.s)
2959:             self.pied_y = self.m + self.h - pad * 0.6 - self.px(g["pilule_h"]) / 2
2960:         sw, sl = self.px(g["stylo"][0]), self.px(g["stylo"][1])
2961:         cote = 2 * sl + 4
2962: 
2963:         def stylo(dd, k):                                # pointe au centre, corps vers le haut
2964:             c = cote * k / 2
2965:             dd.rounded_rectangle([c - sw * k / 2, c - sl * k, c + sw * k / 2, c - sw * k * 1.2], radius=sw * k / 2,
2966:                                  fill=C.NAVY + (255,))
2967:             dd.polygon([(c - sw * k / 2, c - sw * k * 1.4), (c + sw * k / 2, c - sw * k * 1.4), (c, c)],
2968:                        fill=(8, 5, 26, 255))
2969:         self.stylo = _ombre_marge(_net(cote, cote, stylo).rotate(-g["stylo_angle"], resample=Image.BICUBIC), self.s)
2970: 
2971:     def _t_ligne(self, j):
2972:         g = C.ORDONNANCE_GEO
2973:         l = self.spec["lignes"][j]
2974:         avant = [i for i in range(j) if self.spec["lignes"][i].get("temps", 0) == l.get("temps", 0)]
2975:         return self.t0(l.get("temps", 0)) + C.INSERT_ENTREE * 0.6 + len(avant) * g["ecriture"]
2976: 
2977:     def _t_pied(self):
2978:         g = C.ORDONNANCE_GEO
2979:         fin = self._t_ligne(len(self.lignes) - 1) + g["ecriture"] + g["pilule_delai"]
2980:         return max(fin, self.t0(self.spec["temps_pied"])) if "temps_pied" in self.spec else fin
2981: 
2982:     def image(self, t, final):
2983:         g = C.ORDONNANCE_GEO
2984:         k, a = _entree(t, self.t0(), final)
2985:         if a <= 0:
2986:             return None
2987:         cal = self.papier.copy()
2988:         x0 = self.m + self.px(g["pad"])
2989:         plume = None
2990:         for j, (im, y) in enumerate(zip(self.lignes, self.ly)):
2991:             p = 1.0 if final else T.lisse((t - self._t_ligne(j)) / g["ecriture"])
2992:             if p <= 0:
2993:                 continue
2994:             larg = max(1, int(im.width * p))
2995:             cal.alpha_composite(im.crop((0, 0, larg, im.height)), (int(x0), int(y)))
2996:             if 0 < p < 1:
2997:                 plume = (x0 + larg, y + self.px(g["label_px"]) * 0.85)
2998:         if self.pied is not None:
2999:             kk, aa = _frappe(t, self._t_pied(), final)
3000:             if aa > 0:
3001:                 _poser(cal, self.pied, x0 + (self.pied.width - 2 * self.m) / 2, self.pied_y, kk, aa, -2)
3002:         if plume is not None:
3003:             _poser(cal, self.stylo, plume[0], plume[1])
3004:         out = Image.new("RGBA", cal.size, (0, 0, 0, 0))
3005:         _poser(out, cal, cal.width / 2, cal.height / 2, k, a)
3006:         return out
3007: 
3008:     def sons(self):
3009:         out = [(self.t0(), "souffle")] + [(self._t_ligne(j), "clic") for j in range(len(self.lignes))]
3010:         if self.pied is not None:
3011:             out.append((self._t_pied() + C.TAMPON_FRAPPE, "impact"))
3012:         return out
3013: 
