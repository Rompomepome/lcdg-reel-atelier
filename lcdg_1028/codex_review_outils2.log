  24: 
  25: from config import charte as C
  26: from lcdg import binaires as B
  27: from lcdg import controles, montage, son, voix
  28: 
  29: PAS = 0.06          # duree d'un caractere dans la fausse narration
  30: 
  31: 
  32: def fausse_synthese(texte, voice_id, dossier, modele=None, reglages=None):
  33:     """Tonalite de la duree du texte, horodatage lineaire : teste le calage et le mixage."""
  34:     dossier.mkdir(parents=True, exist_ok=True)
  35:     mp3 = dossier / "fausse_voix.mp3"
  36:     B.run(["-f", "lavfi", "-i", f"sine=frequency=220:duration={len(texte) * PAS:.2f}",
  37:            "-ac", "2", str(mp3), "-y"])
  38:     return mp3, {"characters": list(texte),
  39:                  "character_start_times_seconds": [i * PAS for i in range(len(texte))],
  40:                  "character_end_times_seconds": [(i + 1) * PAS for i in range(len(texte))]}
  41: 
  42: EPISODE = {
  43:     "slug": "smoke", "rubrique": "pro",
  44:     "label": "Test de fumée",
  45:     "badge": "Test · ouverture",
  46:     "sous_titre": "Vérification de la chaîne de *montage*.",
  47:     "appel": "Le test, en détail :",
  48:     "blocs": [
  49:         {"duree": 3.8, "texte": None, "fichier": "B0.mp4", "cadrage": "largeur",
  50:          "credit": "Images : source test"},                 # accroche : couverture, sans voix
  51:         {"duree": 5.0, "texte": "Premier bloc avec un *segment surligné* et une virgule. "
  52:                                 "| Puis un second temps.",
  53:          "voix": "Premier bloc, avec un segment surligne. | Puis un second temps.",
  54:          "fichier": "B1.mp4",
  55:          "insert": {"type": "choix", "lignes": [{"label": "Oui", "ok": True},
  56:                                                 {"label": "Non", "ok": False, "temps": 1}]}},
  57:         {"duree": 5.0, "type": "chiffre", "valeur": 140, "depuis": 100, "suffixe": " €",
  58:          "legende": "de reste à charge *par an*",
  59:          "voix": "Cent quarante euros par an.", "fichier": "B2.mp4"},
  60:         {"duree": 5.0, "type": "chiffre", "valeur": 70, "suffixe": " boîtes", "pictos": True,
  61:          "legende": "par an, *six par mois*",
  62:          "voix": "Soixante-dix boites par an.", "fichier": "B3.mp4"},
  63:         {"duree": 5.0, "type": "phrase", "texte": "Une phrase forte, *centrée*.",
  64:          "voix": "Une phrase forte, centree.", "fichier": "B4.mp4"},
  65:     ],
  66: }
  67: 
  68: 
  69: def mire(dest: Path, secondes: float, teinte: int):
  70:     B.run(["-f", "lavfi", "-i",
  71:            f"gradients=s={C.LARGEUR}x{C.HAUTEUR}:c0=0x{teinte:02x}2233:"
  72:            f"c1=0x{teinte:02x}8899:d={secondes + 4}",
  73:            "-t", str(secondes + 4), "-r", str(C.FPS),
  74:            "-c:v", "libx264", "-preset", "ultrafast", "-crf", "28",
  75:            "-pix_fmt", "yuv420p", str(dest), "-y"])
  76: 
  77: 
  78: def main():
  79:     B.exiger()
  80:     ep = EPISODE
  81:     with tempfile.TemporaryDirectory() as tmp:
  82:         dossier = Path(tmp) / "smoke"
  83:         (dossier / "broll").mkdir(parents=True)
  84:         (dossier / "script.json").write_text(
  85:             json.dumps(ep, ensure_ascii=False), encoding="utf-8")
  86:         for i, bl in enumerate(ep["blocs"]):
  87:             mire(dossier / "broll" / bl["fichier"], bl["duree"], 0x20 + i * 0x30)
  88: 
  89:         print("\n1/3  normalisation")
  90:         montage.verifier(ep)              # avant d'encoder le moindre plan
  91:         voix.synthese = fausse_synthese
  92:         piste = voix.preparer(dossier, ep)
  93:         _, bornes, total = montage.base(dossier, ep["blocs"])
  94:         print(f"     {len(bornes)} plans, {total:.2f} s")
  95:         print("2/3  habillage")
  96:         muet = montage.habiller(dossier, ep, bornes, total)
  97:         audio = son.bande(dossier, ep, bornes, total, piste)
  98:         sortie = montage.finaliser(muet, dossier / f"reel_{ep['slug']}.mp4", audio)
  99:         couv = montage.couverture(sortie)
 100:         avant = B.duree(sortie)
 101:         montage.couper_accroche(sortie, bornes[1][0])
 102:         if len(couv) != 2:
 103:             raise SystemExit("[!] couvertures incorrectes")
 104:         print("3/3  controles")
 105:         conforme = controles.rapport(sortie, ep, bornes, bornes[1][0], couv[0])
 106:         print(f"     accroche coupee : {avant:.2f} s -> {B.duree(sortie):.2f} s, "
 107:               f"{len(couv)} couvertures")
 108: 
 109:         garde = Path(__file__).resolve().parent.parent / "smoke_test.mp4"
 110:         shutil.copy(sortie, garde)
 111:         print(f"\nSortie conservee : {garde}")
 112: 
 113:     if not conforme:
 114:         raise SystemExit("[!] Le test de fumee a echoue : ne pas pousser en l'etat.")
 115:     print("[OK] chaine de montage conforme")
 116: 
 117: 
 118: if __name__ == "__main__":
