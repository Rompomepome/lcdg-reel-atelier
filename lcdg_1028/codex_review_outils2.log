3015: # ---------------------------------------------------------------- sablier
3016: _VERRE = [(0.1, 0.0), (0.9, 0.0), (0.88, 0.2), (0.62, 0.44), (0.54, 0.5), (0.62, 0.56), (0.88, 0.8), (0.9, 1.0),
3017:           (0.1, 1.0), (0.12, 0.8), (0.38, 0.56), (0.46, 0.5), (0.38, 0.44), (0.12, 0.2)]
3018: 
3019: 
3020: class Sablier(_Pilules, _Insert):
3021:     """Un sablier dont le sable coule, qui se retourne sans fin ; un « ? » se balance a son coin :
3022:     aucun delai n'est fixe. A droite, les pilules du texte."""
3023: 
3024:     def taille_nominale(self):
3025:         return C.TEXTE_LARGEUR, C.SABLIER_H
3026: 
3027:     def __init__(self, *a):
3028:         super().__init__(*a)
3029:         g = C.SABLIER_GEO
3030:         self.sw, self.sh = self.px(g["sablier"][0]), self.px(g["sablier"][1])
3031:         self.socle, self.tr = self.px(g["socle"]), self.px(g["trait"])
3032:         self.cote = int(max(self.sw, self.sh) * 1.1)
3033:         self.badge = _icone_choix(None, self.px(g["badge"]), self.px(C.CHOIX_GEO["trait"]), self.rubrique)
3034:         self.cx, self.cy = self.m + self.cote / 2, self.m + self.h / 2
3035:         self._preparer_pilules(g, self.m + self.cote + self.px(g["ecart"]), self.cy)
3036:         self.cache = {}
3037: 
3038:     def _dessin(self, p):
3039:         """Le sablier, sable ecoule a la fraction p (le haut se vide, le bas se remplit)."""
3040:         cle = round(p, 2)
3041:         if cle in self.cache:
3042:             return self.cache[cle]
3043:         sw, sh, so, tr, cote = self.sw, self.sh, self.socle, self.tr, self.cote
3044:         rub, navy = tuple(self.rubrique) + (255,), C.NAVY + (255,)
3045: 
3046:         def geo(k):
3047:             x0, y0 = (cote - sw) / 2 * k, (cote - sh) / 2 * k
3048:             ya, yb = y0 + so * k, y0 + (sh - so) * k              # haut et bas du verre
3049:             return x0, y0, ya, yb, [(x0 + sw * k * x, ya + (yb - ya) * y) for x, y in _VERRE]
3050: 
3051:         def verre(d, k):
3052:             d.polygon(geo(k)[4], fill=C.BLANC + (235,))
3053: 
3054:         def sable(d, k):
3055:             x0, _, ya, yb, _ = geo(k)
3056:             col = (yb - ya) / 2
3057:             d.rectangle([0, ya + col * p, cote * k, ya + col], fill=rub)            # le haut se vide
3058:             d.rectangle([0, yb - col * p, cote * k, yb], fill=rub)                  # le bas se remplit
3059:             if 0 < p < 1:
3060:                 d.line([(x0 + sw * k / 2, ya + col), (x0 + sw * k / 2, yb)], fill=rub, width=max(2, int(tr * k * 0.5)))
3061: 
3062:         def contour(d, k):
3063:             x0, y0, _, _, pts = geo(k)
3064:             d.line(pts + [pts[0]], fill=navy, width=int(tr * k), joint="curve")
3065:             for y in (y0, y0 + (sh - so) * k):
3066:                 d.rounded_rectangle([x0 - so * k * 0.4, y, x0 + (sw + so * 0.4) * k, y + so * k], radius=so * k * 0.4,
3067:                                     fill=navy)
3068:         im = _net(cote, cote, verre)
3069:         grains = _net(cote, cote, sable)
3070:         grains.putalpha(ImageChops.multiply(grains.getchannel("A"), _net(cote, cote, lambda d, k: d.polygon(
3071:             geo(k)[4], fill=C.BLANC + (255,))).getchannel("A")))
3072:         im.alpha_composite(grains)
3073:         im.alpha_composite(_net(cote, cote, contour))
3074:         im = _ombre_marge(im, self.s)
3075:         self.cache[cle] = im
3076:         return im
3077: 
3078:     def image(self, t, final):
3079:         g = C.SABLIER_GEO
3080:         k, a = _entree(t, self.t0(), final)
3081:         if a <= 0:
3082:             return None
3083:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
3084:         coule = g["cycle"] - g["retournement"]
3085:         phase = 0.0 if final else (t - self.t0()) % g["cycle"]
3086:         p, angle = (0.5, 0.0) if final else (min(1.0, phase / coule), 180 * T.lisse((phase - coule) / g["retournement"]))
3087:         _poser(out, self._dessin(p), self.cx, self.cy, k, a, angle)
3088:         v = 1.0 if final else (t - self.t0() - C.INSERT_ENTREE) / C.INSERT_ENTREE
3089:         if v > 0:
3090:             amp, freq = C.CHOIX_GEO["balance"]
3091:             ang = 0.0 if final or v < 1 else amp * math.sin(2 * math.pi * freq * (t - self.t0()))
3092:             _poser(out, self.badge, self.cx + self.sw * 0.55, self.cy - self.sh * 0.45,
3093:                    0.3 + 0.7 * (1.0 if final else T.rebond(v)), 1.0 if final else T.lisse(v * 2), ang)
3094:         self._pilules(out, t, final)
3095:         return out
3096: 
3097:     def sons(self):
3098:         return [(self.t0(), "souffle")] + self._sons_pilules()
3099: 
3100: 
3101: # ---------------------------------------------------------------- pilule
3102: class Pilule(_Insert):
3103:     """Une pilule seule (« Aucune rémunération prévue ») qui claque au temps "temps", ton rouge par
3104:     defaut : sous un dessin, elle ne cache rien, la ou un tampon couvrirait ses libelles."""
3105: 
3106:     def _sprite(self, s):
3107:         g = C.PILULE_GEO
3108:         # appele par taille_nominale, avant que _Insert.__init__ ne pose self.rubrique
3109:         return _bulle(self.spec["texte"], max(8, int(g["px"] * s)), max(8, int(g["h"] * s)), int(g["pad"] * s),
