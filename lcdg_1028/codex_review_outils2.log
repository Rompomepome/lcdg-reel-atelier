2261: # -------------------------------------------------------------- icones
2262: class Icones(_Insert):
2263:     """Des cartes a icone dessinee (repere, lune, casque), qui arrivent l'une apres l'autre ; un
2264:     « ? » se balance au coin de chacune : une question encore ouverte."""
2265: 
2266:     def taille_nominale(self):
2267:         return C.TEXTE_LARGEUR, C.ICONES_H
2268: 
2269:     def __init__(self, *a):
2270:         super().__init__(*a)
2271:         g = C.ICONES_GEO
2272:         self.items = self.spec["cartes"]
2273:         n = len(self.items)
2274:         self.ecart = self.px(g["ecart"])
2275:         self.cw = (self.w - (n - 1) * self.ecart) // n
2276:         self.cartes = [self._carte(c) for c in self.items]
2277:         self.badge = _icone_choix(None, self.px(g["badge"]), self.px(C.CHOIX_GEO["trait"]), self.rubrique)
2278: 
2279:     def _dessin_icone(self, nom):
2280:         g = C.ICONES_GEO
2281:         s = self.px(g["icone"])
2282:         tr = self.px(g["trait"])
2283:         navy, rub = C.NAVY + (255,), tuple(self.rubrique) + (255,)
2284:         gris = C.INSERT_GRIS + (255,)
2285: 
2286:         def dessin(dd, k):
2287:             S, e = s * k, tr * k
2288:             if nom == "repere":                           # un repere sur un territoire
2289:                 for x0, hh in ((0.08, 0.2), (0.62, 0.24)):
2290:                     x, y = S * x0, S * 0.94
2291:                     dd.rectangle([x, y - S * hh, x + S * 0.3, y], fill=gris)
2292:                     dd.polygon([(x - S * 0.03, y - S * hh), (x + S * 0.15, y - S * (hh + 0.13)),
2293:                                 (x + S * 0.33, y - S * hh)], fill=gris)
2294:                 cx, cy, r = S / 2, S * 0.36, S * 0.24
2295:                 dd.polygon([(cx - r * 0.86, cy + r * 0.5), (cx, S * 0.86), (cx + r * 0.86, cy + r * 0.5)], fill=rub)
2296:                 dd.ellipse([cx - r, cy - r, cx + r, cy + r], fill=rub)
2297:                 dd.ellipse([cx - r * 0.42, cy - r * 0.42, cx + r * 0.42, cy + r * 0.42], fill=C.BLANC + (255,))
2298:             elif nom == "lune":                           # la nuit : lune et etoiles
2299:                 r = S * 0.36
2300:                 cx, cy = S * 0.46, S * 0.54
2301:                 dd.ellipse([cx - r, cy - r, cx + r, cy + r], fill=navy)
2302:                 dd.ellipse([cx - r + S * 0.2, cy - r - S * 0.1, cx + r + S * 0.2, cy + r - S * 0.1], fill=(0, 0, 0, 0))
2303:                 for ex, ey, er in ((0.78, 0.2, 0.05), (0.88, 0.48, 0.035), (0.66, 0.08, 0.03)):
2304:                     dd.ellipse([S * ex - S * er, S * ey - S * er, S * ex + S * er, S * ey + S * er], fill=rub)
2305:             elif nom == "poubelle":                       # une dose perdue : poubelle et piece
2306:                 dd.rounded_rectangle([S * 0.38, S * 0.1, S * 0.62, S * 0.2], radius=S * 0.03, fill=navy)
2307:                 dd.rounded_rectangle([S * 0.12, S * 0.18, S * 0.78, S * 0.27], radius=S * 0.03, fill=navy)
2308:                 dd.polygon([(S * 0.18, S * 0.3), (S * 0.72, S * 0.3), (S * 0.65, S * 0.96), (S * 0.25, S * 0.96)],
2309:                            fill=navy)
2310:                 for x in (0.34, 0.45, 0.56):
2311:                     dd.line([(S * x, S * 0.42), (S * x, S * 0.84)], fill=C.BLANC + (255,), width=int(e * 0.55))
2312:                 r = S * 0.17
2313:                 dd.ellipse([S * 0.82 - r, S * 0.2 - r, S * 0.82 + r, S * 0.2 + r], fill=C.INSERT_ROUGE + (255,))
2314:             elif nom == "bon":                            # le bon de prise en charge : un formulaire
2315:                 pli = S * 0.2
2316:                 dd.polygon([(S * 0.18, S * 0.05), (S * 0.82 - pli, S * 0.05), (S * 0.82, S * 0.05 + pli),
2317:                             (S * 0.82, S * 0.96), (S * 0.18, S * 0.96)], fill=C.BLANC + (255,), outline=navy,
2318:                            width=int(e * 0.6))
2319:                 dd.polygon([(S * 0.82 - pli, S * 0.05), (S * 0.82 - pli, S * 0.05 + pli), (S * 0.82, S * 0.05 + pli)],
2320:                            fill=gris)
2321:                 dd.rounded_rectangle([S * 0.3, S * 0.3, S * 0.62, S * 0.38], radius=S * 0.02, fill=rub)
2322:                 for y in (0.5, 0.62, 0.74):
2323:                     dd.rounded_rectangle([S * 0.3, S * y, S * 0.7, S * (y + 0.05)], radius=S * 0.02, fill=gris)
2324:             elif nom == "enfant":                         # un enfant
2325:                 cx, r = S / 2, S * 0.15
2326:                 dd.ellipse([cx - r, S * 0.06, cx + r, S * 0.06 + 2 * r], fill=navy)
2327:                 dd.line([(cx - S * 0.15, S * 0.48), (cx - S * 0.3, S * 0.66)], fill=rub, width=int(e))
2328:                 dd.line([(cx + S * 0.15, S * 0.48), (cx + S * 0.3, S * 0.66)], fill=rub, width=int(e))
2329:                 dd.rounded_rectangle([cx - S * 0.17, S * 0.4, cx + S * 0.17, S * 0.74], radius=S * 0.08, fill=rub)
2330:                 dd.rounded_rectangle([cx - S * 0.13, S * 0.68, cx - S * 0.03, S * 0.96], radius=S * 0.04, fill=navy)
2331:                 dd.rounded_rectangle([cx + S * 0.03, S * 0.68, cx + S * 0.13, S * 0.96], radius=S * 0.04, fill=navy)
2332:             elif nom == "compte_rendu":                   # un compte rendu : une page, son titre, ses lignes
2333:                 dd.rounded_rectangle([S * 0.16, S * 0.04, S * 0.84, S * 0.96], radius=S * 0.06, fill=C.BLANC + (255,),
2334:                                      outline=navy, width=int(e * 0.6))
2335:                 dd.rounded_rectangle([S * 0.28, S * 0.15, S * 0.72, S * 0.27], radius=S * 0.03, fill=rub)
2336:                 for y, l in ((0.4, 0.44), (0.52, 0.36), (0.64, 0.44), (0.76, 0.26)):
2337:                     dd.rounded_rectangle([S * 0.28, S * y, S * (0.28 + l), S * (y + 0.05)], radius=S * 0.02, fill=gris)
2338:             elif nom == "concertation":                   # deux bulles : on se concerte
2339:                 dd.rounded_rectangle([S * 0.02, S * 0.1, S * 0.6, S * 0.5], radius=S * 0.13, fill=navy)
2340:                 dd.polygon([(S * 0.12, S * 0.48), (S * 0.3, S * 0.48), (S * 0.1, S * 0.66)], fill=navy)
2341:                 dd.rounded_rectangle([S * 0.38, S * 0.38, S * 0.98, S * 0.8], radius=S * 0.13, fill=rub)
2342:                 dd.polygon([(S * 0.7, S * 0.78), (S * 0.88, S * 0.78), (S * 0.9, S * 0.96)], fill=rub)
2343:                 for x in (0.55, 0.68, 0.81):
2344:                     r = S * 0.045
2345:                     dd.ellipse([S * x - r, S * 0.59 - r, S * x + r, S * 0.59 + r], fill=C.BLANC + (255,))
2346:             elif nom == "patient":                        # un patient qui vous revient : la fleche du retour
2347:                 cx, r = S * 0.36, S * 0.13
2348:                 dd.ellipse([cx - r, S * 0.1, cx + r, S * 0.1 + 2 * r], fill=navy)
2349:                 dd.rounded_rectangle([cx - S * 0.21, S * 0.42, cx + S * 0.21, S * 0.94], radius=S * 0.12, fill=navy)
2350:                 dd.arc([S * 0.5, S * 0.2, S * 0.98, S * 0.68], -90, 90, fill=rub, width=int(e))
2351:                 dd.polygon([(S * 0.6, S * 0.68), (S * 0.76, S * 0.57), (S * 0.76, S * 0.79)], fill=rub)
2352:             else:                                         # le casque de la regulation
2353:                 box = [S * 0.14, S * 0.1, S * 0.86, S * 0.82]
2354:                 dd.arc(box, 180, 360, fill=navy, width=int(e))
2355:                 for x in (S * 0.08, S * 0.74):
2356:                     dd.rounded_rectangle([x, S * 0.42, x + S * 0.18, S * 0.72], radius=S * 0.06, fill=navy)
2357:                 dd.arc([S * 0.3, S * 0.4, S * 0.92, S * 0.98], 10, 100, fill=rub, width=int(e * 0.8))
2358:                 dd.ellipse([S * 0.42, S * 0.86, S * 0.56, S * 1.0 - 1], fill=rub)
2359:         im = _net(s, s, dessin)
2360:         if nom == "poubelle":                             # la piece porte « € »
2361:             _ecrire(ImageDraw.Draw(im), (s * 0.82, s * 0.2), "€", max(6, int(s * 0.2)), C.INSERT_GRAISSE_FORTE,
2362:                     C.BLANC + (255,), "mm")
2363:         return im
2364: 
2365:     def _carte(self, c):
2366:         g, m = C.ICONES_GEO, self.m
2367:         im = _cadre(self.cw, self.h, self.s, marge=m)
2368:         ic = self._dessin_icone(c.get("icone", ""))
2369:         im.alpha_composite(ic, (int(m + (self.cw - ic.width) / 2), int(m + self.px(g["icone_y"]))))
2370:         d = ImageDraw.Draw(im)
2371:         px = self.px(g["label_px"])
2372:         lignes = _couper(c["label"], px, C.INSERT_GRAISSE_FORTE, self.cw - self.px(g["label_marge"]))
2373:         y0 = m + self.px(g["icone_y"]) + ic.height + self.px(g["label_ecart"])
2374:         for i, l in enumerate(lignes):
2375:             _ecrire(d, (m + self.cw / 2, y0 + i * px * 1.2), l, px, C.INSERT_GRAISSE_FORTE, C.NAVY + (255,), "mt")
2376:         return _ombre(im, self.s)
2377: 
2378:     def _t(self, i):
2379:         """Une carte arrive avec le temps du texte de son "temps" (celui de l'insert par defaut)."""
2380:         defaut = self.spec.get("temps", 0)
2381:         tps = self.items[i].get("temps", defaut)
2382:         avant = [j for j in range(i) if self.items[j].get("temps", defaut) == tps]
2383:         return self.t0(tps) + len(avant) * C.ICONES_GEO["decalage"]
2384: 
2385:     def image(self, t, final):
2386:         g = C.ICONES_GEO
2387:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
2388:         for i, carte in enumerate(self.cartes):
2389:             k, a = _entree(t, self._t(i), final)
2390:             if a <= 0:
2391:                 continue
2392:             dy = 0 if final else C.INSERT_MONTEE * self.s * (1 - T.lisse((t - self._t(i)) / C.INSERT_ENTREE))
2393:             cx = self.m + i * (self.cw + self.ecart) + self.cw / 2
2394:             _poser(out, carte, cx, self.m + self.h / 2 + dy, k, a)
2395:             if self.items[i].get("question") is False:   # une tache, pas une question ouverte
2396:                 continue
2397:             tq = self.t0(self.items[i]["temps_question"]) if "temps_question" in self.items[i] else \
2398:                 self._t(i) + C.INSERT_ENTREE * 0.7
2399:             v = 1.0 if final else (t - tq) / C.INSERT_ENTREE
2400:             if v > 0:
2401:                 amp, freq = C.CHOIX_GEO["balance"]
2402:                 angle = 0.0 if final or v < 1 else amp * math.sin(2 * math.pi * freq * (t - self._t(i)))
2403:                 kk = 0.3 + 0.7 * (1.0 if final else T.rebond(v))
2404:                 _poser(out, self.badge, cx + self.cw / 2 - self.px(g["badge"]) * g["badge_pos"],
2405:                        self.m + self.px(g["badge"]) * g["badge_pos"] + dy, kk, 1.0 if final else T.lisse(v * 2), angle)
2406:         return out
2407: 
2408:     def sons(self):
2409:         return [(self._t(i), "clic") for i in range(len(self.cartes))]
2410: 
2411: 
2412: # ---------------------------------------------------------------- prix
2413: class Prix(_Insert):
2414:     """Des boites de vaccin dessinees ; une etiquette de prix tombe sur chacune, au temps de sa
2415:     boite, se balance, puis une pastille (« plus du double ») claque au-dessus de la derniere."""
2416: 
2417:     def taille_nominale(self):
2418:         return C.TEXTE_LARGEUR, C.PRIX_H
2419: 
2420:     def __init__(self, *a):
2421:         super().__init__(*a)
2422:         g = C.PRIX_GEO
2423:         self.items = self.spec["boites"]
2424:         n = len(self.items)
2425:         self.boites = [_ombre_marge(self._boite(b["nom"]), self.s) for b in self.items]
2426:         self.etiquettes = [_ombre_marge(_etiquette([b["prix"]], self.px(g["etiquette_px"]),
2427:                                                    self.px(g["etiquette_pad"][0]), self.px(g["etiquette_pad"][1]),
2428:                                                    _ton(b, self.rubrique)), self.s) for b in self.items]
2429:         self.pastille = (_ombre_marge(_bulle(self.spec["pastille"], self.px(g["pastille_px"]), self.px(g["pastille_h"]),
2430:                                              self.px(g["pastille_pad"]), C.INSERT_ROUGE, queue=False), self.s)
2431:                          if self.spec.get("pastille") else None)
2432:         self.bw, self.bh = self.px(g["boite"][0]), self.px(g["boite"][1])
2433:         # l'etiquette deborde a droite de sa boite : les centres se resserrent d'autant, pour que la
2434:         # derniere reste dans la colonne
2435:         deborde = max(0.0, self.bw * g["etiquette_x"] + (self.etiquettes[-1].width - 2 * self.m) / 2
2436:                       - self.bw / 2)
2437:         utile = self.w - deborde
2438:         self.cx = [self.m + utile * (i + 0.5) / n for i in range(n)]
2439:         self.haut = self.m + self.h - self.px(g["sol"]) - self.bh            # haut des boites
2440: 
2441:     def _boite(self, nom):
2442:         g = C.PRIX_GEO
2443:         w, h, bande = self.px(g["boite"][0]), self.px(g["boite"][1]), self.px(g["bande"])
2444:         ra, tr = self.px(g["rayon"]), max(1, self.px(g["trait"]))
2445:         rub, navy = tuple(self.rubrique) + (255,), C.NAVY + (255,)
2446: 
2447:         def dessin(d, k):
2448:             W, H, B, Q = w * k, h * k, bande * k, ra * k
2449:             d.rounded_rectangle([0, 0, W - 1, H - 1], radius=Q, fill=C.BLANC + (255,))
2450:             d.rounded_rectangle([0, 0, W - 1, B + Q], radius=Q, fill=rub)
2451:             d.rectangle([0, B, W - 1, B + Q], fill=C.BLANC + (255,))
2452:             cx, cy = W * 0.5, B + (H - B) * 0.55                # une seringue preremplie
2453:             L, e = W * 0.42, (H - B) * 0.2
2454:             d.rounded_rectangle([cx - L / 2, cy - e / 2, cx + L / 2, cy + e / 2], radius=e * 0.3,
2455:                                 fill=_teinte(self.rubrique, 0.75) + (255,), outline=navy, width=int(tr * k))
2456:             d.rectangle([cx - L / 2 - L * 0.24, cy - e * 0.12, cx - L / 2, cy + e * 0.12], fill=navy)
2457:             d.rectangle([cx - L / 2 - L * 0.28, cy - e * 0.55, cx - L / 2 - L * 0.22, cy + e * 0.55], fill=navy)
2458:             d.rectangle([cx + L / 2, cy - e * 0.08, cx + L / 2 + L * 0.3, cy + e * 0.08], fill=navy)
2459:             for i in range(1, 5):
2460:                 x = cx - L / 2 + L * i / 5
2461:                 d.line([(x, cy - e / 2), (x, cy - e * 0.05)], fill=navy, width=int(tr * k))
2462:         im = _net(w, h, dessin)
2463:         _ecrire(ImageDraw.Draw(im), (w / 2, bande / 2), nom, self.px(g["nom_px"]), C.INSERT_GRAISSE_FORTE,
2464:                 C.BLANC + (255,), "mm")
2465:         return im
2466: 
2467:     def _t_boite(self, i):
2468:         """Entree de la boite i : avec le temps du texte de son "temps" (celui de l'insert par
2469:         defaut), les boites d'un meme temps a la suite."""
2470:         defaut = self.spec.get("temps", 0)
2471:         tps = self.items[i].get("temps", defaut)
2472:         avant = [j for j in range(i) if self.items[j].get("temps", defaut) == tps]
2473:         return self.t0(tps) + len(avant) * C.INSERT_DECALAGE
2474: 
2475:     def _t(self, i):
2476:         """Chute de l'etiquette i, apres l'entree de sa boite ; les etiquettes d'un meme temps a
2477:         la suite."""
2478:         g = C.PRIX_GEO
2479:         defaut = self.spec.get("temps", 0)
2480:         tps = self.items[i].get("temps", defaut)
2481:         avant = [j for j in range(i) if self.items[j].get("temps", defaut) == tps]
2482:         return self.t0(tps) + C.INSERT_ENTREE * 0.5 + len(avant) * g["decalage"]
2483: 
2484:     def _t_pastille(self):
2485:         g = C.PRIX_GEO
2486:         return max(self._t(i) for i in range(len(self.items))) + g["chute"] + g["pastille_delai"]
2487: 
2488:     def image(self, t, final):
2489:         g = C.PRIX_GEO
2490:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
2491:         for i, boite in enumerate(self.boites):
2492:             k, a = _entree(t, self._t_boite(i), final)
2493:             if a <= 0:
2494:                 continue
2495:             _poser(out, boite, self.cx[i], self.haut + self.bh / 2, k, a)
2496:             u = 1.0 if final else (t - self._t(i)) / g["chute"]
2497:             if u <= 0:
2498:                 continue
2499:             dy = 0.0 if u >= 1 else -self.px(g["chute_haut"]) * (1 - u * u)
2500:             angle = g["etiquette_angle"]
2501:             if not final and u >= 1:                      # elle se balance, puis se pose
2502:                 amp, freq, amorti = g["balance"]
2503:                 tau = t - self._t(i) - g["chute"]
2504:                 angle += amp * math.sin(2 * math.pi * freq * tau) * math.exp(-amorti * tau)
2505:             ex = self.cx[i] + self.bw * g["etiquette_x"]
2506:             _poser(out, self.etiquettes[i], ex, self.haut + self.bh * g["etiquette_y"] + dy, 1.0,
2507:                    1.0 if final else min(1.0, u * 3), angle)
2508:         if self.pastille is not None:
2509:             v = 1.0 if final else (t - self._t_pastille()) / C.TAMPON_FRAPPE
2510:             if v > 0:
2511:                 kk = 1.0 if final or v >= 1 else C.TAMPON_ECHELLE - (C.TAMPON_ECHELLE - 1) * v * v
2512:                 _poser(out, self.pastille, self.cx[-1], self.haut - self.px(g["pastille_dy"]), kk,
2513:                        1.0 if final else min(1.0, v * 2), 4)
2514:         return out
2515: 
2516:     def sons(self):
2517:         g = C.PRIX_GEO
2518:         out = [(self._t(i) + g["chute"], "clic") for i in range(len(self.items))]
2519:         if self.pastille is not None:
2520:             out.append((self._t_pastille() + C.TAMPON_FRAPPE, "impact"))
2521:         return out
2522: 
2523: 
2524: def _coller_coupe(fond, im, x, y):
2525:     """Compose im en (x, y), meme en partie hors de fond (la partie qui deborde est coupee)."""
2526:     x, y = int(round(x)), int(round(y))
2527:     g, h = max(0, -x), max(0, -y)
2528:     d, b = min(im.width, fond.width - x), min(im.height, fond.height - y)
2529:     if d > g and b > h:
2530:         fond.alpha_composite(im.crop((g, h, d, b)), (x + g, y + h))
2531: 
2532: 
2533: def _frappe(t, t0, final):
2534:     """(echelle, opacite) d'un element qui claque comme un tampon a t0."""
2535:     v = 1.0 if final else (t - t0) / C.TAMPON_FRAPPE
2536:     if v <= 0:
2537:         return 0.0, 0.0
2538:     return (1.0 if final or v >= 1 else C.TAMPON_ECHELLE - (C.TAMPON_ECHELLE - 1) * v * v,
2539:             1.0 if final else min(1.0, v * 2))
2540: 
2541: 
2542: class _Pilules:
2543:     """Pilules empilees a droite d'un dessin ("pilules" : [{"texte", "ton", "temps"}]) ; chacune
2544:     claque au temps de son numero. geo : pilule_px, pilule_h, pilule_pad, pilule_ecart."""
2545: 
2546:     def _preparer_pilules(self, g, x, cy):
2547:         self.pil_specs = self.spec.get("pilules", [])
2548:         self.pil = [_ombre_marge(_bulle(p["texte"], self.px(g["pilule_px"]), self.px(g["pilule_h"]),
2549:                                         self.px(g["pilule_pad"]), _ton(p, self.rubrique), queue=False), self.s)
2550:                     for p in self.pil_specs]
2551:         n, ph, ec = len(self.pil), self.px(g["pilule_h"]), self.px(g["pilule_ecart"])
2552:         haut = cy - (n * ph + (n - 1) * ec) / 2
2553:         self.pil_xy = [(x, haut + i * (ph + ec) + ph / 2) for i in range(n)]
2554: 
2555:     def _t_pilule(self, i):
2556:         return self.t0(self.pil_specs[i].get("temps", 0)) + C.INSERT_ENTREE * 0.6
2557: 
2558:     def _pilules(self, out, t, final):
2559:         for i, (im, (x, y)) in enumerate(zip(self.pil, self.pil_xy)):
2560:             k, a = _frappe(t, self._t_pilule(i), final)
2561:             if a > 0:
2562:                 _poser(out, im, x + (im.width - 2 * self.m) / 2, y, k, a, -3)
2563: 
2564:     def _sons_pilules(self):
2565:         return [(self._t_pilule(i) + C.TAMPON_FRAPPE, "impact") for i in range(len(self.pil))]
2566: 
2567: 
2568: # ---------------------------------------------------------------- carte
2569: class Carte(_Insert):
2570:     """Une carte CPS au nom de son titulaire, a cote du lecteur ; au temps "temps" (sinon un instant
2571:     apres son arrivee), elle glisse dans la fente et l'ecran repond : une coche ("ok"), ou une croix,
2572:     et la carte refusee tremble."""
2573: 
2574:     def taille_nominale(self):
2575:         return C.TEXTE_LARGEUR, C.CARTE_H
2576: 
2577:     def __init__(self, *a):
2578:         super().__init__(*a)
2579:         g = C.CARTE_GEO
2580:         self.ok = self.spec.get("ok", True)
2581:         self.carte = _ombre_marge(self._carte(), self.s)
2582:         self.lecteur = _ombre_marge(self._lecteur(), self.s)
2583:         self.verdict = _icone_choix(self.ok, self.px(g["resultat"]), self.px(g["trait"]), self.rubrique)
2584:         cw, lw = self.px(g["carte"][0]), self.px(g["lecteur"][0])
2585:         self.lx = self.m + self.w - self.px(g["pad"]) - lw / 2           # centre du lecteur
2586:         self.x0 = self.m + self.px(g["pad"]) + cw / 2                     # la carte posee a gauche
2587:         self.x1 = self.lx - lw / 2 + cw * (g["profondeur"] - 0.5)         # engagee dans la fente
2588:         self.cy = self.m + self.h / 2
2589: 
2590:     def _carte(self):
2591:         g = C.CARTE_GEO
2592:         w, h, ra = self.px(g["carte"][0]), self.px(g["carte"][1]), self.px(g["rayon"])
2593:         pw, ph = self.px(g["puce"][0]), self.px(g["puce"][1])
2594:         px0, py0 = self.px(g["puce_xy"][0]), self.px(g["puce_xy"][1])
2595:         cl, ce, pad = self.px(g["croix"][0]), self.px(g["croix"][1]), self.px(g["pad"])
2596:         rub = tuple(self.rubrique)
2597:         im = _net(w, h, lambda d, k: d.rounded_rectangle([0, 0, w * k - 1, h * k - 1], radius=ra * k,
2598:                                                          fill=rub + (255,)))
2599:         reflet = _net(w, h, lambda d, k: d.ellipse([w * k * 0.5, h * k * 0.3, w * k * 1.4, h * k * 1.7],
2600:                                                    fill=_teinte(rub, 0.16) + (255,)))
2601:         reflet.putalpha(ImageChops.multiply(reflet.getchannel("A"), im.getchannel("A")))
2602:         im.alpha_composite(reflet)
2603: 
2604:         def puce(d, k):
2605:             d.rounded_rectangle([0, 0, pw * k - 1, ph * k - 1], radius=ph * k * 0.22, fill=C.INSERT_GRIS + (255,))
2606:             trait, filet = max(1, int(ph * k * 0.07)), _teinte(rub, 0.45) + (255,)
2607:             for y in (ph * k / 3, ph * k * 2 / 3):
2608:                 d.line([(0, y), (pw * k * 0.36, y)], fill=filet, width=trait)
2609:                 d.line([(pw * k * 0.64, y), (pw * k, y)], fill=filet, width=trait)
2610:             d.rounded_rectangle([pw * k * 0.36, ph * k * 0.2, pw * k * 0.64, ph * k * 0.8], radius=ph * k * 0.08,
2611:                                 outline=filet, width=trait)
2612:         im.alpha_composite(_net(pw, ph, puce), (px0, py0))
2613:         d = ImageDraw.Draw(im)
2614:         cx, cyc = w - pad - cl / 2, pad + cl / 2                          # la croix du soin
2615:         d.rectangle([cx - cl / 2, cyc - ce / 2, cx + cl / 2, cyc + ce / 2], fill=C.BLANC + (255,))
2616:         d.rectangle([cx - ce / 2, cyc - cl / 2, cx + ce / 2, cyc + cl / 2], fill=C.BLANC + (255,))
2617:         _ecrire(d, (pad, pad), "CARTE CPS", self.px(g["titre_px"]), C.INSERT_GRAISSE_FORTE, C.BLANC + (255,))
2618:         # le nom tient dans la part de la carte qui reste visible une fois engagee dans le lecteur
2619:         nom, px = T.normaliser(self.spec.get("titulaire", "")), self.px(g["nom_px"])
2620:         visible = w * (1 - g["profondeur"]) - 2 * pad
2621:         while px > self.px(g["nom_px_min"]) and T.largeur(nom, px, C.INSERT_GRAISSE_FORTE, 0) > visible:
2622:             px -= 1
2623:         _ecrire(d, (pad, h - pad), nom, px, C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "ls")
2624:         return im
2625: 
2626:     def _lecteur(self):
2627:         g = C.CARTE_GEO
2628:         w, h, ra = self.px(g["lecteur"][0]), self.px(g["lecteur"][1]), self.px(g["lecteur_rayon"])
2629:         ew, eh, ey = self.px(g["ecran"][0]), self.px(g["ecran"][1]), self.px(g["ecran_y"])
2630:         tr, ty, tp = self.px(g["touche"]), self.px(g["touches_y"]), self.px(g["touches_pas"])
2631:         fw, fh = self.px(g["fente"][0]), self.px(g["fente"][1])
2632: 
2633:         def dessin(d, k):
2634:             d.rounded_rectangle([0, 0, w * k - 1, h * k - 1], radius=ra * k, fill=C.NAVY + (255,))
2635:             d.rounded_rectangle([(w - ew) / 2 * k, ey * k, (w + ew) / 2 * k, (ey + eh) * k], radius=ra * k * 0.4,
2636:                                 fill=(8, 5, 26, 255))
2637:             for rang in range(2):
2638:                 for col in (-1, 0, 1):
2639:                     x, y = (w / 2 + col * tp) * k, (ty + rang * tp) * k
2640:                     d.ellipse([x - tr * k / 2, y - tr * k / 2, x + tr * k / 2, y + tr * k / 2],
2641:                               fill=_teinte(C.NAVY, 0.3) + (255,))
2642:             d.rounded_rectangle([0, (h - fh) / 2 * k, fw * k, (h + fh) / 2 * k], radius=fw * k / 2,
2643:                                 fill=(8, 5, 26, 255))                     # la fente, sur le bord gauche
2644:         return _net(w, h, dessin)
2645: 
2646:     def _t_glisse(self):
2647:         if "temps" in self.spec:
2648:             return self.t0(self.spec["temps"])
2649:         return self.t0() + C.CARTE_GEO["attente"]
2650: 
2651:     def image(self, t, final):
2652:         g = C.CARTE_GEO
2653:         k, a = _entree(t, self.t0(), final)
2654:         if a <= 0:
2655:             return None
2656:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
2657:         tg, tv = self._t_glisse(), self._t_glisse() + g["course"]
2658:         p = 1.0 if final else T.lisse((t - tg) / g["course"])
2659:         x = self.x0 + (self.x1 - self.x0) * p
2660:         if not final:                                    # la carte arrive de la gauche
2661:             x -= self.px(g["glisse"]) * (1 - T.lisse((t - self.t0()) / C.INSERT_ENTREE))
2662:             v = (t - tv) / g["refus"][1]
2663:             if not self.ok and 0 < v < 1:                # refusee : elle tremble
2664:                 x += self.px(g["refus"][0]) * math.sin(2 * math.pi * 4 * v) * (1 - v)
2665:         _poser(out, self.carte, x, self.cy, k, a)
2666:         _poser(out, self.lecteur, self.lx, self.cy, k, a)   # le lecteur passe devant la carte engagee
2667:         v = 1.0 if final else (t - tv) / C.INSERT_ENTREE
2668:         if v > 0:
2669:             kk = C.CHOIX_GEO["icone_depart"] + (1 - C.CHOIX_GEO["icone_depart"]) * (1.0 if final else T.rebond(v))
2670:             ey = self.cy - self.px(g["lecteur"][1]) / 2 + self.px(g["ecran_y"]) + self.px(g["ecran"][1]) / 2
2671:             _poser(out, self.verdict, self.lx, ey, kk, 1.0 if final else T.lisse(v * C.INSERT_FONDU))
2672:         return out
2673: 
2674:     def sons(self):
2675:         tv = self._t_glisse() + C.CARTE_GEO["course"]
2676:         return [(self.t0(), "souffle"), (self._t_glisse(), "souffle"), (tv, "clic" if self.ok else "impact")]
2677: 
2678: 
2679: # ---------------------------------------------------------------- compteur
2680: class Compteur(_Insert):
2681:     """Un compteur a rouleaux : les chiffres defilent, puis s'arretent un a un sur « ? » au temps
2682:     "temps" ; une pilule rouge claque dessous (« Aucun chiffre officiel »). Aucun nombre n'y reste :
2683:     le compteur dit que personne ne le publie."""
2684: 
2685:     def taille_nominale(self):
2686:         return C.TEXTE_LARGEUR, C.COMPTEUR_H
2687: 
2688:     def __init__(self, *a):
2689:         super().__init__(*a)
2690:         g = C.COMPTEUR_GEO
2691:         self.n = self.spec.get("chiffres", 4)
2692:         self.cw, self.ch = self.px(g["case"][0]), self.px(g["case"][1])
2693:         ra, pad = self.px(g["rayon"]), self.px(g["pad"])
2694:         self.case = _net(self.cw, self.ch, lambda d, k: d.rounded_rectangle(
2695:             [0, 0, self.cw * k - 1, self.ch * k - 1], radius=ra * k, fill=C.NAVY + (255,)))
2696:         px = self.px(g["chiffre_px"])
2697:         self.glyphes = {c: self._glyphe(c, px, C.BLANC) for c in "0123456789"}
2698:         self.glyphes["?"] = self._glyphe("?", px, _teinte(self.rubrique, 0.4))
2699:         carte = _cadre(self.w, self.h, self.s, marge=self.m)
2700:         d = ImageDraw.Draw(carte)
2701:         tp = self.px(g["titre_px"])
2702:         _ecrire(d, (self.m + pad, self.m + pad), T.normaliser(self.spec.get("titre", "")).upper(), tp,
2703:                 C.INSERT_GRAISSE_FORTE, C.INSERT_GRIS_TEXTE + (255,))
2704:         _ecrire(d, (self.m + self.w - pad, self.m + pad), self.spec.get("date", ""), tp, C.INSERT_GRAISSE_TEXTE,
2705:                 C.INSERT_GRIS_TEXTE + (255,), "ra")
2706:         self.carte = _ombre(carte, self.s)
2707:         largeur = self.n * self.cw + (self.n - 1) * self.px(g["ecart"])
2708:         self.xs = [self.m + (self.w - largeur) / 2 + i * (self.cw + self.px(g["ecart"])) for i in range(self.n)]
2709:         self.yc = self.m + self.px(g["case_y"])
2710:         self.pilule = None
2711:         if self.spec.get("pilule"):
2712:             self.pilule = _ombre_marge(_bulle(self.spec["pilule"], self.px(g["pilule_px"]), self.px(g["pilule_h"]),
2713:                                               self.px(g["pilule_pad"]), C.INSERT_ROUGE, queue=False), self.s)
2714: 
2715:     def _glyphe(self, c, px, couleur):
2716:         im = Image.new("RGBA", (self.cw, self.ch), (0, 0, 0, 0))
2717:         _ecrire(ImageDraw.Draw(im), (self.cw / 2, self.ch / 2), c, px, C.INSERT_GRAISSE_CHIFFRE, couleur + (255,), "mm")
2718:         return im
2719: 
2720:     def _t_arret(self, i):
2721:         return self.t0(self.spec.get("temps", 1)) + C.INSERT_DELAI + i * C.COMPTEUR_GEO["arret"]
2722: 
2723:     def _t_pilule(self):
2724:         g = C.COMPTEUR_GEO
2725:         return self._t_arret(self.n - 1) + g["chute"] + g["pilule_delai"]
2726: 
2727:     def _rouleau(self, i, t, final):
2728:         g = C.COMPTEUR_GEO
2729:         couche = Image.new("RGBA", (self.cw, self.ch), (0, 0, 0, 0))
2730:         ta = self._t_arret(i)
2731:         if final or t >= ta + g["chute"]:
2732:             couche.alpha_composite(self.glyphes["?"])
2733:         else:
2734:             v = g["vitesse"] * (max(self.t0(), min(t, ta)) - self.t0()) + i * 3.7
2735:             chiffre, f = int(v) % 10, v - int(v)
2736:             if t < ta:                                   # le rouleau tourne : le chiffre suivant monte
2737:                 _coller_coupe(couche, self.glyphes[str(chiffre)], 0, -f * self.ch)
2738:                 _coller_coupe(couche, self.glyphes[str((chiffre + 1) % 10)], 0, (1 - f) * self.ch)
2739:             else:                                        # il s'arrete : le « ? » tombe a sa place
2740:                 q = T.rebond((t - ta) / g["chute"])
2741:                 _coller_coupe(couche, self.glyphes[str(chiffre)], 0, q * self.ch)
2742:                 _coller_coupe(couche, self.glyphes["?"], 0, (q - 1) * self.ch)
2743:         couche.putalpha(ImageChops.multiply(couche.getchannel("A"), self.case.getchannel("A")))
2744:         im = self.case.copy()
2745:         im.alpha_composite(couche)
2746:         return im
2747: 
2748:     def image(self, t, final):
2749:         g = C.COMPTEUR_GEO
2750:         k, a = _entree(t, self.t0(), final)
2751:         if a <= 0:
2752:             return None
2753:         cal = self.carte.copy()
2754:         for i, x in enumerate(self.xs):
2755:             cal.alpha_composite(self._rouleau(i, t, final), (int(x), int(self.yc)))
2756:         if self.pilule is not None:
2757:             kk, aa = _frappe(t, self._t_pilule(), final)
2758:             if aa > 0:
2759:                 _poser(cal, self.pilule, self.m + self.w / 2,
2760:                        self.m + self.h - self.px(g["pilule_dy"]) - self.px(g["pilule_h"]) / 2, kk, aa, -3)
2761:         out = Image.new("RGBA", cal.size, (0, 0, 0, 0))
2762:         _poser(out, cal, cal.width / 2, cal.height / 2, k, a)
2763:         return out
2764: 
2765:     def sons(self):
2766:         out = [(self.t0(), "compteur")] + [(self._t_arret(i), "clic") for i in range(self.n)]
2767:         if self.pilule is not None:
2768:             out.append((self._t_pilule() + C.TAMPON_FRAPPE, "impact"))
2769:         return out
