 2766 class Bouclier(_Pilules, _Insert):
 2767     """Un bouclier qui couvre une silhouette (le docteur junior) ; au temps "temps", son contour se
 2768     defait en pointilles et un « ? » se balance : on ne sait pas s'il le couvre. A droite, les
 2769     pilules du texte."""
 2770 
 2771     def taille_nominale(self):
 2772         return C.TEXTE_LARGEUR, C.BOUCLIER_H
 2773 
 2774     def __init__(self, *a):
 2775         super().__init__(*a)
 2776         g = C.BOUCLIER_GEO
 2777         bw, bh = self.px(g["bouclier"][0]), self.px(g["bouclier"][1])
 2778         tr = self.px(g["trait"])
 2779         navy, rub = C.NAVY + (255,), tuple(self.rubrique) + (255,)
 2780 
 2781         def pts(k, retrait=0):
 2782             cx, cy = bw * k / 2, bh * k * 0.48
 2783             fx, fy = 1 - 2 * retrait / bw, 1 - 2 * retrait / bh
 2784             return [(cx + (x * bw * k - cx) * fx, cy + (y * bh * k - cy) * fy) for x, y in _BOUCLIER]
 2785 
 2786         def fond(d, k):
 2787             d.polygon(pts(k), fill=C.BLANC + (255,))
 2788             r, (lb, hb_) = self.px(g["tete"]) * k, (self.px(g["buste"][0]) * k, self.px(g["buste"][1]) * k)
 2789             cx, cy = bw * k / 2, bh * k * 0.5
 2790             d.ellipse([cx - r, cy - r * 2.4, cx + r, cy - r * 0.4], fill=rub)
 2791             d.rounded_rectangle([cx - lb / 2, cy - r * 0.1, cx + lb / 2, cy - r * 0.1 + hb_], radius=hb_ * 0.45, fill=rub)
 2792             cl, ce = self.px(g["croix"][0]) * k, self.px(g["croix"][1]) * k
 2793             yc = cy - r * 0.1 + hb_ * 0.48
 2794             d.rectangle([cx - cl / 2, yc - ce / 2, cx + cl / 2, yc + ce / 2], fill=C.BLANC + (255,))
 2795             d.rectangle([cx - ce / 2, yc - cl / 2, cx + ce / 2, yc + cl / 2], fill=C.BLANC + (255,))
 2796 
 2797         def anneau(d, k):
 2798             d.polygon(pts(k), fill=navy)
 2799             d.polygon(pts(k, tr), fill=(0, 0, 0, 0))
 2800         self.fond = _ombre_marge(_net(bw, bh, fond), self.s)
 2801         plein = _net(bw, bh, anneau)
 2802         periode, trace = (self.px(v) for v in g["pointilles"])
 2803         self.anneaux = [_ombre_marge(plein, self.s), _ombre_marge(_pointilles(plein, periode, trace), self.s)]
 2804         self.badge = _icone_choix(None, self.px(g["badge"]), self.px(C.CHOIX_GEO["trait"]), self.rubrique)
 2805         self.bx, self.by = self.m + bw / 2, self.m + self.h / 2
 2806         self.bw, self.bh = bw, bh
 2807         self._preparer_pilules(g, self.m + bw + self.px(g["ecart"]), self.by)
 2808 
 2809     def _t_doute(self):
 2810         return self.t0(self.spec.get("temps", 1)) + C.INSERT_DELAI
 2811 
 2812     def image(self, t, final):
 2813         g = C.BOUCLIER_GEO
 2814         k, a = _entree(t, self.t0(), final)
 2815         if a <= 0:
 2816             return None
 2817         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 2818         q = 1.0 if final else T.lisse((t - self._t_doute()) / g["bascule"])
 2819         _poser(out, self.fond, self.bx, self.by, k, a)
 2820         _poser(out, self.anneaux[0], self.bx, self.by, k, a * (1 - q))
 2821         _poser(out, self.anneaux[1], self.bx, self.by, k, a * q)
 2822         v = 1.0 if final else (t - self._t_doute() - g["bascule"] * 0.5) / C.INSERT_ENTREE
 2823         if v > 0:
 2824             amp, freq = C.CHOIX_GEO["balance"]
 2825             angle = 0.0 if final or v < 1 else amp * math.sin(2 * math.pi * freq * (t - self._t_doute()))
 2826             kk = 0.3 + 0.7 * (1.0 if final else T.rebond(v))
 2827             _poser(out, self.badge, self.bx + self.bw * 0.4, self.by - self.bh * 0.4, kk,
 2828                    1.0 if final else T.lisse(v * 2), angle)
 2829         self._pilules(out, t, final)
 2830         return out
 2831 
 2832     def sons(self):
 2833         return [(self.t0(), "souffle"), (self._t_doute(), "clic")] + self._sons_pilules()
 2834 
