 2960     def _t_ligne(self, j):
 2961         g = C.ORDONNANCE_GEO
 2962         l = self.spec["lignes"][j]
 2963         avant = [i for i in range(j) if self.spec["lignes"][i].get("temps", 0) == l.get("temps", 0)]
 2964         return self.t0(l.get("temps", 0)) + C.INSERT_ENTREE * 0.6 + len(avant) * g["ecriture"]
 2965 
 2966     def _t_pied(self):
 2967         g = C.ORDONNANCE_GEO
 2968         fin = self._t_ligne(len(self.lignes) - 1) + g["ecriture"] + g["pilule_delai"]
 2969         return max(fin, self.t0(self.spec["temps_pied"])) if "temps_pied" in self.spec else fin
 2970 
 2971     def image(self, t, final):
 2972         g = C.ORDONNANCE_GEO
 2973         k, a = _entree(t, self.t0(), final)
 2974         if a <= 0:
 2975             return None
 2976         cal = self.papier.copy()
 2977         x0 = self.m + self.px(g["pad"])
 2978         plume = None
 2979         for j, (im, y) in enumerate(zip(self.lignes, self.ly)):
 2980             p = 1.0 if final else T.lisse((t - self._t_ligne(j)) / g["ecriture"])
 2981             if p <= 0:
 2982                 continue
 2983             larg = max(1, int(im.width * p))
 2984             cal.alpha_composite(im.crop((0, 0, larg, im.height)), (int(x0), int(y)))
 2985             if 0 < p < 1:
 2986                 plume = (x0 + larg, y + self.px(g["label_px"]) * 0.85)
 2987         if self.pied is not None:
 2988             kk, aa = _frappe(t, self._t_pied(), final)
 2989             if aa > 0:
 2990                 _poser(cal, self.pied, x0 + (self.pied.width - 2 * self.m) / 2, self.pied_y, kk, aa, -2)
 2991         if plume is not None:
 2992             _poser(cal, self.stylo, plume[0], plume[1])
 2993         out = Image.new("RGBA", cal.size, (0, 0, 0, 0))
 2994         _poser(out, cal, cal.width / 2, cal.height / 2, k, a)
 2995         return out
 2996 
 2997     def sons(self):
 2998         out = [(self.t0(), "souffle")] + [(self._t_ligne(j), "clic") for j in range(len(self.lignes))]
 2999         if self.pied is not None:
 3000             out.append((self._t_pied() + C.TAMPON_FRAPPE, "impact"))
 3001         return out
