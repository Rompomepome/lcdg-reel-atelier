 3113         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 3114         _poser(out, self.sprite, self.m + self.w / 2, self.m + self.h / 2, k, a, C.PILULE_GEO["angle"])
