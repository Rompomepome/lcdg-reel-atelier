 2562 class Carte(_Insert):
 2563     """Une carte CPS au nom de son titulaire, a cote du lecteur ; au temps "temps" (sinon un instant
 2564     apres son arrivee), elle glisse dans la fente et l'ecran repond : une coche ("ok"), ou une croix,
 2565     et la carte refusee tremble."""
 2566 
 2567     def taille_nominale(self):
 2568         return C.TEXTE_LARGEUR, C.CARTE_H
 2569 
 2570     def __init__(self, *a):
 2571         super().__init__(*a)
 2572         g = C.CARTE_GEO
 2573         self.ok = self.spec.get("ok", True)
 2574         self.carte = _ombre_marge(self._carte(), self.s)
 2575         self.lecteur = _ombre_marge(self._lecteur(), self.s)
 2576         self.verdict = _icone_choix(self.ok, self.px(g["resultat"]), self.px(g["trait"]), self.rubrique)
 2577         cw, lw = self.px(g["carte"][0]), self.px(g["lecteur"][0])
 2578         self.lx = self.m + self.w - self.px(g["pad"]) - lw / 2           # centre du lecteur
 2579         self.x0 = self.m + self.px(g["pad"]) + cw / 2                     # la carte posee a gauche
 2580         self.x1 = self.lx - lw / 2 + cw * (g["profondeur"] - 0.5)         # engagee dans la fente
 2581         self.cy = self.m + self.h / 2
 2582 
 2583     def _carte(self):
 2584         g = C.CARTE_GEO
 2585         w, h, ra = self.px(g["carte"][0]), self.px(g["carte"][1]), self.px(g["rayon"])
 2586         pw, ph = self.px(g["puce"][0]), self.px(g["puce"][1])
 2587         px0, py0 = self.px(g["puce_xy"][0]), self.px(g["puce_xy"][1])
 2588         cl, ce, pad = self.px(g["croix"][0]), self.px(g["croix"][1]), self.px(g["pad"])
 2589         rub = tuple(self.rubrique)
 2590         im = _net(w, h, lambda d, k: d.rounded_rectangle([0, 0, w * k - 1, h * k - 1], radius=ra * k,
 2591                                                          fill=rub + (255,)))
 2592         reflet = _net(w, h, lambda d, k: d.ellipse([w * k * 0.5, h * k * 0.3, w * k * 1.4, h * k * 1.7],
 2593                                                    fill=_teinte(rub, 0.16) + (255,)))
 2594         reflet.putalpha(ImageChops.multiply(reflet.getchannel("A"), im.getchannel("A")))
 2595         im.alpha_composite(reflet)
 2596 
 2597         def puce(d, k):
 2598             d.rounded_rectangle([0, 0, pw * k - 1, ph * k - 1], radius=ph * k * 0.22, fill=C.INSERT_GRIS + (255,))
 2599             trait, filet = max(1, int(ph * k * 0.07)), _teinte(rub, 0.45) + (255,)
 2600             for y in (ph * k / 3, ph * k * 2 / 3):
 2601                 d.line([(0, y), (pw * k * 0.36, y)], fill=filet, width=trait)
 2602                 d.line([(pw * k * 0.64, y), (pw * k, y)], fill=filet, width=trait)
 2603             d.rounded_rectangle([pw * k * 0.36, ph * k * 0.2, pw * k * 0.64, ph * k * 0.8], radius=ph * k * 0.08,
 2604                                 outline=filet, width=trait)
 2605         im.alpha_composite(_net(pw, ph, puce), (px0, py0))
 2606         d = ImageDraw.Draw(im)
 2607         cx, cyc = w - pad - cl / 2, pad + cl / 2                          # la croix du soin
 2608         d.rectangle([cx - cl / 2, cyc - ce / 2, cx + cl / 2, cyc + ce / 2], fill=C.BLANC + (255,))
 2609         d.rectangle([cx - ce / 2, cyc - cl / 2, cx + ce / 2, cyc + cl / 2], fill=C.BLANC + (255,))
 2610         _ecrire(d, (pad, pad), "CARTE CPS", self.px(g["titre_px"]), C.INSERT_GRAISSE_FORTE, C.BLANC + (255,))
 2611         _ecrire(d, (pad, h - pad), self.spec.get("titulaire", ""), self.px(g["nom_px"]), C.INSERT_GRAISSE_FORTE,
 2612                 C.BLANC + (255,), "ls")
 2613         return im
 2614 
 2615     def _lecteur(self):
 2616         g = C.CARTE_GEO
 2617         w, h, ra = self.px(g["lecteur"][0]), self.px(g["lecteur"][1]), self.px(g["lecteur_rayon"])
 2618         ew, eh, ey = self.px(g["ecran"][0]), self.px(g["ecran"][1]), self.px(g["ecran_y"])
 2619         tr, ty, tp = self.px(g["touche"]), self.px(g["touches_y"]), self.px(g["touches_pas"])
 2620         fw, fh = self.px(g["fente"][0]), self.px(g["fente"][1])
 2621 
 2622         def dessin(d, k):
 2623             d.rounded_rectangle([0, 0, w * k - 1, h * k - 1], radius=ra * k, fill=C.NAVY + (255,))
 2624             d.rounded_rectangle([(w - ew) / 2 * k, ey * k, (w + ew) / 2 * k, (ey + eh) * k], radius=ra * k * 0.4,
 2625                                 fill=(8, 5, 26, 255))
 2626             for rang in range(2):
 2627                 for col in (-1, 0, 1):
 2628                     x, y = (w / 2 + col * tp) * k, (ty + rang * tp) * k
 2629                     d.ellipse([x - tr * k / 2, y - tr * k / 2, x + tr * k / 2, y + tr * k / 2],
 2630                               fill=_teinte(C.NAVY, 0.3) + (255,))
 2631             d.rounded_rectangle([0, (h - fh) / 2 * k, fw * k, (h + fh) / 2 * k], radius=fw * k / 2,
 2632                                 fill=(8, 5, 26, 255))                     # la fente, sur le bord gauche
 2633         return _net(w, h, dessin)
 2634 
 2635     def _t_glisse(self):
 2636         if "temps" in self.spec:
 2637             return self.t0(self.spec["temps"])
 2638         return self.t0() + C.CARTE_GEO["attente"]
 2639 
 2640     def image(self, t, final):
 2641         g = C.CARTE_GEO
 2642         k, a = _entree(t, self.t0(), final)
 2643         if a <= 0:
 2644             return None
 2645         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 2646         tg, tv = self._t_glisse(), self._t_glisse() + g["course"]
 2647         p = 1.0 if final else T.lisse((t - tg) / g["course"])
 2648         x = self.x0 + (self.x1 - self.x0) * p
 2649         if not final:                                    # la carte arrive de la gauche
 2650             x -= self.px(g["glisse"]) * (1 - T.lisse((t - self.t0()) / C.INSERT_ENTREE))
 2651             v = (t - tv) / g["refus"][1]
 2652             if not self.ok and 0 < v < 1:                # refusee : elle tremble
 2653                 x += self.px(g["refus"][0]) * math.sin(2 * math.pi * 4 * v) * (1 - v)
 2654         _poser(out, self.carte, x, self.cy, k, a)
 2655         _poser(out, self.lecteur, self.lx, self.cy, k, a)   # le lecteur passe devant la carte engagee
 2656         v = 1.0 if final else (t - tv) / C.INSERT_ENTREE
 2657         if v > 0:
 2658             kk = C.CHOIX_GEO["icone_depart"] + (1 - C.CHOIX_GEO["icone_depart"]) * (1.0 if final else T.rebond(v))
 2659             ey = self.cy - self.px(g["lecteur"][1]) / 2 + self.px(g["ecran_y"]) + self.px(g["ecran"][1]) / 2
 2660             _poser(out, self.verdict, self.lx, ey, kk, 1.0 if final else T.lisse(v * C.INSERT_FONDU))
 2661         return out
 2662 
 2663     def sons(self):
 2664         tv = self._t_glisse() + C.CARTE_GEO["course"]
 2665         return [(self.t0(), "souffle"), (self._t_glisse(), "souffle"), (tv, "clic" if self.ok else "impact")]
