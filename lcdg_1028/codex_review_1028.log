 2669 class Compteur(_Insert):
 2670     """Un compteur a rouleaux : les chiffres defilent, puis s'arretent un a un sur « ? » au temps
 2671     "temps" ; une pilule rouge claque dessous (« Aucun chiffre officiel »). Aucun nombre n'y reste :
 2672     le compteur dit que personne ne le publie."""
 2673 
 2674     def taille_nominale(self):
 2675         return C.TEXTE_LARGEUR, C.COMPTEUR_H
 2676 
 2677     def __init__(self, *a):
 2678         super().__init__(*a)
 2679         g = C.COMPTEUR_GEO
 2680         self.n = self.spec.get("chiffres", 4)
 2681         self.cw, self.ch = self.px(g["case"][0]), self.px(g["case"][1])
 2682         ra, pad = self.px(g["rayon"]), self.px(g["pad"])
 2683         self.case = _net(self.cw, self.ch, lambda d, k: d.rounded_rectangle(
 2684             [0, 0, self.cw * k - 1, self.ch * k - 1], radius=ra * k, fill=C.NAVY + (255,)))
 2685         px = self.px(g["chiffre_px"])
 2686         self.glyphes = {c: self._glyphe(c, px, C.BLANC) for c in "0123456789"}
 2687         self.glyphes["?"] = self._glyphe("?", px, _teinte(self.rubrique, 0.4))
 2688         carte = _cadre(self.w, self.h, self.s, marge=self.m)
 2689         d = ImageDraw.Draw(carte)
 2690         tp = self.px(g["titre_px"])
 2691         _ecrire(d, (self.m + pad, self.m + pad), T.normaliser(self.spec.get("titre", "")).upper(), tp,
 2692                 C.INSERT_GRAISSE_FORTE, C.INSERT_GRIS_TEXTE + (255,))
 2693         _ecrire(d, (self.m + self.w - pad, self.m + pad), self.spec.get("date", ""), tp, C.INSERT_GRAISSE_TEXTE,
 2694                 C.INSERT_GRIS_TEXTE + (255,), "ra")
 2695         self.carte = _ombre(carte, self.s)
 2696         largeur = self.n * self.cw + (self.n - 1) * self.px(g["ecart"])
 2697         self.xs = [self.m + (self.w - largeur) / 2 + i * (self.cw + self.px(g["ecart"])) for i in range(self.n)]
 2698         self.yc = self.m + self.px(g["case_y"])
 2699         self.pilule = None
 2700         if self.spec.get("pilule"):
 2701             self.pilule = _ombre_marge(_bulle(self.spec["pilule"], self.px(g["pilule_px"]), self.px(g["pilule_h"]),
 2702                                               self.px(g["pilule_pad"]), C.INSERT_ROUGE, queue=False), self.s)
 2703 
 2704     def _glyphe(self, c, px, couleur):
 2705         im = Image.new("RGBA", (self.cw, self.ch), (0, 0, 0, 0))
 2706         _ecrire(ImageDraw.Draw(im), (self.cw / 2, self.ch / 2), c, px, C.INSERT_GRAISSE_CHIFFRE, couleur + (255,), "mm")
 2707         return im
 2708 
 2709     def _t_arret(self, i):
 2710         return self.t0(self.spec.get("temps", 1)) + C.INSERT_DELAI + i * C.COMPTEUR_GEO["arret"]
 2711 
 2712     def _t_pilule(self):
 2713         g = C.COMPTEUR_GEO
 2714         return self._t_arret(self.n - 1) + g["chute"] + g["pilule_delai"]
 2715 
 2716     def _rouleau(self, i, t, final):
 2717         g = C.COMPTEUR_GEO
 2718         couche = Image.new("RGBA", (self.cw, self.ch), (0, 0, 0, 0))
 2719         ta = self._t_arret(i)
 2720         if final or t >= ta + g["chute"]:
 2721             couche.alpha_composite(self.glyphes["?"])
 2722         else:
 2723             v = g["vitesse"] * (max(self.t0(), min(t, ta)) - self.t0()) + i * 3.7
 2724             chiffre, f = int(v) % 10, v - int(v)
 2725             if t < ta:                                   # le rouleau tourne : le chiffre suivant monte
 2726                 _coller_coupe(couche, self.glyphes[str(chiffre)], 0, -f * self.ch)
 2727                 _coller_coupe(couche, self.glyphes[str((chiffre + 1) % 10)], 0, (1 - f) * self.ch)
 2728             else:                                        # il s'arrete : le « ? » tombe a sa place
 2729                 q = T.rebond((t - ta) / g["chute"])
 2730                 _coller_coupe(couche, self.glyphes[str(chiffre)], 0, q * self.ch)
 2731                 _coller_coupe(couche, self.glyphes["?"], 0, (q - 1) * self.ch)
 2732         couche.putalpha(ImageChops.multiply(couche.getchannel("A"), self.case.getchannel("A")))
 2733         im = self.case.copy()
 2734         im.alpha_composite(couche)
 2735         return im
 2736 
 2737     def image(self, t, final):
 2738         g = C.COMPTEUR_GEO
 2739         k, a = _entree(t, self.t0(), final)
 2740         if a <= 0:
 2741             return None
 2742         cal = self.carte.copy()
 2743         for i, x in enumerate(self.xs):
 2744             cal.alpha_composite(self._rouleau(i, t, final), (int(x), int(self.yc)))
 2745         if self.pilule is not None:
 2746             kk, aa = _frappe(t, self._t_pilule(), final)
 2747             if aa > 0:
 2748                 _poser(cal, self.pilule, self.m + self.w / 2,
 2749                        self.m + self.h - self.px(g["pilule_dy"]) - self.px(g["pilule_h"]) / 2, kk, aa, -3)
 2750         out = Image.new("RGBA", cal.size, (0, 0, 0, 0))
 2751         _poser(out, cal, cal.width / 2, cal.height / 2, k, a)
 2752         return out
 2753 
 2754     def sons(self):
 2755         out = [(self.t0(), "compteur")] + [(self._t_arret(i), "clic") for i in range(self.n)]
 2756         if self.pilule is not None:
 2757             out.append((self._t_pilule() + C.TAMPON_FRAPPE, "impact"))
 2758         return out
