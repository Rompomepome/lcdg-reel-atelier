 3009 class Sablier(_Pilules, _Insert):
 3010     """Un sablier dont le sable coule, qui se retourne sans fin ; un « ? » se balance a son coin :
 3011     aucun delai n'est fixe. A droite, les pilules du texte."""
 3012 
 3013     def taille_nominale(self):
 3014         return C.TEXTE_LARGEUR, C.SABLIER_H
 3015 
 3016     def __init__(self, *a):
 3017         super().__init__(*a)
 3018         g = C.SABLIER_GEO
 3019         self.sw, self.sh = self.px(g["sablier"][0]), self.px(g["sablier"][1])
 3020         self.socle, self.tr = self.px(g["socle"]), self.px(g["trait"])
 3021         self.cote = int(max(self.sw, self.sh) * 1.1)
 3022         self.badge = _icone_choix(None, self.px(g["badge"]), self.px(C.CHOIX_GEO["trait"]), self.rubrique)
 3023         self.cx, self.cy = self.m + self.cote / 2, self.m + self.h / 2
 3024         self._preparer_pilules(g, self.m + self.cote + self.px(g["ecart"]), self.cy)
 3025         self.cache = {}
 3026 
 3027     def _dessin(self, p):
 3028         """Le sablier, sable ecoule a la fraction p (le haut se vide, le bas se remplit)."""
 3029         cle = round(p, 2)
 3030         if cle in self.cache:
 3031             return self.cache[cle]
 3032         sw, sh, so, tr, cote = self.sw, self.sh, self.socle, self.tr, self.cote
 3033         rub, navy = tuple(self.rubrique) + (255,), C.NAVY + (255,)
 3034 
 3035         def geo(k):
 3036             x0, y0 = (cote - sw) / 2 * k, (cote - sh) / 2 * k
 3037             ya, yb = y0 + so * k, y0 + (sh - so) * k              # haut et bas du verre
 3038             return x0, y0, ya, yb, [(x0 + sw * k * x, ya + (yb - ya) * y) for x, y in _VERRE]
 3039 
 3040         def verre(d, k):
 3041             d.polygon(geo(k)[4], fill=C.BLANC + (235,))
 3042 
 3043         def sable(d, k):
 3044             x0, _, ya, yb, _ = geo(k)
 3045             col = (yb - ya) / 2
 3046             d.rectangle([0, ya + col * p, cote * k, ya + col], fill=rub)            # le haut se vide
 3047             d.rectangle([0, yb - col * p, cote * k, yb], fill=rub)                  # le bas se remplit
 3048             if 0 < p < 1:
 3049                 d.line([(x0 + sw * k / 2, ya + col), (x0 + sw * k / 2, yb)], fill=rub, width=max(2, int(tr * k * 0.5)))
 3050 
 3051         def contour(d, k):
 3052             x0, y0, _, _, pts = geo(k)
 3053             d.line(pts + [pts[0]], fill=navy, width=int(tr * k), joint="curve")
 3054             for y in (y0, y0 + (sh - so) * k):
 3055                 d.rounded_rectangle([x0 - so * k * 0.4, y, x0 + (sw + so * 0.4) * k, y + so * k], radius=so * k * 0.4,
 3056                                     fill=navy)
 3057         im = _net(cote, cote, verre)
 3058         grains = _net(cote, cote, sable)
 3059         grains.putalpha(ImageChops.multiply(grains.getchannel("A"), _net(cote, cote, lambda d, k: d.polygon(
 3060             geo(k)[4], fill=C.BLANC + (255,))).getchannel("A")))
 3061         im.alpha_composite(grains)
 3062         im.alpha_composite(_net(cote, cote, contour))
 3063         im = _ombre_marge(im, self.s)
 3064         self.cache[cle] = im
 3065         return im
 3066 
 3067     def image(self, t, final):
 3068         g = C.SABLIER_GEO
 3069         k, a = _entree(t, self.t0(), final)
 3070         if a <= 0:
 3071             return None
 3072         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 3073         coule = g["cycle"] - g["retournement"]
 3074         phase = 0.0 if final else (t - self.t0()) % g["cycle"]
 3075         p, angle = (0.5, 0.0) if final else (min(1.0, phase / coule), 180 * T.lisse((phase - coule) / g["retournement"]))
 3076         _poser(out, self._dessin(p), self.cx, self.cy, k, a, angle)
 3077         v = 1.0 if final else (t - self.t0() - C.INSERT_ENTREE) / C.INSERT_ENTREE
 3078         if v > 0:
 3079             amp, freq = C.CHOIX_GEO["balance"]
 3080             ang = 0.0 if final or v < 1 else amp * math.sin(2 * math.pi * freq * (t - self.t0()))
 3081             _poser(out, self.badge, self.cx + self.sw * 0.55, self.cy - self.sh * 0.45,
 3082                    0.3 + 0.7 * (1.0 if final else T.rebond(v)), 1.0 if final else T.lisse(v * 2), ang)
 3083         self._pilules(out, t, final)
 3084         return out
 3085 
 3086     def sons(self):
 3087         return [(self.t0(), "souffle")] + self._sons_pilules()
