 2535 class _Pilules:
 2536     """Pilules empilees a droite d'un dessin ("pilules" : [{"texte", "ton", "temps"}]) ; chacune
 2537     claque au temps de son numero. geo : pilule_px, pilule_h, pilule_pad, pilule_ecart."""
 2538 
 2539     def _preparer_pilules(self, g, x, cy):
 2540         self.pil_specs = self.spec.get("pilules", [])
 2541         self.pil = [_ombre_marge(_bulle(p["texte"], self.px(g["pilule_px"]), self.px(g["pilule_h"]),
 2542                                         self.px(g["pilule_pad"]), _ton(p, self.rubrique), queue=False), self.s)
 2543                     for p in self.pil_specs]
 2544         n, ph, ec = len(self.pil), self.px(g["pilule_h"]), self.px(g["pilule_ecart"])
 2545         haut = cy - (n * ph + (n - 1) * ec) / 2
 2546         self.pil_xy = [(x, haut + i * (ph + ec) + ph / 2) for i in range(n)]
 2547 
 2548     def _t_pilule(self, i):
 2549         return self.t0(self.pil_specs[i].get("temps", 0)) + C.INSERT_ENTREE * 0.6
 2550 
 2551     def _pilules(self, out, t, final):
 2552         for i, (im, (x, y)) in enumerate(zip(self.pil, self.pil_xy)):
 2553             k, a = _frappe(t, self._t_pilule(i), final)
 2554             if a > 0:
 2555                 _poser(out, im, x + (im.width - 2 * self.m) / 2, y, k, a, -3)
 2556 
 2557     def _sons_pilules(self):
 2558         return [(self._t_pilule(i) + C.TAMPON_FRAPPE, "impact") for i in range(len(self.pil))]
 2559 
