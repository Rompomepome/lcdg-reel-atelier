 2856                     self.px(g["numero_px"]), C.INSERT_GRAISSE_FORTE, tuple(self.rubrique) + (255,), "mm")
 2857             _ecrire(d, (self.m + self.cw / 2, self.m + self.ch * g["nom_y"]), dep["nom"], self.px(g["nom_px"]),
 2858                     C.INSERT_GRAISSE_FORTE, C.NAVY + (255,), "mm")
 2859             self.tuiles.append(_ombre(im, self.s))
 2860 
 2861     def _t(self, i):
