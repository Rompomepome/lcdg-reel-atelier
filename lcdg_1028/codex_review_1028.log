 3091 class Pilule(_Insert):
 3092     """Une pilule seule (« Aucune rémunération prévue ») qui claque au temps "temps", ton rouge par
 3093     defaut : sous un dessin, elle ne cache rien, la ou un tampon couvrirait ses libelles."""
