 2864     def image(self, t, final):
 2865         g = C.DEPARTEMENTS_GEO
 2866         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 2867         for i, tuile in enumerate(self.tuiles):
 2868             p = 1.0 if final else (t - self._t(i)) / g["retourne"]
 2869             if p <= 0:
 2870                 continue
 2871             ky = 1.0 if final else max(0.02, T.rebond(p))     # la tuile se retourne : elle s'ouvre en hauteur
 2872             im = tuile.resize((tuile.width, max(1, int(tuile.height * ky))), Image.BICUBIC)
 2873             col, rang = i % g["colonnes"], i // g["colonnes"]
 2874             cx = self.m + col * (self.cw + self.ecart) + self.cw / 2
 2875             cy = self.m + rang * (self.ch + self.ecart) + self.ch / 2
 2876             T.coller(out, im, (cx - im.width / 2, cy - im.height / 2), 1.0 if final else T.lisse(p * C.INSERT_FONDU))
 2877         return out
