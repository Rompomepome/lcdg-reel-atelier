 2884 class Ordonnance(_Insert):
 2885     """Une ordonnance qui s'ecrit : chaque ligne (le traitement, puis sa condition en gris) se trace
 2886     de gauche a droite, un stylo au bout du trait ; une pilule rouge claque au pied ("pied")."""
 2887 
 2888     def _mise_en_page(self, s):
 2889         """Lignes de texte de chaque prescription et hauteur totale, a l'echelle s."""
 2890         g = C.ORDONNANCE_GEO
 2891         p = lambda v: max(1, int(round(v * s)))
 2892         utile = p(g["w"]) - 2 * p(g["pad"])
 2893         blocs = [(_couper(l["label"], p(g["label_px"]), C.INSERT_GRAISSE_FORTE, utile),
 2894                   _couper(l.get("note", ""), p(g["note_px"]), C.INSERT_GRAISSE_TEXTE, utile) if l.get("note") else [])
 2895                  for l in self.spec["lignes"]]
 2896         hauteurs = [len(a) * p(g["label_px"]) * g["interligne"] + len(b) * p(g["note_px"]) * g["interligne"]
 2897                     for a, b in blocs]
 2898         h = p(g["tete"]) + p(g["pad"]) + sum(hauteurs) + (len(blocs) - 1) * p(g["ligne_ecart"]) + p(g["pad"])
 2899         if self.spec.get("pied"):
 2900             h += p(g["pilule_h"]) + p(g["pad"]) * 0.6
 2901         return blocs, hauteurs, h
 2902 
 2903     def taille_nominale(self):
 2904         return C.ORDONNANCE_GEO["w"], int(self._mise_en_page(1.0)[2])
 2905 
 2906     def __init__(self, *a):
 2907         super().__init__(*a)
 2908         g = C.ORDONNANCE_GEO
 2909         blocs, hauteurs, _ = self._mise_en_page(self.s)
 2910         pad, tete = self.px(g["pad"]), self.px(g["tete"])
 2911         rub = tuple(self.rubrique)
 2912         papier = _cadre(self.w, self.h, self.s, marge=self.m)
 2913         bande = _net(self.w, tete, lambda d, k: (
 2914             d.rounded_rectangle([0, 0, self.w * k - 1, tete * k * 1.5], radius=self.px(C.INSERT_RAYON) * k,
 2915                                 fill=_teinte(rub, 0.88) + (255,)),
 2916             d.rectangle([0, (tete - self.px(g["filet"])) * k, self.w * k, tete * k], fill=rub + (255,))))
 2917         bande.putalpha(ImageChops.multiply(bande.getchannel("A"),
 2918                                            papier.crop((self.m, self.m, self.m + self.w, self.m + tete)).getchannel("A")))
 2919         papier.alpha_composite(bande, (self.m, self.m))
 2920         d = ImageDraw.Draw(papier)
 2921         _ecrire(d, (self.m + pad, self.m + tete / 2), T.normaliser(self.spec.get("titre", "Ordonnance")).upper(),
 2922                 self.px(g["titre_px"]), C.INSERT_GRAISSE_FORTE, rub + (255,), "lm")
 2923         if self.spec.get("marque"):
 2924             marque = _bulle(self.spec["marque"], self.px(g["marque_px"]), self.px(g["marque_h"]),
 2925                             self.px(g["marque_pad"]), rub, queue=False)
 2926             papier.alpha_composite(marque, (int(self.m + self.w - pad - marque.width),
 2927                                             int(self.m + (tete - marque.height) / 2)))
 2928         self.papier = _ombre(papier, self.s)
 2929         self.lignes, self.ly = [], []
 2930         y = self.m + tete + pad
 2931         for (labels, notes), hh in zip(blocs, hauteurs):
 2932             im = Image.new("RGBA", (self.w - 2 * pad, int(hh) + 2), (0, 0, 0, 0))
 2933             dl = ImageDraw.Draw(im)
 2934             yy, lp, np_ = 0, self.px(g["label_px"]), self.px(g["note_px"])
 2935             for l in labels:
 2936                 _ecrire(dl, (0, yy), l, lp, C.INSERT_GRAISSE_FORTE, C.NAVY + (255,))
 2937                 yy += lp * g["interligne"]
 2938             for l in notes:
 2939                 _ecrire(dl, (0, yy), l, np_, C.INSERT_GRAISSE_TEXTE, C.INSERT_GRIS_TEXTE + (255,))
 2940                 yy += np_ * g["interligne"]
 2941             self.lignes.append(im)
 2942             self.ly.append(y)
 2943             y += hh + self.px(g["ligne_ecart"])
 2944         self.pied = None
 2945         if self.spec.get("pied"):
 2946             self.pied = _ombre_marge(_bulle(self.spec["pied"], self.px(g["pilule_px"]), self.px(g["pilule_h"]),
 2947                                             self.px(g["pilule_pad"]), C.INSERT_ROUGE, queue=False), self.s)
 2948             self.pied_y = self.m + self.h - pad * 0.6 - self.px(g["pilule_h"]) / 2
 2949         sw, sl = self.px(g["stylo"][0]), self.px(g["stylo"][1])
 2950         cote = 2 * sl + 4
 2951 
 2952         def stylo(dd, k):                                # pointe au centre, corps vers le haut
 2953             c = cote * k / 2
 2954             dd.rounded_rectangle([c - sw * k / 2, c - sl * k, c + sw * k / 2, c - sw * k * 1.2], radius=sw * k / 2,
 2955                                  fill=C.NAVY + (255,))
 2956             dd.polygon([(c - sw * k / 2, c - sw * k * 1.4), (c + sw * k / 2, c - sw * k * 1.4), (c, c)],
 2957                        fill=(8, 5, 26, 255))
 2958         self.stylo = _ombre_marge(_net(cote, cote, stylo).rotate(-g["stylo_angle"], resample=Image.BICUBIC), self.s)
