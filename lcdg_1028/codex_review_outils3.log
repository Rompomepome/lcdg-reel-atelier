  40:         self.debut, self.fin = temps[0], temps[-1] + 10
  41:         self.parts = [Part(x) for x in temps]
  42: 
  43: 
  44: specs = json.loads(Path(args.spec).read_text(encoding="utf-8"))
  45: specs = [specs] if isinstance(specs, dict) else specs
  46: scene = Scene([float(x) for x in args.temps.split(",")])
  47: objs, premier = [], None
  48: for sp in specs:
  49:     o = I.TYPES[sp["type"]]("essai", sp, scene, args.bas - C.INSERT_ECART)
  50:     if sp.get("sur") and premier is not None:
  51:         o.x = premier.x + (premier.w - o.w) / 2
  52:         o.y = premier.y + (premier.h - o.h) / 2
  53:     premier = premier or o
  54:     objs.append(o)
  55: print("échelles :", [round(o.s, 2) for o in objs], "tailles :", [(o.w, o.h) for o in objs])
  56: fond = Image.open(args.fond).convert("RGBA").resize((C.LARGEUR, C.HAUTEUR)) if args.fond else \
  57:     Image.new("RGBA", (C.LARGEUR, C.HAUTEUR), (70, 80, 96, 255))
  58: haut = int(min(o.y for o in objs) - 60)
  59: bas = int(args.bas + 140)
  60: vignettes = []
  61: for t in [float(x) for x in args.instants.split(",")] + ["final"]:
  62:     im = fond.copy()
  63:     for o in objs:
  64:         o.dessiner(im, 0 if t == "final" else t, final=t == "final")
  65:     im = im.crop((0, max(0, haut), C.LARGEUR, min(C.HAUTEUR, bas)))
  66:     d = ImageDraw.Draw(im)
  67:     d.text((16, 10), f"t = {t}", fill=(255, 255, 0, 255), font=ImageFont.truetype("arial.ttf", 34))
  68:     vignettes.append(im.resize((im.width // 2, im.height // 2), Image.LANCZOS))
  69: cols = 3
  70: w, h = vignettes[0].size
  71: planche = Image.new("RGB", (cols * w + (cols + 1) * 6, ((len(vignettes) + cols - 1) // cols) * (h + 6) + 6), (230, 230, 236))
  72: for i, v in enumerate(vignettes):
  73:     planche.paste(v, (6 + (i % cols) * (w + 6), 6 + (i // cols) * (h + 6)))
  74: planche.save(args.sortie)
  75: print(args.sortie, planche.size)
  76: print("sons :", [(round(x, 2), s) for o in objs for x, s in o.sons()])
### scripts/pub.py
   1: """
   2: Version publicite d'un reel (environ 35 a 45 s), decoupee dans le reel complet, sans credit ElevenLabs :
   3: 
   4:     python scripts/pub.py episodes/<dossier> 0,1,2,8,9 [--badge "Vaccins au cabinet"]
   5:     python scripts/livrer.py episodes/<dossier>-pub
   6: 
   7: Les blocs gardes (le bloc 0, la couverture, en tete) reprennent texte, plan et animation du reel complet. La
   8: narration n'est pas relue : elle est decoupee dans celle du reel complet, dans les silences entre les phrases
   9: (meme prise, meme intonation), puis entre dans le cache de lcdg/voix.py sous la cle du texte de la pub :
  10: render.py la reprend comme une narration ordinaire. Rendre d'abord le reel complet (sa narration en cache).
  11: 
  12: Choisir les blocs : le fait fort, le probleme, une question ouverte, l'appel final. Un bloc qui commence par
  13: « Mais » ou « Et » repond au precedent : il ne se garde pas seul. --badge remplace la pastille d'ouverture :
  14: pas de vocabulaire reglementaire (decret, loi) dans la pub, Meta refuse en Europe les publicites qu'il classe
  15: comme politiques (refus du reel « minimum de patients », 10/2026).
  16: """
  17: import sys
  18: if hasattr(sys.stdout, "reconfigure"):
  19:     sys.stdout.reconfigure(encoding="utf-8", errors="replace")
  20: 
  21: import json
  22: import os
  23: import shutil
  24: import subprocess
  25: from pathlib import Path
  26: 
  27: import numpy as np
  28: 
  29: R = Path(__file__).resolve().parent.parent
  30: sys.path.insert(0, str(R))
  31: from config import charte as C
  32: from lcdg import binaires as B, voix
  33: 
  34: TAUX = 44100
  35: FONDU = 0.01
  36: 
  37: args = [a for a in sys.argv[1:]]
  38: if len(args) < 2:
  39:     raise SystemExit(__doc__)
  40: SRC = (R / args[0]).resolve()
  41: garder = [int(x) for x in args[1].split(",")]
  42: if garder[0] != 0:
  43:     raise SystemExit("[!] la pub commence par le bloc 0 (la couverture) : 0,1,...")
  44: autres = {}
  45: if "--badge" in args:
  46:     autres["badge"] = args[args.index("--badge") + 1]
  47: DST = SRC.with_name(SRC.name + "-pub")
  48: 
  49: 
  50: def pcm(f):
  51:     r = subprocess.run([B.FFMPEG, "-v", "error", "-i", str(f), "-f", "f32le", "-ac", "1", "-ar", str(TAUX), "-"],
  52:                        capture_output=True, check=True)
  53:     return np.frombuffer(r.stdout, dtype="<f4").copy()
  54: 
  55: 
  56: # ---------------------------------------------------------------- script de la publicite
  57: ep = json.loads((SRC / "script.json").read_text(encoding="utf-8"))
  58: if not voix.textes(ep)[0]:
  59:     # anciens reels (avant le 02/10/2026) : le bloc 0 etait lu ; la decoupe suppose une couverture muette
  60:     raise SystemExit("[!] le bloc 0 de ce reel a une voix : pub.py ne decoupe que les reels a couverture muette")
  61: b = ep["blocs"]
  62: pub = {k: v for k, v in ep.items() if k != "blocs"}
  63: pub["slug"] = f"{ep['slug']}-pub"
  64: pub.update(autres)
  65: blocs = []
  66: (DST / "broll").mkdir(parents=True, exist_ok=True)
  67: for k, src in enumerate(garder):
  68:     bl = json.loads(json.dumps(b[src]))
  69:     bl.pop("temps", None)
  70:     bl["fichier"] = f"B{k}.mp4"
  71:     shutil.copyfile(SRC / "broll" / b[src]["fichier"], DST / "broll" / bl["fichier"])
  72:     plan_carre = SRC / "broll_carre" / b[src]["fichier"]   # version carree propre a ce plan
  73:     if plan_carre.exists():
  74:         (DST / "broll_carre").mkdir(exist_ok=True)
  75:         shutil.copyfile(plan_carre, DST / "broll_carre" / bl["fichier"])
  76:     blocs.append(bl)
  77: pub["blocs"] = blocs
  78: (DST / "script.json").write_text(json.dumps(pub, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
  79: 
  80: # ---------------------------------------------------------------- narration decoupee
  81: vx = dict(voix.choix(ep))
  82: vx["id"] = vx.get("id") or C.VOIX_ID              # sans voix_off, la voix par defaut de la charte
  83: _, m_src = voix.textes(ep)
  84: tv = [t for t, _ in m_src]                       # tv[i] : texte lu du bloc i + 1
  85: texte_src = " ".join(tv)
  86: mp3_s, js_s = voix.chemins(texte_src, vx["id"], SRC / "voix", vx.get("modele"), vx.get("reglages"))
  87: if not (mp3_s.exists() and js_s.exists()):
  88:     raise SystemExit("[!] narration du reel complet absente du cache : rends-le d'abord")
  89: al = json.loads(js_s.read_text(encoding="utf-8"))
  90: assert "".join(al["characters"]) == texte_src
  91: deb, fin = al["character_start_times_seconds"], al["character_end_times_seconds"]
  92: son = pcm(mp3_s)
  93: pos, p = [], 0
  94: for t in tv:
  95:     pos.append(p)
  96:     p += len(t) + 1
  97: 
  98: 
  99: def lettres(a, z):
 100:     """Premier et dernier caractere alphanumerique de [a, z) hors indications de jeu."""
 101:     dans, idx = False, []
 102:     for i in range(a, z):
 103:         c = texte_src[i]
 104:         if c == "[":
 105:             dans = True
 106:         elif c == "]":
 107:             dans = False
 108:         elif not dans and c.isalnum():
 109:             idx.append(i)
 110:     return idx[0], idx[-1]
 111: 
 112: 
 113: def raccord(fin_a, debut_b):
 114:     """Point le plus calme du blanc entre deux phrases."""
 115:     a, z = fin_a + C.VOIX_RACCORD_GARDE, debut_b - C.VOIX_RACCORD_GARDE
 116:     n = int(C.VOIX_RACCORD_PAS * TAUX)
 117:     i0, i1 = int(a * TAUX), min(int(z * TAUX), len(son))
 118:     if i1 - i0 < 2 * n:
 119:         raise SystemExit(f"[!] pas de blanc entre {fin_a:.2f} s et {debut_b:.2f} s")
 120:     f = son[i0:i1 - (i1 - i0) % n].reshape(-1, n)
 121:     db = 10 * np.log10((f ** 2).mean(axis=1) + 1e-12)
 122:     k = int(np.argmin(db))
 123:     return (i0 + k * n + n // 2) / TAUX
 124: 
 125: 
 126: def coupe(fin_texte, debut_texte):
 127:     """Raccord entre le texte qui finit a fin_texte (exclu) et celui qui commence a debut_texte."""
 128:     _, der = lettres(max(0, fin_texte - 200), fin_texte)
 129:     pre, _ = lettres(debut_texte, len(texte_src))
 130:     return raccord(fin[der], deb[pre])
 131: 
 132: 
 133: # segments : suites de blocs parlants consecutifs, (debut, fin exclue) dans le texte du reel
 134: suites = []
 135: for k in [k for k in garder if k > 0]:
 136:     if suites and k == suites[-1][-1] + 1:
 137:         suites[-1].append(k)
 138:     else:
 139:         suites.append([k])
 140: segments = [(pos[s[0] - 1], pos[s[-1] - 1] + len(tv[s[-1] - 1])) for s in suites]
 141: bornes = []
 142: for k, (a, z) in enumerate(segments):
 143:     t0 = 0.0 if a == 0 else coupe(a - 1, a)
 144:     t1 = len(son) / TAUX if z == len(texte_src) else coupe(z, z + 1)
 145:     bornes.append((t0, t1))
 146:     print(f"  segment {k} (blocs {suites[k]}) : {t0:6.2f} -> {t1:6.2f} s  « {texte_src[a:z][:60]}… »")
 147: 
 148: morceaux, car, debs, fins_, n = [], [], [], [], 0
 149: for k, ((a, z), (t0, t1)) in enumerate(zip(segments, bornes)):
 150:     i0, i1 = int(round(t0 * TAUX)), int(round(t1 * TAUX))
 151:     m = son[i0:i1].copy()
 152:     if k > 0:
 153:         m[:int(FONDU * TAUX)] *= np.linspace(0, 1, int(FONDU * TAUX), dtype=np.float32)
 154:     if k < len(segments) - 1:
 155:         m[-int(FONDU * TAUX):] *= np.linspace(1, 0, int(FONDU * TAUX), dtype=np.float32)
 156:     decal = n / TAUX - i0 / TAUX
 157:     if k > 0:                                   # l'espace entre deux segments : le blanc
 158:         car.append(" ")
 159:         debs.append(fins_[-1])
 160:         fins_.append(max(fins_[-1], deb[a] + decal))
 161:     for q in range(a, z):
 162:         car.append(texte_src[q])
 163:         debs.append(max(0.0, deb[q] + decal))
 164:         fins_.append(max(0.0, fin[q] + decal))
 165:     morceaux.append(m)
 166:     n += len(m)
 167: 
 168: _, m_pub = voix.textes(pub)
 169: texte_pub = " ".join(t for t, _ in m_pub)
 170: assert "".join(car) == texte_pub, ("".join(car)[:200], texte_pub[:200])
 171: mp3_p, js_p = voix.chemins(texte_pub, vx["id"], DST / "voix", vx.get("modele"), vx.get("reglages"))
 172: mp3_p.parent.mkdir(parents=True, exist_ok=True)
 173: tmp = mp3_p.with_name(mp3_p.stem + ".tmp.mp3")
 174: r = subprocess.run([B.FFMPEG, "-v", "error", "-f", "f32le", "-ar", str(TAUX), "-ac", "1", "-i", "-",
 175:                     "-c:a", "libmp3lame", "-b:a", "192k", "-f", "mp3", str(tmp), "-y"],
 176:                    input=np.concatenate(morceaux).astype("<f4").tobytes(), capture_output=True)
 177: if r.returncode:
 178:     raise SystemExit(r.stderr.decode("utf-8", "replace")[-600:])
 179: js_p.write_text(json.dumps({"characters": car,
 180:                             "character_start_times_seconds": [round(x, 4) for x in debs],
 181:                             "character_end_times_seconds": [round(x, 4) for x in fins_]},
 182:                            ensure_ascii=False), encoding="utf-8")
 183: os.replace(tmp, mp3_p)
 184: print(f"narration de la publicite : {n / TAUX:.2f} s, en cache sous {mp3_p.name}")
 185: print(f"script : {DST / 'script.json'}  -> python scripts/livrer.py {DST.relative_to(R)}")
### scripts/verifier.py
   1: """
   2: Controle d'un script sans rien rendre (quelques secondes), a lancer apres chaque modification du texte :
   3: 
   4:     python scripts/verifier.py episodes/<dossier> [...]
   5: 
   6: 1. Nombre de lignes de chaque temps de texte, coupe comme le moteur le coupe : trois au plus (regle du
   7:    CLAUDE.md ; montage.verifier ne controle que la zone sure, pas ce nombre).
   8: 2. Mise en page complete (textes, surlignages, inserts, pastille, bandeau) en 9:16 ET en carre : la charte
   9:    CARRE s'applique avant l'import de lcdg (comme render_carre.py), d'ou un sous-processus par format.
  10: """
  11: import sys
  12: if hasattr(sys.stdout, "reconfigure"):
  13:     sys.stdout.reconfigure(encoding="utf-8", errors="replace")
  14: 
  15: import json
  16: import subprocess
  17: from pathlib import Path
  18: 
  19: R = Path(__file__).resolve().parent.parent
  20: sys.path.insert(0, str(R))
  21: from lcdg import habillage as hb
  22: from lcdg import texte as T
  23: 
  24: LIGNES_MAX = 3
  25: VERIF = r'''
  26: import json, sys
  27: if hasattr(sys.stdout, "reconfigure"):
  28:     sys.stdout.reconfigure(encoding="utf-8", errors="replace")
  29: sys.path.insert(0, sys.argv[1])
  30: from config import charte as C
  31: if sys.argv[3] == "1":
  32:     for cle, valeur in C.CARRE.items():
  33:         setattr(C, cle, valeur)
  34: from lcdg import montage
  35: montage.verifier(json.loads(open(sys.argv[2], encoding="utf-8").read()))
  36: print("mise en page conforme")
  37: '''
  38: 
  39: 
  40: def lignes(ep):
  41:     trop = 0
  42:     for k, b in enumerate(ep["blocs"]):
  43:         if not b.get("texte") or b.get("type") == "chiffre":
  44:             continue
  45:         for i, temps in enumerate(b["texte"].split("|")):
  46:             temps = temps.strip()
  47:             if b.get("type") == "phrase":
  48:                 _, n = hb.style_ajuste(temps)
  49:             else:
  50:                 st = hb.style_bloc()
  51:                 n = len(T.equilibrer(temps, T.mesureur(st), st["largeur"]))
  52:             if n > LIGNES_MAX:
  53:                 trop += 1
  54:                 print(f"  [!] B{k}.{i} : {n} lignes (3 au plus) : {temps}")
  55:     return trop
  56: 
  57: 
  58: if len(sys.argv) < 2:
  59:     raise SystemExit(__doc__)
  60: ok = True
  61: for d in sys.argv[1:]:
  62:     script = (R / d / "script.json").resolve()
  63:     ep = json.loads(script.read_text(encoding="utf-8"))
  64:     print(f"== {Path(d).name}")
  65:     ok &= lignes(ep) == 0
  66:     for nom, carre in (("9:16", "0"), ("carre", "1")):
  67:         r = subprocess.run([sys.executable, "-c", VERIF, str(R), str(script), carre], capture_output=True,
  68:                            text=True, encoding="utf-8", errors="replace", cwd=R)
  69:         sortie = (r.stdout + r.stderr).strip().splitlines()
  70:         print(f"  {nom:6} " + ("\n    ".join(sortie[-6:]) if r.returncode else (sortie[-1] if sortie else "?")))
  71:         ok &= r.returncode == 0
  72: sys.exit(0 if ok else 1)

