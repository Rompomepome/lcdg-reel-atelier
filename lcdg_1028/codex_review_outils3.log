2894: # ---------------------------------------------------------------- ordonnance
2895: class Ordonnance(_Insert):
2896:     """Une ordonnance qui s'ecrit : chaque ligne (le traitement, puis sa condition en gris) se trace
2897:     de gauche a droite, un stylo au bout du trait ; une pilule rouge claque au pied ("pied")."""
2898: 
2899:     def _mise_en_page(self, s):
2900:         """Lignes de texte de chaque prescription et hauteur totale, a l'echelle s."""
2901:         g = C.ORDONNANCE_GEO
2902:         p = lambda v: max(1, int(round(v * s)))
2903:         utile = p(g["w"]) - 2 * p(g["pad"])
2904:         blocs = [(_couper(l["label"], p(g["label_px"]), C.INSERT_GRAISSE_FORTE, utile),
2905:                   _couper(l.get("note", ""), p(g["note_px"]), C.INSERT_GRAISSE_TEXTE, utile) if l.get("note") else [])
2906:                  for l in self.spec["lignes"]]
2907:         hauteurs = [len(a) * p(g["label_px"]) * g["interligne"] + len(b) * p(g["note_px"]) * g["interligne"]
2908:                     for a, b in blocs]
2909:         h = p(g["tete"]) + p(g["pad"]) + sum(hauteurs) + (len(blocs) - 1) * p(g["ligne_ecart"]) + p(g["pad"])
2910:         if self.spec.get("pied"):
2911:             h += p(g["pilule_h"]) + p(g["pad"]) * 0.6
2912:         return blocs, hauteurs, h
2913: 
2914:     def taille_nominale(self):
2915:         return C.ORDONNANCE_GEO["w"], int(self._mise_en_page(1.0)[2])
2916: 
2917:     def __init__(self, *a):
2918:         super().__init__(*a)
2919:         g = C.ORDONNANCE_GEO
2920:         blocs, hauteurs, _ = self._mise_en_page(self.s)
2921:         pad, tete = self.px(g["pad"]), self.px(g["tete"])
2922:         rub = tuple(self.rubrique)
2923:         papier = _cadre(self.w, self.h, self.s, marge=self.m)
2924:         bande = _net(self.w, tete, lambda d, k: (
2925:             d.rounded_rectangle([0, 0, self.w * k - 1, tete * k * 1.5], radius=self.px(C.INSERT_RAYON) * k,
2926:                                 fill=_teinte(rub, 0.88) + (255,)),
2927:             d.rectangle([0, (tete - self.px(g["filet"])) * k, self.w * k, tete * k], fill=rub + (255,))))
2928:         bande.putalpha(ImageChops.multiply(bande.getchannel("A"),
2929:                                            papier.crop((self.m, self.m, self.m + self.w, self.m + tete)).getchannel("A")))
2930:         papier.alpha_composite(bande, (self.m, self.m))
2931:         d = ImageDraw.Draw(papier)
2932:         _ecrire(d, (self.m + pad, self.m + tete / 2), T.normaliser(self.spec.get("titre", "Ordonnance")).upper(),
2933:                 self.px(g["titre_px"]), C.INSERT_GRAISSE_FORTE, rub + (255,), "lm")
2934:         if self.spec.get("marque"):
2935:             marque = _bulle(self.spec["marque"], self.px(g["marque_px"]), self.px(g["marque_h"]),
2936:                             self.px(g["marque_pad"]), rub, queue=False)
2937:             papier.alpha_composite(marque, (int(self.m + self.w - pad - marque.width),
2938:                                             int(self.m + (tete - marque.height) / 2)))
2939:         self.papier = _ombre(papier, self.s)
2940:         self.lignes, self.ly = [], []
2941:         y = self.m + tete + pad
2942:         for (labels, notes), hh in zip(blocs, hauteurs):
2943:             im = Image.new("RGBA", (self.w - 2 * pad, int(hh) + 2), (0, 0, 0, 0))
2944:             dl = ImageDraw.Draw(im)
2945:             yy, lp, np_ = 0, self.px(g["label_px"]), self.px(g["note_px"])
2946:             for l in labels:
2947:                 _ecrire(dl, (0, yy), l, lp, C.INSERT_GRAISSE_FORTE, C.NAVY + (255,))
2948:                 yy += lp * g["interligne"]
2949:             for l in notes:
2950:                 _ecrire(dl, (0, yy), l, np_, C.INSERT_GRAISSE_TEXTE, C.INSERT_GRIS_TEXTE + (255,))
2951:                 yy += np_ * g["interligne"]
2952:             self.lignes.append(im)
2953:             self.ly.append(y)
2954:             y += hh + self.px(g["ligne_ecart"])
2955:         self.pied = None
2956:         if self.spec.get("pied"):
2957:             self.pied = _ombre_marge(_bulle(self.spec["pied"], self.px(g["pilule_px"]), self.px(g["pilule_h"]),
2958:                                             self.px(g["pilule_pad"]), C.INSERT_ROUGE, queue=False), self.s)
2959:             self.pied_y = self.m + self.h - pad * 0.6 - self.px(g["pilule_h"]) / 2
2960:         sw, sl = self.px(g["stylo"][0]), self.px(g["stylo"][1])
2961:         cote = 2 * sl + 4
2962: 
2963:         def stylo(dd, k):                                # pointe au centre, corps vers le haut
2964:             c = cote * k / 2
2965:             dd.rounded_rectangle([c - sw * k / 2, c - sl * k, c + sw * k / 2, c - sw * k * 1.2], radius=sw * k / 2,
2966:                                  fill=C.NAVY + (255,))
2967:             dd.polygon([(c - sw * k / 2, c - sw * k * 1.4), (c + sw * k / 2, c - sw * k * 1.4), (c, c)],
2968:                        fill=(8, 5, 26, 255))
2969:         self.stylo = _ombre_marge(_net(cote, cote, stylo).rotate(-g["stylo_angle"], resample=Image.BICUBIC), self.s)
2970: 
2971:     def _t_ligne(self, j):
2972:         g = C.ORDONNANCE_GEO
2973:         l = self.spec["lignes"][j]
2974:         avant = [i for i in range(j) if self.spec["lignes"][i].get("temps", 0) == l.get("temps", 0)]
2975:         return self.t0(l.get("temps", 0)) + C.INSERT_ENTREE * 0.6 + len(avant) * g["ecriture"]
2976: 
2977:     def _t_pied(self):
2978:         g = C.ORDONNANCE_GEO
2979:         fin = self._t_ligne(len(self.lignes) - 1) + g["ecriture"] + g["pilule_delai"]
2980:         return max(fin, self.t0(self.spec["temps_pied"])) if "temps_pied" in self.spec else fin
2981: 
2982:     def image(self, t, final):
2983:         g = C.ORDONNANCE_GEO
2984:         k, a = _entree(t, self.t0(), final)
2985:         if a <= 0:
2986:             return None
2987:         cal = self.papier.copy()
2988:         x0 = self.m + self.px(g["pad"])
2989:         plume = None
2990:         for j, (im, y) in enumerate(zip(self.lignes, self.ly)):
2991:             p = 1.0 if final else T.lisse((t - self._t_ligne(j)) / g["ecriture"])
2992:             if p <= 0:
2993:                 continue
2994:             larg = max(1, int(im.width * p))
2995:             cal.alpha_composite(im.crop((0, 0, larg, im.height)), (int(x0), int(y)))
2996:             if 0 < p < 1:
2997:                 plume = (x0 + larg, y + self.px(g["label_px"]) * 0.85)
2998:         if self.pied is not None:
2999:             kk, aa = _frappe(t, self._t_pied(), final)
3000:             if aa > 0:
3001:                 _poser(cal, self.pied, x0 + (self.pied.width - 2 * self.m) / 2, self.pied_y, kk, aa, -2)
3002:         if plume is not None:
3003:             _poser(cal, self.stylo, plume[0], plume[1])
3004:         out = Image.new("RGBA", cal.size, (0, 0, 0, 0))
3005:         _poser(out, cal, cal.width / 2, cal.height / 2, k, a)
3006:         return out
3007: 
3008:     def sons(self):
3009:         out = [(self.t0(), "souffle")] + [(self._t_ligne(j), "clic") for j in range(len(self.lignes))]
3010:         if self.pied is not None:
3011:             out.append((self._t_pied() + C.TAMPON_FRAPPE, "impact"))
3012:         return out
