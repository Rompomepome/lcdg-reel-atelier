 125: 
 126: def _ecrire(d, xy, texte, px, graisse, couleur, ancre="la"):
 127:     d.text(xy, T.normaliser(texte), font=T._police(px, graisse), fill=couleur, anchor=ancre)
 128: 
 129: 
 130: def _ombre(im, s):
 131:     flou, alpha, dy = C.INSERT_OMBRE
 132:     return hb.shadow(im, blur=max(2, int(flou * s)), alpha=alpha, offset=(0, max(1, int(dy * s))))
 133: 
 134: 
 135: def _cadre(w, h, s, couleur=C.BLANC, marge=0):
 136:     """Carte arrondie (avec une marge transparente pour l'ombre)."""
 137:     im = Image.new("RGBA", (w + 2 * marge, h + 2 * marge), (0, 0, 0, 0))
 138:     ImageDraw.Draw(im).rounded_rectangle([marge, marge, marge + w - 1, marge + h - 1],
 139:                                          radius=max(4, int(C.INSERT_RAYON * s)),
 140:                                          fill=tuple(couleur) + (255,))
 141:     return im
 142: 
 143: 
 144: def _poser(fond, im, cx, cy, k=1.0, alpha=1.0, angle=0.0):
 145:     """Colle im centre en (cx, cy), a l'echelle k, tourne de angle degres."""
 146:     if alpha <= 0.003 or k <= 0.01:
 147:         return
 148:     if abs(k - 1) > 0.01:
 149:         im = im.resize((max(1, int(im.width * k)), max(1, int(im.height * k))), Image.BICUBIC)
 150:     if abs(angle) > 0.05:
 151:         im = im.rotate(angle, resample=Image.BICUBIC, expand=True)
 152:     T.coller(fond, im, (cx - im.width / 2, cy - im.height / 2), min(1.0, alpha))
 153: 
 154: 
 155: def _nombre(v, dec):
 156:     # meme ecriture que les chiffres cles (habillage.Chiffre.nombre) : milliers separes par
 157:     # une espace fine, virgule decimale (« 3 400 », « 49,6 »)
 158:     return f"{v:,.{dec}f}".replace(",", " ").replace(".", ",")
 159: 
 160: 
 161: class _Insert:
 162:     """Placement, entree commune et sortie avec le texte du bloc."""
 163: 
 164:     def __init__(self, nom, spec, scene, bas):
 165:         self.nom, self.spec, self.scene = nom, spec, scene
 166:         self.debut, self.fin = scene.debut, scene.fin
 167:         self.instants = [scene.debut] + [p.debut for p in scene.parts[1:]]
 168:         w0, h0 = self.taille_nominale()
 169:         dispo = bas - C.INSERT_HAUT_MIN
 170:         self.s = min(1.0, dispo / h0, C.TEXTE_LARGEUR / w0)
 171:         if self.s < C.INSERT_ECHELLE_MIN:
 172:             raise SystemExit(f"[!] {nom} : pas la place pour l'insert « {spec['type']} » au-dessus "
 173:                              f"du texte ({dispo:.0f} px pour {h0} px). Raccourcis le texte du bloc "
 174:                              "ou retire l'insert.")
 175:         self.w, self.h = int(w0 * self.s), int(h0 * self.s)
 176:         self.m = int(C.INSERT_OMBRE[0] * C.INSERT_MARGE_OMBRE * self.s) + 4   # ombres
 177:         self.x, self.y = C.TEXTE_X, bas - self.h
 178:         self.rubrique = tuple(hb._RUBRIQUE)
 179: 
 180:     def px(self, v):
 181:         return max(1, int(round(v * self.s)))
 182: 
 183:     def t0(self, k=0):
 184:         return self.instants[min(max(0, k), len(self.instants) - 1)] + C.INSERT_DELAI
 185: 
 186:     def taille_nominale(self):
 187:         raise NotImplementedError
 188: 
 189:     def image(self, t, final):
 190:         raise NotImplementedError
 191: 
 192:     def sons(self):
 193:         return []
 194: 
 195:     def dessiner(self, lay, t, final=False):
 196:         so = 0.0 if final else self.scene.parts[-1]._sortie(t)
 197:         if so >= 1:
 198:             return
 199:         im = self.image(t, final)
 200:         if im is not None:
 201:             T.coller(lay, im, (self.x - self.m, self.y - self.m - C.SORTIE_MONTEE * so), 1 - so)
 202: 
 203:     def couche(self):
 204:         lay = hb._vide(); self.dessiner(lay, 0, final=True)
 205:         return lay
 206: 
 207: 
 208: # ----------------------------------------------------------------- verrou
 209: class Verrou(_Insert):
 210:     """Les recommandations gardees pour le site : une carte fermee par recommandation."""
 211: 
 212:     def taille_nominale(self):
 213:         return C.TEXTE_LARGEUR, C.VERROU_CARTE_H
 214: 
 215:     def __init__(self, *a):
 216:         super().__init__(*a)
 217:         self.n = int(self.spec["n"])
 218:         g = self.px(C.INSERT_ECART_ELEMENTS)
 219:         self.cw = (self.w - (self.n - 1) * g) // self.n
 220:         self.pas = self.cw + g
 221:         self.cartes = [self._carte(i + 1) for i in range(self.n)]
 222:         self.cadenas = self._cadenas()
 223: 
 224:     def _carte(self, numero):
 225:         cw, ch, s, m = self.cw, self.h, self.s, self.m
 226:         im = _cadre(cw, ch, s, marge=m)
 227:         d = ImageDraw.Draw(im)
 228:         g = C.VERROU_GEO
 229:         r = self.px(g["rond"])
 230:         cx, cy = m + self.px(g["rond_marge"]) + r, m + self.px(g["rond_marge"]) + r
 231:         d.ellipse([cx - r, cy - r, cx + r, cy + r], fill=self.rubrique + (255,))
 232:         _ecrire(d, (cx, cy), str(numero), self.px(g["numero_px"]), C.INSERT_GRAISSE_FORTE,
 233:                 C.BLANC + (255,), "mm")
 234:         pad = self.px(g["pad"])
 235:         for k, frac in enumerate(C.VERROU_LIGNES):
 236:             y = m + self.px(g["ligne_y"]) + k * self.px(g["ligne_pas"])
 237:             d.rounded_rectangle([m + pad, y, m + pad + int((cw - 2 * pad) * frac), y + self.px(g["ligne_h"])],
 238:                                 radius=self.px(g["ligne_h"] / 2), fill=C.INSERT_GRIS + (255,))
 239:         return _ombre(im, s)
 240: 
 241:     def _cadenas(self):
 242:         s = self.s
 243:         g = C.VERROU_GEO
 244:         r = self.px(g["pastille"])                       # pastille blanche sous le cadenas
 245:         im = Image.new("RGBA", (2 * r + 8, 2 * r + 8), (0, 0, 0, 0))
 246:         d = ImageDraw.Draw(im)
 247:         c = r + 4
 248:         d.ellipse([c - r, c - r, c + r, c + r], fill=C.BLANC + (255,))
 249:         bw, bh = self.px(g["corps"][0]), self.px(g["corps"][1])
 250:         x0, y0 = c - bw / 2, c - bh / 2 + self.px(g["corps_bas"])
 251:         anse, trait = self.px(g["anse"]), self.px(g["trait"])
 252:         haut_anse = y0 - anse * 0.15                     # centre de l'arc de l'anse
 253:         d.arc([c - anse / 2, haut_anse - anse * 0.7, c + anse / 2, haut_anse + anse * 0.7],
 254:               180, 360, fill=C.NAVY + (255,), width=trait)
 255:         for xa in (c - anse / 2 + trait / 2, c + anse / 2 - trait / 2):   # les branches
 256:             d.line([(xa, haut_anse), (xa, y0 + 2)], fill=C.NAVY + (255,), width=trait)
 257:         d.rounded_rectangle([x0, y0, x0 + bw, y0 + bh], radius=self.px(g["corps_rayon"]),
 258:                             fill=C.NAVY + (255,))
 259:         k = self.px(g["trou"])
 260:         d.ellipse([c - k, y0 + bh * 0.36 - k, c + k, y0 + bh * 0.36 + k], fill=C.BLANC + (255,))
 261:         d.rectangle([c - k / 3, y0 + bh * 0.36, c + k / 3, y0 + bh * 0.72], fill=C.BLANC + (255,))
 262:         return _ombre(im, s)
 263: 
 264:     def _t(self, i):
 265:         return self.t0() + i * C.INSERT_DECALAGE
 266: 
 267:     def image(self, t, final):
 268:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 269:         for i, carte in enumerate(self.cartes):
 270:             u = 1.0 if final else (t - self._t(i)) / C.INSERT_ENTREE
 271:             if u <= 0:
 272:                 continue
 273:             k = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u))
 274:             dy = 0 if final else C.INSERT_MONTEE * self.s * (1 - T.lisse(u))
 275:             cx = self.m + i * self.pas + self.cw / 2
 276:             cy = self.m + self.h / 2 + dy
 277:             _poser(out, carte, cx, cy, k, 1.0 if final else T.lisse(u * C.INSERT_FONDU))
 278:             # le cadenas tremble une fois, quand la carte est posee
 279:             v = 1.0 if final else (t - self._t(i) - C.VERROU_SECOUSSE[1]) / C.VERROU_SECOUSSE[2]
 280:             angle = 0.0 if (final or not 0 < v < 1) else \
 281:                 C.VERROU_SECOUSSE[0] * math.sin(2 * math.pi * 3 * v) * (1 - v)
 282:             _poser(out, self.cadenas, cx, cy + self.h * C.VERROU_GEO["cadenas_y"] * k, k,
 283:                    1.0 if final else T.lisse(u * C.INSERT_FONDU), angle)
 284:         return out
 285: 
 286:     def sons(self):
 287:         return [(self._t(i), "clic") for i in range(self.n)]
 288: 
