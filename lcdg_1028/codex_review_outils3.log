2262: class Icones(_Insert):
2263:     """Des cartes a icone dessinee (repere, lune, casque), qui arrivent l'une apres l'autre ; un
2264:     « ? » se balance au coin de chacune : une question encore ouverte."""
2265: 
2266:     def taille_nominale(self):
2267:         return C.TEXTE_LARGEUR, C.ICONES_H
