3102: class Pilule(_Insert):
3103:     """Une pilule seule (« Aucune rémunération prévue ») qui claque au temps "temps", ton rouge par
3104:     defaut : sous un dessin, elle ne cache rien, la ou un tampon couvrirait ses libelles."""
3105: 
3106:     def _sprite(self, s):
3107:         g = C.PILULE_GEO
3108:         # appele par taille_nominale, avant que _Insert.__init__ ne pose self.rubrique
3109:         return _bulle(self.spec["texte"], max(8, int(g["px"] * s)), max(8, int(g["h"] * s)), int(g["pad"] * s),
3110:                       _ton({"ton": self.spec.get("ton", "rouge")}, tuple(hb._RUBRIQUE)), queue=False)
3111: 
3112:     def taille_nominale(self):
3113:         im = self._sprite(1.0)
3114:         return im.width, im.height
3115: 
3116:     def __init__(self, *a):
3117:         super().__init__(*a)
3118:         self.sprite = _ombre_marge(self._sprite(self.s), self.s)
3119: 
3120:     def image(self, t, final):
3121:         k, a = _frappe(t, self.t0(self.spec.get("temps", 0)), final)
3122:         if a <= 0:
3123:             return None
3124:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
3125:         _poser(out, self.sprite, self.m + self.w / 2, self.m + self.h / 2, k, a, C.PILULE_GEO["angle"])
3126:         return out
3127: 
3128:     def sons(self):
3129:         return [(self.t0(self.spec.get("temps", 0)) + C.TAMPON_FRAPPE, "impact")]
3130: 
3131: 
3132: TYPES = {"verrou": Verrou, "calendrier": Calendrier, "barres": Barres, "choix": Choix,
3133:          "tampon": Tampon, "circuit": Circuit, "duel": Duel, "frise": Frise, "frigo": Frigo,
3134:          "ticket": Ticket, "appel": Appel, "loupe": Loupe, "calcul": Calcul, "ages": Ages,
3135:          "vases": Vases, "pieces": Pieces, "part": Part, "bascule": Bascule, "icones": Icones,
3136:          "prix": Prix, "carte": Carte, "compteur": Compteur, "bouclier": Bouclier,
3137:          "departements": Departements, "ordonnance": Ordonnance, "sablier": Sablier, "pilule": Pilule}
3138: 
3139: 
3140: def inserts(ep, scenes, ouverture=None):
3141:     """Les inserts du reel, un ou plusieurs par bloc qui en porte (scenes : habillage.scenes)."""
3142:     out = []
3143:     for k, bl in enumerate(ep["blocs"]):
3144:         specs = bl.get("insert")
3145:         if not specs:
3146:             continue
3147:         specs = [specs] if isinstance(specs, dict) else specs
3148:         if bl.get("type") in ("phrase", "chiffre") or k == 0:
3149:             raise SystemExit(f"[!] bloc {k} : un insert se pose sur un bloc de texte (pas sur "
3150:                              "l'accroche, une phrase forte ou un chiffre cle).")
3151:         scene = scenes[k]
3152:         hauts = [b[1] for b in (hb._bbox(lay) for _, lay, _ in scene.couches()) if b]
3153:         bas = min(hauts) if hauts else C.BLOC_Y
3154:         if ouverture is not None and ouverture.scene is scene:
3155:             bas = ouverture.pos[1]
3156:         premier, haut = None, bas - C.INSERT_ECART
3157:         for spec in specs:
3158:             # "carre": false le retire de la version carree, plus basse : au bloc 1, la pastille
3159:             # d'ouverture ne laisse pas toujours la place d'un insert (charte.CARRE)
3160:             if spec.get("carre") is False and C.LARGEUR == C.HAUTEUR:
3161:                 continue
3162:             if spec.get("type") not in TYPES:
3163:                 raise SystemExit(f"[!] bloc {k} : insert inconnu « {spec.get('type')} ». "
3164:                                  f"Types : {', '.join(TYPES)}.")
3165:             nom = f"insert bloc {k}" + (f" ({spec['type']})" if len(specs) > 1 else "")
3166:             # "sur": true centre l'element sur le premier insert du bloc (un tampon sur un dessin) ;
3167:             # sinon, chaque element s'empile au-dessus du precedent
3168:             sur = spec.get("sur") and premier is not None
3169:             ins = TYPES[spec["type"]](nom, spec, scene, bas - C.INSERT_ECART if sur else haut)
3170:             if sur:
3171:                 ins.x = premier.x + (premier.w - ins.w) / 2
3172:                 ins.y = premier.y + (premier.h - ins.h) / 2
3173:             else:
3174:                 haut = ins.y - C.INSERT_ECART_ELEMENTS
3175:             premier = premier or ins
3176:             out.append(ins)
3177:     return out
### config/charte.py
   1: """
   2: Charte visuelle et sonore du reel LCDG.
   3: 
   4: Toutes ces valeurs ont ete validees une par une avec Romain.
   5: Ne les modifier qu'a la demande explicite : le gabarit est fige.
   6: """
   7: from pathlib import Path
   8: 
   9: RACINE = Path(__file__).resolve().parent.parent
  10: ASSETS = RACINE / "assets"
  11: POLICE = ASSETS / "fonts" / "Montserrat.ttf"
  12: LOGO_SRC = ASSETS / "logo" / "LOGO_LCDG.png"
  13: AUDIO = ASSETS / "audio"        # musiques (non versionnees : licences)
  14: SFX = ASSETS / "sfx"            # bruitages de motion (non versionnes)
  15: EPISODES = RACINE / "episodes"
  16: 
  17: # ---------------------------------------------------------------- format
  18: LARGEUR, HAUTEUR, FPS = 1080, 1920, 30
  19: 
  20: # Zone sure 4:5. Le fil Instagram et Facebook recadre le reel en 4:5 (1080x1350,
  21: # centre) : tout ce qui doit rester lisible tient dans cette bande. Adoptee le
  22: # 17/09/2026 a la demande de Romain, le logo a 44 px du haut sortait du recadrage.
  23: # Le 9:16 est conserve pour garder le plein ecran dans l'onglet Reels.
  24: ZONE_SURE_HAUT = (HAUTEUR - LARGEUR * 5 // 4) // 2   # 285
  25: ZONE_SURE_BAS = ZONE_SURE_HAUT + LARGEUR * 5 // 4    # 1635
  26: 
  27: # ------------------------------------------------- couleurs (theme.css du site)
  28: PRIMARY = (4, 123, 191)      # --primary        #047bbf
  29: STRONG = (3, 99, 153)        # --primary-strong #036399  (reserve, non utilise au montage)
  30: NAVY = (27, 16, 70)          # --titles         #1b1046
  31: BLANC = (255, 255, 255)
  32: RADIUS = 16                  # --radius .625rem, remis a l'echelle du 1080
  33: 
  34: # Couleur de bandeau par rubrique du site. Le reel prend celle de l'article.
  35: RUBRIQUES = {
  36:     "pro": (4, 123, 191),        # #047bbf  Vie Pro & Metier
  37:     "politique": (79, 70, 229),  # #4f46e5
  38:     "clinique": (5, 150, 105),   # #059669
  39:     "numerique": (124, 58, 237), # #7c3aed
  40:     "patient": (225, 29, 72),    # #e11d48
  41: }
  42: 
  43: # ------------------------------------------------------------- typographie
  44: # Style v2, propose le 01/10/2026 : plus de contour bleu ni de filet blanc, qui
  45: # dataient le rendu. Le texte tient par une ombre douce et le voile sombre ; la
  46: # hierarchie passe par la taille et la graisse, comme les titres du site
