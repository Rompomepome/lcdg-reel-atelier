 559: class Credit:
 560:     """Source d'un plan (champ "credit" du bloc), en petit sous le logo, alignee sur sa
 561:     droite, le temps du plan."""
 562: 
 563:     def __init__(self, texte, debut, fin):
 564:         self.debut, self.fin = debut, fin
 565:         px, g = C.CREDIT_PX, C.CREDIT_GRAISSE
 566:         m = C.HALO_FLOU * 2
 567:         self.ombre, self.glyphes, _ = T.sprite(texte, px, g, 0)
 568:         x = W - C.LOGO_MARGE_X - T.largeur(texte, px, g, 0)
 569:         y = C.LOGO_Y + lockup(C.LOGO_PX).height + C.CREDIT_ECART
 570:         self.pos = (x - m, y - m)
 571: 
 572:     def dessiner(self, lay, t, final=False):
 573:         a = 1.0 if final else min(T.lisse((t - self.debut) / C.CREDIT_FONDU),
 574:                                   T.lisse((self.fin - t) / C.CREDIT_FONDU))
 575:         if a <= 0.003:
 576:             return
 577:         T.coller(lay, self.ombre, self.pos, a * C.CREDIT_ALPHA)
 578:         T.coller(lay, self.glyphes, self.pos, a * C.CREDIT_ALPHA)
 579: 
 580:     def couche(self):
 581:         lay = _vide(); self.dessiner(lay, 0, final=True)
 582:         return lay
