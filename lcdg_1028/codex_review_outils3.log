### scripts/render.py
   1: """
   2: Etape 2 : montage.
   3: 
   4:     python scripts/render.py episodes/2026-08-05-violences-cabinet
   5: 
   6: Normalise les B-rolls, rend l'habillage, puis controle le fichier de sortie par
   7: mesure de pixels. Le reel sort sans piste audio : la musique est posee ensuite, a part.
   8: """
   9: import sys
  10: # la console Windows est en cp1252 par defaut : les accents y provoqueraient une
  11: # UnicodeEncodeError.
  12: if hasattr(sys.stdout, "reconfigure"):
  13:     sys.stdout.reconfigure(encoding="utf-8", errors="replace")
  14: 
  15: import json, shutil, sys, time
  16: from pathlib import Path
  17: sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
  18: try:
  19:     from dotenv import load_dotenv
  20:     load_dotenv(Path(__file__).resolve().parent.parent / ".env")
  21: except ImportError:
  22:     pass
  23: from config import charte as C
  24: from lcdg import binaires as B, montage, controles, son, voix
  25: 
  26: 
  27: def main(dossier: str):
  28:     B.exiger()
  29:     episode = Path(dossier).resolve()
  30:     ep = json.loads((episode / "script.json").read_text(encoding="utf-8"))
  31:     t0 = time.time()
  32: 
  33:     print("\n1/3  normalisation des B-rolls")
  34:     montage.verifier(ep)              # avant d'encoder le moindre plan
  35:     # la voix off fixe la duree de chaque plan : elle passe avant la base
  36:     piste = voix.preparer(episode, ep) if voix.active(ep) else None
  37:     _, bornes, total = montage.base(episode, ep["blocs"])
  38:     print(f"     {len(bornes)} plans, {total:.2f} s")
  39: 
  40:     print("2/3  rendu de l'habillage")
  41:     muet = montage.habiller(episode, ep, bornes, total)
  42:     audio = son.bande(episode, ep, bornes, total, piste)   # voix, musique, bruitages
  43:     sortie = montage.finaliser(muet, episode / f"reel_{ep['slug']}.mp4", audio)
  44:     if piste:                         # voix seule, pour le montage final en musique
  45:         shutil.copy(piste, episode / piste.name)
  46: 
  47:     couv = montage.couverture(sortie)            # avant la coupe : l'accroche est en place
  48:     decalage = 0.0
  49:     if C.ACCROCHE_COUVERTURE:
  50:         decalage = bornes[1][0]
  51:         montage.couper_accroche(sortie, decalage)
  52: 
  53:     print("3/3  controles")
  54:     # sur le fichier livre, apres la coupe ; l'accroche coupee se controle sur la couverture
  55:     conforme = controles.rapport(sortie, ep, bornes, decalage, couv[0])
  56: 
  57:     print(f"\n{sortie}\n" + "\n".join(map(str, couv)) + f"   ({time.time()-t0:.0f} s)")
  58:     sys.exit(0 if conforme else 2)
  59: 
  60: 
  61: if __name__ == "__main__":
  62:     if len(sys.argv) < 2:
  63:         raise SystemExit("usage : python scripts/render.py episodes/<dossier>")
  64:     main(sys.argv[1])
### scripts/render_carre.py
   1: """
   2: Declinaison carree 1080x1080 d'un episode, pour LinkedIn.
   3: 
   4:     python scripts/render_carre.py episodes/2026-09-18-arrets-de-travail
   5: 
   6: Reprend script.json et les B-rolls de l'episode, avec la mise en page de charte.CARRE.
   7: Un plan compose pour le 9:16 (photo posee en bandeau au-dessus du texte) peut avoir sa
   8: version carree dans broll_carre/, sous le meme nom : elle est prise a la place.
   9: Sortie : reel_<slug>_carre.mp4, controlee comme le reel (code retour 2 si non conforme).
  10: """
  11: import sys
  12: # la console Windows est en cp1252 par defaut
  13: if hasattr(sys.stdout, "reconfigure"):
  14:     sys.stdout.reconfigure(encoding="utf-8", errors="replace")
  15: 
  16: import json, os, shutil, time
  17: from pathlib import Path
  18: sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
  19: # avant lcdg.binaires, qui lit FFMPEG_BIN et FFPROBE_BIN a l'import (cf. render.py)
  20: try:
  21:     from dotenv import load_dotenv
  22:     load_dotenv(Path(__file__).resolve().parent.parent / ".env")
  23: except ImportError:
  24:     pass
  25: from config import charte as C
  26: 
  27: # avant tout import de lcdg/habillage : il fige W, H et les positions par defaut a l'import
  28: for cle, valeur in C.CARRE.items():
  29:     setattr(C, cle, valeur)
  30: 
  31: from lcdg import binaires as B, montage, controles, son, voix
  32: 
  33: 
  34: def preparer(episode: Path, ep: dict) -> Path:
  35:     """Dossier de travail carre/ : B-rolls de l'episode, versions carrees prioritaires."""
  36:     travail = episode / "carre"
  37:     (travail / "broll").mkdir(parents=True, exist_ok=True)
  38:     for bl in ep["blocs"]:
  39:         src = episode / "broll_carre" / bl["fichier"]
  40:         if not src.exists():
  41:             src = episode / "broll" / bl["fichier"]
  42:         dst = travail / "broll" / bl["fichier"]
  43:         dst.unlink(missing_ok=True)
  44:         if src.exists():
  45:             try:
  46:                 os.link(src, dst)          # pas de copie de plusieurs centaines de Mo
  47:             except OSError:
  48:                 shutil.copy(src, dst)
  49:     return travail
  50: 
  51: 
  52: def main(dossier: str):
  53:     B.exiger()
  54:     episode = Path(dossier).resolve()
  55:     ep = json.loads((episode / "script.json").read_text(encoding="utf-8"))
  56:     travail = preparer(episode, ep)
  57:     t0 = time.time()
  58: 
  59:     print(f"\n{ep['label']} — carre {C.LARGEUR}x{C.HAUTEUR}")
  60:     print("1/3  normalisation des B-rolls")
  61:     montage.verifier(ep)              # avant d'encoder le moindre plan
  62:     # la voix off fixe la duree de chaque plan : elle passe avant la base
  63:     piste = voix.preparer(episode, ep) if voix.active(ep) else None
  64:     _, bornes, total = montage.base(travail, ep["blocs"])
  65:     print(f"     {len(bornes)} plans, {total:.2f} s")
  66:     print("2/3  rendu de l'habillage")
  67:     muet = montage.habiller(travail, ep, bornes, total)
  68:     audio = son.bande(episode, ep, bornes, total, piste)   # voix, musique, bruitages
  69:     final = montage.finaliser(muet, episode / f"reel_{ep['slug']}_carre.mp4", audio)
  70:     couv = montage.couverture(final)             # avant la coupe : l'accroche est en place
  71:     decalage = 0.0
  72:     if C.ACCROCHE_COUVERTURE:
  73:         decalage = bornes[1][0]
  74:         montage.couper_accroche(final, decalage)
  75:     print("3/3  controles")
  76:     # sur le fichier livre, apres la coupe ; l'accroche coupee se controle sur la couverture
  77:     conforme = controles.rapport(final, ep, bornes, decalage, couv[0])
  78:     print(f"\n{final}\n" + "\n".join(map(str, couv)) + f"   ({time.time()-t0:.0f} s)")
  79:     sys.exit(0 if conforme else 2)
  80: 
  81: 
  82: if __name__ == "__main__":
  83:     if len(sys.argv) < 2:
  84:         raise SystemExit("usage : python scripts/render_carre.py episodes/<dossier>")
  85:     main(sys.argv[1])
### lcdg/voix.py
   1: """
   2: Voix off de synthese (ElevenLabs) : la narration pilote le rythme du reel.
   3: 
   4: Chaque bloc du script porte son texte lu dans le champ "voix". La narration entiere est
   5: generee d'un seul appel, pour garder une prosodie continue ; l'horodatage de chaque
   6: caractere renvoye par l'API sert ensuite a caler chaque plan sur sa phrase, et chaque
   7: temps d'un texte ("|") sur le moment ou la voix le prononce.
   8: 
   9: Les generations sont gardees en cache dans episodes/<dossier>/voix/ : une narration deja
  10: payee n'est jamais regeneree, ni pour la version carree, ni pour un nouveau rendu.
  11: """
  12: import base64
  13: import hashlib
  14: import json
  15: import os
  16: import sys
  17: from pathlib import Path
  18: 
  19: import requests
  20: 
  21: sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
  22: from config import charte as C
  23: from lcdg import binaires as B
  24: 
  25: API = "https://api.elevenlabs.io/v1"
  26: 
  27: 
  28: def _cle() -> str:
  29:     cle = os.environ.get("ELEVENLABS_API_KEY", "").strip()
  30:     if not cle:
  31:         raise SystemExit("[!] ELEVENLABS_API_KEY absente de .env (voir .env.example).")
  32:     return cle
  33: 
  34: 
  35: def corps(texte: str, modele: str | None = None, reglages: dict | None = None) -> dict:
  36:     modele = modele or C.VOIX_MODELE
  37:     if reglages:
  38:         pass                                  # reglages propres a la voix (VOIX_CATALOGUE)
  39:     elif modele.startswith("eleven_v3"):
  40:         # v3 : le jeu passe par les indications entre crochets du texte, pas par les reglages
  41:         reglages = {"stability": C.VOIX_STABILITE, "similarity_boost": C.VOIX_SIMILARITE}
  42:     else:
  43:         reglages = {"stability": C.VOIX_STABILITE, "similarity_boost": C.VOIX_SIMILARITE,
  44:                     "style": C.VOIX_STYLE, "use_speaker_boost": True, "speed": C.VOIX_VITESSE}
  45:     return {"text": texte, "model_id": modele, "voice_settings": reglages}
  46: 
  47: 
  48: def chemins(texte: str, voice_id: str, dossier: Path, modele: str | None = None,
  49:             reglages: dict | None = None) -> tuple[Path, Path]:
  50:     """(mp3, alignement json) de ce texte lu par cette voix, dans le cache."""
  51:     requete = corps(texte, modele, reglages)
  52:     cle = hashlib.sha256(json.dumps([voice_id, requete], sort_keys=True,
  53:                                     ensure_ascii=False).encode("utf-8")).hexdigest()[:16]
  54:     return dossier / f"{cle}.mp3", dossier / f"{cle}.json"
  55: 
  56: 
  57: def synthese(texte: str, voice_id: str, dossier: Path, modele: str | None = None,
  58:              reglages: dict | None = None) -> tuple[Path, dict]:
  59:     """(mp3, alignement par caractere) de la narration, depuis le cache si elle existe."""
  60:     requete = corps(texte, modele, reglages)
  61:     mp3, js = chemins(texte, voice_id, dossier, modele, reglages)
  62:     if mp3.exists() and js.exists():
  63:         return mp3, json.loads(js.read_text(encoding="utf-8"))
  64:     dossier.mkdir(parents=True, exist_ok=True)
  65:     r = requests.post(f"{API}/text-to-speech/{voice_id}/with-timestamps",
  66:                       params={"output_format": "mp3_44100_128"},
  67:                       headers={"xi-api-key": _cle()}, json=requete, timeout=300)
  68:     if not r.ok:
  69:         raise SystemExit(f"[!] ElevenLabs a refuse la generation ({r.status_code}) : {r.text[:300]}")
  70:     reponse = r.json()
  71:     alignement = reponse["alignment"]
  72:     if len(alignement["characters"]) != len(texte):
  73:         raise SystemExit("[!] ElevenLabs : l'horodatage ne correspond pas au texte envoye "
  74:                          f"({len(alignement['characters'])} caracteres pour {len(texte)}).")
  75:     mp3.write_bytes(base64.b64decode(reponse["audio_base64"]))
  76:     js.write_text(json.dumps(alignement, ensure_ascii=False), encoding="utf-8")
  77:     return mp3, alignement
  78: 
  79: 
  80: def choix(ep: dict) -> dict:
  81:     """Voix du reel : "voix_off" est une cle de charte.VOIX_CATALOGUE ou un dict
  82:     (id, modele, reglages) ; a defaut, la voix par defaut de la charte."""
  83:     v = ep.get("voix_off") or {}
  84:     if isinstance(v, str):
  85:         if v not in C.VOIX_CATALOGUE:
  86:             raise SystemExit(f"[!] voix_off inconnue : « {v} ». Voix validees : "
  87:                              + ", ".join(C.VOIX_CATALOGUE))
  88:         if not C.VOIX_CATALOGUE[v].get("id"):
  89:             raise SystemExit(f"[!] voix_off « {v} » : {C.VOIX_CATALOGUE[v]['nom']} n'est pas "
  90:                              "encore enregistree dans l'espace ElevenLabs.")
  91:         v = C.VOIX_CATALOGUE[v]
  92:     return v
  93: 
  94: 
  95: def active(ep: dict) -> bool:
  96:     """Le reel a une voix des qu'un bloc porte un texte lu."""
  97:     return any((bl.get("voix") or "").strip() for bl in ep["blocs"])
  98: 
  99: 
 100: def _decouper(texte: str) -> tuple[str, list[int]]:
 101:     """Texte lu sans les '|', et position du debut de chaque temps apres le premier."""
 102:     propre, debuts = "", []
 103:     for i, morceau in enumerate(texte.split("|")):
 104:         morceau = morceau.strip()
 105:         if i:
 106:             propre += " "
 107:             debuts.append(len(propre))
 108:         propre += morceau
 109:     return propre, debuts
 110: 
 111: 
 112: def textes(ep: dict) -> tuple[bool, list[tuple[str, list[int]]]]:
 113:     """(bloc 0 muet, [(texte lu, debut de chaque temps)] des blocs parlants).
 114: 
 115:     Accroche en couverture : le bloc 0 n'a pas de voix, la narration commence au bloc 1.
 116:     La narration envoyee a ElevenLabs est ces textes joints par une espace."""
 117:     blocs = ep["blocs"]
 118:     muet = C.ACCROCHE_COUVERTURE and not (blocs[0].get("voix") or "").strip()
 119:     parlants = blocs[1:] if muet else blocs
 120:     return muet, [_decouper((bl.get("voix") or "").strip()) for bl in parlants]
 121: 
 122: 
 123: def preparer(episode: Path, ep: dict) -> Path:
 124:     """Genere (ou reprend) la narration et cale le reel dessus.
 125: 
 126:     Fixe en memoire la duree de chaque bloc (une coupe juste avant chaque phrase) et
 127:     les instants de ses temps ("temps", relatifs au debut du bloc). Retourne la piste
 128:     voix (wav 48 kHz) calee sur la video et mise au niveau de la charte."""
 129:     blocs = ep["blocs"]
 130:     muet, morceaux = textes(ep)
 131:     if C.ACCROCHE_COUVERTURE and not muet:
 132:         print("[i] bloc 0 : sa voix est coupee avec l'accroche, qui ne sert qu'a la couverture. "
 133:               "Dans un nouveau script, ne mets pas de voix au bloc 0 : elle consomme le quota "
 134:               "pour rien.")
 135:     vides = [k + muet for k, (t, _) in enumerate(morceaux) if not t]
 136:     if vides:
 137:         raise SystemExit(f"[!] Bloc(s) sans texte lu (champ voix) : {vides}")
 138:     texte = " ".join(t for t, _ in morceaux)
 139:     v = choix(ep)
 140:     mp3, al = synthese(texte, v.get("id") or C.VOIX_ID, episode / "voix",
 141:                        v.get("modele"), v.get("reglages"))
 142:     modele = v.get("modele") or C.VOIX_MODELE
 143:     tempo = C.VOIX_TEMPO_V3 if modele.startswith("eleven_v3") else 1.0
 144:     deb = [x / tempo for x in al["character_start_times_seconds"]]
 145:     fin = [x / tempo for x in al["character_end_times_seconds"]]
 146: 
 147:     d0 = C.VOIX_DEBUT + (C.ACCROCHE_COUVERTURE_DUREE if muet else 0.0)
 148:     pos, phrases = 0, []
 149:     for t, debuts in morceaux:
 150:         phrases.append((d0 + deb[pos], d0 + fin[pos + len(t) - 1],
 151:                         [d0 + deb[pos + i] for i in debuts]))
 152:         pos += len(t) + 1
 153:     coupes = ([0.0, C.ACCROCHE_COUVERTURE_DUREE] if muet else [0.0])
 154:     coupes += [max(0.0, a - C.VOIX_AVANCE) for a, _, _ in phrases[1:]]
 155:     coupes.append(phrases[-1][1] + C.VOIX_TENUE)
 156:     if muet:
 157:         phrases.insert(0, (0.0, 0.0, []))
 158:     for k, bl in enumerate(blocs):
 159:         bl["duree"] = round(coupes[k + 1] - coupes[k], 3)
 160:         bl["temps"] = [round(t - C.VOIX_AVANCE - coupes[k], 3) for t in phrases[k][2]]
 161: 
 162:     wav = episode / "voix" / f"voix_{ep['slug']}.wav"
 163:     # correction propre a la voix (charte.VOIX_CATALOGUE) : filtres fixes ("traitement") et
 164:     # anti-resonance mesuree sur cette narration ("anti_resonance"), avant tout le reste
 165:     corrections = [v["traitement"]] if v.get("traitement") else []
 166:     if v.get("anti_resonance"):
 167:         from lcdg import resonance
 168:         corrections.append(resonance.filtres(mp3))
 169:     traitement = "".join(f"{c}," for c in corrections if c)
 170:     B.run(["-i", str(mp3), "-af",
 171:            f"{traitement}atempo={tempo},adelay={int(d0 * 1000)}:all=1,"
 172:            f"loudnorm=I={C.VOIX_LUFS}:TP={C.VOIX_TP_CIBLE}:LRA=11,aresample=48000",
 173:            "-ar", "48000", "-ac", "2", str(wav), "-y"])
 174:     return wav
### lcdg/montage.py
   1: """Montage : normalisation des B-rolls, rendu de l'habillage, sortie sans piste audio."""
   2: import json
   3: import subprocess
   4: import sys
   5: from pathlib import Path
   6: 
   7: from PIL import Image
   8: 
   9: sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
  10: from config import charte as C
  11: from lcdg import binaires as B
  12: from lcdg import habillage as hb
  13: from lcdg import inserts as ins
  14: 
  15: 
  16: # ------------------------------------------------------------------ 1. base
  17: def _source(src: Path) -> tuple[float, float]:
  18:     """(images par seconde, duree en s) de la piste video d'un plan."""
  19:     B.exiger()
  20:     r = subprocess.run([B.FFPROBE, "-v", "error", "-select_streams", "v:0",
  21:                         "-show_entries", "stream=avg_frame_rate,r_frame_rate,duration",
  22:                         "-show_entries", "format=duration", "-of", "json", str(src)],
  23:                        capture_output=True, text=True)
  24:     if r.returncode:
  25:         raise SystemExit(f"[!] ffprobe ne lit pas {src} :\n{r.stderr[-400:]}")
  26:     infos = json.loads(r.stdout)
  27:     pistes = infos.get("streams") or []
  28:     if not pistes:
  29:         raise SystemExit(f"[!] {src} n'a pas de piste video.")
  30:     piste = pistes[0]
  31:     cadence = 0.0
  32:     for champ in ("avg_frame_rate", "r_frame_rate"):
  33:         n, _, d = (piste.get(champ) or "0/0").partition("/")
  34:         if float(n or 0) > 0 and float(d or 1) > 0:
  35:             cadence = float(n) / float(d or 1)
  36:             break
  37:     duree = float(piste.get("duration") or infos.get("format", {}).get("duration") or 0)
  38:     if cadence <= 0 or duree <= 0:
  39:         raise SystemExit(f"[!] {src} : cadence ou duree illisible.")
  40:     return cadence, duree
  41: 
  42: 
  43: def base(episode: Path, blocs: list[dict]) -> tuple[Path, list, float]:
  44:     """Concatene les B-rolls recadres en 1080x1920, avec un zoom lent."""
  45:     seg_dir = episode / "segments"
  46:     seg_dir.mkdir(parents=True, exist_ok=True)
  47:     parts, bornes, t = [], [], 0.0
  48: 
  49:     for i, bl in enumerate(blocs):
  50:         src = episode / "broll" / bl["fichier"]
  51:         if not src.exists():
  52:             raise SystemExit(f"[!] B-roll manquant : {src}")
  53:         duree = bl["duree"] + (C.CROIX_DUREE + C.OUTRO_DUREE if i == len(blocs) - 1 else 0)
  54:         out = seg_dir / f"s{i}.mp4"
  55:         # a la coupe, l'image se pose (recul de p0 a 1 en n0 images), puis le zoom lent
  56:         # reprend jusqu'a BROLL_ZOOM : l'entree du reel livre arrive en zoom et floue, une
  57:         # phrase forte d'un coup de zoom, les autres plans d'une impulsion legere
  58:         entree = i == (1 if C.ACCROCHE_COUVERTURE and len(blocs) > 1 else -1)
  59:         if entree:
  60:             n0, p0 = C.OUVERTURE_IMAGES, C.OUVERTURE_ZOOM
  61:         elif bl.get("type") == "phrase":
  62:             n0, p0 = C.PHRASE_IMAGES, C.PHRASE_ZOOM
  63:         else:
  64:             n0, p0 = C.IMPULSION_IMAGES, C.IMPULSION
  65:         z = (f"if(lt(in,{n0}),{p0}-{p0 - 1:.4f}*(1-pow(1-in/{n0},3)),"
  66:              f"min(1+{(C.BROLL_ZOOM-1)/170:.6f}*(in-{n0}),{C.BROLL_ZOOM}))")
  67:         # zoompan emet une image par image source : si le plan n'en a pas assez pour
  68:         # couvrir le bloc, on les duplique avant (sinon le plan sort court, et l'image
  69:         # prend de l'avance sur la voix pour tout le reste du reel)
  70:         cadence_src, duree_src = _source(src)
  71:         dispo = duree_src - C.BROLL_MARGE_S
  72:         besoin = duree * C.FPS + C.BROLL_IMAGES_MARGE
  73:         if dispo <= 0:
  74:             raise SystemExit(f"[!] Plan {i} ({bl['fichier']}) : {duree_src:.2f} s, plus court "
  75:                              f"que la marge d'entree ({C.BROLL_MARGE_S} s).")
  76:         reechantillonnage = ""
  77:         if dispo * cadence_src < besoin:
  78:             taux = besoin / dispo
  79:             reechantillonnage = f"fps=fps={taux:.4f},"
  80:             vitesse = C.FPS / taux
  81:             if vitesse < C.BROLL_VITESSE_MIN:
  82:                 print(f"[!] plan {i} ({bl['fichier']}) : {dispo:.1f} s utiles pour un bloc de "
  83:                       f"{duree:.1f} s, lu a {vitesse:.2f}x : le ralenti se verra, un plan plus "
  84:                       "long serait mieux.")
  85:         cadre = (f"scale={C.LARGEUR}:{C.HAUTEUR}:force_original_aspect_ratio=increase,"
  86:                  f"crop={C.LARGEUR}:{C.HAUTEUR},")
  87:         if bl.get("cadrage") == "largeur":
  88:             # plan entier en pleine largeur, sur son propre fond floute et assombri
  89:             source = (f"[0:v]split[pl][fd];[fd]{cadre}"
  90:                       f"boxblur=luma_radius={C.PLAN_LARGEUR_FLOU}:luma_power=2:"
  91:                       f"chroma_radius={C.PLAN_LARGEUR_FLOU // 2}:chroma_power=2,"
  92:                       f"eq=brightness={C.PLAN_LARGEUR_LUMIERE}[fond];"
  93:                       f"[pl]scale={C.LARGEUR}:-2[plan];"
  94:                       f"[fond][plan]overlay=0:{C.PLAN_LARGEUR_Y}[cadre];[cadre]")
  95:         else:
  96:             source = f"[0:v]{cadre}"
  97:         vf = (f"{reechantillonnage}zoompan=z='{z}':d=1:"
  98:               f"x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)':"
  99:               f"s={C.LARGEUR}x{C.HAUTEUR}:fps={C.FPS},"
 100:               f"{C.ETALONNAGE},"
 101:               f"tpad=stop_mode=clone:stop_duration=3,setsar=1,format=yuv420p")
 102:         if bl.get("type") in hb.TYPES_FLOUS:
 103:             # flou de profondeur : une copie floutee se fond par-dessus a l'entree du bloc
 104:             # et s'efface avec la sortie du texte (le dernier bloc deborde sur la croix)
 105:             fin = bl["duree"] + (C.BLOC_RESIDU if i == len(blocs) - 1 else 0)
 106:             r = C.FLOU_RAYON
 107:             filtre = ["-filter_complex",
 108:                       f"{source}{vf},split[net][f0];"
 109:                       f"[f0]boxblur=luma_radius={r}:luma_power=2:"
 110:                       f"chroma_radius={r // 2}:chroma_power=2,format=yuva420p,"
 111:                       f"fade=t=in:st=0:d={C.FLOU_ENTREE}:alpha=1,"
 112:                       f"fade=t=out:st={max(0.0, fin - C.SORTIE_DUREE):.3f}:"
 113:                       f"d={C.SORTIE_DUREE}:alpha=1[flou];"
 114:                       f"[net][flou]overlay=format=auto,format=yuv420p[v]",
 115:                       "-map", "[v]"]
 116:         elif entree:
 117:             r = C.OUVERTURE_FLOU
 118:             filtre = ["-filter_complex",
 119:                       f"{source}{vf},split[net][f0];"
 120:                       f"[f0]boxblur=luma_radius={r}:luma_power=1:"
 121:                       f"chroma_radius={r // 2}:chroma_power=1,format=yuva420p,"
 122:                       f"fade=t=out:st=0:d={C.OUVERTURE_NET}:alpha=1[flou];"
 123:                       f"[net][flou]overlay=format=auto,format=yuv420p[v]",
 124:                       "-map", "[v]"]
 125:         else:
 126:             filtre = ["-filter_complex", f"{source}{vf}[v]", "-map", "[v]"]
 127:         B.run(["-ss", str(C.BROLL_MARGE_S), "-i", str(src), "-t", f"{duree:.3f}",
 128:                "-an", *filtre, "-r", str(C.FPS), "-c:v", "libx264",
 129:                "-preset", "veryfast", "-crf", "18", str(out), "-y"])
 130:         d = B.duree(out)
 131:         if d < duree - C.BROLL_TOLERANCE_IMAGES / C.FPS:
 132:             # les bornes suivent le plan, la voix suit son horodatage : ils se decaleraient
 133:             raise SystemExit(f"[!] Plan {i} ({bl['fichier']}) : {d:.2f} s au lieu de "
 134:                              f"{duree:.2f} s. L'image prendrait de l'avance sur la voix.")
 135:         bornes.append((round(t, 3), round(t + d, 3)))
 136:         t += d
 137:         parts.append(out)
 138: 
 139:     liste = episode / "concat.txt"
 140:     liste.write_text("\n".join(f"file '{p.as_posix()}'" for p in parts), encoding="utf-8")
 141:     sortie = episode / "base.mp4"
 142:     B.run(["-f", "concat", "-safe", "0", "-i", str(liste), "-c", "copy", str(sortie), "-y"])
 143:     return sortie, bornes, round(t, 3)
 144: 
 145: 
 146: # --------------------------------------------------------------- 2. habillage
 147: def bornes_nominales(ep: dict) -> list:
 148:     """Bornes des plans selon les durees du script (les vraies sortent de base())."""
 149:     t, bornes = 0.0, []
 150:     for bl in ep["blocs"]:
 151:         bornes.append((round(t, 3), round(t + bl["duree"], 3)))
 152:         t += bl["duree"]
 153:     return bornes
 154: 
 155: 
 156: def verifier(ep: dict, bornes: list | None = None):
 157:     """Un texte trop long sortirait du recadrage 4:5 du fil ou de sa colonne : on le
 158:     verifie avant tout encodage. La mise en page ne depend pas des durees reelles, les
 159:     bornes du script suffisent quand base() n'a pas encore tourne."""
 160:     # chaque temps de l'ecran a sa phrase lue : sinon le texte et la voix se decalent
 161:     for k, bl in enumerate(ep["blocs"][1:], 1):
 162:         lu = (bl.get("voix") or "").strip()
 163:         if not lu:
 164:             continue
 165:         if bl.get("type") == "chiffre":
 166:             if "|" in lu:
 167:                 raise SystemExit(f"[!] bloc {k} : la voix d'un chiffre cle n'a qu'un temps, "
 168:                                  "retire ses « | ».")
 169:         elif lu.count("|") != (bl.get("texte") or "").count("|"):
 170:             raise SystemExit(f"[!] bloc {k} : {lu.count('|')} « | » dans la voix, "
 171:                              f"{(bl.get('texte') or '').count('|')} a l'ecran. Chaque temps de "
 172:                              "l'ecran doit avoir sa phrase lue, dans le meme ordre.")
 173:     bornes = bornes or bornes_nominales(ep)
 174:     croix = bornes[-1][0] + ep["blocs"][-1]["duree"]
 175:     hb.rubrique(ep.get("rubrique"))
 176:     carte = hb.CarteFinale(croix + C.CROIX_DUREE, ep.get("appel"))
 177:     if carte.lignes_appel > 1:
 178:         raise SystemExit(f"[!] Appel a l'action trop long pour une ligne : "
 179:                          f"« {carte.texte_appel} ». Raccourcis le champ appel de script.json.")
 180:     couches = [("logo", hb.watermark(), C.LARGEUR), ("carte finale", carte.couche(), C.LARGEUR)]
 181:     for sc in hb.scenes(ep, bornes, croix):
 182:         couches += sc.couches()
 183:     couches += [("credit", cr.couche(), C.LARGEUR) for cr in hb.credits(ep, bornes)]
 184:     les_scenes = hb.scenes(ep, bornes, croix)
 185:     ouv = hb.ouverture(ep, les_scenes)
 186:     if ouv:
 187:         couches.append(("pastille d'ouverture", ouv.couche(), hb.COLONNE))
 188:     couches += [(i.nom, i.couche(), hb.COLONNE) for i in ins.inserts(ep, les_scenes, ouv)]
 189:     if ep.get("bandeau"):
 190:         # le bandeau s'arrete avant le logo, qui garde sa place
 191:         logo_gauche = hb.watermark().getchannel("A").getbbox()[0]
 192:         couches.append(("bandeau", hb.Bandeau(ep["bandeau"], 0, 1).couche(),
 193:                         logo_gauche - C.BANDEAU_ECART_LOGO))
 194:     zones = [(nom, hb.hors_zone(lay, droite)) for nom, lay, droite in couches]
 195:     debords = [f"    {nom} : y {z[0]}-{z[1]}, x jusqu'a {z[2]}" for nom, z in zones if z]
 196:     if debords:
 197:         raise SystemExit(
 198:             f"[!] Hors de la zone sure 4:5 (y {C.ZONE_SURE_HAUT}-{C.ZONE_SURE_BAS}) "
 199:             f"ou de la colonne de texte (x <= {hb.COLONNE}) :\n"
 200:             + "\n".join(debords) + "\n    Raccourcis le texte ou le surlignage dans script.json.")
 201: 
 202: 
 203: def habiller(episode: Path, ep: dict, bornes: list, total: float) -> Path:
 204:     """Compose l'habillage image par image et l'incruste sur la base."""
 205:     n = int(round(total * C.FPS))
 206:     croix = total - (C.CROIX_DUREE + C.OUTRO_DUREE)
 207:     plein = croix + C.CROIX_DUREE
 208: 
 209:     verifier(ep, bornes)
 210:     statique = Image.new("RGBA", (C.LARGEUR, C.HAUTEUR), (0, 0, 0, 0))
 211:     statique.alpha_composite(hb.scrim())
 212:     logo = hb.watermark()
 213:     scenes = hb.scenes(ep, bornes, croix)
 214:     carte = hb.CarteFinale(plein, ep.get("appel"))
 215:     # ni pendant l'accroche, ni sur la carte finale
 216:     # le bandeau laisse l'entree du reel livre a la pastille du sujet : il arrive au plan
 217:     # suivant
 218:     debut_bandeau = bornes[2][0] if C.ACCROCHE_COUVERTURE and len(bornes) > 2 else bornes[1][0]
 219:     bandeau = (hb.Bandeau(ep["bandeau"], debut_bandeau, croix, scenes)
 220:                if ep.get("bandeau") else None)
 221:     ouverture = hb.ouverture(ep, scenes)
 222:     les_inserts = ins.inserts(ep, scenes, ouverture)
 223:     credits = hb.credits(ep, bornes)
 224: 
 225:     sortie = episode / "reel_muet.mp4"
 226:     proc = subprocess.Popen(
 227:         [B.FFMPEG, "-v", "error", "-i", str(episode / "base.mp4"),
 228:          "-f", "rawvideo", "-pix_fmt", "rgba",
 229:          "-s", f"{C.LARGEUR}x{C.HAUTEUR}", "-r", str(C.FPS), "-i", "-",
 230:          "-filter_complex", "[0:v][1:v]overlay=format=auto:shortest=1[v]",
 231:          "-map", "[v]", "-c:v", "libx264", "-preset", "medium", "-crf", "19",
 232:          "-pix_fmt", "yuv420p", "-movflags", "+faststart", str(sortie), "-y"],
 233:         stdin=subprocess.PIPE)
 234: 
 235:     for i in range(n):
 236:         t = i / C.FPS
 237:         lay = statique.copy()
 238:         actives = [sc for sc in scenes if sc.debut <= t < sc.fin]
 239:         for sc in actives:              # le voile passe sous le logo, qui garde sa lumiere
 240:             sc.voiler(lay, t)
 241:         lay.alpha_composite(logo)
 242:         for cr in credits:
 243:             if cr.debut <= t < cr.fin:
 244:                 cr.dessiner(lay, t)
 245:         if bandeau and bandeau.debut <= t < bandeau.fin:
 246:             bandeau.dessiner(lay, t)
 247:         for sc in actives:
 248:             sc.dessiner(lay, t)
 249:         for i in les_inserts:
 250:             if i.debut <= t < i.fin:
 251:                 i.dessiner(lay, t)
 252:         if ouverture and ouverture.debut <= t < ouverture.fin:
 253:             ouverture.dessiner(lay, t)
 254:         if t >= croix:
 255:             lay.alpha_composite(hb.cross_wipe((t - croix) / C.CROIX_DUREE))
 256:         if t >= plein:
 257:             carte.dessiner(lay, t)
 258:         try:
 259:             proc.stdin.write(lay.tobytes())
 260:         except (BrokenPipeError, OSError) as e:
 261:             proc.stdin.close(); proc.wait()
 262:             raise RuntimeError(
 263:                 f"ffmpeg s'est arrete pendant le rendu (image {i}/{n}) : {e}\n"
 264:                 "Verifie l'espace disque et que base.mp4 est lisible.") from e
 265: 
 266:     proc.stdin.close()
 267:     if proc.wait() != 0:
 268:         raise RuntimeError("ffmpeg a echoue pendant l'incrustation de l'habillage.")
 269:     return sortie
 270: 
 271: 
 272: # ------------------------------------------------------------------ 3. sortie
 273: def finaliser(muet: Path, sortie: Path, voix: Path | None = None) -> Path:
 274:     """Pose la bande son (voix, musique, bruitages : lcdg/son.py) sur l'habillage.
 275:     Sans bande son, le reel sort muet."""
 276:     sortie.unlink(missing_ok=True)
 277:     if voix is None:
 278:         muet.replace(sortie)
 279:         return sortie
 280:     # la voix s'arrete avant la carte finale : du silence la prolonge jusqu'au bout
 281:     B.run(["-i", str(muet), "-i", str(voix), "-map", "0:v", "-map", "1:a",
 282:            "-c:v", "copy", "-af", "apad", "-c:a", "aac", "-b:a", "192k", "-ar", "48000",
 283:            "-shortest", "-movflags", "+faststart", str(sortie), "-y"])
 284:     muet.unlink(missing_ok=True)
 285:     return sortie
 286: 
 287: 
 288: def couverture(video: Path) -> list[Path]:
 289:     """Images de couverture, prises quand l'accroche est en place : couverture_<slug>.jpg
 290:     a cote du reel et, pour un reel 9:16, sa version 4:5 (zone sure du fil)."""
 291:     dest = video.with_name(video.stem.replace("reel_", "couverture_", 1) + ".jpg")
 292:     B.run(["-ss", str(C.COUVERTURE_T), "-i", str(video), "-frames:v", "1",
 293:            "-q:v", "2", str(dest), "-y"])
 294:     out = [dest]
 295:     if C.HAUTEUR > C.LARGEUR:
 296:         quatre_cinq = dest.with_name(dest.stem + "_4x5.jpg")
 297:         B.run(["-i", str(dest), "-vf", f"crop={C.LARGEUR}:{C.ZONE_SURE_BAS - C.ZONE_SURE_HAUT}:"
 298:                f"0:{C.ZONE_SURE_HAUT}", "-q:v", "2", str(quatre_cinq), "-y"])
 299:         out.append(quatre_cinq)
 300:     return out
 301: 
 302: 
 303: def couper_accroche(video: Path, debut: float) -> Path:
 304:     """Retire l'accroche (servie en couverture) : le reel livre commence au bloc 1."""
 305:     tmp = video.with_name(video.stem + "_coupe.mp4")
 306:     B.run(["-ss", f"{debut:.4f}", "-i", str(video), "-c:v", "libx264", "-crf", "17",
 307:            "-preset", "slow", "-pix_fmt", "yuv420p", "-af", f"afade=t=in:st=0:d={C.COUPE_FONDU}",
 308:            "-c:a", "aac", "-b:a", "192k", "-ar", "48000", "-movflags", "+faststart",
 309:            str(tmp), "-y"])
 310:     tmp.replace(video)
 311:     return video
### lcdg/inserts.py
   1: """
   2: Inserts animes : de petites illustrations posees au-dessus du texte d'un bloc, pour faire
   3: comprendre l'information d'un coup d'oeil (Romain, 05/10/2026 : « les inserts et les
   4: illustrations en plus, ca aide a la comprehension »).
   5: 
   6: Champ "insert" d'un bloc de texte (pas d'une phrase forte ni d'un chiffre cle) :
   7: 
   8:   {"type": "verrou", "n": 3}
   9:       les recommandations de l'article, en cartes fermees d'un cadenas (dernier bloc)
  10:   {"type": "calendrier", "annee": 2026, "mois": 10, "du": 12, "au": 18, "legende": "mi-octobre"}
  11:       le mois, la periode surlignee (sur une meme semaine), une etiquette
  12:   {"type": "barres", "unite": "×", "lignes": [{"label": "Sans désogestrel", "valeur": 1}, ...]}
  13:       des barres qui poussent ; une valeur de 1 en tete sert de reference (grise). "unite"
  14:       se place avant le nombre (×1,7), "suffixe" apres (50 €) ; "reference": true grise une
  15:       ligne
  16:   {"type": "choix", "lignes": [{"label": "En pharmacie", "ok": true}, ...]}
  17:       une liste coche / croix ; sans "ok", un « ? » : une question encore ouverte
  18:   {"type": "tampon", "texte": "Export interdit"}
  19:       un tampon qui claque
  20:   {"type": "circuit", "lignes": [{"titre": "Dose injectée", "etapes": ["−11,75 €", "+11,75 €"],
  21:                                   "fin": "remboursée", "ok": true}, ...]}
  22:       un flux par ligne : des pilules reliees par des fleches qui se tracent, une issue
  23:       verte (ok) ou rouge ; une etape qui commence par « − » s'ecrit en rouge, « + » en vert
  24:   {"type": "duel", "cartes": [{"date": "14 oct.", "texte": "Contrôler 650 médecins", "ok": false},
  25:                               {"date": "20 oct.", "texte": "Les aider : SOS IJ", "ok": true}]}
  26:       deux cartes datees face a face, puis un « ≠ » qui claque entre elles ; sans "ok", une
  27:       carte prend la couleur de la rubrique (deux options : « Accepter » / « Refuser »)
  28:   {"type": "frise", "etapes": [{"label": "Vos chiffres notifiés"}, ..., {"label": "...", "alerte": true}]}
  29:       une procedure, de haut en bas : le trait descend de noeud en noeud ; une etape
  30:       "alerte" en rouge
  31: 
  32: Illustrations (Romain, 23/10/2026 : « ça doit être interactif et ultra ludique ») :
  33: 
  34:   {"type": "frigo", "mode": "remplir", "doses": 6, "prix": 1, "etiquette": ["Payées d'abord", "par vous"]}
  35:       les boites de vaccin tombent dans le refrigerateur ; au temps "prix", une piece « € » se
  36:       pose sur chacune et l'etiquette claque sur la porte
  37:   {"type": "frigo", "mode": "releve", "titre": "Température enregistrée"}
  38:       le refrigerateur plein et la courbe de temperature qui s'enregistre entre +2 et +8 °C
  39:       (conservation des vaccins grippe) ; l'ecran affiche la valeur du moment
  40:   {"type": "ticket", "titre": "Votre facturation", "lignes": [{"label": "Injection",
  41:                                                                "valeur": "pas à part", "ok": false}, ...]}
  42:       un ticket qui s'imprime ligne par ligne, coche ou croix a gauche, valeur a droite
  43:   {"type": "appel", "etapes": [{"icone": "telephone", "label": "Appel de votre CPAM", "note": "en principe"},
  44:                                {"icone": "courrier", "label": "Puis le courrier"}]}
  45:       un telephone qui sonne, une fleche, puis le courrier qui arrive en vol
  46:   {"type": "loupe", "site": "ameli.fr", "recherche": "mise sous objectifs", "vide": "Aucun résultat"}
  47:       la recherche se tape, la loupe balaie la page, rien ne sort
  48:   {"type": "calcul", "titre": "...", "temps_question": 1,
  49:    "parts": [{"label": "...", "valeur": 0.68}, {"label": "...", "valeur": 0.32, "question": true}]}
  50:       une barre qui se remplit ; la part "question" se detache, un « ? » au-dessus. Les parts
  51:       sont une illustration : aucun chiffre ne s'affiche. "ton": "rouge", "vert" ou "bleu"
  52:       colore une part et son libelle (trois regimes selon l'age, par exemple)
  53: 
  54:   {"type": "ages", "titre": "...", "ordre": [2, 1, 0], "zones": [{"label": "Avant l'âge légal",
  55:                                                                 "bulle": "Réduite dès le 1er €", "ton": "rouge"}, ...]}
  56:       une regle en zones colorees ; un curseur va de zone en zone, une bulle dit ce qui s'y passe
  57:   {"type": "vases", "titre": "1 € gagné, 1 € de pension en moins", "gauche": "...", "droite": "...",
  58:    "ajout": {"label": "IJ", "temps": 1}}
  59:       deux bocaux communicants : l'un monte, l'autre baisse d'autant ; une piece tombe ensuite
  60:   {"type": "pieces", "titre": "Au-delà du seuil", "gauche": "...", "droite": "...", "temps": 1}
  61:       deux piles de pieces : deux s'empilent a gauche, une s'envole a droite, compteurs
  62:   {"type": "part", "pastille": "...", "part": 20, "centre": "au plus", "legende_part": "...",
  63:    "legende_reste": "...", "temps_part": 1}
  64:       un anneau d'activite qui se remplit, la part plafonnee se detache, son pourcentage au centre
  65:   {"type": "bascule", "avant": {"haut": "Sept. 2026", "jour": "30", "bas": "..."}, "apres": {...},
  66:    "legende_avant": "...", "legende_apres": "...", "pilule": "Nouvelles règles", "temps": 1}
  67:       un ephemeride dont la page se plie pour montrer la suivante ; une pilule claque
  68:   {"type": "icones", "cartes": [{"icone": "repere" | "lune" | "casque" | "poubelle" | "bon" | "enfant",
  69:                                  "label": "...", "temps": 1}, ...]}
  70:       des cartes a icone dessinee, un « ? » qui se balance au coin de chacune
  71:   {"type": "prix", "boites": [{"nom": "Vaxigrip", "prix": "11,75 €"}, {..., "ton": "rouge"}],
  72:    "pastille": "plus du double"}
  73:       des boites de vaccin dessinees, une etiquette de prix tombe sur chacune, une pastille claque
  74: 
  75: Reels docteurs juniors et acces direct aux IPA (28/10/2026) :
  76: 
  77:   {"type": "carte", "titulaire": "Docteur junior", "ok": true, "temps": 1}
  78:       une carte CPS au nom du titulaire glisse dans le lecteur ; l'ecran repond coche ou croix
  79:       (refusee, la carte tremble)
  80:   {"type": "compteur", "titre": "Cartes CPS délivrées", "date": "au 28 octobre", "pilule": "...", "temps": 1}
  81:       des rouleaux de chiffres qui defilent puis s'arretent sur « ? » ; aucun nombre ne reste
  82:   {"type": "bouclier", "temps": 1, "pilules": [{"texte": "...", "ton": "rouge", "temps": 1}, ...]}
  83:       un bouclier sur une silhouette, dont le contour passe en pointilles avec un « ? » ; les
  84:       pilules du texte a droite
  85:   {"type": "departements", "liste": [{"numero": "34", "nom": "Hérault"}, ...]}
  86:       des tuiles de departement qui se retournent l'une apres l'autre
  87:   {"type": "ordonnance", "titre": "Ordonnance", "marque": "IPA", "lignes": [{"label": "...", "note": "...",
  88:    "temps": 1}], "pied": "...", "temps_pied": 2}
  89:       une ordonnance qui s'ecrit au stylo, ligne par ligne, une pilule rouge au pied
  90:   {"type": "sablier", "pilules": [...]}
  91:       un sablier qui coule et se retourne sans fin, un « ? » ; les pilules du texte a droite
  92:   {"type": "pilule", "texte": "Aucune rémunération prévue", "temps": 1}
  93:       une pilule seule qui claque, sous un dessin : elle ne cache pas ses libelles
  94:   "appel" accepte aussi l'icone "infirmier", et un "temps" par etape ; "icones" accepte les icones
  95:   "compte_rendu", "concertation", "patient", et par carte "question": false (une tache, pas une
  96:   question ouverte) ou "temps_question"
  97: 
  98: Le champ "insert" peut aussi etre une liste : les elements s'empilent dans l'ordre, et
  99: "sur": true centre un element sur le premier (un tampon qui claque sur un dessin).
 100: 
 101: Un element (ligne, barre, tampon) peut porter "temps" : il arrive avec le temps du texte
 102: de ce numero (0 = debut du bloc, 1 = apres le premier "|"...). "carre": false dans l'insert
 103: le retire de la version carree, quand il n'y tient pas (bloc 1, sous la pastille d'ouverture). L'insert se cale en bas sur
 104: le haut du texte (et de la pastille d'ouverture), en haut sur INSERT_HAUT_MIN, a gauche sur
 105: la colonne de texte ; il retrecit s'il le faut. Il sort avec le texte du bloc.
 106: Toutes les valeurs viennent de config/charte.py — ne rien coder en dur ici.
