2412: # ---------------------------------------------------------------- prix
2413: class Prix(_Insert):
2414:     """Des boites de vaccin dessinees ; une etiquette de prix tombe sur chacune, au temps de sa
2415:     boite, se balance, puis une pastille (« plus du double ») claque au-dessus de la derniere."""
2416: 
2417:     def taille_nominale(self):
2418:         return C.TEXTE_LARGEUR, C.PRIX_H
2419: 
2420:     def __init__(self, *a):
2421:         super().__init__(*a)
2422:         g = C.PRIX_GEO
2423:         self.items = self.spec["boites"]
2424:         n = len(self.items)
2425:         self.boites = [_ombre_marge(self._boite(b["nom"]), self.s) for b in self.items]
2426:         self.etiquettes = [_ombre_marge(_etiquette([b["prix"]], self.px(g["etiquette_px"]),
2427:                                                    self.px(g["etiquette_pad"][0]), self.px(g["etiquette_pad"][1]),
2428:                                                    _ton(b, self.rubrique)), self.s) for b in self.items]
2429:         self.pastille = (_ombre_marge(_bulle(self.spec["pastille"], self.px(g["pastille_px"]), self.px(g["pastille_h"]),
2430:                                              self.px(g["pastille_pad"]), C.INSERT_ROUGE, queue=False), self.s)
2431:                          if self.spec.get("pastille") else None)
2432:         self.bw, self.bh = self.px(g["boite"][0]), self.px(g["boite"][1])
2433:         # l'etiquette deborde a droite de sa boite : les centres se resserrent d'autant, pour que la
2434:         # derniere reste dans la colonne
2435:         deborde = max(0.0, self.bw * g["etiquette_x"] + (self.etiquettes[-1].width - 2 * self.m) / 2
2436:                       - self.bw / 2)
2437:         utile = self.w - deborde
2438:         self.cx = [self.m + utile * (i + 0.5) / n for i in range(n)]
2439:         self.haut = self.m + self.h - self.px(g["sol"]) - self.bh            # haut des boites
2440: 
2441:     def _boite(self, nom):
2442:         g = C.PRIX_GEO
2443:         w, h, bande = self.px(g["boite"][0]), self.px(g["boite"][1]), self.px(g["bande"])
2444:         ra, tr = self.px(g["rayon"]), max(1, self.px(g["trait"]))
2445:         rub, navy = tuple(self.rubrique) + (255,), C.NAVY + (255,)
2446: 
2447:         def dessin(d, k):
2448:             W, H, B, Q = w * k, h * k, bande * k, ra * k
2449:             d.rounded_rectangle([0, 0, W - 1, H - 1], radius=Q, fill=C.BLANC + (255,))
2450:             d.rounded_rectangle([0, 0, W - 1, B + Q], radius=Q, fill=rub)
2451:             d.rectangle([0, B, W - 1, B + Q], fill=C.BLANC + (255,))
2452:             cx, cy = W * 0.5, B + (H - B) * 0.55                # une seringue preremplie
2453:             L, e = W * 0.42, (H - B) * 0.2
2454:             d.rounded_rectangle([cx - L / 2, cy - e / 2, cx + L / 2, cy + e / 2], radius=e * 0.3,
2455:                                 fill=_teinte(self.rubrique, 0.75) + (255,), outline=navy, width=int(tr * k))
2456:             d.rectangle([cx - L / 2 - L * 0.24, cy - e * 0.12, cx - L / 2, cy + e * 0.12], fill=navy)
2457:             d.rectangle([cx - L / 2 - L * 0.28, cy - e * 0.55, cx - L / 2 - L * 0.22, cy + e * 0.55], fill=navy)
2458:             d.rectangle([cx + L / 2, cy - e * 0.08, cx + L / 2 + L * 0.3, cy + e * 0.08], fill=navy)
2459:             for i in range(1, 5):
2460:                 x = cx - L / 2 + L * i / 5
2461:                 d.line([(x, cy - e / 2), (x, cy - e * 0.05)], fill=navy, width=int(tr * k))
2462:         im = _net(w, h, dessin)
2463:         _ecrire(ImageDraw.Draw(im), (w / 2, bande / 2), nom, self.px(g["nom_px"]), C.INSERT_GRAISSE_FORTE,
2464:                 C.BLANC + (255,), "mm")
2465:         return im
2466: 
2467:     def _t_boite(self, i):
2468:         """Entree de la boite i : avec le temps du texte de son "temps" (celui de l'insert par
2469:         defaut), les boites d'un meme temps a la suite."""
2470:         defaut = self.spec.get("temps", 0)
2471:         tps = self.items[i].get("temps", defaut)
2472:         avant = [j for j in range(i) if self.items[j].get("temps", defaut) == tps]
2473:         return self.t0(tps) + len(avant) * C.INSERT_DECALAGE
2474: 
2475:     def _t(self, i):
2476:         """Chute de l'etiquette i, apres l'entree de sa boite ; les etiquettes d'un meme temps a
2477:         la suite."""
2478:         g = C.PRIX_GEO
2479:         defaut = self.spec.get("temps", 0)
2480:         tps = self.items[i].get("temps", defaut)
2481:         avant = [j for j in range(i) if self.items[j].get("temps", defaut) == tps]
2482:         return self.t0(tps) + C.INSERT_ENTREE * 0.5 + len(avant) * g["decalage"]
2483: 
2484:     def _t_pastille(self):
2485:         g = C.PRIX_GEO
2486:         return max(self._t(i) for i in range(len(self.items))) + g["chute"] + g["pastille_delai"]
2487: 
2488:     def image(self, t, final):
2489:         g = C.PRIX_GEO
2490:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
2491:         for i, boite in enumerate(self.boites):
2492:             k, a = _entree(t, self._t_boite(i), final)
2493:             if a <= 0:
2494:                 continue
2495:             _poser(out, boite, self.cx[i], self.haut + self.bh / 2, k, a)
2496:             u = 1.0 if final else (t - self._t(i)) / g["chute"]
2497:             if u <= 0:
2498:                 continue
2499:             dy = 0.0 if u >= 1 else -self.px(g["chute_haut"]) * (1 - u * u)
2500:             angle = g["etiquette_angle"]
2501:             if not final and u >= 1:                      # elle se balance, puis se pose
2502:                 amp, freq, amorti = g["balance"]
2503:                 tau = t - self._t(i) - g["chute"]
2504:                 angle += amp * math.sin(2 * math.pi * freq * tau) * math.exp(-amorti * tau)
2505:             ex = self.cx[i] + self.bw * g["etiquette_x"]
2506:             _poser(out, self.etiquettes[i], ex, self.haut + self.bh * g["etiquette_y"] + dy, 1.0,
2507:                    1.0 if final else min(1.0, u * 3), angle)
2508:         if self.pastille is not None:
2509:             v = 1.0 if final else (t - self._t_pastille()) / C.TAMPON_FRAPPE
2510:             if v > 0:
2511:                 kk = 1.0 if final or v >= 1 else C.TAMPON_ECHELLE - (C.TAMPON_ECHELLE - 1) * v * v
2512:                 _poser(out, self.pastille, self.cx[-1], self.haut - self.px(g["pastille_dy"]), kk,
2513:                        1.0 if final else min(1.0, v * 2), 4)
2514:         return out
2515: 
2516:     def sons(self):
2517:         g = C.PRIX_GEO
2518:         out = [(self._t(i) + g["chute"], "clic") for i in range(len(self.items))]
2519:         if self.pastille is not None:
2520:             out.append((self._t_pastille() + C.TAMPON_FRAPPE, "impact"))
2521:         return out
2522: 
2523: 
2524: def _coller_coupe(fond, im, x, y):
2525:     """Compose im en (x, y), meme en partie hors de fond (la partie qui deborde est coupee)."""
2526:     x, y = int(round(x)), int(round(y))
2527:     g, h = max(0, -x), max(0, -y)
2528:     d, b = min(im.width, fond.width - x), min(im.height, fond.height - y)
2529:     if d > g and b > h:
2530:         fond.alpha_composite(im.crop((g, h, d, b)), (x + g, y + h))
2531: 
2532: 
2533: def _frappe(t, t0, final):
2534:     """(echelle, opacite) d'un element qui claque comme un tampon a t0."""
2535:     v = 1.0 if final else (t - t0) / C.TAMPON_FRAPPE
2536:     if v <= 0:
2537:         return 0.0, 0.0
2538:     return (1.0 if final or v >= 1 else C.TAMPON_ECHELLE - (C.TAMPON_ECHELLE - 1) * v * v,
2539:             1.0 if final else min(1.0, v * 2))
2540: 
