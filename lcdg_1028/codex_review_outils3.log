2289:                 for x0, hh in ((0.08, 0.2), (0.62, 0.24)):
2290:                     x, y = S * x0, S * 0.94
2291:                     dd.rectangle([x, y - S * hh, x + S * 0.3, y], fill=gris)
2292:                     dd.polygon([(x - S * 0.03, y - S * hh), (x + S * 0.15, y - S * (hh + 0.13)),
2293:                                 (x + S * 0.33, y - S * hh)], fill=gris)
2294:                 cx, cy, r = S / 2, S * 0.36, S * 0.24
2295:                 dd.polygon([(cx - r * 0.86, cy + r * 0.5), (cx, S * 0.86), (cx + r * 0.86, cy + r * 0.5)], fill=rub)
2296:                 dd.ellipse([cx - r, cy - r, cx + r, cy + r], fill=rub)
2297:                 dd.ellipse([cx - r * 0.42, cy - r * 0.42, cx + r * 0.42, cy + r * 0.42], fill=C.BLANC + (255,))
2298:             elif nom == "lune":                           # la nuit : lune et etoiles
