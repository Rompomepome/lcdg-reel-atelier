 156: def verifier(ep: dict, bornes: list | None = None):
 157:     """Un texte trop long sortirait du recadrage 4:5 du fil ou de sa colonne : on le
 158:     verifie avant tout encodage. La mise en page ne depend pas des durees reelles, les
 159:     bornes du script suffisent quand base() n'a pas encore tourne."""
 160:     # chaque temps de l'ecran a sa phrase lue : sinon le texte et la voix se decalent
 161:     for k, bl in enumerate(ep["blocs"][1:], 1):
 162:         lu = (bl.get("voix") or "").strip()
 163:         if not lu:
 164:             continue
 165:         if bl.get("type") == "chiffre":
 166:             if "|" in lu:
 167:                 raise SystemExit(f"[!] bloc {k} : la voix d'un chiffre cle n'a qu'un temps, "
 168:                                  "retire ses « | ».")
 169:         elif lu.count("|") != (bl.get("texte") or "").count("|"):
 170:             raise SystemExit(f"[!] bloc {k} : {lu.count('|')} « | » dans la voix, "
 171:                              f"{(bl.get('texte') or '').count('|')} a l'ecran. Chaque temps de "
 172:                              "l'ecran doit avoir sa phrase lue, dans le meme ordre.")
 173:     bornes = bornes or bornes_nominales(ep)
 174:     croix = bornes[-1][0] + ep["blocs"][-1]["duree"]
 175:     hb.rubrique(ep.get("rubrique"))
 176:     carte = hb.CarteFinale(croix + C.CROIX_DUREE, ep.get("appel"))
 177:     if carte.lignes_appel > 1:
 178:         raise SystemExit(f"[!] Appel a l'action trop long pour une ligne : "
 179:                          f"« {carte.texte_appel} ». Raccourcis le champ appel de script.json.")
 180:     couches = [("logo", hb.watermark(), C.LARGEUR), ("carte finale", carte.couche(), C.LARGEUR)]
 181:     for sc in hb.scenes(ep, bornes, croix):
 182:         couches += sc.couches()
 183:     couches += [("credit", cr.couche(), C.LARGEUR) for cr in hb.credits(ep, bornes)]
 184:     les_scenes = hb.scenes(ep, bornes, croix)
 185:     ouv = hb.ouverture(ep, les_scenes)
 186:     if ouv:
 187:         couches.append(("pastille d'ouverture", ouv.couche(), hb.COLONNE))
 188:     couches += [(i.nom, i.couche(), hb.COLONNE) for i in ins.inserts(ep, les_scenes, ouv)]
 189:     if ep.get("bandeau"):
 190:         # le bandeau s'arrete avant le logo, qui garde sa place
 288: def couverture(video: Path) -> list[Path]:
 289:     """Images de couverture, prises quand l'accroche est en place : couverture_<slug>.jpg
 290:     a cote du reel et, pour un reel 9:16, sa version 4:5 (zone sure du fil)."""
 291:     dest = video.with_name(video.stem.replace("reel_", "couverture_", 1) + ".jpg")
 292:     B.run(["-ss", str(C.COUVERTURE_T), "-i", str(video), "-frames:v", "1",
 293:            "-q:v", "2", str(dest), "-y"])
 294:     out = [dest]
 295:     if C.HAUTEUR > C.LARGEUR:
 296:         quatre_cinq = dest.with_name(dest.stem + "_4x5.jpg")
 297:         B.run(["-i", str(dest), "-vf", f"crop={C.LARGEUR}:{C.ZONE_SURE_BAS - C.ZONE_SURE_HAUT}:"
 298:                f"0:{C.ZONE_SURE_HAUT}", "-q:v", "2", str(quatre_cinq), "-y"])
 299:         out.append(quatre_cinq)
 300:     return out
 301: 
 302: 
 303: def couper_accroche(video: Path, debut: float) -> Path:
 304:     """Retire l'accroche (servie en couverture) : le reel livre commence au bloc 1."""
 305:     tmp = video.with_name(video.stem + "_coupe.mp4")
 306:     B.run(["-ss", f"{debut:.4f}", "-i", str(video), "-c:v", "libx264", "-crf", "17",
 307:            "-preset", "slow", "-pix_fmt", "yuv420p", "-af", f"afade=t=in:st=0:d={C.COUPE_FONDU}",
 308:            "-c:a", "aac", "-b:a", "192k", "-ar", "48000", "-movflags", "+faststart",
 309:            str(tmp), "-y"])
 310:     tmp.replace(video)
 311:     return video
  90: 
  91: 
  92: def bande(episode: Path, ep: dict, bornes: list, total: float, voix: Path | None) -> Path | None:
  93:     """Mixe voix, musique (sous la voix) et bruitages en une piste stereo 48 kHz au niveau
  94:     de la charte. None si le reel n'a ni voix ni musique."""
  95:     # Gain fixe partout : une normalisation dynamique (loudnorm) au milieu du graphe
  96:     # remonte les fondus et decale la piste qu'elle traite (02/10/2026, la musique
  97:     # disparaissait 2,7 s avant la fin du reel).
  98:     fond = musique(ep)
  99:     if voix is None and fond is None:
 100:         return None
 101:     travail = episode / "voix"
 102:     travail.mkdir(parents=True, exist_ok=True)
 103:     sfx = effets(ep, bornes, total, travail / "effets.wav")
 104:     entrees, graphe, mix = [], [], []
 105:     if voix is not None:
 106:         entrees += ["-i", str(voix)]
 107:         graphe.append(f"[{len(entrees) // 2 - 1}:a]apad,atrim=0:{total:.3f},asplit=2[voix][cle]")
 108:         mix.append("[voix]")
 109:     if fond is not None:
 110:         entrees += ["-i", str(fond)]
 111:         k = len(entrees) // 2 - 1
 112:         extrait = f"aresample={SR},atrim=0:{total:.3f},asetpts=N/SR/TB"
 113:         gain = C.MUSIQUE_LUFS - sonie(fond, extrait)
 114:         graphe.append(f"[{k}:a]{extrait},volume={gain:.2f}dB,"
 115:                       f"afade=t=in:st=0:d={C.MUSIQUE_FONDU_IN},"
 116:                       f"afade=t=out:st={max(0.0, total - C.MUSIQUE_FONDU_OUT):.3f}:"
 117:                       f"d={C.MUSIQUE_FONDU_OUT}[fond]")
 118:         if voix is not None:
 119:             # la musique s'efface quand la voix parle
 120:             graphe.append(f"[fond][cle]sidechaincompress={C.MUSIQUE_DUCKING}[fond_d]")
 121:             mix.append("[fond_d]")
 122:         else:
 123:             mix.append("[fond]")
 124:     elif voix is not None:
 125:         graphe[-1] = graphe[-1].replace(",asplit=2[voix][cle]", "[voix]")
 126:     if sfx is not None:
 127:         entrees += ["-i", str(sfx)]
 128:         graphe.append(f"[{len(entrees) // 2 - 1}:a]apad,atrim=0:{total:.3f}[sfx]")
 129:         mix.append("[sfx]")
 130:     graphe.append("".join(mix) + f"amix=inputs={len(mix)}:duration=longest:normalize=0[a]")
 131:     brute = travail / f"bande_{ep['slug']}_brute.wav"
 132:     B.run([*entrees, "-filter_complex", ";".join(graphe), "-map", "[a]",
 133:            "-ar", str(SR), "-ac", "2", "-t", f"{total:.3f}", str(brute), "-y"])
 134:     # mise au niveau final : un gain fixe, puis le limiteur pour les cretes
 135:     gain = C.SON_LUFS - sonie(brute)
 136:     dest = travail / f"bande_{ep['slug']}.wav"
 137:     B.run(["-i", str(brute), "-af",
 138:            f"volume={gain:.2f}dB,alimiter=limit={10 ** (C.SON_TP_CIBLE / 20):.3f}:level=false,"
 139:            f"aresample={SR}", "-ar", str(SR), "-ac", "2", str(dest), "-y"])
 140:     brute.unlink(missing_ok=True)
 141:     return dest

