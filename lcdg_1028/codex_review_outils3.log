 869: # ---------------------------------------------------- illustrations : outils
 870: def _net(w, h, dessiner):
 871:     """Forme sans escalier : tracee a INSERT_SURECHANTILLON fois sa taille, puis reduite.
 872:     dessiner(d, k) recoit le pinceau et le facteur k, a appliquer a toutes les longueurs."""
 873:     k = C.INSERT_SURECHANTILLON
 874:     w, h = max(1, int(round(w))), max(1, int(round(h)))
 875:     grand = Image.new("RGBA", (w * k, h * k), (0, 0, 0, 0))
 876:     dessiner(ImageDraw.Draw(grand), k)
 877:     return grand.resize((w, h), Image.LANCZOS)
 878: 
 879: 
 880: def _teinte(couleur, p):
 881:     """La couleur eclaircie vers le blanc (p = 1 : blanc)."""
 882:     return tuple(int(round(c + (255 - c) * p)) for c in couleur)
 883: 
 884: 
 885: def _ombre_marge(im, s):
 886:     """im entoure de la marge que demande son ombre, puis ombre (le centre ne bouge pas)."""
 887:     m = int(C.INSERT_OMBRE[0] * C.INSERT_MARGE_OMBRE * s) + 4
 888:     out = Image.new("RGBA", (im.width + 2 * m, im.height + 2 * m), (0, 0, 0, 0))
 889:     out.alpha_composite(im, (m, m))
 890:     return _ombre(out, s)
 891: 
 892: 
 893: def _icone_choix(ok, diametre, trait, rubrique):
 894:     """Rond a coche (ok), a croix (non), ou « ? » a la couleur de la rubrique (ok absent : une
 895:     question encore ouverte)."""
 896:     r = diametre / 2
 897:     n = int(2 * r) + 4
 898:     im = Image.new("RGBA", (n, n), (0, 0, 0, 0))
 899:     d = ImageDraw.Draw(im)
 900:     c = n / 2
 901:     fond = rubrique if ok is None else C.INSERT_VERT if ok else C.INSERT_ROUGE
 902:     d.ellipse([c - r, c - r, c + r, c + r], fill=tuple(fond) + (255,))
 903:     if ok is None:
 904:         _ecrire(d, (c, c), "?", int(r * C.CHOIX_GEO["question"]), C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
 905:     elif ok:
 906:         d.line([(c - r * 0.45, c + r * 0.02), (c - r * 0.1, c + r * 0.36), (c + r * 0.48, c - r * 0.3)],
 907:                fill=C.BLANC + (255,), width=trait, joint="curve")
 908:     else:
 909:         k = r * 0.38
 910:         d.line([(c - k, c - k), (c + k, c + k)], fill=C.BLANC + (255,), width=trait)
 911:         d.line([(c - k, c + k), (c + k, c - k)], fill=C.BLANC + (255,), width=trait)
 912:     return im
 913: 
 914: 
 915: def _pointilles(im, periode, plein):
 916:     """Garde un trait sur deux le long de diagonales : un contour devient pointille."""
 917:     masque = Image.new("L", im.size, 0)
 918:     d = ImageDraw.Draw(masque)
 919:     for x in range(-im.height, im.width, periode):
 920:         d.polygon([(x, 0), (x + plein, 0), (x + plein + im.height, im.height), (x + im.height, im.height)], fill=255)
 921:     out = im.copy()
 922:     out.putalpha(ImageChops.multiply(im.getchannel("A"), masque))
 923:     return out
 924: 
 925: 
 926: def _etiquette(lignes, px, padx, pady, couleur=C.INSERT_ROUGE):
 927:     """Etiquette de prix (pointe et trou a gauche), texte blanc ; ni rotation ni ombre."""
 928:     lignes = [T.normaliser(l) for l in lignes]
 929:     lh = px * 1.18
 930:     h = len(lignes) * lh + 2 * pady
 931:     pointe = h * 0.42
 932:     w = max(T.largeur(l, px, C.INSERT_GRAISSE_FORTE, 0) for l in lignes) + 2 * padx + pointe
 933: 
 934:     def dessin(d, k):
 935:         W, H, P = w * k, h * k, pointe * k
 936:         fond = tuple(couleur) + (255,)
 937:         d.rounded_rectangle([P * 0.6, 0, W, H], radius=H * 0.16, fill=fond)
 938:         d.polygon([(P + 1, 0), (0, H / 2), (P + 1, H)], fill=fond)
 939:         r = H * 0.085
 940:         d.ellipse([P * 0.5 - r, H / 2 - r, P * 0.5 + r, H / 2 + r], fill=(0, 0, 0, 0))
 941:     im = _net(w, h, dessin)
 942:     d = ImageDraw.Draw(im)
 943:     for i, l in enumerate(lignes):
 944:         _ecrire(d, (pointe + (w - pointe) / 2, pady + lh * (i + 0.5)), l, px, C.INSERT_GRAISSE_FORTE,
 945:                 C.BLANC + (255,), "mm")
 946:     return im
 947: 
 948: 
 949: # -------------------------------------------------------------- frigo
 950: class Frigo(_Insert):
 951:     """L'enceinte refrigeree du cabinet.
 952:     Mode "remplir" : les boites de vaccin tombent sur les etageres ; au temps "prix", une piece
 953:     « € » se pose sur chacune, puis une etiquette claque sur la porte (« Payées d'abord »).
 954:     Mode "releve" : le refrigerateur plein et, a cote, la courbe de temperature qui s'enregistre
 955:     dans la plage de conservation ; l'ecran du refrigerateur affiche la valeur du moment."""
 956: 
 957:     def _releve(self):
 958:         return self.spec.get("mode") == "releve"
 959: 
 960:     def _hauteur_frigo(self):
 961:         return C.FRIGO_RELEVE_H if self._releve() else C.FRIGO_H
 962: 
 963:     def _etiquette(self, s):
 964:         """L'etiquette de prix, deja tournee (sans ombre)."""
 965:         g = C.FRIGO_GEO
 966:         im = _etiquette(self.spec.get("etiquette", []), max(8, int(round(g["etiquette_px"] * s))),
 967:                         g["etiquette_pad"][0] * s, g["etiquette_pad"][1] * s)
 968:         return im.rotate(-g["etiquette_angle"], resample=Image.BICUBIC, expand=True)
 969: 
 970:     def taille_nominale(self):
 971:         fh = self._hauteur_frigo()
 972:         fw = C.FRIGO_W * fh / C.FRIGO_H
 973:         if self._releve():
 974:             return C.TEXTE_LARGEUR, fh
 975:         ew = self._etiquette(1.0).width if self.spec.get("etiquette") else 0
 976:         return int(fw + max(0, ew - C.FRIGO_GEO["chevauche"])), fh
 977: 
 978:     def __init__(self, *a):
 979:         super().__init__(*a)
 980:         g = C.FRIGO_GEO
 981:         self.f = self.s * self._hauteur_frigo() / C.FRIGO_H        # echelle de la geometrie FRIGO_GEO
 982:         self.fh = int(round(self._hauteur_frigo() * self.s))
 983:         self.fw = int(round(C.FRIGO_W * self.f))
 984:         q = self.f
 985:         pan, vm, pied = g["panneau"] * q, g["vitre_marge"] * q, g["pied"][1] * q
 986:         self.vitre = (vm, pan + vm, self.fw - 2 * vm - g["poignee"][0] * q, self.fh - pied - vm)
 987:         x0, y0, x1, y1 = self.vitre
 988:         bw, bh = g["boite"][0] * q, g["boite"][1] * q
 989:         ecart = g["boite_ecart"] * q
 990:         rang = (y1 - y0) / 2
 991:         self.places = []                                         # coin haut-gauche de chaque boite
 992:         for r in range(2):
 993:             base = y0 + rang * (r + 1) - g["etagere"] * q
 994:             larg = 3 * bw + 2 * ecart
 995:             for c in range(3):
 996:                 self.places.append((x0 + (x1 - x0 - larg) / 2 + c * (bw + ecart), base - bh))
 997:         self.n = min(len(self.places), int(self.spec.get("doses", len(self.places))))
 998:         self.boite = self._boite(bw, bh)
 999:         self.mf = int(C.INSERT_OMBRE[0] * C.INSERT_MARGE_OMBRE * self.s) + 4     # marge d'ombre
1000:         corps = self._corps(plein=self._releve())
1001:         self.fond_frigo = _ombre_marge(corps, self.s)
1002:         self.masque_vitre = Image.new("L", corps.size, 0)
1003:         ImageDraw.Draw(self.masque_vitre).rounded_rectangle([x0, y0, x1, y1], radius=g["rayon"] * q * 0.5,
1004:                                                              fill=255)
1005:         if self._releve():
1006:             self._init_courbe()
1007:         else:
1008:             p = max(8, int(round(g["piece"] * q)))
1009:             self.piece = _net(p, p, lambda d, k: d.ellipse([0, 0, p * k - 1, p * k - 1],
1010:                                                            fill=C.INSERT_ROUGE + (255,)))
1011:             _ecrire(ImageDraw.Draw(self.piece), (p / 2, p / 2), "€", max(6, int(round(g["piece_px"] * q))),
1012:                     C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
1013:             self.etiquette = _ombre_marge(self._etiquette(self.s), self.s) if self.spec.get("etiquette") else None
1014: 
1015:     # -- dessin du refrigerateur
1016:     def _boite(self, bw, bh):
1017:         q = self.f
1018: 
1019:         def dessin(d, k):
1020:             W, H = bw * k, bh * k
1021:             d.rounded_rectangle([0, 0, W - 1, H - 1], radius=6 * q * k, fill=C.BLANC + (255,),
1022:                                 outline=C.INSERT_GRIS + (255,), width=max(1, int(2 * q * k)))
1023:             d.rounded_rectangle([0, 0, W - 1, H * 0.3], radius=6 * q * k, fill=tuple(self.rubrique) + (255,))
1024:             d.rectangle([0, H * 0.18, W - 1, H * 0.3], fill=tuple(self.rubrique) + (255,))
1025:             for i, frac in enumerate((0.7, 0.45)):
1026:                 y = H * (0.48 + i * 0.16)
1027:                 d.rounded_rectangle([W * 0.16, y, W * (0.16 + frac * 0.7), y + H * 0.07], radius=H * 0.035,
1028:                                     fill=C.INSERT_GRIS + (255,))
1029:         return _net(bw, bh, dessin)
1030: 
1031:     def _corps(self, plein):
1032:         g, q = C.FRIGO_GEO, self.f
1033:         w, h = self.fw, self.fh
1034:         x0, y0, x1, y1 = self.vitre
1035: 
1036:         def dessin(d, k):
1037:             W, H, Q = w * k, h * k, q * k
1038:             pw, ph = g["pied"][0] * Q, g["pied"][1] * Q
1039:             for x in (W * 0.2, W * 0.8):
1040:                 d.rounded_rectangle([x - pw / 2, H - ph - 8 * Q, x + pw / 2, H - 1], radius=4 * Q,
1041:                                     fill=C.INSERT_GRIS_TEXTE + (255,))
1042:             r = g["rayon"] * Q
1043:             d.rounded_rectangle([0, 0, W - 1, H - ph], radius=r, fill=C.BLANC + (255,))
1044:             pan = g["panneau"] * Q
1045:             d.rounded_rectangle([0, 0, W - 1, pan + r], radius=r, fill=C.NAVY + (255,))
1046:             d.rectangle([0, pan, W - 1, pan + r], fill=C.BLANC + (255,))
1047:             ew, eh = g["ecran"][0] * Q, g["ecran"][1] * Q
1048:             d.rounded_rectangle([(W - ew) / 2, (pan - eh) / 2, (W + ew) / 2, (pan + eh) / 2], radius=eh * 0.25,
1049:                                 fill=(8, 5, 26, 255))
1050:             led = 5 * Q
1051:             d.ellipse([r * 0.7 - led, pan / 2 - led, r * 0.7 + led, pan / 2 + led], fill=C.INSERT_VERT + (255,))
1052:             d.ellipse([W - r * 0.7 - led, pan / 2 - led, W - r * 0.7 + led, pan / 2 + led],
1053:                       fill=_teinte(C.NAVY, 0.45) + (255,))
1054:             vx0, vy0, vx1, vy1 = x0 * k, y0 * k, x1 * k, y1 * k
1055:             d.rounded_rectangle([vx0, vy0, vx1, vy1], radius=r * 0.5, fill=_teinte(self.rubrique, 0.86) + (255,))
1056:             lw = vx1 - vx0
1057:             d.polygon([(vx0 + lw * 0.58, vy0), (vx0 + lw * 0.78, vy0), (vx0 + lw * 0.38, vy1), (vx0 + lw * 0.18, vy1)],
1058:                       fill=_teinte(self.rubrique, 0.93) + (255,))
1059:             rang = (vy1 - vy0) / 2
1060:             for i in range(2):
1061:                 y = vy0 + rang * (i + 1) - g["etagere"] * Q
1062:                 d.rectangle([vx0, y, vx1, y + g["etagere"] * Q], fill=_teinte(self.rubrique, 0.6) + (255,))
1063:             gw, gh = g["poignee"][0] * Q, g["poignee"][1] * Q
1064:             gx = vx1 + (W - vx1 - gw) / 2
1065:             d.rounded_rectangle([gx, H * 0.36, gx + gw, H * 0.36 + gh], radius=gw / 2,
1066:                                 fill=C.INSERT_GRIS + (255,))
1067:         im = _net(w, h, dessin)
1068:         if plein:
1069:             for i in range(self.n):
1070:                 im.alpha_composite(self.boite, (int(round(self.places[i][0])), int(round(self.places[i][1]))))
1071:         if not self._releve():
1072:             self._ecran(im, self.spec.get("ecran", "+5 °C"))
1073:         return im
1074: 
1075:     def _ecran(self, im, texte):
1076:         g, q = C.FRIGO_GEO, self.f
1077:         _ecrire(ImageDraw.Draw(im), (self.fw / 2, g["panneau"] * q / 2), texte, max(6, int(round(g["ecran_px"] * q))),
1078:                 C.INSERT_GRAISSE_FORTE, _teinte(C.INSERT_VERT, 0.35) + (255,), "mm")
1079: 
1080:     # -- mode « remplir »
1081:     def _t_boite(self, i):
1082:         return self.t0(self.spec.get("temps", 0)) + C.INSERT_ENTREE * 0.6 + i * C.FRIGO_DECALAGE
1083: 
1084:     def _t_piece(self, i):
1085:         return self.t0(self.spec.get("prix", 1)) + i * C.FRIGO_PIECE_DECALAGE
1086: 
1087:     def _t_etiquette(self):
1088:         return self._t_piece(self.n - 1) + C.INSERT_ENTREE * 0.6
1089: 
1090:     def _remplir(self, frigo, t, final):
1091:         g, q = C.FRIGO_GEO, self.f
1092:         couche = Image.new("RGBA", self.masque_vitre.size, (0, 0, 0, 0))
1093:         for i in range(self.n):
1094:             v = 1.0 if final else (t - self._t_boite(i)) / C.INSERT_ENTREE
1095:             if v <= 0:
1096:                 continue
1097:             x, y = self.places[i]
1098:             if v < 1:                                   # la boite tombe, en accelerant
1099:                 y -= g["chute"] * q * (1 - v * v)
1100:             else:                                       # puis rebondit a peine sur l'etagere
1101:                 w2 = 1.0 if final else (t - self._t_boite(i) - C.INSERT_ENTREE) / C.INSERT_ENTREE
1102:                 if w2 < 1:
1103:                     y -= 6 * q * math.sin(math.pi * w2) * (1 - w2)
1104:             T.coller(couche, self.boite, (x, y), min(1.0, v * 4))
1105:         couche.putalpha(ImageChops.multiply(couche.getchannel("A"), self.masque_vitre))
1106:         frigo.alpha_composite(couche, (self.mf, self.mf))
1107:         for i in range(self.n):
1108:             v = 1.0 if final else (t - self._t_piece(i)) / C.INSERT_ENTREE
1109:             if v <= 0:
1110:                 continue
1111:             x, y = self.places[i]
1112:             kk = 0.3 + 0.7 * (1.0 if final else T.rebond(v))
1113:             _poser(frigo, self.piece, self.mf + x + self.boite.width * 0.82, self.mf + y + self.boite.height * 0.12,
1114:                    kk, 1.0 if final else T.lisse(v * C.INSERT_FONDU))
1115: 
1116:     # -- mode « releve »
1117:     @staticmethod
1118:     def _temperature(x):
1119:         """Courbe de demonstration, toujours dans la plage (3,4 a 6,6 °C)."""
1120:         return (5.0 + 0.9 * math.sin(2 * math.pi * (1.3 * x + 0.1)) + 0.45 * math.sin(2 * math.pi * (3.7 * x + 0.3))
1121:                 + 0.2 * math.sin(2 * math.pi * 7.1 * x))
1122: 
1123:     def _init_courbe(self):
1124:         g = C.FRIGO_COURBE
1125:         self.cx0 = self.fw + self.px(g["ecart"])                 # gauche de la carte, dans la boite
1126:         cw, ch = self.w - self.cx0, self.h
1127:         pad = self.px(g["pad"])
1128:         carte = _cadre(cw, ch, self.s, marge=self.m)
1129:         d = ImageDraw.Draw(carte)
1130:         m = self.m
1131:         _ecrire(d, (m + pad, m + pad), self.spec.get("titre", "Température enregistrée"), self.px(g["titre_px"]),
1132:                 C.INSERT_GRAISSE_FORTE, C.NAVY + (255,))
1133:         axe = self.px(g["axe_px"])
1134:         lab_w = T.largeur("+8 °C", axe, C.INSERT_GRAISSE_TEXTE, 0) + pad * 0.6
1135:         self.zone = (m + pad + lab_w, m + pad + self.px(g["titre_px"]) * 1.9, m + cw - pad, m + ch - pad)
1136:         zx0, zy0, zx1, zy1 = self.zone
1137:         lo, hi = g["plage"]
1138:         ya, yb = self._y(hi), self._y(lo)
1139:         d.rectangle([zx0, ya, zx1, yb], fill=_teinte(C.INSERT_VERT, 0.85) + (255,))
1140:         for y, v in ((ya, hi), (yb, lo)):
1141:             for x in range(int(zx0), int(zx1), self.px(14)):
1142:                 d.line([(x, y), (min(zx1, x + self.px(8)), y)], fill=C.INSERT_VERT + (255,), width=max(1, self.px(3)))
1143:             _ecrire(d, (zx0 - pad * 0.4, y), f"+{v}{NBSP}°C", axe, C.INSERT_GRAISSE_TEXTE, C.INSERT_VERT + (255,), "rm")
1144:         self.carte_courbe = _ombre(carte, self.s)
1145:         self.rec_px = self.px(g["rec_px"])
1146:         self.rec_xy = (m + cw - pad, m + pad + self.px(g["titre_px"]) * 0.55)
1147: 
1148:     def _y(self, v):
1149:         zx0, zy0, zx1, zy1 = self.zone
1150:         e0, e1 = C.FRIGO_COURBE["echelle"]
1151:         return zy1 - (v - e0) / (e1 - e0) * (zy1 - zy0)
1152: 
1153:     def _t_courbe(self):
1154:         return self.t0(self.spec.get("temps", 0)) + C.INSERT_ENTREE * 1.2
1155: 
1156:     def _courbe(self, t, final):
1157:         """La carte de la courbe, tracee jusqu'a p ; et la temperature du moment."""
1158:         g = C.FRIGO_COURBE
1159:         p = 1.0 if final else max(0.0, min(1.0, (t - self._t_courbe()) / g["duree"]))
1160:         carte = self.carte_courbe.copy()
1161:         zx0, zy0, zx1, zy1 = self.zone
1162:         if p > 0:
1163:             n = max(2, int(120 * p))
1164:             pts = [(zx0 + (zx1 - zx0) * p * i / (n - 1), self._y(self._temperature(p * i / (n - 1))))
1165:                    for i in range(n)]
1166: 
1167:             def dessin(d, k):
1168:                 d.line([(x * k, y * k) for x, y in pts], fill=tuple(self.rubrique) + (255,),
1169:                        width=max(2, int(self.px(g["trait"]) * k)), joint="curve")
1170:                 r = self.px(g["tete"]) * k
1171:                 x, y = pts[-1][0] * k, pts[-1][1] * k
1172:                 d.ellipse([x - r, y - r, x + r, y + r], fill=C.BLANC + (255,), outline=tuple(self.rubrique) + (255,),
1173:                           width=max(2, int(self.px(4) * k)))
1174:             carte.alpha_composite(_net(carte.width, carte.height, dessin))
1175:         # pastille rouge qui clignote : l'enregistrement ne s'arrete pas
1176:         d = ImageDraw.Draw(carte)
1177:         allume = final or (t * 2) % 2 < 1.3
1178:         x, y = self.rec_xy
1179:         r = self.rec_px * 0.36
1180:         d.ellipse([x - 2 * r, y - r, x, y + r], fill=C.INSERT_ROUGE + (255 if allume else 60,))
1181:         return carte, self._temperature(p)
1182: 
1183:     def image(self, t, final):
1184:         u = 1.0 if final else (t - self.t0(self.spec.get("temps", 0))) / C.INSERT_ENTREE
1185:         if u <= 0:
1186:             return None
1187:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
1188:         frigo = self.fond_frigo.copy()
1189:         if self._releve():
1190:             carte, temp = self._courbe(t, final)
1191:             v = 1.0 if final else (t - self.t0(self.spec.get("temps", 0)) - C.INSERT_ENTREE * 0.5) / C.INSERT_ENTREE
1192:             if v > 0:
1193:                 dx = 0 if final else C.INSERT_MONTEE * self.s * (1 - T.lisse(v))
1194:                 _poser(out, carte, self.cx0 + carte.width / 2 + dx, self.m + self.h / 2,
1195:                        1.0, 1.0 if final else T.lisse(v * C.INSERT_FONDU))
1196:             ecran = Image.new("RGBA", frigo.size, (0, 0, 0, 0))
1197:             self._ecran_sur(ecran, f"+{temp:.1f}{NBSP}°C".replace(".", ","))
1198:             frigo.alpha_composite(ecran)
1199:         else:
1200:             self._remplir(frigo, t, final)
1201:         k = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u))
1202:         _poser(out, frigo, self.m + self.fw / 2, self.m + self.h - self.fh / 2, k,
1203:                1.0 if final else T.lisse(u * C.INSERT_FONDU))
1204:         if not self._releve() and self.etiquette is not None:
1205:             v = 1.0 if final else (t - self._t_etiquette()) / C.TAMPON_FRAPPE
1206:             if v > 0:
1207:                 kk = 1.0 if final or v >= 1 else C.TAMPON_ECHELLE - (C.TAMPON_ECHELLE - 1) * v * v
1208:                 dx = 0.0
1209:                 if not final and v > 1:
1210:                     w2 = (t - self._t_etiquette() - C.TAMPON_FRAPPE) / C.TAMPON_SECOUSSE[1]
1211:                     if w2 < 1:
1212:                         dx = C.TAMPON_SECOUSSE[0] * self.s * math.sin(2 * math.pi * 4 * w2) * (1 - w2)
1213:                 g = C.FRIGO_GEO
1214:                 cx = self.m + self.fw - g["chevauche"] * self.s + (self.etiquette.width - 2 * self.mf) / 2 + dx
1215:                 cy = self.m + self.h - self.fh + self.fh * g["etiquette_y"]
1216:                 _poser(out, self.etiquette, cx, cy, kk, 1.0 if final else min(1.0, v * C.TAMPON_GEO["fondu"]))
1217:         return out
1218: 
1219:     def _ecran_sur(self, im, texte):
1220:         g, q = C.FRIGO_GEO, self.f
1221:         _ecrire(ImageDraw.Draw(im), (self.mf + self.fw / 2, self.mf + g["panneau"] * q / 2), texte,
1222:                 max(6, int(round(g["ecran_px"] * q))), C.INSERT_GRAISSE_FORTE, _teinte(C.INSERT_VERT, 0.35) + (255,), "mm")
1223: 
1224:     def sons(self):
1225:         t0 = self.t0(self.spec.get("temps", 0))
1226:         if self._releve():
1227:             return [(t0, "clic"), (self._t_courbe(), "compteur")]
1228:         out = [(self._t_boite(0), "compteur"), (self._t_piece(0), "compteur")]
1229:         if self.etiquette is not None:
1230:             out.append((self._t_etiquette() + C.TAMPON_FRAPPE, "impact"))
1231:         return out
1232: 
1233: 
1234: # ------------------------------------------------------------- ticket
1235: class Ticket(_Insert):
1236:     """Un ticket de facturation qui s'imprime ligne par ligne ; chaque ligne recoit une coche ou
1237:     une croix, et sa valeur a droite (« remboursée », « pas à part »)."""
1238: 
1239:     def taille_nominale(self):
1240:         g = C.TICKET_GEO
1241:         n = len(self.spec["lignes"])
1242:         return C.TICKET_W + 2 * g["fente_deborde"], g["fente_h"] + g["tete"] + n * g["ligne_h"] + g["pad"] + g["dents"]
1243: 
1244:     def __init__(self, *a):
1245:         super().__init__(*a)
1246:         g = C.TICKET_GEO
1247:         self.lignes = self.spec["lignes"]
1248:         self.pw = self.px(C.TICKET_W)
1249:         self.fente = (self.px(g["fente_h"]), self.px(g["fente_deborde"]))
1250:         self.tete, self.lh, self.pad = self.px(g["tete"]), self.px(g["ligne_h"]), self.px(g["pad"])
1251:         self.dents = self.px(g["dents"])
1252:         ph = self.tete + len(self.lignes) * self.lh + self.pad
1253:         papier = Image.new("RGBA", (self.pw, ph), C.BLANC + (255,))
1254:         d = ImageDraw.Draw(papier)
1255:         _ecrire(d, (self.pw / 2, self.tete * 0.55), T.normaliser(self.spec.get("titre", "")).upper(),
1256:                 self.px(g["titre_px"]), C.INSERT_GRAISSE_FORTE, C.INSERT_GRIS_TEXTE + (255,), "mm")
1257:         self.icone_x = self.pad + self.px(g["icone"]) / 2
1258:         for i, l in enumerate(self.lignes):
1259:             y = self.tete + i * self.lh
1260:             for x in range(self.pad, self.pw - self.pad, self.px(16)):     # pointilles d'imprimante
1261:                 d.line([(x, y), (x + self.px(8), y)], fill=C.INSERT_GRIS + (255,), width=max(1, self.px(3)))
1262:             cy = y + self.lh / 2
1263:             # le libelle se resserre plutot que de toucher la valeur, alignee a droite
1264:             x_label = self.pad + self.px(g["icone"]) + self.px(18)
1265:             place = (self.pw - self.pad - x_label - self.px(g["ecart_valeur"])
1266:                      - T.largeur(T.normaliser(l.get("valeur", "")), self.px(g["valeur_px"]), C.INSERT_GRAISSE_FORTE, 0))
1267:             px = self.px(g["label_px"])
1268:             while px > self.px(g["label_px_min"]) and \
1269:                     T.largeur(T.normaliser(l["label"]), px, C.INSERT_GRAISSE_TEXTE, 0) > place:
1270:                 px -= 1
1271:             _ecrire(d, (x_label, cy), l["label"], px, C.INSERT_GRAISSE_TEXTE, C.NAVY + (255,), "lm")
1272:             couleur = C.INSERT_VERT if l.get("ok") else C.INSERT_ROUGE
1273:             _ecrire(d, (self.pw - self.pad, cy), l.get("valeur", ""), self.px(g["valeur_px"]), C.INSERT_GRAISSE_FORTE,
1274:                     couleur + (255,), "rm")
1275:         self.papier = papier
1276:         self.icones = [_icone_choix(l.get("ok"), self.px(g["icone"]), self.px(g["trait_icone"]), self.rubrique)
1277:                        for l in self.lignes]
1278:         fw, fh = self.pw + 2 * self.fente[1], self.fente[0]
1279: 
1280:         def dessin(d, k):
1281:             d.rounded_rectangle([0, 0, fw * k - 1, fh * k - 1], radius=fh * k / 2, fill=C.NAVY + (255,))
1282:             d.rounded_rectangle([fh * k * 0.6, fh * k * 0.42, (fw - fh * 0.6) * k, fh * k * 0.62], radius=fh * k * 0.1,
1283:                                 fill=(8, 5, 26, 255))
1284:         self.imprimante = _ombre_marge(_net(fw, fh, dessin), self.s)
1285: 
1286:     def _t_ligne(self, i):
1287:         l = self.lignes[i]
1288:         precedentes = [j for j in range(i) if self.lignes[j].get("temps", 0) == l.get("temps", 0)]
1289:         return self.t0(l.get("temps", 0)) + C.INSERT_ENTREE + len(precedentes) * C.TICKET_GEO["avance"] * 1.3
1290: 
1291:     def _longueur(self, t, final):
1292:         if final:
1293:             return self.papier.height
1294:         a = C.TICKET_GEO["avance"]
1295:         L = self.tete * T.lisse((t - self.t0() - C.INSERT_ENTREE * 0.4) / a)
1296:         for i in range(len(self.lignes)):
1297:             L += self.lh * T.lisse((t - self._t_ligne(i)) / a)
1298:         if len(self.lignes):
1299:             L += self.pad * T.lisse((t - self._t_ligne(len(self.lignes) - 1) - a) / a)
1300:         return int(round(L))
1301: 
1302:     def image(self, t, final):
1303:         u = 1.0 if final else (t - self.t0()) / C.INSERT_ENTREE
1304:         if u <= 0:
1305:             return None
1306:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
1307:         L = self._longueur(t, final)
1308:         x0 = self.m + self.fente[1]
1309:         y0 = self.m + self.fente[0] / 2
1310:         if L > 0:
1311:             dents = self.dents
1312:             bande = Image.new("RGBA", (self.pw, L + dents), (0, 0, 0, 0))
1313:             bande.alpha_composite(self.papier.crop((0, 0, self.pw, L)))
1314:             n = max(2, self.pw // max(4, dents))
1315: 
1316:             def dessin(d, k):
1317:                 pas = self.pw * k / n
1318:                 pts = [(0, 0)]
1319:                 for i in range(n):
1320:                     pts += [(pas * (i + 0.5), dents * k * 0.95), (pas * (i + 1), 0)]
1321:                 d.polygon(pts, fill=C.BLANC + (255,))
1322:             bande.alpha_composite(_net(self.pw, dents, dessin), (0, L))
1323:             for i, l in enumerate(self.lignes):              # l'icone tombe quand sa ligne est sortie
1324:                 v = 1.0 if final else (t - self._t_ligne(i) - C.TICKET_GEO["avance"] * 0.8) / C.INSERT_ENTREE
1325:                 cy = self.tete + (i + 0.5) * self.lh
1326:                 if v > 0 and cy < L:
1327:                     kk = C.CHOIX_GEO["icone_depart"] + (1 - C.CHOIX_GEO["icone_depart"]) * (1.0 if final else T.rebond(v))
1328:                     _poser(bande, self.icones[i], self.icone_x, cy, kk, 1.0 if final else T.lisse(v * C.INSERT_FONDU))
1329:             _poser(out, _ombre_marge(bande, self.s), x0 + self.pw / 2, y0 + (L + dents) / 2)
1330:         k = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u))
1331:         _poser(out, self.imprimante, self.m + self.w / 2, self.m + self.fente[0] / 2, k,
1332:                1.0 if final else T.lisse(u * C.INSERT_FONDU))
1333:         return out
1334: 
1335:     def sons(self):
1336:         return [(self.t0() + C.INSERT_ENTREE * 0.4, "souffle")] + [(self._t_ligne(i), "clic")
1337:                                                                     for i in range(len(self.lignes))]
1338: 
