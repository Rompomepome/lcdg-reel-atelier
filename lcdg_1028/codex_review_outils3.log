2300:                 cx, cy = S * 0.46, S * 0.54
2301:                 dd.ellipse([cx - r, cy - r, cx + r, cy + r], fill=navy)
2302:                 dd.ellipse([cx - r + S * 0.2, cy - r - S * 0.1, cx + r + S * 0.2, cy + r - S * 0.1], fill=(0, 0, 0, 0))
2303:                 for ex, ey, er in ((0.78, 0.2, 0.05), (0.88, 0.48, 0.035), (0.66, 0.08, 0.03)):
2304:                     dd.ellipse([S * ex - S * er, S * ey - S * er, S * ex + S * er, S * ey + S * er], fill=rub)
2305:             elif nom == "poubelle":                       # une dose perdue : poubelle et piece
2306:                 dd.rounded_rectangle([S * 0.38, S * 0.1, S * 0.62, S * 0.2], radius=S * 0.03, fill=navy)
2307:                 dd.rounded_rectangle([S * 0.12, S * 0.18, S * 0.78, S * 0.27], radius=S * 0.03, fill=navy)
2308:                 dd.polygon([(S * 0.18, S * 0.3), (S * 0.72, S * 0.3), (S * 0.65, S * 0.96), (S * 0.25, S * 0.96)],
2309:                            fill=navy)
2310:                 for x in (0.34, 0.45, 0.56):
2311:                     dd.line([(S * x, S * 0.42), (S * x, S * 0.84)], fill=C.BLANC + (255,), width=int(e * 0.55))
2312:                 r = S * 0.17
2313:                 dd.ellipse([S * 0.82 - r, S * 0.2 - r, S * 0.82 + r, S * 0.2 + r], fill=C.INSERT_ROUGE + (255,))
2314:             elif nom == "bon":                            # le bon de prise en charge : un formulaire
2315:                 pli = S * 0.2
2316:                 dd.polygon([(S * 0.18, S * 0.05), (S * 0.82 - pli, S * 0.05), (S * 0.82, S * 0.05 + pli),
2317:                             (S * 0.82, S * 0.96), (S * 0.18, S * 0.96)], fill=C.BLANC + (255,), outline=navy,
2318:                            width=int(e * 0.6))
2319:                 dd.polygon([(S * 0.82 - pli, S * 0.05), (S * 0.82 - pli, S * 0.05 + pli), (S * 0.82, S * 0.05 + pli)],
2320:                            fill=gris)
2321:                 dd.rounded_rectangle([S * 0.3, S * 0.3, S * 0.62, S * 0.38], radius=S * 0.02, fill=rub)
2322:                 for y in (0.5, 0.62, 0.74):
2323:                     dd.rounded_rectangle([S * 0.3, S * y, S * 0.7, S * (y + 0.05)], radius=S * 0.02, fill=gris)
2324:             elif nom == "enfant":                         # un enfant
2325:                 cx, r = S / 2, S * 0.15
2326:                 dd.ellipse([cx - r, S * 0.06, cx + r, S * 0.06 + 2 * r], fill=navy)
2327:                 dd.line([(cx - S * 0.15, S * 0.48), (cx - S * 0.3, S * 0.66)], fill=rub, width=int(e))
2328:                 dd.line([(cx + S * 0.15, S * 0.48), (cx + S * 0.3, S * 0.66)], fill=rub, width=int(e))
2329:                 dd.rounded_rectangle([cx - S * 0.17, S * 0.4, cx + S * 0.17, S * 0.74], radius=S * 0.08, fill=rub)
2330:                 dd.rounded_rectangle([cx - S * 0.13, S * 0.68, cx - S * 0.03, S * 0.96], radius=S * 0.04, fill=navy)
2331:                 dd.rounded_rectangle([cx + S * 0.03, S * 0.68, cx + S * 0.13, S * 0.96], radius=S * 0.04, fill=navy)
2332:             elif nom == "compte_rendu":                   # un compte rendu : une page, son titre, ses lignes
2333:                 dd.rounded_rectangle([S * 0.16, S * 0.04, S * 0.84, S * 0.96], radius=S * 0.06, fill=C.BLANC + (255,),
2334:                                      outline=navy, width=int(e * 0.6))
2335:                 dd.rounded_rectangle([S * 0.28, S * 0.15, S * 0.72, S * 0.27], radius=S * 0.03, fill=rub)
2336:                 for y, l in ((0.4, 0.44), (0.52, 0.36), (0.64, 0.44), (0.76, 0.26)):
2337:                     dd.rounded_rectangle([S * 0.28, S * y, S * (0.28 + l), S * (y + 0.05)], radius=S * 0.02, fill=gris)
2338:             elif nom == "concertation":                   # deux bulles : on se concerte
2339:                 dd.rounded_rectangle([S * 0.02, S * 0.1, S * 0.6, S * 0.5], radius=S * 0.13, fill=navy)
2340:                 dd.polygon([(S * 0.12, S * 0.48), (S * 0.3, S * 0.48), (S * 0.1, S * 0.66)], fill=navy)
2341:                 dd.rounded_rectangle([S * 0.38, S * 0.38, S * 0.98, S * 0.8], radius=S * 0.13, fill=rub)
2342:                 dd.polygon([(S * 0.7, S * 0.78), (S * 0.88, S * 0.78), (S * 0.9, S * 0.96)], fill=rub)
2343:                 for x in (0.55, 0.68, 0.81):
2344:                     r = S * 0.045
2345:                     dd.ellipse([S * x - r, S * 0.59 - r, S * x + r, S * 0.59 + r], fill=C.BLANC + (255,))
2346:             elif nom == "patient":                        # un patient qui vous revient : la fleche du retour
2347:                 cx, r = S * 0.36, S * 0.13
2348:                 dd.ellipse([cx - r, S * 0.1, cx + r, S * 0.1 + 2 * r], fill=navy)
2349:                 dd.rounded_rectangle([cx - S * 0.21, S * 0.42, cx + S * 0.21, S * 0.94], radius=S * 0.12, fill=navy)
2350:                 dd.arc([S * 0.5, S * 0.2, S * 0.98, S * 0.68], -90, 90, fill=rub, width=int(e))
2351:                 dd.polygon([(S * 0.6, S * 0.68), (S * 0.76, S * 0.57), (S * 0.76, S * 0.79)], fill=rub)
2352:             else:                                         # le casque de la regulation
2353:                 box = [S * 0.14, S * 0.1, S * 0.86, S * 0.82]
2354:                 dd.arc(box, 180, 360, fill=navy, width=int(e))
2355:                 for x in (S * 0.08, S * 0.74):
2356:                     dd.rounded_rectangle([x, S * 0.42, x + S * 0.18, S * 0.72], radius=S * 0.06, fill=navy)
2357:                 dd.arc([S * 0.3, S * 0.4, S * 0.92, S * 0.98], 10, 100, fill=rub, width=int(e * 0.8))
2358:                 dd.ellipse([S * 0.42, S * 0.86, S * 0.56, S * 1.0 - 1], fill=rub)
2359:         im = _net(s, s, dessin)
2360:         if nom == "poubelle":                             # la piece porte « € »
2361:             _ecrire(ImageDraw.Draw(im), (s * 0.82, s * 0.2), "€", max(6, int(s * 0.2)), C.INSERT_GRAISSE_FORTE,
2362:                     C.BLANC + (255,), "mm")
2363:         return im
