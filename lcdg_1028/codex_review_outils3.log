 113: from PIL import Image, ImageChops, ImageDraw
 114: 
 115: sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
 116: from config import charte as C
 117: from lcdg import habillage as hb
 118: from lcdg import texte as T
 119: 
 120: MOIS = ["janvier", "février", "mars", "avril", "mai", "juin", "juillet", "août", "septembre",
 121:         "octobre", "novembre", "décembre"]
 122: JOURS = "LMMJVSD"
 123: NBSP = " "
