 526:     def dessiner(self, lay, t, final=False):
 527:         debut = fin = 0.0
 528:         if not final:
 529:             seg = next(((a, b) for a, b in self.segments if a <= t < b), None)
 530:             if seg is None:
 531:                 return
 532:             debut, fin = seg
 533:         sortie = 0.0 if final else T.lisse((t - (fin - C.BANDEAU_FONDU)) / C.BANDEAU_FONDU)
 534:         for i, (mots, boites) in enumerate(self.lignes):
 535:             t0 = debut + i * C.BANDEAU_DECALAGE
 536:             e = 1.0 if final else T.lisse((t - t0) / C.BANDEAU_ENTREE)
 537:             alpha = e * (1 - sortie) * C.BANDEAU_ALPHA
 538:             if alpha <= 0.003:
 539:                 continue
 540:             dx = -C.BANDEAU_GLISSEMENT * ((1 - e) + sortie)
 541:             for om, gl, x, y in mots:
 542:                 T.coller(lay, om, (x + dx, y), alpha)
 543:                 T.coller(lay, gl, (x + dx, y), alpha)
 544:             p = 1.0 if final else T.rebond((t - t0 - C.BANDEAU_BOITE_RETARD) / C.BANDEAU_BOITE_POP)
 545:             if p <= 0:
 546:                 continue
 547:             k = C.BANDEAU_BOITE_ECHELLE + (1 - C.BANDEAU_BOITE_ECHELLE) * p
 548:             for boite, (cx, cy) in boites:
 549:                 im = boite if abs(k - 1) < 0.01 else boite.resize(
 550:                     (max(1, int(boite.width * k)), max(1, int(boite.height * k))), Image.BICUBIC)
 551:                 T.coller(lay, im, (cx + dx - im.width / 2, cy - im.height / 2),
 552:                          min(1.0, (1 - sortie) * C.BANDEAU_ALPHA * min(1.0, p * 2)))
 553: 
 554:     def couche(self):
 555:         lay = _vide(); self.dessiner(lay, 0, final=True)
 556:         return lay
