 399: # ----------------------------------------------------------------- barres
 400: class Barres(_Insert):
 401:     """Des barres horizontales qui poussent, la valeur qui defile au bout."""
 402: 
 403:     def taille_nominale(self):
 404:         n = len(self.spec["lignes"])
 405:         return C.TEXTE_LARGEUR, 2 * C.BARRES_PAD + n * C.BARRES_LIGNE_H
 406: 
 407:     def __init__(self, *a):
 408:         super().__init__(*a)
 409:         sp = self.spec
 410:         self.unite = T.normaliser(sp.get("unite", ""))
 411:         # suffixe colle au nombre par une espace insecable : « 50 € »
 412:         self.suffixe = T.normaliser(sp.get("suffixe", "")).replace(" ", "\u00a0")
 413:         self.lignes = sp["lignes"]
 414:         self.vmax = max(l["valeur"] for l in self.lignes)
 415:         self.dec = max((len(str(l["valeur"]).split(".")[1]) if "." in str(l["valeur"]) else 0)
 416:                        for l in self.lignes)
 417:         self.depart = 1.0 if self.unite in ("×", "x") else 0.0
 418:         pad = self.px(C.BARRES_PAD)
 419:         val_w = T.largeur(f"{self.unite}{_nombre(self.vmax, self.dec)}{self.suffixe}",
 420:                           self.px(C.BARRES_VALEUR_PX), C.INSERT_GRAISSE_FORTE, 0)
 421:         self.barre_max = self.w - 2 * pad - val_w - self.px(C.BARRES_GEO["valeur_marge"])
 422:         self.pad = pad
 423:         self._fonds = {}
 424: 
 425:     def _fond(self, hc):
 426:         """Carte de hauteur hc (elle grandit a chaque nouvelle barre), gardee en cache."""
 427:         if hc not in self._fonds:
 428:             self._fonds[hc] = _ombre(_cadre(self.w, hc, self.s, marge=self.m), self.s)
 429:         return self._fonds[hc]
 430: 
 431:     def _hauteur(self, t, final):
 432:         lh = self.px(C.BARRES_LIGNE_H)
 433:         if final:
 434:             return self.h
 435:         n = sum(T.lisse((t - self._t(i)) / C.BARRES_OUVERTURE) for i in range(len(self.lignes)))
 436:         return min(self.h, int(2 * self.pad + n * lh))
 437: 
 438:     def _t(self, i):
 439:         precedentes = [j for j in range(i) if self.lignes[j].get("temps", 0) == self.lignes[i].get("temps", 0)]
 440:         return self.t0(self.lignes[i].get("temps", 0)) + C.BARRES_DELAI + len(precedentes) * C.BARRES_DECALAGE
 441: 
 442:     def image(self, t, final):
 443:         u = 1.0 if final else (t - self.t0()) / C.INSERT_ENTREE
 444:         if u <= 0:
 445:             return None
 446:         # la carte est calee en bas, sur le texte : elle grandit vers le haut, et les barres
 447:         # deja posees montent avec elle
 448:         hc = self._hauteur(t, final)
 449:         carte = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 450:         haut = self.h - hc
 451:         carte.alpha_composite(self._fond(hc), (0, haut))
 452:         d = ImageDraw.Draw(carte)
 453:         m, pad = self.m, self.pad
 454:         for i, l in enumerate(self.lignes):
 455:             v_ = 1.0 if final else (t - self._t(i)) / C.INSERT_POUSSE
 456:             if v_ <= 0:
 457:                 continue
 458:             p = 1.0 if final else T.lisse(v_)
 459:             y = m + haut + pad + i * self.px(C.BARRES_LIGNE_H)
 460:             if y + self.px(C.BARRES_LIGNE_H) > m + haut + hc + self.px(C.BARRES_GEO["tolerance"]):
 461:                 continue                                 # pas encore de place pour cette ligne
 462:             a = int(255 * min(1.0, 1.0 if final else v_ * C.BARRES_GEO["fondu_ligne"]))
 463:             _ecrire(d, (m + pad, y), l["label"], self.px(C.BARRES_LABEL_PX), C.INSERT_GRAISSE_TEXTE,
 464:                     C.NAVY + (a,))
 465:             yb = y + self.px(C.BARRES_LABEL_PX + C.BARRES_GEO["label_ecart"])
 466:             hb_ = self.px(C.BARRES_EPAISSEUR)
 467:             # une premiere ligne a x1 (multiplicateur) est la reference : grise
 468:             reference = l.get("reference", i == 0 and self.depart == 1.0 and l["valeur"] == 1)
 469:             couleur = C.INSERT_GRIS if reference else self.rubrique
 470:             longueur = max(hb_, self.barre_max * l["valeur"] / self.vmax * p)
 471:             d.rounded_rectangle([m + pad, yb, m + pad + longueur, yb + hb_], radius=hb_ // 2,
 472:                                 fill=tuple(couleur) + (a,))
 473:             v = self.depart + (l["valeur"] - self.depart) * p
 474:             # des que l'arrondi atteint la cible, la valeur s'affiche telle quelle (« ×2 »,
 475:             # pas « ×2,0 » quelques images avant)
 476:             if p >= 1 or round(v, self.dec) == round(l["valeur"], self.dec):
 477:                 v, dec = l["valeur"], (0 if float(l["valeur"]).is_integer() else self.dec)
 478:             else:
 479:                 dec = self.dec
 480:             texte = f"{self.unite}{_nombre(v, dec)}{self.suffixe}"
 481:             _ecrire(d, (m + pad + longueur + self.px(C.BARRES_GEO["valeur_ecart"]), yb + hb_ / 2),
 482:                     texte, self.px(C.BARRES_VALEUR_PX), C.INSERT_GRAISSE_FORTE,
 483:                     (C.INSERT_GRIS_TEXTE if reference else C.NAVY) + (a,), "lm")
 484:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 485:         k = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u))
 486:         _poser(out, carte, carte.width / 2, carte.height / 2, k,
 487:                1.0 if final else T.lisse(u * C.INSERT_FONDU))
 488:         return out
 489: 
 490:     def sons(self):
 491:         return [(self._t(i), "clic") for i in range(len(self.lignes))]
 492: 
 493: 
 494: # ------------------------------------------------------------------ choix
 495: class Choix(_Insert):
 496:     """Une liste ou chaque ligne recoit une coche verte ou une croix rouge."""
 497: 
 498:     def taille_nominale(self):
 499:         n = len(self.spec["lignes"])
 500:         larg = max(T.largeur(T.normaliser(l["label"]), C.CHOIX_PX, C.INSERT_GRAISSE_TEXTE, 0)
 501:                    for l in self.spec["lignes"])
 502:         w = int(C.CHOIX_PAD * 3 + C.CHOIX_ICONE + larg + C.CHOIX_PAD)
 503:         return max(w, C.CHOIX_LARGEUR_MIN), n * C.CHOIX_LIGNE_H + (n - 1) * C.CHOIX_ECART
 504: 
 505:     def __init__(self, *a):
 506:         super().__init__(*a)
 507:         self.lignes = self.spec["lignes"]
 508:         self.lh = self.px(C.CHOIX_LIGNE_H)
 509:         self.pas = self.lh + self.px(C.CHOIX_ECART)
 510:         self.cartes = [self._ligne(l) for l in self.lignes]
 511:         self.icones = [self._icone(l.get("ok")) for l in self.lignes]
 512: 
 513:     def _ligne(self, l):
 514:         m = self.m
 515:         im = _cadre(self.w, self.lh, self.s, marge=m)
 516:         d = ImageDraw.Draw(im)
 517:         x = m + self.px(C.CHOIX_PAD) * 2 + self.px(C.CHOIX_ICONE)
 518:         _ecrire(d, (x, m + self.lh / 2), l["label"], self.px(C.CHOIX_PX), C.INSERT_GRAISSE_TEXTE,
 519:                 C.NAVY + (255,), "lm")
 520:         return _ombre(im, self.s)
 521: 
 522:     def _icone(self, ok):
 523:         return _icone_choix(ok, self.px(C.CHOIX_ICONE), self.px(C.CHOIX_GEO["trait"]), self.rubrique)
 524: 
 525:     def _t(self, i):
 526:         l = self.lignes[i]
 527:         precedentes = [j for j in range(i) if self.lignes[j].get("temps", 0) == l.get("temps", 0)]
 528:         return self.t0(l.get("temps", 0)) + len(precedentes) * C.CHOIX_DECALAGE
 529: 
 530:     def image(self, t, final):
 531:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 532:         for i, (carte, icone) in enumerate(zip(self.cartes, self.icones)):
 533:             u = 1.0 if final else (t - self._t(i)) / C.INSERT_ENTREE
 534:             if u <= 0:
 535:                 continue
 536:             dx = 0 if final else -C.INSERT_MONTEE * self.s * (1 - T.lisse(u))
 537:             cy = self.m + i * self.pas + self.lh / 2
 538:             _poser(out, carte, carte.width / 2 + dx, cy, 1.0,
 539:                    1.0 if final else T.lisse(u * C.INSERT_FONDU))
 540:             v = 1.0 if final else (t - self._t(i) - C.CHOIX_ICONE_DELAI) / C.INSERT_ENTREE
 541:             if v > 0:
 542:                 k0 = C.CHOIX_GEO["icone_depart"]
 543:                 k = k0 + (1 - k0) * (1.0 if final else T.rebond(v))
 544:                 cx = self.m + self.px(C.CHOIX_PAD) + self.px(C.CHOIX_ICONE) / 2 + dx
 545:                 # une question ouverte ne tient pas en place : son « ? » se balance
 546:                 angle = 0.0
 547:                 if not final and self.lignes[i].get("ok") is None and v > 1:
 548:                     amp, freq = C.CHOIX_GEO["balance"]
 549:                     angle = amp * math.sin(2 * math.pi * freq * (t - self._t(i)))
 550:                 _poser(out, icone, cx, cy, k, 1.0 if final else T.lisse(v * C.CHOIX_GEO["fondu_icone"]), angle)
 551:         return out
 552: 
 553:     def sons(self):
 554:         return [(self._t(i) + C.CHOIX_ICONE_DELAI, "clic") for i in range(len(self.lignes))]
 555: 
 556: 
 557: # ----------------------------------------------------------------- tampon
 558: class Tampon(_Insert):
 559:     """Un tampon qui claque sur l'image (« Export interdit »)."""
 560: 
 561:     def _sprite(self, s):
 562:         texte = T.normaliser(self.spec["texte"]).upper()
 563:         px = max(8, int(C.TAMPON_PX * s))
 564:         f = T._police(px, C.INSERT_GRAISSE_FORTE)
 565:         b = f.getbbox(texte)
 566:         tw, th = b[2] - b[0], b[3] - b[1]
 567:         g = C.TAMPON_GEO
 568:         padx, pady = int(C.TAMPON_PAD[0] * s), int(C.TAMPON_PAD[1] * s)
 569:         trait = max(2, int(g["trait"] * s))
 570:         w, h = tw + 2 * padx, th + 2 * pady
 571:         im = Image.new("RGBA", (w + 8, h + 8), (0, 0, 0, 0))
 572:         d = ImageDraw.Draw(im)
 573:         rouge = C.INSERT_ROUGE + (255,)
 574:         d.rounded_rectangle([4, 4, 4 + w, 4 + h], radius=max(4, int(g["rayon"] * s)),
 575:                             fill=C.BLANC + (C.TAMPON_FOND,), outline=rouge, width=trait)
 576:         i = trait + max(2, int(g["filet_retrait"] * s))
 577:         d.rounded_rectangle([4 + i, 4 + i, 4 + w - i, 4 + h - i], radius=max(3, int(g["filet_rayon"] * s)),
 578:                             outline=rouge, width=max(1, trait // 3))
 579:         d.text((4 + padx - b[0], 4 + pady - b[1]), texte, font=f, fill=rouge)
 580:         return im.rotate(C.TAMPON_ANGLE, resample=Image.BICUBIC, expand=True)
 581: 
 582:     def taille_nominale(self):
 583:         im = self._sprite(1.0)
 584:         return im.width, im.height
 585: 
 586:     def __init__(self, *a):
 587:         super().__init__(*a)
 588:         self.sprite = _ombre(self._sprite(self.s), self.s)
 589: 
 590:     def _t(self):
 591:         return self.t0(self.spec.get("temps", 0))
 592: 
 593:     def dessiner(self, lay, t, final=False):
 594:         """Colle le tampon directement sur le cadre : agrandi au moment de la frappe, il
 595:         deborde de sa boite."""
 596:         so = 0.0 if final else self.scene.parts[-1]._sortie(t)
 597:         u = 1.0 if final else (t - self._t()) / C.TAMPON_FRAPPE
 598:         if so >= 1 or u <= 0:
 599:             return
 600:         k = 1.0 if final or u >= 1 else C.TAMPON_ECHELLE - (C.TAMPON_ECHELLE - 1) * u * u
 601:         dx = 0.0
 602:         if not final and u > 1:
 603:             v = (t - self._t() - C.TAMPON_FRAPPE) / C.TAMPON_SECOUSSE[1]
 604:             if v < 1:
 605:                 dx = C.TAMPON_SECOUSSE[0] * self.s * math.sin(2 * math.pi * 4 * v) * (1 - v)
 606:         alpha = (1.0 if final else min(1.0, u * C.TAMPON_GEO["fondu"])) * (1 - so)
 607:         _poser(lay, self.sprite, self.x + self.w / 2 + dx,
 608:                self.y + self.h / 2 - C.SORTIE_MONTEE * so, k, alpha)
 609: 
 610:     def sons(self):
 611:         return [(self._t() + C.TAMPON_FRAPPE, "impact")]
 612: 
 613: 
 614: def _couper(texte, px, graisse, largeur):
 615:     """Decoupe un libelle en lignes qui tiennent dans largeur (mots entiers)."""
 616:     lignes, cur = [], ""
 617:     for mot in T.normaliser(texte).split(" "):
 618:         essai = f"{cur} {mot}".strip()
 619:         if cur and T.largeur(essai, px, graisse, 0) > largeur:
 620:             lignes.append(cur)
 621:             cur = mot
 622:         else:
 623:             cur = essai
 624:     return lignes + ([cur] if cur else [])
 625: 
 626: 
 627: def _pilule(texte, px, h, pad, fond, couleur):
 628:     w = int(T.largeur(T.normaliser(texte), px, C.INSERT_GRAISSE_FORTE, 0) + 2 * pad)
 629:     im = Image.new("RGBA", (w, h), (0, 0, 0, 0))
 630:     d = ImageDraw.Draw(im)
 631:     d.rounded_rectangle([0, 0, w - 1, h - 1], radius=h // 2, fill=tuple(fond) + (255,))
 632:     _ecrire(d, (w / 2, h / 2), texte, px, C.INSERT_GRAISSE_FORTE, tuple(couleur) + (255,), "mm")
 633:     return im
 634: 
 635: 
 636: def _fleche(d, x0, x1, y, p, trait, tete, couleur):
 637:     """Fleche horizontale de x0 a x1, tracee sur la fraction p (la pointe suit le trait)."""
 638:     if p <= 0:
 639:         return
 640:     xe = x0 + (x1 - x0) * min(1.0, p)
 641:     d.line([(x0, y), (max(x0, xe - tete * 0.6), y)], fill=couleur, width=trait)
 642:     d.polygon([(xe, y), (xe - tete, y - tete * 0.7), (xe - tete, y + tete * 0.7)], fill=couleur)
 643: 
 644: 
 645: # ---------------------------------------------------------------- circuit
 646: class Circuit(_Insert):
 647:     """Ce que devient l'argent, ligne par ligne : pilules reliees par des fleches, issue."""
 648: 
 649:     def _elements(self, l, s):
 650:         g = C.CIRCUIT_GEO
 651:         px, h, pad = max(8, int(C.CIRCUIT_PILULE_PX * s)), max(8, int(C.CIRCUIT_PILULE_H * s)), int(g["pilule_pad"] * s)
 652:         out = []
 653:         for e in l["etapes"]:
 654:             couleur = C.INSERT_ROUGE if e.startswith(("−", "-")) else C.INSERT_VERT if e.startswith("+") else C.NAVY
 655:             out.append(_pilule(e, px, h, pad, C.INSERT_GRIS, couleur))
 656:         if l.get("fin"):
 657:             fond = C.INSERT_VERT if l.get("ok") else C.INSERT_ROUGE
 658:             out.append(_pilule(l["fin"], max(8, int(C.CIRCUIT_FIN_PX * s)), h, pad, fond, C.BLANC))
 659:         return out
 660: 
 661:     def taille_nominale(self):
 662:         lignes = self.spec["lignes"]
 663:         larg = max(2 * C.CIRCUIT_PAD + sum(e.width for e in self._elements(l, 1.0))
 664:                    + (len(self._elements(l, 1.0)) - 1) * C.CIRCUIT_FLECHE for l in lignes)
 665:         n = len(lignes)
 666:         return max(C.TEXTE_LARGEUR, larg), n * C.CIRCUIT_LIGNE_H + (n - 1) * C.CIRCUIT_ECART
 667: 
 668:     def __init__(self, *a):
 669:         super().__init__(*a)
 670:         self.lignes = self.spec["lignes"]
 671:         self.lh = self.px(C.CIRCUIT_LIGNE_H)
 672:         self.pas = self.lh + self.px(C.CIRCUIT_ECART)
 673:         self.elements = [self._elements(l, self.s) for l in self.lignes]
 674:         self.cartes = []
 675:         for l in self.lignes:
 676:             im = _cadre(self.w, self.lh, self.s, marge=self.m)
 677:             _ecrire(ImageDraw.Draw(im), (self.m + self.px(C.CIRCUIT_PAD), self.m + self.px(C.CIRCUIT_GEO["titre_y"])),
 678:                     l.get("titre", ""), self.px(C.CIRCUIT_TITRE_PX), C.INSERT_GRAISSE_TEXTE,
 679:                     C.INSERT_GRIS_TEXTE + (255,))
 680:             self.cartes.append(_ombre(im, self.s))
 681: 
 682:     def _t(self, i):
 683:         l = self.lignes[i]
 684:         precedentes = [j for j in range(i) if self.lignes[j].get("temps", 0) == l.get("temps", 0)]
 685:         return self.t0(l.get("temps", 0)) + len(precedentes) * C.INSERT_DECALAGE * 3
 686: 
 687:     def image(self, t, final):
 688:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 689:         g = C.CIRCUIT_GEO
 690:         trait, tete, marge = self.px(g["trait"]), self.px(g["tete"]), self.px(g["fleche_marge"])
 691:         for i, (carte, elements) in enumerate(zip(self.cartes, self.elements)):
 692:             u = 1.0 if final else (t - self._t(i)) / C.INSERT_ENTREE
 693:             if u <= 0:
 694:                 continue
 695:             dx = 0 if final else -C.INSERT_MONTEE * self.s * (1 - T.lisse(u))
 696:             top = self.m + i * self.pas
 697:             _poser(out, carte, carte.width / 2 + dx, top + self.lh / 2, 1.0,
 698:                    1.0 if final else T.lisse(u * C.INSERT_FONDU))
 699:             cy = top + self.px(g["rangee_y"]) + (self.lh - self.px(g["rangee_y"])) / 2
 700:             x = self.m + self.px(C.CIRCUIT_PAD) + dx
 701:             d = ImageDraw.Draw(out)
 702:             for k, e in enumerate(elements):
 703:                 tk = self._t(i) + C.INSERT_ENTREE * 0.5 + k * C.CIRCUIT_DECALAGE
 704:                 v = 1.0 if final else (t - tk) / C.INSERT_ENTREE
 705:                 if k > 0:                                # la fleche qui mene a cet element
 706:                     p = 1.0 if final else (t - (tk - C.CIRCUIT_DECALAGE * 0.75)) / (C.CIRCUIT_DECALAGE * 0.7)
 707:                     _fleche(d, x - self.px(C.CIRCUIT_FLECHE) + marge, x - marge, cy, p, trait, tete,
 708:                             C.INSERT_GRIS_TEXTE + (255,))
 709:                 if v > 0:
 710:                     kk = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(v))
 711:                     _poser(out, e, x + e.width / 2, cy, kk, 1.0 if final else T.lisse(v * C.INSERT_FONDU))
 712:                 x += e.width + self.px(C.CIRCUIT_FLECHE)
 713:         return out
 714: 
 715:     def sons(self):
 716:         return [(self._t(i) + C.INSERT_ENTREE * 0.5 + k * C.CIRCUIT_DECALAGE, "clic")
 717:                 for i, el in enumerate(self.elements) for k in range(len(el))]
 718: 
 719: 
 720: # ------------------------------------------------------------------- duel
 721: class Duel(_Insert):
 722:     """Deux cartes datees face a face (une decision, puis son contraire), un « ≠ » entre."""
 723: 
 724:     def taille_nominale(self):
 725:         return C.TEXTE_LARGEUR, C.DUEL_H
 726: 
 727:     def __init__(self, *a):
 728:         super().__init__(*a)
 729:         g = C.DUEL_GEO
 730:         self.cartes_spec = self.spec["cartes"][:2]
 731:         self.ecart = self.px(g["ecart"])
 732:         self.cw = (self.w - self.ecart) // 2
 733:         self.cartes = [self._carte(c) for c in self.cartes_spec]
 734:         r = self.px(C.DUEL_SIGNE) // 2
 735:         im = Image.new("RGBA", (2 * r + 8, 2 * r + 8), (0, 0, 0, 0))
 736:         d = ImageDraw.Draw(im)
 737:         d.ellipse([4, 4, 4 + 2 * r, 4 + 2 * r], fill=C.NAVY + (255,))
 738:         _ecrire(d, (4 + r, 4 + r), "≠", self.px(g["signe_px"]), C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
 739:         self.signe = _ombre(im, self.s)
 740: 
 741:     def _carte(self, c):
 742:         g, m = C.DUEL_GEO, self.m
 743:         im = _cadre(self.cw, self.h, self.s, marge=m)
 744:         d = ImageDraw.Draw(im)
 745:         tete = self.px(C.DUEL_TETE)
 746:         # "ok" absent : une option neutre, a la couleur de la rubrique
 747:         couleur = (self.rubrique if "ok" not in c else C.INSERT_VERT if c["ok"] else C.INSERT_ROUGE) + (255,)
 748:         rayon = max(4, int(C.INSERT_RAYON * self.s))
 749:         d.rounded_rectangle([m, m, m + self.cw - 1, m + tete], radius=rayon, fill=couleur)
 750:         d.rectangle([m, m + tete // 2, m + self.cw - 1, m + tete], fill=couleur)
 751:         _ecrire(d, (m + self.cw / 2, m + tete / 2), c["date"], self.px(C.DUEL_DATE_PX),
 752:                 C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
 753:         px = self.px(C.DUEL_TEXTE_PX)
 754:         lignes = _couper(c["texte"], px, C.INSERT_GRAISSE_FORTE, self.cw - 2 * self.px(g["pad"]))
 755:         lh = px * g["interligne"]
 756:         y0 = m + tete + (self.h - tete - lh * len(lignes)) / 2 + lh / 2
 757:         for k, ligne in enumerate(lignes):
 758:             _ecrire(d, (m + self.cw / 2, y0 + k * lh), ligne, px, C.INSERT_GRAISSE_FORTE, C.NAVY + (255,), "mm")
 759:         return _ombre(im, self.s)
 760: 
 761:     def _t(self, i):
 762:         c = self.cartes_spec[i]
 763:         precedentes = [j for j in range(i) if self.cartes_spec[j].get("temps", 0) == c.get("temps", 0)]
 764:         return self.t0(c.get("temps", 0)) + len(precedentes) * C.DUEL_DECALAGE
 765: 
 766:     def _t_signe(self):
 767:         return max(self._t(i) for i in range(len(self.cartes))) + C.DUEL_SIGNE_DELAI
 768: 
 769:     def image(self, t, final):
 770:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 771:         for i, carte in enumerate(self.cartes):
 772:             u = 1.0 if final else (t - self._t(i)) / C.INSERT_ENTREE
 773:             if u <= 0:
 774:                 continue
 775:             sens = -1 if i == 0 else 1
 776:             dx = 0 if final else sens * C.INSERT_MONTEE * self.s * (1 - T.lisse(u))
 777:             k = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u))
 778:             cx = self.m + i * (self.cw + self.ecart) + self.cw / 2 + dx
 779:             _poser(out, carte, cx, self.m + self.h / 2, k, 1.0 if final else T.lisse(u * C.INSERT_FONDU))
 780:         v = 1.0 if final else (t - self._t_signe()) / C.INSERT_ENTREE
 781:         if v > 0 and len(self.cartes) == 2:
 782:             k = 0.3 + 0.7 * (1.0 if final else T.rebond(v))
 783:             angle = 0.0 if (final or v >= 1) else 12 * math.sin(2 * math.pi * 2 * v) * (1 - v)
 784:             _poser(out, self.signe, self.m + self.w / 2, self.m + self.h / 2, k,
 785:                    1.0 if final else T.lisse(v * C.INSERT_FONDU), angle)
 786:         return out
 787: 
 788:     def sons(self):
 789:         return [(self._t(i), "clic") for i in range(len(self.cartes))] + [(self._t_signe(), "impact")]
 790: 
 791: 
 792: # ------------------------------------------------------------------ frise
 793: class Frise(_Insert):
 794:     """Une procedure en etapes, de haut en bas : le trait descend de noeud en noeud, chaque
 795:     libelle se pose a droite de son noeud ; une etape "alerte" en rouge."""
 796: 
 797:     def _largeur_libelle(self, e, s):
 798:         graisse = C.INSERT_GRAISSE_FORTE if e.get("alerte") else C.INSERT_GRAISSE_TEXTE
 799:         return T.largeur(T.normaliser(e["label"]), max(8, int(C.FRISE_LABEL_PX * s)), graisse, 0)
 800: 
 801:     def taille_nominale(self):
 802:         g = C.FRISE_GEO
 803:         n = len(self.spec["etapes"])
 804:         larg = 2 * C.FRISE_PAD + 2 * C.FRISE_NOEUD + g["label_x"] + max(
 805:             self._largeur_libelle(e, 1.0) for e in self.spec["etapes"])
 806:         return max(int(larg), C.CHOIX_LARGEUR_MIN), 2 * C.FRISE_PAD + n * C.FRISE_LIGNE_H
 807: 
 808:     def __init__(self, *a):
 809:         super().__init__(*a)
 810:         self.etapes = self.spec["etapes"]
 811:         self.pad = self.px(C.FRISE_PAD)
 812:         self.r = self.px(C.FRISE_NOEUD)
 813:         self.lh = self.px(C.FRISE_LIGNE_H)
 814:         self.xn = self.m + self.pad + self.r
 815:         self.ys = [self.m + self.pad + self.lh * (i + 0.5) for i in range(len(self.etapes))]
 816:         self.fond = _ombre(_cadre(self.w, self.h, self.s, marge=self.m), self.s)
 817:         self.noeuds = []
 818:         for i, e in enumerate(self.etapes):
 819:             couleur = (C.INSERT_ROUGE if e.get("alerte") else self.rubrique) + (255,)
 820:             im = Image.new("RGBA", (2 * self.r + 4, 2 * self.r + 4), (0, 0, 0, 0))
 821:             d = ImageDraw.Draw(im)
 822:             d.ellipse([2, 2, 2 + 2 * self.r, 2 + 2 * self.r], fill=couleur)
 823:             _ecrire(d, (2 + self.r, 2 + self.r), "!" if e.get("alerte") else str(i + 1),
 824:                     self.px(C.FRISE_GEO["numero_px"]), C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
 825:             self.noeuds.append(im)
 826: 
 827:     def _t(self, i):
 828:         e = self.etapes[i]
 829:         precedentes = [j for j in range(i) if self.etapes[j].get("temps", 0) == e.get("temps", 0)]
 830:         return self.t0(e.get("temps", 0)) + C.INSERT_ENTREE * 0.6 + len(precedentes) * C.FRISE_DECALAGE
 831: 
 832:     def image(self, t, final):
 833:         u = 1.0 if final else (t - self.t0()) / C.INSERT_ENTREE
 834:         if u <= 0:
 835:             return None
 836:         carte = self.fond.copy()
 837:         d = ImageDraw.Draw(carte)
 838:         g = C.FRISE_GEO
 839:         trait = self.px(g["trait"])
 840:         d.line([(self.xn, self.ys[0]), (self.xn, self.ys[-1])], fill=C.INSERT_GRIS + (255,), width=trait)
 841:         for i in range(1, len(self.ys)):         # le trait colore descend jusqu'au noeud i
 842:             p = 1.0 if final else (t - (self._t(i) - C.FRISE_TRACE)) / C.FRISE_TRACE
 843:             if p > 0:
 844:                 y1 = self.ys[i - 1] + (self.ys[i] - self.ys[i - 1]) * min(1.0, p)
 845:                 couleur = (C.INSERT_ROUGE if self.etapes[i].get("alerte") else self.rubrique) + (255,)
 846:                 d.line([(self.xn, self.ys[i - 1]), (self.xn, y1)], fill=couleur, width=trait)
 847:         px = self.px(C.FRISE_LABEL_PX)
 848:         for i, e in enumerate(self.etapes):
 849:             v = 1.0 if final else (t - self._t(i)) / C.INSERT_ENTREE
 850:             if v <= 0:
 851:                 continue
 852:             k = 0.3 + 0.7 * (1.0 if final else T.rebond(v))
 853:             _poser(carte, self.noeuds[i], self.xn, self.ys[i], k, 1.0 if final else T.lisse(v * C.INSERT_FONDU))
 854:             a = int(255 * (1.0 if final else T.lisse(v * C.INSERT_FONDU)))
 855:             dx = 0 if final else -self.px(g["glisse"]) * (1 - T.lisse(v))
 856:             couleur = (C.INSERT_ROUGE if e.get("alerte") else C.NAVY) + (a,)
 857:             graisse = C.INSERT_GRAISSE_FORTE if e.get("alerte") else C.INSERT_GRAISSE_TEXTE
 858:             _ecrire(d, (self.xn + self.r + self.px(g["label_x"]) + dx, self.ys[i]), e["label"], px, graisse,
 859:                     couleur, "lm")
 860:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 861:         k = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u))
 862:         _poser(out, carte, carte.width / 2, carte.height / 2, k, 1.0 if final else T.lisse(u * C.INSERT_FONDU))
 863:         return out
 864: 
 865:     def sons(self):
 866:         return [(self._t(i), "impact" if e.get("alerte") else "clic") for i, e in enumerate(self.etapes)]
 867: 
