1340: # -------------------------------------------------------------- appel
1341: class Appel(_Insert):
1342:     """Ce qui arrive d'abord : un telephone qui sonne dans sa carte, une fleche, puis le
1343:     courrier qui vole jusqu'a la sienne."""
1344: 
1345:     def taille_nominale(self):
1346:         return C.TEXTE_LARGEUR, C.APPEL_H
1347: 
1348:     def __init__(self, *a):
1349:         super().__init__(*a)
1350:         g = C.APPEL_GEO
1351:         self.etapes = self.spec["etapes"][:2]
1352:         self.ecart = self.px(g["ecart"])
1353:         self.cw = (self.w - self.ecart) // 2
1354:         self.cartes = [self._carte(e) for e in self.etapes]
1355:         self.icones = [self._icone(e.get("icone")) for e in self.etapes]
1356:         self.ondes = self._ondes()
1357: 
1358:     def _icone(self, nom):
1359:         return {"telephone": self._telephone, "infirmier": self._infirmier}.get(nom, self._enveloppe)()
1360: 
1361:     def _infirmier(self):
1362:         """Un soignant en buste, la croix du soin sur la poitrine (l'infirmier en pratique avancee)."""
1363:         g = C.APPEL_GEO
1364:         w, h = self.px(g["infirmier"][0]), self.px(g["infirmier"][1])
1365:         rub = tuple(self.rubrique) + (255,)
1366: 
1367:         def dessin(d, k):
1368:             W, H = w * k, h * k
1369:             r = W * 0.2
1370:             d.ellipse([W / 2 - r, 0, W / 2 + r, 2 * r], fill=C.NAVY + (255,))
1371:             d.rounded_rectangle([W * 0.08, H * 0.42, W * 0.92, H - 1], radius=W * 0.3, fill=rub)
1372:             c, l, e = (W / 2, H * 0.7), W * 0.26, W * 0.08
1373:             d.rectangle([c[0] - l / 2, c[1] - e / 2, c[0] + l / 2, c[1] + e / 2], fill=C.BLANC + (255,))
1374:             d.rectangle([c[0] - e / 2, c[1] - l / 2, c[0] + e / 2, c[1] + l / 2], fill=C.BLANC + (255,))
1375:         return _net(w, h, dessin)
1376: 
1377:     def _carte(self, e):
1378:         g, m = C.APPEL_GEO, self.m
1379:         im = _cadre(self.cw, self.h, self.s, marge=m)
1380:         d = ImageDraw.Draw(im)
1381:         pad = self.px(g["pad"])
1382:         px, pn = self.px(g["label_px"]), self.px(g["note_px"])
1383:         lignes = _couper(e["label"], px, C.INSERT_GRAISSE_FORTE, self.cw - 2 * pad)
1384:         note = e.get("note")
1385:         bas = m + self.h - pad - (pn * 1.3 if note else 0)
1386:         for i, l in enumerate(reversed(lignes)):
1387:             _ecrire(d, (m + self.cw / 2, bas - i * px * 1.18), l, px, C.INSERT_GRAISSE_FORTE, C.NAVY + (255,), "ms")
1388:         if note:
1389:             _ecrire(d, (m + self.cw / 2, m + self.h - pad), note, pn, C.INSERT_GRAISSE_TEXTE,
1390:                     C.INSERT_GRIS_TEXTE + (255,), "ms")
1391:         return _ombre(im, self.s)
1392: 
1393:     def _telephone(self):
1394:         g = C.APPEL_GEO
1395:         w, h = self.px(g["telephone"][0]), self.px(g["telephone"][1])
1396: 
1397:         def dessin(d, k):
1398:             W, H = w * k, h * k
1399:             d.rounded_rectangle([0, 0, W - 1, H - 1], radius=W * 0.2, fill=C.NAVY + (255,))
1400:             b = W * 0.08
1401:             d.rounded_rectangle([b, b * 1.6, W - b, H - b * 1.6], radius=W * 0.12, fill=tuple(self.rubrique) + (255,))
1402:             r = W * 0.17
1403:             d.ellipse([W / 2 - r, H * 0.3 - r, W / 2 + r, H * 0.3 + r], fill=_teinte(self.rubrique, 0.75) + (255,))
1404:             rb = W * 0.11
1405:             for x, c in ((W * 0.3, C.INSERT_ROUGE), (W * 0.7, C.INSERT_VERT)):
1406:                 d.ellipse([x - rb, H * 0.76 - rb, x + rb, H * 0.76 + rb], fill=c + (255,))
1407:             d.rounded_rectangle([W * 0.38, b * 0.55, W * 0.62, b * 1.05], radius=b * 0.25, fill=(8, 5, 26, 255))
1408:         return _net(w, h, dessin)
1409: 
1410:     def _enveloppe(self):
1411:         g = C.APPEL_GEO
1412:         w, h = self.px(g["enveloppe"][0]), self.px(g["enveloppe"][1])
1413:         tr = self.px(g["trait"])
1414: 
1415:         def dessin(d, k):
1416:             W, H, e = w * k, h * k, tr * k
1417:             d.rounded_rectangle([e / 2, e / 2, W - e / 2, H - e / 2], radius=W * 0.06, fill=C.BLANC + (255,),
1418:                                 outline=C.NAVY + (255,), width=int(e))
1419:             d.line([(e, e), (W / 2, H * 0.58), (W - e, e)], fill=C.NAVY + (255,), width=int(e), joint="curve")
1420:             r = H * 0.14
1421:             d.ellipse([W - r * 1.6 - r, -0, W - r * 1.6 + r, 2 * r], fill=C.INSERT_ROUGE + (255,))
1422:         return _net(w, h, dessin)
1423: 
1424:     def _ondes(self):
1425:         """Les ondes de la sonnerie, de part et d'autre du telephone."""
1426:         g = C.APPEL_GEO
1427:         tw, th = self.px(g["telephone"][0]), self.px(g["telephone"][1])
1428:         w, h = tw * 2.2, th * 0.8
1429:         tr = self.px(g["trait"])
1430: 
1431:         def dessin(d, k):
1432:             W, H = w * k, h * k
1433:             for i in range(g["ondes"]):
1434:                 r = (tw * 0.62 + i * tr * 2.6) * k
1435:                 box = [W / 2 - r, H / 2 - r, W / 2 + r, H / 2 + r]
1436:                 for a0 in (-35, 145):
1437:                     d.arc(box, a0, a0 + 70, fill=tuple(self.rubrique) + (255,), width=int(tr * k))
1438:         return _net(w, h, dessin)
1439: 
1440:     def _t(self, i):
1441:         if "temps" in self.etapes[i]:                    # une etape peut attendre son temps du texte
1442:             return self.t0(self.etapes[i]["temps"])
1443:         t = self.t0(self.spec.get("temps", 0))
1444:         return t if i == 0 else t + C.APPEL_GEO["courrier"]
1445: 
1446:     def image(self, t, final):
1447:         g = C.APPEL_GEO
1448:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
1449:         for i, carte in enumerate(self.cartes):
1450:             u = 1.0 if final else (t - self._t(i)) / C.INSERT_ENTREE
1451:             if u <= 0:
1452:                 continue
1453:             k = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u))
1454:             dx = 0 if final or i == 0 else C.INSERT_MONTEE * self.s * (1 - T.lisse(u))
1455:             cx = self.m + i * (self.cw + self.ecart) + self.cw / 2
1456:             _poser(out, carte, cx + dx, self.m + self.h / 2, k, 1.0 if final else T.lisse(u * C.INSERT_FONDU))
1457:             iy = self.m + self.px(g["icone_y"])
1458:             icone, angle, ix = self.icones[i], 0.0, cx + dx
1459:             if self.etapes[i].get("icone") == "telephone":
1460:                 tau = 0.0 if final else t - self._t(i) - C.INSERT_ENTREE * 0.4
1461:                 sonne = not final and 0 < tau < g["sonnerie"] and (tau % 0.65) < 0.45
1462:                 if sonne:
1463:                     angle = g["secousse"] * math.sin(2 * math.pi * 14 * tau)
1464:                     _poser(out, self.ondes, ix, iy, 1.0, 0.55 + 0.45 * math.sin(2 * math.pi * 3 * tau) ** 2)
1465:             elif self.etapes[i].get("icone") != "infirmier":   # le courrier arrive en vol, de la droite
1466:                 v = 1.0 if final else (t - self._t(i) - C.INSERT_ENTREE * 0.3) / (C.INSERT_ENTREE * 1.4)
1467:                 if v <= 0:
1468:                     continue
1469:                 p = 1.0 if final else T.rebond(v)
1470:                 ix += (1 - p) * self.px(260)
1471:                 iy -= (1 - p) * self.px(90)
1472:                 angle = -22 * (1 - p)
1473:             _poser(out, icone, ix, iy, k, 1.0 if final else T.lisse(u * C.INSERT_FONDU), angle)
1474:         if len(self.cartes) == 2:                         # la fleche se trace d'une carte a l'autre
1475:             p = 1.0 if final else (t - (self._t(1) - C.INSERT_ENTREE * 0.6)) / (C.INSERT_ENTREE * 0.6)
1476:             x0 = self.m + self.cw + self.ecart * 0.2
1477:             x1 = self.m + self.cw + self.ecart * 0.8
1478:             fl = Image.new("RGBA", out.size, (0, 0, 0, 0))
1479:             _fleche(ImageDraw.Draw(fl), x0, x1, self.m + self.h / 2, p, self.px(C.CIRCUIT_GEO["trait"]),
1480:                     self.px(C.CIRCUIT_GEO["tete"]), C.BLANC + (255,))
1481:             out.alpha_composite(_ombre(fl, self.s))
1482:         return out
1483: 
1484:     def sons(self):
1485:         return [(self._t(0), "clic")] + ([(self._t(1), "souffle")] if len(self.cartes) == 2 else [])
1486: 
1487: 
1488: # -------------------------------------------------------------- loupe
1489: class Loupe(_Insert):
1490:     """Une page qu'on fouille : la recherche se tape, la loupe balaie la page, rien ne sort."""
1491: 
1492:     def taille_nominale(self):
1493:         return C.TEXTE_LARGEUR, C.LOUPE_H
1494: 
1495:     def __init__(self, *a):
1496:         super().__init__(*a)
1497:         g = C.LOUPE_GEO
1498:         m = self.m
1499:         carte = _cadre(self.w, self.h, self.s, marge=m)
1500:         d = ImageDraw.Draw(carte)
1501:         barre = self.px(g["barre"])
1502:         rayon = max(4, int(C.INSERT_RAYON * self.s))
1503:         gris = _teinte(C.INSERT_GRIS_TEXTE, 0.82)
1504:         d.rounded_rectangle([m, m, m + self.w - 1, m + barre], radius=rayon, fill=gris + (255,))
1505:         d.rectangle([m, m + barre - rayon, m + self.w - 1, m + barre], fill=gris + (255,))
1506:         r = self.px(g["point"])
1507:         for i in range(3):
1508:             x = m + self.px(28) + i * r * 3
1509:             d.ellipse([x - r, m + barre / 2 - r, x + r, m + barre / 2 + r], fill=C.BLANC + (255,))
1510:         upx = self.px(g["url_px"])
1511:         url = T.normaliser(self.spec.get("site", ""))
1512:         uw = T.largeur(url, upx, C.INSERT_GRAISSE_TEXTE, 0) + 2 * self.px(g["url_pad"])
1513:         ux = m + self.px(28) + r * 9
1514:         d.rounded_rectangle([ux, m + barre * 0.2, ux + uw, m + barre * 0.8], radius=barre * 0.3, fill=C.BLANC + (255,))
1515:         _ecrire(d, (ux + uw / 2, m + barre / 2), url, upx, C.INSERT_GRAISSE_TEXTE, C.INSERT_GRIS_TEXTE + (255,), "mm")
1516:         pad = self.px(28)
1517:         ch = self.px(g["champ_h"])
1518:         self.champ = (m + pad, m + barre + self.px(g["champ_y"]), m + self.w - pad, m + barre + self.px(g["champ_y"]) + ch)
1519:         x0, y0, x1, y1 = self.champ
1520:         d.rounded_rectangle([x0, y0, x1, y1], radius=ch / 2, outline=C.INSERT_GRIS + (255,), width=max(2, self.px(4)))
1521:         self.fond = _ombre(carte, self.s)
1522:         self.petite = self._loupe(ch * 0.18, max(2, self.px(4)), C.INSERT_GRIS_TEXTE)
1523:         self.grande = self._loupe(self.px(g["loupe"]), self.px(g["trait"]), C.NAVY, vitre=True)
1524:         self.zone = (x0, y1, x1, m + self.h)                       # sous le champ : la page
1525: 
1526:     def _loupe(self, r, trait, couleur, vitre=False):
1527:         taille = r * 3.3
1528: 
1529:         def dessin(d, k):
1530:             R, e, c = r * k, trait * k, taille * k * 0.38
1531:             if vitre:
1532:                 d.ellipse([c - R, c - R, c + R, c + R], fill=_teinte(self.rubrique, 0.82) + (150,))
1533:             d.ellipse([c - R, c - R, c + R, c + R], outline=tuple(couleur) + (255,), width=int(e))
1534:             a = c + R * 0.72
1535:             d.line([(a, a), (taille * k * 0.92, taille * k * 0.92)], fill=tuple(couleur) + (255,), width=int(e * 1.5))
1536:         return _net(taille, taille, dessin)
1537: 
1538:     def _temps(self):
1539:         g = C.LOUPE_GEO
1540:         t0 = self.t0(self.spec.get("temps", 0)) + C.INSERT_ENTREE * 0.5
1541:         return t0, t0 + g["frappe"], t0 + g["frappe"] + g["balayage"]
1542: 
1543:     def image(self, t, final):
1544:         g = C.LOUPE_GEO
1545:         u = 1.0 if final else (t - self.t0(self.spec.get("temps", 0))) / C.INSERT_ENTREE
1546:         if u <= 0:
1547:             return None
1548:         carte = self.fond.copy()
1549:         d = ImageDraw.Draw(carte)
1550:         frappe, balai, fin = self._temps()
1551:         x0, y0, x1, y1 = self.champ
1552:         ch = y1 - y0
1553:         _poser(carte, self.petite, x0 + ch * 0.62, (y0 + y1) / 2 + ch * 0.04)
1554:         texte = T.normaliser(self.spec.get("recherche", ""))
1555:         n = len(texte) if final else int(len(texte) * max(0.0, min(1.0, (t - frappe) / g["frappe"])))
1556:         px = self.px(g["champ_px"])
1557:         tx = x0 + ch * 1.15
1558:         _ecrire(d, (tx, (y0 + y1) / 2), texte[:n], px, C.INSERT_GRAISSE_TEXTE, C.NAVY + (255,), "lm")
1559:         if not final and t < fin and (t % g["curseur"]) < g["curseur"] * 0.55:
1560:             xc = tx + T.largeur(texte[:n], px, C.INSERT_GRAISSE_TEXTE, 0) + self.px(4)
1561:             d.line([(xc, (y0 + y1) / 2 - px * 0.6), (xc, (y0 + y1) / 2 + px * 0.6)], fill=tuple(self.rubrique) + (255,),
1562:                    width=max(2, self.px(4)))
1563:         zx0, zy0, zx1, zy1 = self.zone
1564:         cx, cy = (zx0 + zx1) / 2, (zy0 + zy1) / 2
1565:         if not final and balai < t < fin + C.INSERT_ENTREE:      # la loupe cherche, en huit
1566:             tau = (t - balai) / g["balayage"]
1567:             a = min(1.0, (t - balai) / C.INSERT_ENTREE) * min(1.0, max(0.0, (fin + C.INSERT_ENTREE - t) / C.INSERT_ENTREE))
1568:             lx = cx + (zx1 - zx0) * 0.3 * math.sin(2 * math.pi * tau)
1569:             ly = cy + (zy1 - zy0) * 0.16 * math.sin(4 * math.pi * tau)
1570:             _poser(carte, self.grande, lx + self.grande.width * 0.12, ly + self.grande.height * 0.12, 1.0, a)
1571:         v = 1.0 if final else (t - fin) / C.INSERT_ENTREE
1572:         if v > 0:
1573:             _ecrire(d, (cx, zy0 + (zy1 - zy0) * g["vide_y"]), self.spec.get("vide", ""), self.px(g["vide_px"]),
1574:                     C.INSERT_GRAISSE_FORTE,
1575:                     C.INSERT_GRIS_TEXTE + (int(255 * min(1.0, v)),), "mm")
1576:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
1577:         k = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u))
1578:         _poser(out, carte, carte.width / 2, carte.height / 2, k, 1.0 if final else T.lisse(u * C.INSERT_FONDU))
1579:         return out
1580: 
1581:     def sons(self):
1582:         frappe, balai, _ = self._temps()
1583:         return [(frappe, "compteur"), (balai, "souffle")]
1584: 
1585: 
1586: # ------------------------------------------------------------- calcul
1587: class Calcul(_Insert):
1588:     """Le calcul qui cible les medecins : la barre se remplit ; au temps "temps_question", la part
1589:     marquee "question" se detache vers le haut, son empreinte en pointille, un « ? » au-dessus."""
1590: 
1591:     def taille_nominale(self):
1592:         return C.TEXTE_LARGEUR, C.CALCUL_H
1593: 
1594:     def __init__(self, *a):
1595:         super().__init__(*a)
1596:         g = C.CALCUL_GEO
1597:         m, pad = self.m, self.px(g["pad"])
1598:         self.parts = self.spec["parts"]
1599:         total = sum(p["valeur"] for p in self.parts)
1600:         self.bx0, self.bx1 = m + pad, m + self.w - pad
1601:         self.by, self.bh = m + self.px(g["barre_y"]), self.px(g["barre_h"])
1602:         bw = self.bx1 - self.bx0
1603:         bornes, x = [], 0.0
1604:         for p in self.parts:
1605:             bornes.append((x, x + bw * p["valeur"] / total))
1606:             x = bornes[-1][1]
1607:         self.bornes = bornes
1608:         carte = _cadre(self.w, self.h, self.s, marge=m)
1609:         d = ImageDraw.Draw(carte)
1610:         _ecrire(d, (m + pad, m + pad), self.spec.get("titre", ""), self.px(g["titre_px"]), C.INSERT_GRAISSE_FORTE,
1611:                 C.NAVY + (255,))
1612:         d.rounded_rectangle([self.bx0, self.by, self.bx1, self.by + self.bh], radius=self.bh / 2,
1613:                             fill=C.INSERT_GRIS + (255,))
1614:         self.fond = carte
1615:         self.segments = [self._segment(i) for i in range(len(self.parts))]
1616:         self.labels = self._labels()
1617:         b = self.px(g["badge"])
1618:         badge = _net(2 * b, 2 * b, lambda dd, k: dd.ellipse([0, 0, 2 * b * k - 1, 2 * b * k - 1], fill=C.NAVY + (255,)))
1619:         _ecrire(ImageDraw.Draw(badge), (b, b), "?", int(b * 1.25), C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
1620:         self.badge = _ombre_marge(badge, self.s)
1621:         self.question = next((i for i, p in enumerate(self.parts) if p.get("question")), None)
1622:         if self.question is not None:
1623:             a, b2 = self.bornes[self.question]
1624:             empreinte = _net(b2 - a, self.bh, lambda dd, k: dd.rounded_rectangle(
1625:                 [0, 0, (b2 - a) * k - 1, self.bh * k - 1], radius=self.bh * k / 2 if self.question == len(self.parts) - 1 else 0,
1626:                 outline=C.INSERT_GRIS_TEXTE + (255,), width=int(self.px(4) * k)))
1627:             self.empreinte = _pointilles(empreinte, *[self.px(v) for v in g["pointille"]])
1628: 
1629:     def _ton(self, p):
1630:         """Couleur d'une part : "ton" rouge ou vert (une regle defavorable ou favorable) ; "bleu",
1631:         ou pas de ton, la rubrique. Un libelle ne prend la couleur de sa part que si elle porte un
1632:         ton."""
1633:         return {"rouge": C.INSERT_ROUGE, "vert": C.INSERT_VERT}.get(p.get("ton"), tuple(self.rubrique))
1634: 
1635:     def _segment(self, i):
1636:         """Le segment i, arrondi a ses bouts exterieurs ; raye s'il porte la question."""
1637:         g = C.CALCUL_GEO
1638:         a, b = self.bornes[i]
1639:         w, h = b - a, self.bh
1640:         premier, dernier = i == 0, i == len(self.parts) - 1
1641:         question = self.parts[i].get("question")
1642: 
1643:         def dessin(d, k):
1644:             W, H = w * k, h * k
1645:             couleur = _teinte(self.rubrique, 0.45) if question else self._ton(self.parts[i])
1646:             gauche = 0 if premier else -H
1647:             droite = W if dernier else W + H
1648:             d.rounded_rectangle([gauche, 0, droite - 1, H - 1], radius=H / 2, fill=couleur + (255,))
1649:             if question:
1650:                 pas = self.px(g["rayures"]) * k
1651:                 x = -H
1652:                 while x < W:
1653:                     d.line([(x, H), (x + H, 0)], fill=_teinte(self.rubrique, 0.68) + (255,), width=int(pas * 0.4))
1654:                     x += pas
1655:         return _net(w, h, dessin)
1656: 
1657:     def _labels(self):
1658:         g = C.CALCUL_GEO
1659:         px = self.px(g["label_px"])
1660:         y = self.by + self.bh + self.px(g["accolade_y"])
1661:         out = []
1662:         for i, p in enumerate(self.parts):
1663:             a, b = self.bornes[i]
1664:             dernier = i == len(self.parts) - 1
1665:             im = Image.new("RGBA", self.fond.size, (0, 0, 0, 0))
1666:             d = ImageDraw.Draw(im)
1667:             couleur = (self._ton(p) if p.get("ton") else C.NAVY if p.get("question") else C.INSERT_GRIS_TEXTE) + (255,)
1668:             tr = max(2, self.px(3))
1669:             d.line([(self.bx0 + a + tr, y), (self.bx0 + b - tr, y)], fill=couleur, width=tr)
1670:             for x in (self.bx0 + a + tr, self.bx0 + b - tr):
1671:                 d.line([(x, y - self.px(10)), (x, y)], fill=couleur, width=tr)
1672:             ancre, x = ("rt", self.bx0 + b) if dernier else ("lt", self.bx0 + a)
1673:             _ecrire(d, (x, y + self.px(10)), p["label"], px,
1674:                     C.INSERT_GRAISSE_FORTE if p.get("question") else C.INSERT_GRAISSE_TEXTE, couleur, ancre)
1675:             out.append(im)
1676:         return out
1677: 
1678:     def _t_question(self):
1679:         return self.t0(self.spec.get("temps_question", 1)) + C.INSERT_DELAI
1680: 
1681:     def image(self, t, final):
1682:         g = C.CALCUL_GEO
1683:         u = 1.0 if final else (t - self.t0()) / C.INSERT_ENTREE
1684:         if u <= 0:
1685:             return None
1686:         carte = self.fond.copy()
1687:         p = 1.0 if final else T.lisse((t - self.t0() - C.INSERT_ENTREE * 0.5) / g["remplissage"])
1688:         bw = self.bx1 - self.bx0
1689:         rempli = bw * p
1690:         v = 0.0 if self.question is None else (1.0 if final else T.lisse((t - self._t_question()) / C.INSERT_ENTREE))
1691:         for i, seg in enumerate(self.segments):
1692:             a, b = self.bornes[i]
1693:             if rempli <= a:
1694:                 continue
1695:             vis = seg.crop((0, 0, max(1, int(round(min(b, rempli) - a))), seg.height))
1696:             if i == self.question and v > 0:
1697:                 carte.alpha_composite(self.empreinte, (int(round(self.bx0 + a)), int(round(self.by))))
1698:                 dy = -self.px(g["levee"]) * v
1699:                 flotte = 0.0 if final else self.px(g["flotte"]) * math.sin(2 * math.pi * 0.8 * (t - self._t_question())) * v
1700:                 cx = self.bx0 + (a + b) / 2
1701:                 cy = self.by + self.bh / 2 + dy + flotte
1702:                 _poser(carte, _ombre_marge(vis, self.s), cx, cy, 1.0, 1.0, g["angle"] * v)
1703:                 w2 = 1.0 if final else (t - self._t_question() - C.INSERT_ENTREE * 0.5) / C.INSERT_ENTREE
1704:                 if w2 > 0:
1705:                     kk = 0.3 + 0.7 * (1.0 if final else T.rebond(w2))
1706:                     _poser(carte, self.badge, self.bx0 + b - self.px(g["badge"]) * 0.6,
1707:                            cy - self.bh / 2 - self.px(g["badge"]) * 0.7, kk, 1.0 if final else T.lisse(w2 * C.INSERT_FONDU))
1708:             else:
1709:                 carte.alpha_composite(vis, (int(round(self.bx0 + a)), int(round(self.by))))
1710:         for i, lab in enumerate(self.labels):
1711:             w2 = 1.0 if final else (t - self.t0() - C.INSERT_ENTREE * 0.5 - g["remplissage"] * (i + 1) / len(self.labels)) \
1712:                 / C.INSERT_ENTREE
1713:             if w2 > 0:
1714:                 T.coller(carte, lab, (0, 0), min(1.0, w2))
1715:         carte = _ombre(carte, self.s)
1716:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
1717:         k = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u))
1718:         _poser(out, carte, carte.width / 2, carte.height / 2, k, 1.0 if final else T.lisse(u * C.INSERT_FONDU))
1719:         return out
1720: 
1721:     def sons(self):
1722:         out = [(self.t0() + C.INSERT_ENTREE * 0.5, "souffle")]
1723:         if self.question is not None:
1724:             out += [(self._t_question(), "clic"), (self._t_question() + C.INSERT_ENTREE * 0.5, "impact")]
1725:         return out
1726: 
1727: 
1728: def _ton(spec, rubrique):
1729:     """Couleur d'un element : "ton" rouge, vert, ou la rubrique."""
1730:     return {"rouge": C.INSERT_ROUGE, "vert": C.INSERT_VERT}.get(spec.get("ton"), tuple(rubrique))
1731: 
1732: 
1733: def _bulle(texte, px, h, pad, couleur, queue=True):
1734:     """Pilule de couleur, texte blanc, avec une pointe dessous (une bulle qui designe)."""
1735:     w = int(T.largeur(T.normaliser(texte), px, C.INSERT_GRAISSE_FORTE, 0) + 2 * pad)
1736:     q = h * 0.32 if queue else 0
1737: 
1738:     def dessin(d, k):
1739:         d.rounded_rectangle([0, 0, w * k - 1, h * k - 1], radius=h * k / 2, fill=tuple(couleur) + (255,))
1740:         if queue:
1741:             d.polygon([(w * k / 2 - q * k, h * k - 2), (w * k / 2 + q * k, h * k - 2), (w * k / 2, (h + q) * k)],
1742:                       fill=tuple(couleur) + (255,))
1743:     im = _net(w, h + q, dessin)
1744:     _ecrire(ImageDraw.Draw(im), (w / 2, h / 2), texte, px, C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
1745:     return im
1746: 
1747: 
1748: def _entree(t, t0, final):
1749:     """(echelle, opacite) d'un element qui arrive en rebond a t0."""
1750:     u = 1.0 if final else (t - t0) / C.INSERT_ENTREE
1751:     if u <= 0:
1752:         return 0.0, 0.0
1753:     return (C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u)),
1754:             1.0 if final else T.lisse(u * C.INSERT_FONDU))
1755: 
1756: 
1757: # --------------------------------------------------------------- ages
1758: class Ages(_Insert):
1759:     """La regle des ages : trois zones colorees, un curseur « vous » qui va de zone en zone (dans
1760:     l'ordre de "ordre") ; a chaque arret, une bulle dit ce que devient la pension dans cette zone."""
1761: 
1762:     def taille_nominale(self):
1763:         return C.TEXTE_LARGEUR, C.AGES_H
1764: 
1765:     def __init__(self, *a):
1766:         super().__init__(*a)
1767:         g, m = C.AGES_GEO, self.m
1768:         pad = self.px(g["pad"])
1769:         self.zones = self.spec["zones"]
1770:         n = len(self.zones)
1771:         self.x0, self.x1 = m + pad, m + self.w - pad
1772:         self.ry = m + self.px(g["regle_y"])
1773:         rh, ecart = self.px(g["regle_h"]), self.px(g["ecart"])
1774:         larg = (self.x1 - self.x0 - (n - 1) * ecart) / n
1775:         self.bornes = [(self.x0 + i * (larg + ecart), self.x0 + i * (larg + ecart) + larg) for i in range(n)]
1776:         carte = _cadre(self.w, self.h, self.s, marge=m)
1777:         d = ImageDraw.Draw(carte)
1778:         _ecrire(d, (m + pad, m + pad), self.spec.get("titre", ""), self.px(g["titre_px"]), C.INSERT_GRAISSE_FORTE,
1779:                 C.NAVY + (255,))
1780:         regle = Image.new("RGBA", carte.size, (0, 0, 0, 0))
1781: 
1782:         def dessin(dd, k):
1783:             for i, (a, b) in enumerate(self.bornes):
1784:                 r = rh * k / 2 if i in (0, n - 1) else rh * k * 0.2
1785:                 dd.rounded_rectangle([a * k, (self.ry - rh / 2) * k, b * k, (self.ry + rh / 2) * k], radius=r,
1786:                                      fill=_ton(self.zones[i], self.rubrique) + (255,))
1787:         regle.alpha_composite(_net(carte.width, carte.height, dessin))
1788:         carte.alpha_composite(regle)
1789:         for i, (a, b) in enumerate(self.bornes):
1790:             _ecrire(d, ((a + b) / 2, self.ry + rh / 2 + self.px(g["label_ecart"])), self.zones[i]["label"], self.px(g["label_px"]),
1791:                     C.INSERT_GRAISSE_FORTE, _ton(self.zones[i], self.rubrique) + (255,), "mt")
1792:         self.fond = _ombre(carte, self.s)
1793:         self.bulles = [_ombre_marge(_bulle(z["bulle"], self.px(g["bulle_px"]), self.px(g["bulle_h"]),
1794:                                            self.px(g["bulle_pad"]), _ton(z, self.rubrique)), self.s) for z in self.zones]
1795:         r = self.px(g["curseur"])
1796:         curseur = _net(2 * r + 4, 2 * r + 4, lambda dd, k: (
1797:             dd.ellipse([2 * k, 2 * k, (2 * r + 2) * k, (2 * r + 2) * k], fill=C.BLANC + (255,)),
1798:             dd.ellipse([2 * k + r * 0.28 * k, 2 * k + r * 0.28 * k, (2 * r + 2) * k - r * 0.28 * k,
1799:                         (2 * r + 2) * k - r * 0.28 * k], fill=C.NAVY + (255,))))
1800:         self.curseur = _ombre_marge(curseur, self.s)
1801:         self.ordre = self.spec.get("ordre", list(range(n)))
1802: 
1803:     def _etapes(self):
1804:         """[(zone, arrivee, depart)] : le curseur arrive au centre de chaque zone, s'y arrete."""
1805:         g = C.AGES_GEO
1806:         t = self.t0(self.spec.get("temps", 0)) + C.INSERT_ENTREE * 0.8
1807:         out = []
1808:         for k, z in enumerate(self.ordre):
1809:             arrivee = t if k == 0 else t + g["deplacement"]
1810:             depart = arrivee + g["pause"]
1811:             out.append((z, arrivee, depart))
1812:             t = depart
1813:         return out
1814: 
1815:     def _x(self, z):
1816:         a, b = self.bornes[z]
1817:         return (a + b) / 2
1818: 
1819:     def image(self, t, final):
1820:         g = C.AGES_GEO
1821:         k, a = _entree(t, self.t0(self.spec.get("temps", 0)), final)
1822:         if a <= 0:
1823:             return None
1824:         carte = self.fond.copy()
1825:         etapes = self._etapes()
1826:         if final:
1827:             z, x, bulle = etapes[-1][0], self._x(etapes[-1][0]), (etapes[-1][0], 1.0)
1828:         else:
1829:             x, bulle = self._x(etapes[0][0]), None
1830:             for i, (z, arr, dep) in enumerate(etapes):
1831:                 if t >= arr:
1832:                     x = self._x(z)
1833:                     bulle = (z, (t - arr) / C.INSERT_ENTREE)
1834:                 if i + 1 < len(etapes) and dep <= t < etapes[i + 1][1]:      # en chemin vers la suivante
1835:                     p = T.lisse((t - dep) / g["deplacement"])
1836:                     x = self._x(z) + (self._x(etapes[i + 1][0]) - self._x(z)) * p
1837:                     bulle = None
1838:             if t < etapes[0][1]:
1839:                 bulle = None
1840:         _poser(carte, self.curseur, x, self.ry)
1841:         if bulle:
1842:             z, u = bulle
1843:             kk = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u))
1844:             b = self.bulles[z]
1845:             bx = min(max(x, self.m + b.width / 2), self.m + self.w - b.width / 2)
1846:             _poser(carte, b, bx, self.ry - self.px(g["curseur"]) - self.px(g["bulle_ecart"]) - (b.height - 2 * self.m) / 2
1847:                    - self.m + self.m, kk, 1.0 if final else T.lisse(u * C.INSERT_FONDU))
1848:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
1849:         _poser(out, carte, carte.width / 2, carte.height / 2, k, a)
1850:         return out
1851: 
1852:     def sons(self):
1853:         e = self._etapes()
1854:         return [(e[0][1] - C.INSERT_ENTREE * 0.4, "souffle")] + [(arr, "clic") for _, arr, _ in e]
1855: 
1856: 
1857: # --------------------------------------------------------------- vases
1858: class Vases(_Insert):
1859:     """Deux bocaux communicants : vos revenus montent, votre pension baisse d'autant, des « +1 € »
1860:     et « −1 € » s'envolent ; au temps "ajout", une piece (« IJ ») tombe dans les revenus et la
1861:     pension baisse encore."""
1862: 
1863:     def taille_nominale(self):
1864:         return C.TEXTE_LARGEUR, C.VASES_H
1865: 
1866:     def __init__(self, *a):
1867:         super().__init__(*a)
1868:         g, m = C.VASES_GEO, self.m
1869:         carte = _cadre(self.w, self.h, self.s, marge=m)
1870:         d = ImageDraw.Draw(carte)
1871:         _ecrire(d, (m + self.w / 2, m + self.px(g["pad"])), self.spec.get("titre", ""), self.px(g["titre_px"]),
1872:                 C.INSERT_GRAISSE_FORTE, C.NAVY + (255,), "mt")
1873:         self.vw, self.vh = self.px(g["vase"][0]), self.px(g["vase"][1])
1874:         self.fond_y = m + self.px(g["fond_y"])                              # bas des bocaux
1875:         self.cx = [m + self.w * c for c in g["col"]]
1876:         for cx, lab in zip(self.cx, (self.spec.get("gauche", ""), self.spec.get("droite", ""))):
1877:             _ecrire(d, (cx, self.fond_y + self.px(10)), lab, self.px(g["label_px"]), C.INSERT_GRAISSE_FORTE,
1878:                     C.NAVY + (255,), "mt")
1879:         self.fond = carte
1880:         tr = self.px(g["trait"])
1881:         self.bocal = _net(self.vw, self.vh, lambda dd, k: dd.rounded_rectangle(
1882:             [tr * k / 2, tr * k / 2, (self.vw - tr / 2) * k, (self.vh - tr / 2) * k], radius=self.vw * k * 0.16,
1883:             outline=C.INSERT_GRIS + (255,), width=int(tr * k)))
1884:         self.masque = _net(self.vw, self.vh, lambda dd, k: dd.rounded_rectangle(
1885:             [tr * k, tr * k, (self.vw - tr) * k, (self.vh - tr) * k], radius=self.vw * k * 0.13,
1886:             fill=(255, 255, 255, 255))).getchannel("A")
1887:         j = self.px(g["jeton"])
1888:         jeton = _net(j, j, lambda dd, k: dd.ellipse([0, 0, j * k - 1, j * k - 1], fill=C.INSERT_VERT + (255,)))
1889:         _ecrire(ImageDraw.Draw(jeton), (j / 2, j / 2), self.spec.get("ajout", {}).get("label", ""),
1890:                 self.px(g["jeton_px"]), C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
1891:         self.jeton = _ombre_marge(jeton, self.s)
1892: 
1893:     def _t(self):
1894:         return self.t0(self.spec.get("temps", 0)) + C.INSERT_ENTREE * 0.8
1895: 
1896:     def _t_ajout(self):
1897:         return self.t0(self.spec.get("ajout", {}).get("temps", 1)) + C.INSERT_DELAI
1898: 
1899:     def _niveaux(self, t, final):
1900:         g = C.VASES_GEO
1901:         p = 1.0 if final else T.lisse((t - self._t()) / g["remplissage"])
1902:         rev = g["revenus"][0] + (g["revenus"][1] - g["revenus"][0]) * p
1903:         pen = g["pension"][0] + (g["pension"][1] - g["pension"][0]) * p
1904:         if self.spec.get("ajout"):
1905:             q = 1.0 if final else T.lisse((t - self._t_ajout() - g["chute"]) / C.INSERT_ENTREE)
1906:             rev += g["ij"] * q
1907:             pen -= g["ij"] * q
1908:         return rev, pen
1909: 
1910:     def _contenu(self, niveau, couleur, t):
1911:         """Le bocal rempli jusqu'a niveau (0 a 1), surface ondulee."""
1912:         g = C.VASES_GEO
1913:         tr = self.px(g["trait"])
1914:         haut = tr + (self.vh - 2 * tr) * (1 - niveau)
1915:         amp = self.px(g["vague"])
1916: 
1917:         def dessin(dd, k):
1918:             pts = [(x * k, (haut + amp * math.sin(2 * math.pi * (x / self.vw * g["onde"][0] + t * g["onde"][1]))) * k)
1919:                    for x in range(0, self.vw + 1, max(1, self.vw // 24))]
1920:             dd.polygon(pts + [(self.vw * k, self.vh * k), (0, self.vh * k)], fill=tuple(couleur) + (255,))
1921:         im = _net(self.vw, self.vh, dessin)
1922:         im.putalpha(ImageChops.multiply(im.getchannel("A"), self.masque))
1923:         im.alpha_composite(self.bocal)
1924:         return im
1925: 
1926:     def image(self, t, final):
1927:         g = C.VASES_GEO
1928:         k, a = _entree(t, self.t0(self.spec.get("temps", 0)), final)
1929:         if a <= 0:
1930:             return None
1931:         carte = self.fond.copy()
1932:         rev, pen = self._niveaux(t, final)
1933:         for cx, niveau, couleur in ((self.cx[0], rev, C.INSERT_VERT), (self.cx[1], pen, self.rubrique)):
1934:             v = self._contenu(niveau, couleur, 0 if final else t)
1935:             carte.alpha_composite(v, (int(round(cx - self.vw / 2)), int(round(self.fond_y - self.vh))))
1936:         d = ImageDraw.Draw(carte)
1937:         if not final:                                    # les « +1 € » et « −1 € » s'envolent
1938:             n = int(g["remplissage"] / g["envol_pas"])
1939:             for i in range(n):
1940:                 ti = self._t() + i * g["envol_pas"]
1941:                 w2 = (t - ti) / g["envol"]
1942:                 if 0 < w2 < 1:
1943:                     al = int(255 * min(1.0, w2 * 4) * (1 - w2))
1944:                     dy = self.px(g["envol_dy"]) * T.lisse(w2)
1945:                     y = self.fond_y - self.vh * 0.35 - dy
1946:                     ecart = self.vw / 2 + self.px(g["envol_ecart"])
1947:                     _ecrire(d, (self.cx[0] - ecart, y), f"+1{NBSP}€", self.px(g["envol_px"]), C.INSERT_GRAISSE_FORTE,
1948:                             C.INSERT_VERT + (al,), "rs")
1949:                     _ecrire(d, (self.cx[1] + ecart, y), f"−1{NBSP}€", self.px(g["envol_px"]), C.INSERT_GRAISSE_FORTE,
1950:                             C.INSERT_ROUGE + (al,), "ls")
1951:         _ecrire(d, ((self.cx[0] + self.cx[1]) / 2, self.fond_y - self.vh * g["egal_y"]), "=", self.px(g["egal_px"]),
1952:                 C.INSERT_GRAISSE_FORTE, C.INSERT_GRIS_TEXTE + (255,), "mm")
1953:         if self.spec.get("ajout") and not final:         # le jeton tombe dans le bocal des revenus
1954:             w2 = (t - self._t_ajout()) / g["chute"]
1955:             if 0 < w2 < g["jeton_vie"]:
1956:                 y0 = self.fond_y - self.vh - self.px(g["jeton_haut"])
1957:                 y1 = self.fond_y - self.vh * (rev + 0.1)
1958:                 y = y0 + (y1 - y0) * min(1.0, w2) ** 2
1959:                 _poser(carte, self.jeton, self.cx[0], y, 1.0, min(1.0, (g["jeton_vie"] - w2) * 3))
1960:         carte = _ombre(carte, self.s)
1961:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
1962:         _poser(out, carte, carte.width / 2, carte.height / 2, k, a)
1963:         return out
1964: 
1965:     def sons(self):
1966:         out = [(self._t(), "compteur")]
1967:         if self.spec.get("ajout"):
1968:             out.append((self._t_ajout() + C.VASES_GEO["chute"], "clic"))
1969:         return out
1970: 
