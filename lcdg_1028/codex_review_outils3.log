 290: # ------------------------------------------------------------- calendrier
 291: class Calendrier(_Insert):
 292:     """Le mois en carte, la periode qui compte surlignee, une etiquette a cote."""
 293: 
 294:     def taille_nominale(self):
 295:         lg = T.largeur(T.normaliser(self.spec.get("legende", "")), C.CAL_ETIQUETTE_PX,
 296:                        C.INSERT_GRAISSE_FORTE, 0)
 297:         self.etiquette_w0 = int(lg + 2 * C.CAL_ETIQUETTE_PAD) if self.spec.get("legende") else 0
 298:         w = C.CAL_W + (C.INSERT_ECART_ELEMENTS + self.etiquette_w0 if self.etiquette_w0 else 0)
 299:         return w, C.CAL_H
 300: 
 301:     def __init__(self, *a):
 302:         super().__init__(*a)
 303:         sp = self.spec
 304:         self.cw = self.px(C.CAL_W)
 305:         semaines = calendar.Calendar(0).monthdayscalendar(sp["annee"], sp["mois"])
 306:         g = C.CAL_GEO
 307:         pad, tete = self.px(g["pad"]), self.px(C.CAL_TETE)
 308:         jours_y = tete + self.px(g["jours_y"])
 309:         grille_y = jours_y + self.px(g["grille_y"])
 310:         cel_w = (self.cw - 2 * pad) / 7
 311:         cel_h = (self.h - grille_y - pad) / len(semaines)
 312:         self.cellules = {}
 313:         for li, sem in enumerate(semaines):
 314:             for co, jour in enumerate(sem):
 315:                 if jour:
 316:                     self.cellules[jour] = (pad + co * cel_w, grille_y + li * cel_h, cel_w, cel_h)
 317:         m = self.m
 318:         fond = _cadre(self.cw, self.h, self.s, marge=m)
 319:         d = ImageDraw.Draw(fond)
 320:         d.rounded_rectangle([m, m, m + self.cw - 1, m + tete], radius=max(4, int(C.INSERT_RAYON * self.s)),
 321:                             fill=self.rubrique + (255,))
 322:         d.rectangle([m, m + tete // 2, m + self.cw - 1, m + tete], fill=self.rubrique + (255,))
 323:         titre = f"{MOIS[sp['mois'] - 1]} {sp['annee']}".upper()
 324:         _ecrire(d, (m + self.cw / 2, m + tete / 2), titre, self.px(g["titre_px"]),
 325:                 C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
 326:         for co, j in enumerate(JOURS):
 327:             _ecrire(d, (m + pad + (co + 0.5) * cel_w, m + jours_y), j, self.px(g["jour_px"]),
 328:                     C.INSERT_GRAISSE_TEXTE, C.INSERT_GRIS_TEXTE + (255,), "mm")
 329:         self.chiffres_blancs = Image.new("RGBA", fond.size, (0, 0, 0, 0))
 330:         db = ImageDraw.Draw(self.chiffres_blancs)
 331:         for jour, (x, y, w, h) in self.cellules.items():
 332:             xy = (m + x + w / 2, m + y + h / 2)
 333:             _ecrire(d, xy, str(jour), self.px(g["numero_px"]), C.INSERT_GRAISSE_CHIFFRE,
 334:                     C.NAVY + (255,), "mm")
 335:             if sp["du"] <= jour <= sp["au"]:
 336:                 _ecrire(db, xy, str(jour), self.px(g["numero_px"]), C.INSERT_GRAISSE_FORTE,
 337:                         C.BLANC + (255,), "mm")
 338:         self.fond = _ombre(fond, self.s)
 339:         x0, y0, _, h0 = self.cellules[sp["du"]]
 340:         x1, _, w1, _ = self.cellules[sp["au"]]
 341:         r = self.px(g["bande_retrait"])
 342:         self.bande = (m + x0 + r, m + y0 + r, m + x1 + w1 - r, m + y0 + h0 - r)
 343:         self.etiquette = None
 344:         if self.etiquette_w0:
 345:             ew, eh = self.px(self.etiquette_w0), self.px(C.CAL_ETIQUETTE_H)
 346:             et = Image.new("RGBA", (ew, eh), (0, 0, 0, 0))
 347:             de = ImageDraw.Draw(et)
 348:             de.rounded_rectangle([0, 0, ew - 1, eh - 1], radius=eh // 2, fill=self.rubrique + (255,))
 349:             _ecrire(de, (ew / 2, eh / 2), sp["legende"], self.px(C.CAL_ETIQUETTE_PX),
 350:                     C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
 351:             self.etiquette = _ombre(et, self.s)
 352:             self.etiquette_c = (m + self.cw + self.px(C.INSERT_ECART_ELEMENTS) + ew / 2,
 353:                                 (self.bande[1] + self.bande[3]) / 2)
 354: 
 355:     def _temps(self):
 356:         t0 = self.t0()
 357:         balai = t0 + C.CAL_BALAYAGE_DELAI
 358:         return t0, balai, balai + C.INSERT_POUSSE
 359: 
 360:     def image(self, t, final):
 361:         t0, balai, fin_balai = self._temps()
 362:         u = 1.0 if final else (t - t0) / C.INSERT_ENTREE
 363:         if u <= 0:
 364:             return None
 365:         carte = self.fond.copy()
 366:         p = 1.0 if final else T.lisse((t - balai) / C.INSERT_POUSSE)
 367:         if p > 0:
 368:             x0, y0, x1, y1 = self.bande
 369:             xe = x0 + (x1 - x0) * p
 370:             ImageDraw.Draw(carte).rounded_rectangle([x0, y0, xe, y1],
 371:                                                     radius=self.px(C.CAL_GEO["bande_rayon"]),
 372:                                                     fill=self.rubrique + (255,))
 373:             masque = Image.new("L", carte.size, 0)
 374:             ImageDraw.Draw(masque).rectangle([x0, y0, xe, y1], fill=255)
 375:             # les jours de la periode passent en blanc, au rythme du balayage
 376:             blancs = self.chiffres_blancs.copy()
 377:             blancs.putalpha(Image.composite(blancs.getchannel("A"), masque, masque))
 378:             carte.alpha_composite(blancs)
 379:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 380:         k = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u))
 381:         _poser(out, carte, carte.width / 2, carte.height / 2, k,
 382:                1.0 if final else T.lisse(u * C.INSERT_FONDU))
 383:         if self.etiquette is not None:
 384:             v = 1.0 if final else (t - fin_balai) / C.INSERT_ENTREE
 385:             if v > 0:
 386:                 ke = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(v))
 387:                 _poser(out, self.etiquette, *self.etiquette_c, ke,
 388:                        1.0 if final else T.lisse(v * C.INSERT_FONDU))
 389:         return out
 390: 
 391:     def sons(self):
 392:         t0, balai, fin_balai = self._temps()
 393:         out = [(t0, "souffle"), (balai, "clic")]
 394:         if self.etiquette is not None:
 395:             out.append((fin_balai, "clic"))
 396:         return out
 397: 
