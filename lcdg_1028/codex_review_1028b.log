 2378:     def _t(self, i):
 2379:         """Une carte arrive avec le temps du texte de son "temps" (celui de l'insert par defaut)."""
 2380:         defaut = self.spec.get("temps", 0)
 2381:         tps = self.items[i].get("temps", defaut)
 2382:         avant = [j for j in range(i) if self.items[j].get("temps", defaut) == tps]
 2383:         return self.t0(tps) + len(avant) * C.ICONES_GEO["decalage"]
 2384: 
 2385:     def image(self, t, final):
 2386:         g = C.ICONES_GEO
 2387:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 2388:         for i, carte in enumerate(self.cartes):
 2389:             k, a = _entree(t, self._t(i), final)
 2390:             if a <= 0:
 2391:                 continue
 2392:             dy = 0 if final else C.INSERT_MONTEE * self.s * (1 - T.lisse((t - self._t(i)) / C.INSERT_ENTREE))
 2393:             cx = self.m + i * (self.cw + self.ecart) + self.cw / 2
 2394:             _poser(out, carte, cx, self.m + self.h / 2 + dy, k, a)
 2395:             if self.items[i].get("question") is False:   # une tache, pas une question ouverte
 2396:                 continue
 2397:             tq = self.t0(self.items[i]["temps_question"]) if "temps_question" in self.items[i] else \
 2398:                 self._t(i) + C.INSERT_ENTREE * 0.7
 2399:             v = 1.0 if final else (t - tq) / C.INSERT_ENTREE
 2400:             if v > 0:
 2401:                 amp, freq = C.CHOIX_GEO["balance"]
 2402:                 angle = 0.0 if final or v < 1 else amp * math.sin(2 * math.pi * freq * (t - self._t(i)))
 2403:                 kk = 0.3 + 0.7 * (1.0 if final else T.rebond(v))
 2404:                 _poser(out, self.badge, cx + self.cw / 2 - self.px(g["badge"]) * g["badge_pos"],
 2405:                        self.m + self.px(g["badge"]) * g["badge_pos"] + dy, kk, 1.0 if final else T.lisse(v * 2), angle)
 2406:         return out
 2407: 
 2408:     def sons(self):
 2409:         return [(self._t(i), "clic") for i in range(len(self.cartes))]
