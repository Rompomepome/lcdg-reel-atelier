 1341: class Appel(_Insert):
 1342:     """Ce qui arrive d'abord : un telephone qui sonne dans sa carte, une fleche, puis le
 1343:     courrier qui vole jusqu'a la sienne."""
 1344: 
 1345:     def taille_nominale(self):
 1346:         return C.TEXTE_LARGEUR, C.APPEL_H
 1347: 
 1348:     def __init__(self, *a):
 1349:         super().__init__(*a)
 1350:         g = C.APPEL_GEO
 1351:         self.etapes = self.spec["etapes"][:2]
 1352:         self.ecart = self.px(g["ecart"])
 1353:         self.cw = (self.w - self.ecart) // 2
 1354:         self.cartes = [self._carte(e) for e in self.etapes]
 1355:         self.icones = [self._icone(e.get("icone")) for e in self.etapes]
 1356:         self.ondes = self._ondes()
 1357: 
 1358:     def _icone(self, nom):
 1359:         return {"telephone": self._telephone, "infirmier": self._infirmier}.get(nom, self._enveloppe)()
 1360: 
 1361:     def _infirmier(self):
 1362:         """Un soignant en buste, la croix du soin sur la poitrine (l'infirmier en pratique avancee)."""
 1363:         g = C.APPEL_GEO
 1364:         w, h = self.px(g["infirmier"][0]), self.px(g["infirmier"][1])
 1365:         rub = tuple(self.rubrique) + (255,)
 1366: 
 1367:         def dessin(d, k):
 1368:             W, H = w * k, h * k
