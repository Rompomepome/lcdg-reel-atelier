  720: # ------------------------------------------------------------------- duel
  721: class Duel(_Insert):
  722:     """Deux cartes datees face a face (une decision, puis son contraire), un « ≠ » entre."""
  723: 
  724:     def taille_nominale(self):
  725:         return C.TEXTE_LARGEUR, C.DUEL_H
  726: 
  727:     def __init__(self, *a):
  728:         super().__init__(*a)
  729:         g = C.DUEL_GEO
  730:         self.cartes_spec = self.spec["cartes"][:2]
  731:         self.ecart = self.px(g["ecart"])
  732:         self.cw = (self.w - self.ecart) // 2
  733:         self.cartes = [self._carte(c) for c in self.cartes_spec]
  734:         r = self.px(C.DUEL_SIGNE) // 2
  735:         im = Image.new("RGBA", (2 * r + 8, 2 * r + 8), (0, 0, 0, 0))
  736:         d = ImageDraw.Draw(im)
  737:         d.ellipse([4, 4, 4 + 2 * r, 4 + 2 * r], fill=C.NAVY + (255,))
  738:         _ecrire(d, (4 + r, 4 + r), "≠", self.px(g["signe_px"]), C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
  739:         self.signe = _ombre(im, self.s)
  740: 
  741:     def _carte(self, c):
  742:         g, m = C.DUEL_GEO, self.m
  743:         im = _cadre(self.cw, self.h, self.s, marge=m)
  744:         d = ImageDraw.Draw(im)
  745:         tete = self.px(C.DUEL_TETE)
  746:         # "ok" absent : une option neutre, a la couleur de la rubrique
  747:         couleur = (self.rubrique if "ok" not in c else C.INSERT_VERT if c["ok"] else C.INSERT_ROUGE) + (255,)
  748:         rayon = max(4, int(C.INSERT_RAYON * self.s))
  749:         d.rounded_rectangle([m, m, m + self.cw - 1, m + tete], radius=rayon, fill=couleur)
  750:         d.rectangle([m, m + tete // 2, m + self.cw - 1, m + tete], fill=couleur)
  751:         _ecrire(d, (m + self.cw / 2, m + tete / 2), c["date"], self.px(C.DUEL_DATE_PX),
  752:                 C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
  753:         px = self.px(C.DUEL_TEXTE_PX)
  754:         lignes = _couper(c["texte"], px, C.INSERT_GRAISSE_FORTE, self.cw - 2 * self.px(g["pad"]))
  755:         lh = px * g["interligne"]
  756:         y0 = m + tete + (self.h - tete - lh * len(lignes)) / 2 + lh / 2
  757:         for k, ligne in enumerate(lignes):
  758:             _ecrire(d, (m + self.cw / 2, y0 + k * lh), ligne, px, C.INSERT_GRAISSE_FORTE, C.NAVY + (255,), "mm")
  759:         return _ombre(im, self.s)
  760: 
  761:     def _t(self, i):
  762:         c = self.cartes_spec[i]
  763:         precedentes = [j for j in range(i) if self.cartes_spec[j].get("temps", 0) == c.get("temps", 0)]
  764:         return self.t0(c.get("temps", 0)) + len(precedentes) * C.DUEL_DECALAGE
  765: 
  766:     def _t_signe(self):
  767:         return max(self._t(i) for i in range(len(self.cartes))) + C.DUEL_SIGNE_DELAI
  768: 
  769:     def image(self, t, final):
  770:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
  771:         for i, carte in enumerate(self.cartes):
  772:             u = 1.0 if final else (t - self._t(i)) / C.INSERT_ENTREE
  773:             if u <= 0:
  774:                 continue
  775:             sens = -1 if i == 0 else 1
  776:             dx = 0 if final else sens * C.INSERT_MONTEE * self.s * (1 - T.lisse(u))
  777:             k = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u))
  778:             cx = self.m + i * (self.cw + self.ecart) + self.cw / 2 + dx
  779:             _poser(out, carte, cx, self.m + self.h / 2, k, 1.0 if final else T.lisse(u * C.INSERT_FONDU))
  780:         v = 1.0 if final else (t - self._t_signe()) / C.INSERT_ENTREE
  781:         if v > 0 and len(self.cartes) == 2:
  782:             k = 0.3 + 0.7 * (1.0 if final else T.rebond(v))
  783:             angle = 0.0 if (final or v >= 1) else 12 * math.sin(2 * math.pi * 2 * v) * (1 - v)
  784:             _poser(out, self.signe, self.m + self.w / 2, self.m + self.h / 2, k,
  785:                    1.0 if final else T.lisse(v * C.INSERT_FONDU), angle)
  786:         return out
  787: 
  788:     def sons(self):
  789:         return [(self._t(i), "clic") for i in range(len(self.cartes))] + [(self._t_signe(), "impact")]
  790: 
  791: 
  792: # ------------------------------------------------------------------ frise
  793: class Frise(_Insert):
  794:     """Une procedure en etapes, de haut en bas : le trait descend de noeud en noeud, chaque
  795:     libelle se pose a droite de son noeud ; une etape "alerte" en rouge."""
  796: 
  797:     def _largeur_libelle(self, e, s):
  798:         graisse = C.INSERT_GRAISSE_FORTE if e.get("alerte") else C.INSERT_GRAISSE_TEXTE
  799:         return T.largeur(T.normaliser(e["label"]), max(8, int(C.FRISE_LABEL_PX * s)), graisse, 0)
  800: 
  801:     def taille_nominale(self):
  802:         g = C.FRISE_GEO
  803:         n = len(self.spec["etapes"])
  804:         larg = 2 * C.FRISE_PAD + 2 * C.FRISE_NOEUD + g["label_x"] + max(
  805:             self._largeur_libelle(e, 1.0) for e in self.spec["etapes"])
  806:         return max(int(larg), C.CHOIX_LARGEUR_MIN), 2 * C.FRISE_PAD + n * C.FRISE_LIGNE_H
  807: 
  808:     def __init__(self, *a):
  809:         super().__init__(*a)
  810:         self.etapes = self.spec["etapes"]
  811:         self.pad = self.px(C.FRISE_PAD)
  812:         self.r = self.px(C.FRISE_NOEUD)
  813:         self.lh = self.px(C.FRISE_LIGNE_H)
  814:         self.xn = self.m + self.pad + self.r
  815:         self.ys = [self.m + self.pad + self.lh * (i + 0.5) for i in range(len(self.etapes))]
  816:         self.fond = _ombre(_cadre(self.w, self.h, self.s, marge=self.m), self.s)
  817:         self.noeuds = []
  818:         for i, e in enumerate(self.etapes):
  819:             couleur = (C.INSERT_ROUGE if e.get("alerte") else self.rubrique) + (255,)
  820:             im = Image.new("RGBA", (2 * self.r + 4, 2 * self.r + 4), (0, 0, 0, 0))
  821:             d = ImageDraw.Draw(im)
  822:             d.ellipse([2, 2, 2 + 2 * self.r, 2 + 2 * self.r], fill=couleur)
  823:             _ecrire(d, (2 + self.r, 2 + self.r), "!" if e.get("alerte") else str(i + 1),
  824:                     self.px(C.FRISE_GEO["numero_px"]), C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
  825:             self.noeuds.append(im)
  826: 
  827:     def _t(self, i):
  828:         e = self.etapes[i]
  829:         precedentes = [j for j in range(i) if self.etapes[j].get("temps", 0) == e.get("temps", 0)]
  830:         return self.t0(e.get("temps", 0)) + C.INSERT_ENTREE * 0.6 + len(precedentes) * C.FRISE_DECALAGE
  831: 
  832:     def image(self, t, final):
  833:         u = 1.0 if final else (t - self.t0()) / C.INSERT_ENTREE
  834:         if u <= 0:
  835:             return None
  836:         carte = self.fond.copy()
  837:         d = ImageDraw.Draw(carte)
  838:         g = C.FRISE_GEO
  839:         trait = self.px(g["trait"])
  840:         d.line([(self.xn, self.ys[0]), (self.xn, self.ys[-1])], fill=C.INSERT_GRIS + (255,), width=trait)
  841:         for i in range(1, len(self.ys)):         # le trait colore descend jusqu'au noeud i
  842:             p = 1.0 if final else (t - (self._t(i) - C.FRISE_TRACE)) / C.FRISE_TRACE
  843:             if p > 0:
  844:                 y1 = self.ys[i - 1] + (self.ys[i] - self.ys[i - 1]) * min(1.0, p)
  845:                 couleur = (C.INSERT_ROUGE if self.etapes[i].get("alerte") else self.rubrique) + (255,)
  846:                 d.line([(self.xn, self.ys[i - 1]), (self.xn, y1)], fill=couleur, width=trait)
  847:         px = self.px(C.FRISE_LABEL_PX)
  848:         for i, e in enumerate(self.etapes):
  849:             v = 1.0 if final else (t - self._t(i)) / C.INSERT_ENTREE
  850:             if v <= 0:
  851:                 continue
  852:             k = 0.3 + 0.7 * (1.0 if final else T.rebond(v))
  853:             _poser(carte, self.noeuds[i], self.xn, self.ys[i], k, 1.0 if final else T.lisse(v * C.INSERT_FONDU))
  854:             a = int(255 * (1.0 if final else T.lisse(v * C.INSERT_FONDU)))
  855:             dx = 0 if final else -self.px(g["glisse"]) * (1 - T.lisse(v))
  856:             couleur = (C.INSERT_ROUGE if e.get("alerte") else C.NAVY) + (a,)
  857:             graisse = C.INSERT_GRAISSE_FORTE if e.get("alerte") else C.INSERT_GRAISSE_TEXTE
  858:             _ecrire(d, (self.xn + self.r + self.px(g["label_x"]) + dx, self.ys[i]), e["label"], px, graisse,
  859:                     couleur, "lm")
  860:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
  861:         k = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u))
  862:         _poser(out, carte, carte.width / 2, carte.height / 2, k, 1.0 if final else T.lisse(u * C.INSERT_FONDU))
  863:         return out
  864: 
  865:     def sons(self):
  866:         return [(self._t(i), "impact" if e.get("alerte") else "clic") for i, e in enumerate(self.etapes)]
  867: 
