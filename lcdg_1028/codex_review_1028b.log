 1446:     def image(self, t, final):
 1447:         g = C.APPEL_GEO
 1448:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 1449:         for i, carte in enumerate(self.cartes):
 1450:             u = 1.0 if final else (t - self._t(i)) / C.INSERT_ENTREE
 1451:             if u <= 0:
 1452:                 continue
 1453:             k = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u))
 1454:             dx = 0 if final or i == 0 else C.INSERT_MONTEE * self.s * (1 - T.lisse(u))
 1455:             cx = self.m + i * (self.cw + self.ecart) + self.cw / 2
 1456:             _poser(out, carte, cx + dx, self.m + self.h / 2, k, 1.0 if final else T.lisse(u * C.INSERT_FONDU))
 1457:             iy = self.m + self.px(g["icone_y"])
 1458:             icone, angle, ix = self.icones[i], 0.0, cx + dx
 1459:             if self.etapes[i].get("icone") == "telephone":
 1460:                 tau = 0.0 if final else t - self._t(i) - C.INSERT_ENTREE * 0.4
 1461:                 sonne = not final and 0 < tau < g["sonnerie"] and (tau % 0.65) < 0.45
 1462:                 if sonne:
 1463:                     angle = g["secousse"] * math.sin(2 * math.pi * 14 * tau)
 1464:                     _poser(out, self.ondes, ix, iy, 1.0, 0.55 + 0.45 * math.sin(2 * math.pi * 3 * tau) ** 2)
 1465:             elif self.etapes[i].get("icone") != "infirmier":   # le courrier arrive en vol, de la droite
 1466:                 v = 1.0 if final else (t - self._t(i) - C.INSERT_ENTREE * 0.3) / (C.INSERT_ENTREE * 1.4)
 1467:                 if v <= 0:
 1468:                     continue
 1469:                 p = 1.0 if final else T.rebond(v)
 1470:                 ix += (1 - p) * self.px(260)
 1471:                 iy -= (1 - p) * self.px(90)
 1472:                 angle = -22 * (1 - p)
 1473:             _poser(out, icone, ix, iy, k, 1.0 if final else T.lisse(u * C.INSERT_FONDU), angle)
 1474:         if len(self.cartes) == 2:                         # la fleche se trace d'une carte a l'autre
 1475:             p = 1.0 if final else (t - (self._t(1) - C.INSERT_ENTREE * 0.6)) / (C.INSERT_ENTREE * 0.6)
 1476:             x0 = self.m + self.cw + self.ecart * 0.2
 1477:             x1 = self.m + self.cw + self.ecart * 0.8
 1478:             fl = Image.new("RGBA", out.size, (0, 0, 0, 0))
 1479:             _fleche(ImageDraw.Draw(fl), x0, x1, self.m + self.h / 2, p, self.px(C.CIRCUIT_GEO["trait"]),
 1480:                     self.px(C.CIRCUIT_GEO["tete"]), C.BLANC + (255,))
 1481:             out.alpha_composite(_ombre(fl, self.s))
 1482:         return out
