  869: # ---------------------------------------------------- illustrations : outils
  870: def _net(w, h, dessiner):
  871:     """Forme sans escalier : tracee a INSERT_SURECHANTILLON fois sa taille, puis reduite.
  872:     dessiner(d, k) recoit le pinceau et le facteur k, a appliquer a toutes les longueurs."""
  873:     k = C.INSERT_SURECHANTILLON
  874:     w, h = max(1, int(round(w))), max(1, int(round(h)))
  875:     grand = Image.new("RGBA", (w * k, h * k), (0, 0, 0, 0))
  876:     dessiner(ImageDraw.Draw(grand), k)
  877:     return grand.resize((w, h), Image.LANCZOS)
  878: 
  879: 
  880: def _teinte(couleur, p):
  881:     """La couleur eclaircie vers le blanc (p = 1 : blanc)."""
  882:     return tuple(int(round(c + (255 - c) * p)) for c in couleur)
  883: 
  884: 
  885: def _ombre_marge(im, s):
  886:     """im entoure de la marge que demande son ombre, puis ombre (le centre ne bouge pas)."""
  887:     m = int(C.INSERT_OMBRE[0] * C.INSERT_MARGE_OMBRE * s) + 4
  888:     out = Image.new("RGBA", (im.width + 2 * m, im.height + 2 * m), (0, 0, 0, 0))
  889:     out.alpha_composite(im, (m, m))
  890:     return _ombre(out, s)
  891: 
  892: 
  893: def _icone_choix(ok, diametre, trait, rubrique):
  894:     """Rond a coche (ok), a croix (non), ou « ? » a la couleur de la rubrique (ok absent : une
  895:     question encore ouverte)."""
  896:     r = diametre / 2
  897:     n = int(2 * r) + 4
  898:     im = Image.new("RGBA", (n, n), (0, 0, 0, 0))
  899:     d = ImageDraw.Draw(im)
  900:     c = n / 2
--- lcdg/inserts.py:900-1100 ---
  900:     c = n / 2
  901:     fond = rubrique if ok is None else C.INSERT_VERT if ok else C.INSERT_ROUGE
  902:     d.ellipse([c - r, c - r, c + r, c + r], fill=tuple(fond) + (255,))
  903:     if ok is None:
  904:         _ecrire(d, (c, c), "?", int(r * C.CHOIX_GEO["question"]), C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
  905:     elif ok:
  906:         d.line([(c - r * 0.45, c + r * 0.02), (c - r * 0.1, c + r * 0.36), (c + r * 0.48, c - r * 0.3)],
  907:                fill=C.BLANC + (255,), width=trait, joint="curve")
  908:     else:
  909:         k = r * 0.38
  910:         d.line([(c - k, c - k), (c + k, c + k)], fill=C.BLANC + (255,), width=trait)
  911:         d.line([(c - k, c + k), (c + k, c - k)], fill=C.BLANC + (255,), width=trait)
  912:     return im
  913: 
