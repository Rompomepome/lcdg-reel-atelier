 1215:                 cy = self.m + self.h - self.fh + self.fh * g["etiquette_y"]
 1216:                 _poser(out, self.etiquette, cx, cy, kk, 1.0 if final else min(1.0, v * C.TAMPON_GEO["fondu"]))
