 2773: _BOUCLIER = [(0.5, 0.0), (0.95, 0.12), (0.95, 0.48), (0.89, 0.68), (0.76, 0.85), (0.5, 1.0), (0.24, 0.85),
 2774:              (0.11, 0.68), (0.05, 0.48), (0.05, 0.12)]
