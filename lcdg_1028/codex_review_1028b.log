 2847: # ---------------------------------------------------------------- departements
 2848: class Departements(_Insert):
 2849:     """Les departements concernes : des tuiles (numero, nom) qui se retournent l'une apres l'autre."""
 2850: 
 2851:     def taille_nominale(self):
 2852:         g = C.DEPARTEMENTS_GEO
 2853:         rangs = -(-len(self.spec["liste"]) // g["colonnes"])
 2854:         return C.TEXTE_LARGEUR, rangs * g["case_h"] + (rangs - 1) * g["ecart"]
 2855: 
 2856:     def __init__(self, *a):
 2857:         super().__init__(*a)
 2858:         g = C.DEPARTEMENTS_GEO
 2859:         self.ecart = self.px(g["ecart"])
 2860:         self.cw = (self.w - (g["colonnes"] - 1) * self.ecart) // g["colonnes"]
 2861:         self.ch = self.px(g["case_h"])
 2862:         self.tuiles = []
 2863:         for dep in self.spec["liste"]:
 2864:             im = _cadre(self.cw, self.ch, self.s, marge=self.m)
 2865:             d = ImageDraw.Draw(im)
 2866:             _ecrire(d, (self.m + self.cw / 2, self.m + self.ch * g["numero_y"]), dep["numero"],
 2867:                     self.px(g["numero_px"]), C.INSERT_GRAISSE_FORTE, tuple(self.rubrique) + (255,), "mm")
 2868:             _ecrire(d, (self.m + self.cw / 2, self.m + self.ch * g["nom_y"]), dep["nom"], self.px(g["nom_px"]),
 2869:                     C.INSERT_GRAISSE_FORTE, C.NAVY + (255,), "mm")
 2870:             self.tuiles.append(_ombre(im, self.s))
 2871: 
 2872:     def _t(self, i):
 2873:         return self.t0(self.spec.get("temps", 0)) + i * C.DEPARTEMENTS_GEO["decalage"]
 2874: 
 2875:     def image(self, t, final):
 2876:         g = C.DEPARTEMENTS_GEO
 2877:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 2878:         for i, tuile in enumerate(self.tuiles):
 2879:             p = 1.0 if final else (t - self._t(i)) / g["retourne"]
 2880:             if p <= 0:
 2881:                 continue
 2882:             ky = 1.0 if final else max(0.02, T.rebond(p))     # la tuile se retourne : elle s'ouvre en hauteur
 2883:             im = tuile.resize((tuile.width, max(1, int(tuile.height * ky))), Image.BICUBIC)
 2884:             col, rang = i % g["colonnes"], i // g["colonnes"]
 2885:             cx = self.m + col * (self.cw + self.ecart) + self.cw / 2
 2886:             cy = self.m + rang * (self.ch + self.ecart) + self.ch / 2
 2887:             T.coller(out, im, (cx - im.width / 2, cy - im.height / 2), 1.0 if final else T.lisse(p * C.INSERT_FONDU))
 2888:         return out
 2889: 
 2890:     def sons(self):
 2891:         return [(self._t(i), "clic") for i in range(len(self.tuiles))]
 2892: 
