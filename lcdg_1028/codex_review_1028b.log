+# ---------------------------------------------------------------- pilule
+class Pilule(_Insert):
+    """Une pilule seule (« Aucune rémunération prévue ») qui claque au temps "temps", ton rouge par
+    defaut : sous un dessin, elle ne cache rien, la ou un tampon couvrirait ses libelles."""
