 255: # change, chaque entrée suit son fichier, sinon la protection contre les tournages déjà vus se trompe de plan
 256: # (review Codex, 05/11/2026)
 257: REGISTRE = EP / "plans_utilises.json"
 258: registre = json.loads(REGISTRE.read_text(encoding="utf-8"))
 259: for ep in (PHARMACIEN, COTISATION, INSTALLATIONS):
 260:     d = EP / f"{ep['date']}-{ep['slug']}"
 261:     (d / "broll").mkdir(parents=True, exist_ok=True)
 262:     f = d / "script.json"
 263:     blocs_avant = json.loads(f.read_text(encoding="utf-8"))["blocs"] if f.exists() else []
 264:     par_fichier = {b["fichier"]: registre[f"{d.name}/{i}"] for i, b in enumerate(blocs_avant)
 265:                    if f"{d.name}/{i}" in registre}
 266:     for cle in [c for c in registre if c.startswith(d.name + "/")]:
 267:         del registre[cle]
 268:     for j, b in enumerate(ep["blocs"]):
 269:         if b["fichier"] in par_fichier:
 270:             registre[f"{d.name}/{j}"] = par_fichier[b["fichier"]]
 271:     # garder, plan par plan, le choix, le recadrage et le crédit déjà faits : le fichier du plan sert de clé
 272:     ancien = {a["fichier"]: a for a in blocs_avant}
 273:     for b in ep["blocs"]:
 274:         a = ancien.get(b["fichier"])
 275:         if a:
 276:             b["requete"] = a.get("requete", b["requete"])
 277:             for cle in ("cadrage", "credit"):
 278:                 if cle in a:
 279:                     b[cle] = a[cle]
 280:     f.write_text(json.dumps(ep, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
 281:     texte = " ".join((b.get("voix") or "") for b in ep["blocs"])
 282:     import re
 283:     lu = re.sub(r"\[[a-z-]+\]\s*", "", texte).replace(" | ", " ")
 284:     print(f"{d.name} : {len(ep['blocs']) - 1} plans, {len(lu)} caractères lus, environ "
 285:           f"{len(lu) / CARS_PAR_SECONDE[ep['voix_off']]:.0f} s, environ {len(lu) * 300 / 1400:.0f} crédits")
 286: # même écriture que lcdg/registre.py
 287: REGISTRE.write_text(json.dumps(dict(sorted(registre.items())), ensure_ascii=False, indent=1), encoding="utf-8")
