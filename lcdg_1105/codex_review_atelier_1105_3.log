  13: for slug in ("soins-pharmacien", "cotisation-ordre", "premieres-installations"):
  14:     s = json.loads((EP / f"2026-11-04-{slug}" / "script.json").read_text(encoding="utf-8"))
  15:     print(f"\n=== {s['label']} ({s['voix_off']}) ; couverture : {s['sous_titre'].replace('*', '')}")
  16:     for k, b in enumerate(s["blocs"]):
  17:         if k == 0:
  18:             continue
  19:         ecran = b.get("texte") or f"{b.get('prefixe', '')}{b.get('valeur', '')}{b.get('suffixe', '')} {b.get('legende', '')}"
  20:         voix = re.sub(r"\[[a-z-]+\]\s*", "", b.get("voix") or "")
  21:         print(f"B{k} ECRAN : {ecran.replace('*', '').replace(' | ', ' / ')}")
  22:         print(f"B{k} VOIX  : {voix.replace(' | ', ' ')}")
