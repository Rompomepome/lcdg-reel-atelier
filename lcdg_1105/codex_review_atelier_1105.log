 244: # caractères lus par seconde, mesurés le 05/11/2026 sur les premiers rendus de ces reels (fin de reel comprise)
 245: CARS_PAR_SECONDE = {"homme_age": 14.1, "femme_agee": 15.8, "femme_jeune": 14.6}
 246: for ep in (PHARMACIEN, COTISATION, INSTALLATIONS):
 247:     d = EP / f"{ep['date']}-{ep['slug']}"
 248:     (d / "broll").mkdir(parents=True, exist_ok=True)
 249:     f = d / "script.json"
 250:     # garder, plan par plan, le choix, le recadrage et le crédit déjà faits : le fichier du plan sert de clé
 251:     ancien = {a["fichier"]: a for a in json.loads(f.read_text(encoding="utf-8"))["blocs"]} if f.exists() else {}
 252:     for b in ep["blocs"]:
 253:         a = ancien.get(b["fichier"])
 254:         if a:
 255:             b["requete"] = a.get("requete", b["requete"])
 256:             for cle in ("cadrage", "credit"):
 257:                 if cle in a:
 258:                     b[cle] = a[cle]
 259:     f.write_text(json.dumps(ep, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
 260:     texte = " ".join((b.get("voix") or "") for b in ep["blocs"])
 261:     import re
 262:     lu = re.sub(r"\[[a-z-]+\]\s*", "", texte).replace(" | ", " ")
 263:     print(f"{d.name} : {len(ep['blocs']) - 1} plans, {len(lu)} caractères lus, environ "
 264:           f"{len(lu) / CARS_PAR_SECONDE[ep['voix_off']]:.0f} s, environ {len(lu) * 300 / 1400:.0f} crédits")
