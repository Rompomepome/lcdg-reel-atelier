1735:         bw = self.bx1 - self.bx0
1736:         rempli = bw * p
1737:         v = 0.0 if self.question is None else (1.0 if final else T.lisse((t - self._t_question()) / C.INSERT_ENTREE))
1738:         for i, seg in enumerate(self.segments):
