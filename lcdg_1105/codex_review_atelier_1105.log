  61: # version publicite d'un reel (episode a part, monte depuis la meme narration)
  62: PUB = {"7_Minimum_patients": ("2026-10-13-minimum-patients-pub", "minimum-patients-pub"),
  63:        "8_Arrets_de_travail_MSO": ("2026-10-22-arrets-travail-mso-pub", "arrets-travail-mso-pub"),
  64:        "9_Vaccins_au_cabinet": ("2026-10-22-vaccins-cabinet-pub", "vaccins-cabinet-pub"),
  65:        "10_Cumul_emploi_retraite": ("2026-10-22-cumul-emploi-retraite-pub", "cumul-emploi-retraite-pub"),
  66:        "11_Docteurs_juniors": ("2026-10-28-docteurs-juniors-pub", "docteurs-juniors-pub"),
  67:        "12_Acces_direct_IPA": ("2026-10-28-acces-direct-ipa-pub", "acces-direct-ipa-pub")}
  68: # reels 13 a 15 refaits le 05/11/2026 en moins d'une minute (Romain : « il faudrait pas qu'il depasse
  69: # 1 minute ») : leurs anciennes versions publicite portent l'ancien texte, le reel lui-meme sert de publicite
  70: # rappels deja donnes pour tous les reels : on ne les repete pas reel par reel
  71: COMMUNS = ("- étiquette « Info IA »", "- réponse en message privé")
  72: 
  73: 
  74: def sections(md):
  75:     """(a faire, instagram, linkedin, lien de bio, publicite ou None) d'un legendes.md."""
  76:     a_faire = re.search(r"avant de publier :\n(.*?)\n\n## ", md, re.S).group(1).strip()
  77:     insta = re.search(r"## Instagram[^\n]*\n(.*?)\n## ", md, re.S).group(1).strip()
  78:     # jusqu'a la section suivante : la publicite Meta, quand il y en a une, vient juste apres
  79:     linkedin = re.search(r"## LinkedIn[^\n]*\n(.*?)\n## ", md, re.S).group(1).strip()
  80:     bio = re.search(r"## Lien de la bio[^\n]*\n(.*)", md, re.S).group(1).strip()
  81:     pub = re.search(r"## Publicité[^\n]*\n(.*?)\n## ", md, re.S)
  82:     return a_faire, insta, linkedin, bio, pub.group(1).strip() if pub else None
  83: 
  84: 
  85: def propres(a_faire):
  86:     """Les points propres a ce reel (un point peut tenir sur plusieurs lignes)."""
  87:     points, courant = [], []
  88:     for ligne in a_faire.splitlines():
  89:         if ligne.startswith("- ") and courant:
  90:             points.append(courant); courant = []
  91:         courant.append(ligne)
  92:     if courant:
  93:         points.append(courant)
  94:     return ["\n".join(p) for p in points if not p[0].startswith(COMMUNS)]
  95: 
