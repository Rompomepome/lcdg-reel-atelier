  74: def sections(md):
  75:     """(a faire, instagram, linkedin, lien de bio, publicite ou None) d'un legendes.md."""
  76:     a_faire = re.search(r"avant de publier :\n(.*?)\n\n## ", md, re.S).group(1).strip()
  77:     insta = re.search(r"## Instagram[^\n]*\n(.*?)\n## ", md, re.S).group(1).strip()
  78:     # jusqu'a la section suivante : la publicite Meta, quand il y en a une, vient juste apres
  79:     linkedin = re.search(r"## LinkedIn[^\n]*\n(.*?)\n## ", md, re.S).group(1).strip()
  80:     bio = re.search(r"## Lien de la bio[^\n]*\n(.*)", md, re.S).group(1).strip()
  81:     pub = re.search(r"## Publicité[^\n]*\n(.*?)\n## ", md, re.S)
  82:     return a_faire, insta, linkedin, bio, pub.group(1).strip() if pub else None
