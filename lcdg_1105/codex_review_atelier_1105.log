"""Une seule fois, le 04/11/2026 : le bloc 9 du reel pharmacien est retiré. La narration découpée par pub.py
(aucun crédit) passe dans le cache du reel complet, et le registre des plans suit les nouveaux numéros."""
import json
import shutil
import sys
from pathlib import Path

R = Path(r"C:\Users\NR SMART\tools\lcdg-reel")
sys.path.insert(0, str(R))
from lcdg import voix

EP = R / "episodes" / "2026-11-04-soins-pharmacien"
PUB = R / "episodes" / "2026-11-04-soins-pharmacien-pub"
ep = json.loads((EP / "script.json").read_text(encoding="utf-8"))
vx = voix.choix(ep)
_, m = voix.textes(ep)
texte = " ".join(t for t, _ in m)
mp3, js = voix.chemins(texte, vx["id"], EP / "voix", vx.get("modele"), vx.get("reglages"))
src_mp3, src_js = voix.chemins(texte, vx["id"], PUB / "voix", vx.get("modele"), vx.get("reglages"))
if not (src_mp3.exists() and src_js.exists()):
    raise SystemExit(f"[!] narration découpée absente : {src_mp3}")
shutil.copyfile(src_mp3, mp3)
shutil.copyfile(src_js, js)
print("narration du reel complet :", mp3.name, f"{len(json.loads(js.read_text(encoding='utf-8'))['characters'])} caractères")

reg_f = R / "episodes" / "plans_utilises.json"
reg = json.loads(reg_f.read_text(encoding="utf-8"))
nom = EP.name
reg.pop(f"{nom}/9", None)
for vieux, neuf in ((10, 9), (11, 10)):
    if f"{nom}/{vieux}" in reg:
        reg[f"{nom}/{neuf}"] = reg.pop(f"{nom}/{vieux}")
reg_f.write_text(json.dumps(dict(sorted(reg.items())), ensure_ascii=False, indent=1), encoding="utf-8")
(EP / "broll" / "B9.mp4").unlink(missing_ok=True)
print("registre à jour")
### C:\Users\NR SMART\tools\lcdg-reel-atelier\lcdg_1104\migrer_1104.py
"""Une seule fois, le 04/11/2026 : des blocs ont été retirés des scripts après la relecture. Les plans
téléchargés, les planches de candidats et le registre des plans suivent les nouveaux numéros de blocs.
Rien n'est perdu sauf le premier candidat automatique d'un bloc retiré (retiré aussi du registre)."""
import json
from pathlib import Path

R = Path(r"C:\Users\NR SMART\tools\lcdg-reel\episodes")
# dossier : {ancien numéro de bloc : nouveau numéro} ; un bloc absent est retiré
PLANS = {
    "2026-11-04-soins-pharmacien": {0: 0, 1: 1, 2: 2, 4: 3, 5: 4, 6: 5, 7: 6, 8: 7, 9: 8, 10: 9, 11: 10, 12: 11},
    "2026-11-04-cotisation-ordre": {0: 0, 1: 1, 2: 2, 3: 3, 4: 4, 6: 5, 7: 6, 8: 7, 9: 8},
    "2026-11-04-premieres-installations": {0: 0, 1: 1, 3: 2, 4: 3, 5: 4, 6: 5, 7: 6, 8: 7, 9: 8, 10: 9},
}
reg_f = R / "plans_utilises.json"
reg = json.loads(reg_f.read_text(encoding="utf-8"))
for ep, plan in PLANS.items():
    d = R / ep / "broll"
    nb_ancien = max(max(plan), 13) + 1
    # 1. les fichiers : d'abord sous un nom provisoire, puis sous le nouveau (les numéros se chevauchent)
    for vieux in range(nb_ancien):
        (d / f"B{vieux}.jpg").unlink(missing_ok=True)
        src = d / f"B{vieux}.mp4"
        if src.exists():
            if vieux in plan:
                src.rename(d / f"tmp_{plan[vieux]}.mp4")
            else:
                src.unlink()
        for ext in ("json", "jpg"):
            c = d / "candidats" / f"{vieux}.{ext}"
            if c.exists():
                if vieux in plan:
                    c.rename(d / "candidats" / f"tmp_{plan[vieux]}.{ext}")
                else:
                    c.unlink()
    for f in d.glob("tmp_*.mp4"):
        f.rename(d / f"B{f.stem[4:]}.mp4")
    for f in (d / "candidats").glob("tmp_*.*"):
        f.rename(d / "candidats" / f"{f.stem[4:]}{f.suffix}")
    # 2. le registre
    anciennes = {k: v for k, v in reg.items() if k.startswith(ep + "/")}
    for k in anciennes:
        del reg[k]
    for k, v in anciennes.items():
        vieux = int(k.split("/")[1])
        if vieux in plan:
            reg[f"{ep}/{plan[vieux]}"] = v
    print(ep, sorted(p.name for p in d.glob("B*.mp4")), sorted(p.name for p in (d / "candidats").glob("*.jpg")))
reg_f.write_text(json.dumps(reg, ensure_ascii=False, indent=1), encoding="utf-8")
### C:\Users\NR SMART\tools\lcdg-reel-atelier\lcdg_1104\planche.py
"""Planche de contrôle d'une vidéo : une image toutes les N secondes, en grille, avec l'instant.

    python planche.py <video.mp4> <sortie.jpg> [pas=2.5] [colonnes=8] [largeur=240]"""
import json
import subprocess
import sys
from pathlib import Path

from PIL import Image, ImageDraw

video, sortie = sys.argv[1], sys.argv[2]
pas = float(sys.argv[3]) if len(sys.argv) > 3 else 2.5
cols = int(sys.argv[4]) if len(sys.argv) > 4 else 8
larg = int(sys.argv[5]) if len(sys.argv) > 5 else 240
info = json.loads(subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration:stream=width,height",
                                  "-select_streams", "v:0", "-of", "json", video],
                                 capture_output=True, text=True).stdout)
duree = float(info["format"]["duration"])
w, h = info["streams"][0]["width"], info["streams"][0]["height"]
haut = int(larg * h / w)
images = []
t = 0.5
while t < duree:
    r = subprocess.run(["ffmpeg", "-v", "error", "-ss", f"{t:.2f}", "-i", video, "-frames:v", "1",
                        "-vf", f"scale={larg}:{haut}", "-f", "image2pipe", "-vcodec", "mjpeg", "-"],
                       capture_output=True)
    if r.stdout:
        Path(sortie).with_suffix(".tmp.jpg").write_bytes(r.stdout)
        im = Image.open(Path(sortie).with_suffix(".tmp.jpg")).convert("RGB")
        ImageDraw.Draw(im).text((5, 5), f"{t:.1f}", fill=(255, 255, 0))
        images.append(im)
    t += pas
Path(sortie).with_suffix(".tmp.jpg").unlink(missing_ok=True)
rangs = (len(images) + cols - 1) // cols
feuille = Image.new("RGB", (cols * (larg + 4), rangs * (haut + 4)), (30, 30, 30))
for i, im in enumerate(images):
    feuille.paste(im, ((i % cols) * (larg + 4), (i // cols) * (haut + 4)))
feuille.save(sortie, quality=88)
print(f"{sortie} : {duree:.1f} s, {len(images)} images, {feuille.size}")
