 142:     B.run(["-f", "concat", "-safe", "0", "-i", str(liste), "-c", "copy", str(sortie), "-y"])
 143:     return sortie, bornes, round(t, 3)
 144: 
 145: 
 146: # --------------------------------------------------------------- 2. habillage
 147: def bornes_nominales(ep: dict) -> list:
 148:     """Bornes des plans selon les durees du script (les vraies sortent de base())."""
 149:     t, bornes = 0.0, []
 150:     for bl in ep["blocs"]:
 151:         bornes.append((round(t, 3), round(t + bl["duree"], 3)))
 152:         t += bl["duree"]
 153:     return bornes
 154: 
 155: 
 156: def verifier(ep: dict, bornes: list | None = None):
 157:     """Un texte trop long sortirait du recadrage 4:5 du fil ou de sa colonne : on le
 158:     verifie avant tout encodage. La mise en page ne depend pas des durees reelles, les
 159:     bornes du script suffisent quand base() n'a pas encore tourne."""
 160:     # chaque temps de l'ecran a sa phrase lue : sinon le texte et la voix se decalent
 161:     for k, bl in enumerate(ep["blocs"][1:], 1):
 162:         lu = (bl.get("voix") or "").strip()
 163:         if not lu:
 164:             continue
 165:         if bl.get("type") == "chiffre":
 166:             if "|" in lu:
 167:                 raise SystemExit(f"[!] bloc {k} : la voix d'un chiffre cle n'a qu'un temps, "
 168:                                  "retire ses « | ».")
 169:         elif lu.count("|") != (bl.get("texte") or "").count("|"):
 170:             raise SystemExit(f"[!] bloc {k} : {lu.count('|')} « | » dans la voix, "
 171:                              f"{(bl.get('texte') or '').count('|')} a l'ecran. Chaque temps de "
 172:                              "l'ecran doit avoir sa phrase lue, dans le meme ordre.")
 173:     bornes = bornes or bornes_nominales(ep)
 174:     croix = bornes[-1][0] + ep["blocs"][-1]["duree"]
 175:     hb.rubrique(ep.get("rubrique"))
 176:     carte = hb.CarteFinale(croix + C.CROIX_DUREE, ep.get("appel"))
 177:     if carte.lignes_appel > 1:
 178:         raise SystemExit(f"[!] Appel a l'action trop long pour une ligne : "
 179:                          f"« {carte.texte_appel} ». Raccourcis le champ appel de script.json.")
 180:     couches = [("logo", hb.watermark(), C.LARGEUR), ("carte finale", carte.couche(), C.LARGEUR)]
 181:     for sc in hb.scenes(ep, bornes, croix):
 182:         couches += sc.couches()
 183:     couches += [("credit", cr.couche(), C.LARGEUR) for cr in hb.credits(ep, bornes)]
 184:     les_scenes = hb.scenes(ep, bornes, croix)
 185:     ouv = hb.ouverture(ep, les_scenes)
 186:     if ouv:
 187:         couches.append(("pastille d'ouverture", ouv.couche(), hb.COLONNE))
 188:     couches += [(i.nom, i.couche(), hb.COLONNE) for i in ins.inserts(ep, les_scenes, ouv)]
 189:     if ep.get("bandeau"):
 190:         # le bandeau s'arrete avant le logo, qui garde sa place
 191:         logo_gauche = hb.watermark().getchannel("A").getbbox()[0]
 192:         couches.append(("bandeau", hb.Bandeau(ep["bandeau"], 0, 1).couche(),
 193:                         logo_gauche - C.BANDEAU_ECART_LOGO))
 194:     zones = [(nom, hb.hors_zone(lay, droite)) for nom, lay, droite in couches]
 195:     debords = [f"    {nom} : y {z[0]}-{z[1]}, x jusqu'a {z[2]}" for nom, z in zones if z]
 196:     if debords:
 197:         raise SystemExit(
 198:             f"[!] Hors de la zone sure 4:5 (y {C.ZONE_SURE_HAUT}-{C.ZONE_SURE_BAS}) "
 199:             f"ou de la colonne de texte (x <= {hb.COLONNE}) :\n"
 200:             + "\n".join(debords) + "\n    Raccourcis le texte ou le surlignage dans script.json.")
 201: 
 202: 
 203: def habiller(episode: Path, ep: dict, bornes: list, total: float) -> Path:
 204:     """Compose l'habillage image par image et l'incruste sur la base."""
 205:     n = int(round(total * C.FPS))
 206:     croix = total - (C.CROIX_DUREE + C.OUTRO_DUREE)
 207:     plein = croix + C.CROIX_DUREE
 208: 
 209:     verifier(ep, bornes)
 210:     statique = Image.new("RGBA", (C.LARGEUR, C.HAUTEUR), (0, 0, 0, 0))
 211:     statique.alpha_composite(hb.scrim())
 212:     logo = hb.watermark()
 213:     scenes = hb.scenes(ep, bornes, croix)
 214:     carte = hb.CarteFinale(plein, ep.get("appel"))
 215:     # ni pendant l'accroche, ni sur la carte finale
 216:     # le bandeau laisse l'entree du reel livre a la pastille du sujet : il arrive au plan
 217:     # suivant
 218:     debut_bandeau = bornes[2][0] if C.ACCROCHE_COUVERTURE and len(bornes) > 2 else bornes[1][0]
 219:     bandeau = (hb.Bandeau(ep["bandeau"], debut_bandeau, croix, scenes)
 220:                if ep.get("bandeau") else None)

