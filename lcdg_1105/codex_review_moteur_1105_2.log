 129:         mix.append("[sfx]")
 130:     graphe.append("".join(mix) + f"amix=inputs={len(mix)}:duration=longest:normalize=0[a]")
 131:     brute = travail / f"bande_{ep['slug']}_brute.wav"
 132:     B.run([*entrees, "-filter_complex", ";".join(graphe), "-map", "[a]",
 133:            "-ar", str(SR), "-ac", "2", "-t", f"{total:.3f}", str(brute), "-y"])
 134:     # mise au niveau final : un gain fixe, puis le limiteur pour les cretes
 135:     gain = C.SON_LUFS - sonie(brute)
