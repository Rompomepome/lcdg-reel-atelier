 282:     if f.exists():                                  # garder le plan, le recadrage et le crédit déjà choisis
 283:         ancien = json.loads(f.read_text(encoding="utf-8"))
 284:         for b, a in zip(ep["blocs"], ancien["blocs"]):
 285:             if len(ancien["blocs"]) == len(ep["blocs"]):
 286:                 b["requete"] = a.get("requete", b["requete"])
 287:             for cle in ("cadrage", "credit"):
 288:                 if cle in a:
 289:                     b[cle] = a[cle]
 290:     f.write_text(json.dumps(ep, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
 291:     texte = " ".join((b.get("voix") or "") for b in ep["blocs"])
 292:     print(f"{d.name} : {len(ep['blocs'])} blocs, {len(texte)} caractères lus")
