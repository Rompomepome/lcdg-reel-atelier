### lcdg_1104/migrer_1104.py
   1: """Une seule fois, le 04/11/2026 : des blocs ont été retirés des scripts après la relecture. Les plans
   2: téléchargés, les planches de candidats et le registre des plans suivent les nouveaux numéros de blocs.
   3: Rien n'est perdu sauf le premier candidat automatique d'un bloc retiré (retiré aussi du registre)."""
   4: import json
   5: from pathlib import Path
   6: 
   7: R = Path(r"C:\Users\NR SMART\tools\lcdg-reel\episodes")
   8: # dossier : {ancien numéro de bloc : nouveau numéro} ; un bloc absent est retiré
   9: PLANS = {
  10:     "2026-11-04-soins-pharmacien": {0: 0, 1: 1, 2: 2, 4: 3, 5: 4, 6: 5, 7: 6, 8: 7, 9: 8, 10: 9, 11: 10, 12: 11},
  11:     "2026-11-04-cotisation-ordre": {0: 0, 1: 1, 2: 2, 3: 3, 4: 4, 6: 5, 7: 6, 8: 7, 9: 8},
  12:     "2026-11-04-premieres-installations": {0: 0, 1: 1, 3: 2, 4: 3, 5: 4, 6: 5, 7: 6, 8: 7, 9: 8, 10: 9},
  13: }
  14: reg_f = R / "plans_utilises.json"
  15: reg = json.loads(reg_f.read_text(encoding="utf-8"))
  16: for ep, plan in PLANS.items():
  17:     d = R / ep / "broll"
  18:     nb_ancien = max(max(plan), 13) + 1
  19:     # 1. les fichiers : d'abord sous un nom provisoire, puis sous le nouveau (les numéros se chevauchent)
  20:     for vieux in range(nb_ancien):
  21:         (d / f"B{vieux}.jpg").unlink(missing_ok=True)
  22:         src = d / f"B{vieux}.mp4"
  23:         if src.exists():
  24:             if vieux in plan:
  25:                 src.rename(d / f"tmp_{plan[vieux]}.mp4")
  26:             else:
  27:                 src.unlink()
  28:         for ext in ("json", "jpg"):
  29:             c = d / "candidats" / f"{vieux}.{ext}"
  30:             if c.exists():
  31:                 if vieux in plan:
  32:                     c.rename(d / "candidats" / f"tmp_{plan[vieux]}.{ext}")
  33:                 else:
  34:                     c.unlink()
  35:     for f in d.glob("tmp_*.mp4"):
  36:         f.rename(d / f"B{f.stem[4:]}.mp4")
  37:     for f in (d / "candidats").glob("tmp_*.*"):
  38:         f.rename(d / "candidats" / f"{f.stem[4:]}{f.suffix}")
  39:     # 2. le registre
  40:     anciennes = {k: v for k, v in reg.items() if k.startswith(ep + "/")}
  41:     for k in anciennes:
  42:         del reg[k]
  43:     for k, v in anciennes.items():
  44:         vieux = int(k.split("/")[1])
  45:         if vieux in plan:
  46:             reg[f"{ep}/{plan[vieux]}"] = v
  47:     print(ep, sorted(p.name for p in d.glob("B*.mp4")), sorted(p.name for p in (d / "candidats").glob("*.jpg")))
  48: reg_f.write_text(json.dumps(reg, ensure_ascii=False, indent=1), encoding="utf-8")
