 136: def _proches(im: Image.Image, bande: slice, couleur) -> int:
 137:     """Pixels de la couleur du surlignage dans la bande, colonne de texte comprise."""
 138:     colonne = slice(max(0, C.TEXTE_X - C.SURLIGNE_MARGE),
 139:                     C.TEXTE_X + C.TEXTE_LARGEUR + C.SURLIGNE_MARGE)
 140:     a = np.array(im.convert("RGB")).astype(int)[bande, colonne]
 141:     return int((np.abs(a - couleur).sum(axis=2) < C.SURLIGNE_CONTROLE_ECART).sum())
