  61: SURTITRE_APPROCHE = 0.10
  62: SURTITRE_H = 64
  63: SURTITRE_PAD = 22
  64: SURTITRE_ECART = 30            # entre la pastille et l'accroche
  65: 
  66: BLOC_PX, BLOC_GRAISSE = 66, "Bold"
  67: CLE_GRAISSE = "ExtraBold"      # segment entre asterisques
  68: BLOC_INTERLIGNE = 78
