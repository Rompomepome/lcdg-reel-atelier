 251: REGISTRE = EP / "plans_utilises.json"
 252: registre = json.loads(REGISTRE.read_text(encoding="utf-8"))
 253: for ep in (PHARMACIEN, COTISATION, INSTALLATIONS):
 254:     d = EP / f"{ep['date']}-{ep['slug']}"
 255:     (d / "broll").mkdir(parents=True, exist_ok=True)
 256:     f = d / "script.json"
 257:     blocs_avant = json.loads(f.read_text(encoding="utf-8"))["blocs"] if f.exists() else []
 258:     par_fichier = {b["fichier"]: registre[f"{d.name}/{i}"] for i, b in enumerate(blocs_avant)
 259:                    if f"{d.name}/{i}" in registre}
 260:     for cle in [c for c in registre if c.startswith(d.name + "/")]:
 261:         del registre[cle]
 262:     for j, b in enumerate(ep["blocs"]):
 263:         if b["fichier"] in par_fichier:
 264:             registre[f"{d.name}/{j}"] = par_fichier[b["fichier"]]
 265:     # garder, plan par plan, le choix, le recadrage et le crédit déjà faits : le fichier du plan sert de clé
 266:     ancien = {a["fichier"]: a for a in blocs_avant}
 267:     for b in ep["blocs"]:
 268:         a = ancien.get(b["fichier"])
 269:         if a:
 270:             b["requete"] = a.get("requete", b["requete"])
 271:             for cle in ("cadrage", "credit"):
 272:                 if cle in a:
 273:                     b[cle] = a[cle]
 274:     f.write_text(json.dumps(ep, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
 275:     texte = " ".join((b.get("voix") or "") for b in ep["blocs"])
 276:     import re
 277:     lu = re.sub(r"\[[a-z-]+\]\s*", "", texte).replace(" | ", " ")
 278:     print(f"{d.name} : {len(ep['blocs']) - 1} plans, {len(lu)} caractères lus, environ "
 279:           f"{len(lu) / CARS_PAR_SECONDE[ep['voix_off']]:.0f} s, environ {len(lu) * 300 / 1400:.0f} crédits")
 280: # même écriture que lcdg/registre.py
 281: REGISTRE.write_text(json.dumps(dict(sorted(registre.items())), ensure_ascii=False, indent=1), encoding="utf-8")
### lcdg_1105/textes.py
   1: """Imprime, reel par reel, ce qu'on lit à l'écran et ce qu'on entend : le texte à valider avant la voix.
   2: 
   3:     python textes.py"""
   4: import json
   5: import re
   6: import sys
   7: from pathlib import Path
   8: 
   9: if hasattr(sys.stdout, "reconfigure"):
  10:     sys.stdout.reconfigure(encoding="utf-8", errors="replace")
  11: 
  12: EP = Path(r"C:\Users\NR SMART\tools\lcdg-reel\episodes")
  13: for slug in ("soins-pharmacien", "cotisation-ordre", "premieres-installations"):
  14:     s = json.loads((EP / f"2026-11-04-{slug}" / "script.json").read_text(encoding="utf-8"))
  15:     print(f"\n=== {s['label']} ({s['voix_off']}) ; couverture : {s['sous_titre'].replace('*', '')}")
  16:     for k, b in enumerate(s["blocs"]):
  17:         if k == 0:
  18:             continue
  19:         ecran = b.get("texte") or f"{b.get('prefixe', '')}{b.get('valeur', '')}{b.get('suffixe', '')} {b.get('legende', '')}"
  20:         voix = re.sub(r"\[[a-z-]+\]\s*", "", b.get("voix") or "")
  21:         print(f"B{k} ECRAN : {ecran.replace('*', '').replace(' | ', ' / ')}")
  22:         print(f"B{k} VOIX  : {voix.replace(' | ', ' ')}")
### lcdg_1104/cache_voix_1104.py
   1: """Vérifie, sans appeler ElevenLabs, que la narration de chaque épisode est déjà dans le cache (aucun crédit)."""
   2: import json
   3: import sys
   4: from pathlib import Path
   5: 
   6: R = Path(r"C:\Users\NR SMART\tools\lcdg-reel")
   7: sys.path.insert(0, str(R))
   8: from lcdg import voix
   9: 
  10: for nom in sys.argv[1:]:
  11:     d = R / "episodes" / nom
  12:     ep = json.loads((d / "script.json").read_text(encoding="utf-8"))
  13:     vx = voix.choix(ep)
  14:     _, m = voix.textes(ep)
  15:     mp3, js = voix.chemins(" ".join(t for t, _ in m), vx["id"], d / "voix", vx.get("modele"), vx.get("reglages"))
  16:     print(nom, "en cache" if mp3.exists() and js.exists() else "ABSENTE : serait regénérée et payée")
