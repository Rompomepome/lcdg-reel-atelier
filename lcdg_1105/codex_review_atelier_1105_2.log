  45:         for i, temps in enumerate(b["texte"].split("|")):
  46:             temps = temps.strip()
  47:             if b.get("type") == "phrase":
  48:                 _, n = hb.style_ajuste(temps)
  49:             else:
  50:                 st = hb.style_bloc()
  51:                 n = len(T.equilibrer(temps, T.mesureur(st), st["largeur"]))
  52:             if n > LIGNES_MAX:
  53:                 trop += 1
  54:                 print(f"  [!] B{k}.{i} : {n} lignes (3 au plus) : {temps}")
  55:     return trop
  56: 
  57: 
  58: if len(sys.argv) < 2:
  59:     raise SystemExit(__doc__)
  60: ok = True
  61: for d in sys.argv[1:]:
  62:     script = (R / d / "script.json").resolve()
  63:     ep = json.loads(script.read_text(encoding="utf-8"))
  64:     print(f"== {Path(d).name}")
  65:     ok &= lignes(ep) == 0
  66:     for nom, carre in (("9:16", "0"), ("carre", "1")):
  67:         r = subprocess.run([sys.executable, "-c", VERIF, str(R), str(script), carre], capture_output=True,
  68:                            text=True, encoding="utf-8", errors="replace", cwd=R)
  69:         sortie = (r.stdout + r.stderr).strip().splitlines()
  70:         print(f"  {nom:6} " + ("\n    ".join(sortie[-6:]) if r.returncode else (sortie[-1] if sortie else "?")))
  71:         ok &= r.returncode == 0
  72: sys.exit(0 if ok else 1)
--- scripts/render.py ---
   1: """
   2: Etape 2 : montage.
   3: 
   4:     python scripts/render.py episodes/2026-08-05-violences-cabinet
   5: 
   6: Normalise les B-rolls, rend l'habillage, puis controle le fichier de sortie par
   7: mesure de pixels. Le reel sort sans piste audio : la musique est posee ensuite, a part.
   8: """
   9: import sys
  10: # la console Windows est en cp1252 par defaut : les accents y provoqueraient une
  11: # UnicodeEncodeError.
  12: if hasattr(sys.stdout, "reconfigure"):
  13:     sys.stdout.reconfigure(encoding="utf-8", errors="replace")
  14: 
  15: import json, shutil, sys, time
  16: from pathlib import Path
  17: sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
  18: try:
  19:     from dotenv import load_dotenv
  20:     load_dotenv(Path(__file__).resolve().parent.parent / ".env")
  21: except ImportError:
  22:     pass
  23: from config import charte as C
  24: from lcdg import binaires as B, montage, controles, son, voix
  25: 
  26: 
  27: def main(dossier: str):
  28:     B.exiger()
  29:     episode = Path(dossier).resolve()
  30:     ep = json.loads((episode / "script.json").read_text(encoding="utf-8"))
  31:     t0 = time.time()
  32: 
  33:     print("\n1/3  normalisation des B-rolls")
  34:     montage.verifier(ep)              # avant d'encoder le moindre plan
  35:     # la voix off fixe la duree de chaque plan : elle passe avant la base
  36:     piste = voix.preparer(episode, ep) if voix.active(ep) else None
  37:     _, bornes, total = montage.base(episode, ep["blocs"])
  38:     print(f"     {len(bornes)} plans, {total:.2f} s")
  39: 
  40:     print("2/3  rendu de l'habillage")
  41:     muet = montage.habiller(episode, ep, bornes, total)
  42:     audio = son.bande(episode, ep, bornes, total, piste)   # voix, musique, bruitages
  43:     sortie = montage.finaliser(muet, episode / f"reel_{ep['slug']}.mp4", audio)
  44:     if piste:                         # voix seule, pour le montage final en musique
  45:         shutil.copy(piste, episode / piste.name)
  46: 
  47:     couv = montage.couverture(sortie)            # avant la coupe : l'accroche est en place
  48:     decalage = 0.0
  49:     if C.ACCROCHE_COUVERTURE:
  50:         decalage = bornes[1][0]
  51:         montage.couper_accroche(sortie, decalage)
  52: 
  53:     print("3/3  controles")
  54:     # sur le fichier livre, apres la coupe ; l'accroche coupee se controle sur la couverture
  55:     conforme = controles.rapport(sortie, ep, bornes, decalage, couv[0])
  56: 
  57:     print(f"\n{sortie}\n" + "\n".join(map(str, couv)) + f"   ({time.time()-t0:.0f} s)")
  58:     sys.exit(0 if conforme else 2)
  59: 
  60: 
  61: if __name__ == "__main__":
  62:     if len(sys.argv) < 2:
  63:         raise SystemExit("usage : python scripts/render.py episodes/<dossier>")
  64:     main(sys.argv[1])
--- scripts/prepare.py ---
   1: """
   2: Etape 1 : recuperation des candidats et preparation de la validation.
   3: 
   4:     python scripts/prepare.py episodes/2026-08-05-violences-cabinet
   5: 
   6: Lit script.json, interroge Pexels pour chaque bloc, telecharge les candidats et
   7: construit une planche contact. Ne monte rien.
   8: """
   9: import sys
  10: # la console Windows est en cp1252 par defaut : les accents y provoqueraient une
  11: # UnicodeEncodeError.
  12: if hasattr(sys.stdout, "reconfigure"):
  13:     sys.stdout.reconfigure(encoding="utf-8", errors="replace")
  14: 
  15: import json
  16: import sys
  17: from pathlib import Path
  18: 
  19: from PIL import Image, ImageDraw
  20: 
  21: sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
  22: try:
  23:     from dotenv import load_dotenv
  24:     load_dotenv(Path(__file__).resolve().parent.parent / ".env")
  25: except ImportError:
  26:     pass
  27: 
  28: from lcdg import binaires as B
  29: from lcdg import pexels, registre
  30: from lcdg.logo import police
  31: 
  32: 
  33: def planche(episode: Path, blocs: list[dict]):
  34:     """Une vignette par bloc, avec la requete et le texte, pour valider d'un coup d'oeil."""
  35:     cases, lg = [], police(20, "SemiBold")
  36:     for i, bl in enumerate(blocs):
  37:         v = episode / "broll" / bl["fichier"]
  38:         img = episode / "broll" / f"{v.stem}.jpg"
  39:         if v.exists() and not img.exists():
  40:             B.run(["-ss", "1.5", "-i", str(v), "-frames:v", "1",
  41:                    "-vf", "scale=300:-1", str(img), "-y"])
  42:         cases.append((img if img.exists() else None, bl))
  43: 
  44:     cols = 3
  45:     lignes = (len(cases) + cols - 1) // cols
  46:     W, Hc = 330, 260
  47:     sheet = Image.new("RGB", (cols * W, lignes * Hc), (245, 245, 248))
  48:     d = ImageDraw.Draw(sheet)
  49:     for i, (img, bl) in enumerate(cases):
  50:         x, y = (i % cols) * W + 10, (i // cols) * Hc + 10
  51:         if img:
  52:             v = Image.open(img)
  53:             v.thumbnail((300, 170))
  54:             sheet.paste(v, (x, y))
  55:         d.text((x, y + 176), f"[{i}] {bl['requete'][:38]}", font=lg, fill=(10, 10, 10))
  56:         txt = (bl.get("texte") or bl.get("legende") or "(accroche)").replace("*", "").replace("|", "")
  57:         d.text((x, y + 200), txt[:44], font=lg, fill=(90, 90, 100))
  58:         d.text((x, y + 222), txt[44:88], font=lg, fill=(90, 90, 100))
  59:     out = episode / "planche_broll.jpg"
  60:     sheet.save(out, quality=92)
  61:     return out
  62: 
  63: 
  64: def main(dossier: str):
  65:     B.exiger()
  66:     episode = Path(dossier).resolve()
  67:     fiche = episode / "script.json"
  68:     if not fiche.exists():
  69:         raise SystemExit(f"[!] {fiche} introuvable. Copie episodes/exemple/script.json.")
  70:     ep = json.loads(fiche.read_text(encoding="utf-8"))
  71:     (episode / "broll").mkdir(parents=True, exist_ok=True)
  72: 
  73:     print(f"\n{ep['label']} — {len(ep['blocs'])} plans\n")
  74:     rapport = []
  75:     for i, bl in enumerate(ep["blocs"]):
  76:         bl["fichier"] = bl.get("fichier") or f"B{i}.mp4"
  77:         cible = episode / "broll" / bl["fichier"]
  78:         if cible.exists():
  79:             print(f"  [{i}] deja present : {bl['fichier']}")
  80:             continue
  81:         # un plan deja monte dans un autre reel est ecarte : le public le reconnaitrait
  82:         pris = registre.ids_utilises(sauf=f"{episode.name}/{i}")
  83:         cands = [c for c in pexels.chercher(bl["requete"], n=8,
  84:                                             duree_min=max(6, int(bl["duree"]) + 2))
  85:                  if c["id"] not in pris][:4]
  86:         if not cands:
  87:             print(f"  [{i}] AUCUN resultat pour « {bl['requete']} » — reformule la requete")
  88:             continue
  89:         c = cands[0]
  90:         pexels.telecharger(c, cible)
  91:         registre.inscrire(episode.name, i, c)
  92:         note = pexels.qualite(c)
  93:         rapport.append((i, bl["requete"], c, note))
  94:         print(f"  [{i}] {bl['requete'][:34]:34} -> {c['largeur']}x{c['hauteur']}  {note}")
  95:         alt = episode / "broll" / "alternatives.json"
  96:         anciens = json.loads(alt.read_text(encoding="utf-8")) if alt.exists() else {}
  97:         anciens[str(i)] = cands
  98:         alt.write_text(json.dumps(anciens, ensure_ascii=False, indent=1), encoding="utf-8")
  99: 
 100:     fiche.write_text(json.dumps(ep, ensure_ascii=False, indent=2), encoding="utf-8")
 101:     p = planche(episode, ep["blocs"])
 102: 
 103:     faibles = [r for r in rapport if "molle" in r[3]]
 104:     if faibles:
 105:         print("\n  A surveiller, ces plans seront mous apres recadrage :")
 106:         for i, req, c, _ in faibles:
 107:             print(f"    [{i}] {req} — {c['url_page']}")
 108: 
 109:     print(f"\nA valider :\n  {p}")
 110:     print("\nPour changer un plan :")
 111:     print(f'  python scripts/broll.py chercher {dossier} <bloc> "<requete>" ["<requete>" ...]')
 112:     print(f"  python scripts/broll.py choisir  {dossier} <bloc> C<n>")
 113:     print("Puis controle chaque plan sur toute sa duree :")
 114:     print(f"  python scripts/broll.py revue {dossier}")
 115:     print(f"  python scripts/render.py {dossier}\n")
 116: 
 117: 
 118: if __name__ == "__main__":
 119:     if len(sys.argv) < 2:
 120:         raise SystemExit("usage : python scripts/prepare.py episodes/<dossier>")
 121:     main(sys.argv[1])
--- lcdg/controles.py ---
   1: """
   2: Controles automatiques sur le fichier de sortie.
   3: 
   4: Ils existent a cause d'un bug reel : une valeur codee en dur dans le script de rendu
   5: ecrasait la taille du logo definie dans la charte. L'apercu montrait la bonne taille,
   6: la video non, et l'erreur a survecu a quatre corrections. On ne verifie donc plus
   7: sur un apercu, mais par mesure de pixels sur le fichier livre.
   8: """
   9: import subprocess
  10: import sys
  11: from pathlib import Path
  12: 
  13: import numpy as np
  14: from PIL import Image
  15: 
  16: sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
  17: from config import charte as C
  18: from lcdg import binaires as B
  19: from lcdg import habillage as hb
  20: from lcdg import son
  21: 
  22: 
  23: def _frame(video: Path, t: float) -> Image.Image | None:
  24:     tmp = video.parent / f"_ctrl_{int(t*100)}.png"
  25:     B.run(["-ss", str(t), "-i", str(video), "-frames:v", "1", str(tmp), "-y"])
  26:     if not tmp.exists():
  27:         return None
  28:     im = Image.open(tmp).copy()
  29:     tmp.unlink(missing_ok=True)
  30:     return im
  31: 
  32: 
  33: def _instants(video: Path, n: int = 4) -> list[float]:
  34:     """Points de mesure repartis dans la zone qui porte du texte.
  35: 
  36:     On evite l'accroche et l'outro (fond navy), et surtout on cale sur la duree
  37:     reelle : des instants codes en dur cassent sur une video courte.
  38:     """
  39:     d = B.duree(video)
  40:     debut = min(4.6, d * 0.30)   # apres l'accroche
  41:     fin = max(debut + 0.5, d - (C.CROIX_DUREE + C.OUTRO_DUREE + 1.0))
  42:     if fin <= debut:
  43:         debut, fin = d * 0.25, d * 0.75
  44:     pas = (fin - debut) / max(1, n - 1)
  45:     return [round(debut + i * pas, 2) for i in range(n)]
  46: 
  47: 
  48: def mesurer_logo(video: Path, instants=None) -> tuple[int, int, int]:
  49:     """Intersection des zones claires sur plusieurs plans.
  50: 
  51:     Mesurer sur une seule image est piegeux : un ciel ou une blouse dans le coin
  52:     superieur droit se fait compter comme du logo. Le logo, lui, est le seul element
  53:     clair present au meme endroit sur TOUS les plans.
  54: 
  55:     Retourne (hauteur, largeur, ordonnee du haut) en pixels de l'image.
  56:     """
  57:     haut = max(0, C.LOGO_Y - 34)
  58:     commun = None
  59:     # 6 plans et non 4 : le 04/11/2026, les 4 instants du carre tombaient tous sur un insert clair sous le
  60:     # logo (238 px mesures pour un logo de 124 px, conforme a l'image)
  61:     for t in (instants or _instants(video, 6)):
  62:         im = _frame(video, t)
  63:         if im is None:
  64:             continue
  65:         g = np.array(im.convert("L")).astype(float)
  66:         masque = g[haut:C.LOGO_Y + C.LOGO_PX + 116, C.LARGEUR // 2:] > 200
  67:         commun = masque if commun is None else (commun & masque)
  68:     if commun is None:
  69:         return (0, 0, 0)
  70:     ys, xs = np.where(commun)
  71:     if not len(ys):
  72:         return (0, 0, 0)
  73:     return int(ys.max() - ys.min() + 1), int(xs.max() - xs.min() + 1), haut + int(ys.min())
  74: 
  75: 
  76: def mesurer_hors_zone(video: Path) -> int:
  77:     """Pixels clairs hors de la zone sure 4:5 sur la carte finale.
  78: 
  79:     La carte est un aplat navy : au-dessus et en dessous de la zone sure, tout pixel
  80:     clair est un element (logo, slogan, mention) qui serait coupe dans le fil.
  81:     """
  82:     im = _frame(video, max(0.0, B.duree(video) - 0.2))
  83:     if im is None:
  84:         return -1
  85:     g = np.array(im.convert("L"))
  86:     dehors = np.concatenate([g[:C.ZONE_SURE_HAUT].ravel(), g[C.ZONE_SURE_BAS:].ravel()])
  87:     return int((dehors > 90).sum())
  88: 
  89: 
  90: def pistes_audio(video: Path) -> int:
  91:     """Nombre de pistes audio du fichier livre : une avec la voix off, aucune sinon."""
  92:     sortie = B.probe(video, "stream=codec_type")
  93:     return sum(1 for ligne in sortie.splitlines() if ligne.strip() == "audio")
  94: 
  95: 
  96: def mesurer_voix(video: Path) -> dict:
  97:     """Loudness integree et true peak de la piste audio (la voix seule)."""
  98:     r = subprocess.run([B.FFMPEG, "-hide_banner", "-i", str(video), "-af",
  99:                         f"loudnorm=I={C.VOIX_LUFS}:TP={C.VOIX_TP_CIBLE}:print_format=summary",
 100:                         "-f", "null", "-"], capture_output=True, text=True)
 101:     out = {}
 102:     for ligne in r.stderr.splitlines():
 103:         if "Input Integrated" in ligne:
 104:             out["lufs"] = float(ligne.split(":")[1].replace("LUFS", "").strip())
 105:         if "Input True Peak" in ligne:
 106:             out["tp"] = float(ligne.split(":")[1].replace("dBTP", "").strip())
 107:     return out
 108: 
 109: 
 110: def _temps_surlignes(ep: dict, bornes: list) -> list:
 111:     """[(nom, texte anime, bande de l'image)] des temps de texte qui portent un surlignage :
 112:     l'accroche, chaque temps d'un bloc, la legende d'un chiffre. Instants et positions
 113:     viennent des scenes de l'habillage : le controle suit ce qui a ete dessine."""
 114:     hb.rubrique(ep.get("rubrique"))
 115:     blocs = ep["blocs"]
 116:     croix = bornes[-1][0] + blocs[-1]["duree"]
 117:     bande_bloc = slice(C.BLOC_Y, C.BLOC_Y + 4 * C.BLOC_INTERLIGNE)
 118:     demi = 2 * C.ACCROCHE_INTERLIGNE
 119:     bande_phrase = slice(C.ACCROCHE_CENTRE - demi, C.ACCROCHE_CENTRE + demi)
 120:     out = []
 121:     for k, sc in enumerate(hb.scenes(ep, bornes, croix)):
 122:         if isinstance(sc, hb.Accroche):
 123:             st, n = hb.style_ajuste(ep["sous_titre"])
 124:             haut = sc.y + C.SURTITRE_H + C.SURTITRE_ECART
 125:             out.append(("accroche", sc.texte,
 126:                         slice(haut, haut + n * st["interligne"] + C.SURLIGNE_MARGE)))
 127:         elif isinstance(sc, hb.Chiffre):
 128:             out.append((f"bloc {k}", sc.legende, bande_bloc))
 129:         else:
 130:             for i, part in enumerate(sc.parts):
 131:                 nom = f"bloc {k}" + (f" (temps {i + 1})" if len(sc.parts) > 1 else "")
 132:                 out.append((nom, part, bande_phrase if sc.grand else bande_bloc))
 133:     return [(nom, cine, bande) for nom, cine, bande in out if cine.marques]
 134: 
 135: 
 136: def _proches(im: Image.Image, bande: slice, couleur) -> int:
 137:     """Pixels de la couleur du surlignage dans la bande, colonne de texte comprise."""
 138:     colonne = slice(max(0, C.TEXTE_X - C.SURLIGNE_MARGE),
 139:                     C.TEXTE_X + C.TEXTE_LARGEUR + C.SURLIGNE_MARGE)
 140:     a = np.array(im.convert("RGB")).astype(int)[bande, colonne]
 141:     return int((np.abs(a - couleur).sum(axis=2) < C.SURLIGNE_CONTROLE_ECART).sum())
 142: 
 143: 
 144: def mesurer_surlignages(video: Path, ep: dict, bornes: list, decalage: float = 0.0,
 145:                         couverture: Path | None = None) -> tuple[int, list]:
 146:     """(temps controles, temps ou le surlignage manque).
 147: 
 148:     Le controle du texte sur le fichier livre : pour chaque temps qui porte un surlignage,
 149:     on cherche la couleur de la rubrique dans la bande ou ce texte est pose, juste avant sa
 150:     sortie. Un texte decale, mal colore ou absent fait echouer le temps. decalage : debut
 151:     du fichier livre dans le montage (l'accroche coupee) ; ce qui le precede se controle
 152:     sur l'image de couverture."""
 153:     couleur = np.array(C.RUBRIQUES.get(ep.get("rubrique") or "pro", C.PRIMARY))
 154:     n, manques = 0, []
 155:     for nom, cine, bande in _temps_surlignes(ep, bornes):
 156:         t = max(cine.debut, cine.fin - C.SORTIE_DUREE - 0.1)
 157:         if t < decalage:
 158:             if not (couverture and Path(couverture).exists()):
 159:                 continue
 160:             im = Image.open(couverture)
 161:         else:
 162:             im = _frame(video, t - decalage)
 163:         if im is None:
 164:             continue
 165:         n += 1
 166:         proches = _proches(im, bande, couleur)
 167:         if proches < C.SURLIGNE_CONTROLE_MIN:
 168:             manques.append(f"{nom} ({proches} px)")
 169:     return n, manques
 170: 
 171: 
 172: def rapport(video: Path, ep: dict | None = None, bornes: list | None = None,
 173:             decalage: float = 0.0, couverture: Path | None = None) -> bool:
 174:     """Affiche le bilan et retourne True si tout est conforme. Avec le script et les
 175:     bornes des plans, controle aussi la duree et le texte (surlignages) du fichier livre.
 176:     decalage : debut du fichier livre dans le montage, quand l'accroche a ete coupee ; elle
 177:     se controle alors sur la couverture."""
 178:     lh, _, ly = mesurer_logo(video)
 179:     hz = mesurer_hors_zone(video)
 180:     pa = pistes_audio(video)
 181:     lignes, ok = [], True
 182: 
 183:     def check(nom, valeur, attendu, tol, unite=""):
 184:         nonlocal ok
 185:         bon = abs(valeur - attendu) <= tol
 186:         ok = ok and bon
 187:         lignes.append(f"  {'OK ' if bon else 'ECHEC'}  {nom:22} {valeur}{unite} "
 188:                       f"(attendu {attendu}{unite} ±{tol})")
 189: 
 190:     check("logo (hauteur)", lh, C.LOGO_PX, 8, " px")
 191:     check("logo (position)", ly, C.LOGO_Y, 8, " px")
 192:     check("hors zone 4:5 (fin)", hz, 0, 0, " px")
 193:     avec_voix = ep is not None and any((bl.get("voix") or "").strip() for bl in ep["blocs"])
 194:     avec_fond = ep is not None and son.musique(ep) is not None
 195:     check("pistes audio", pa, 1 if (avec_voix or avec_fond) else 0, 0)
 196:     if avec_voix or avec_fond:
 197:         # voix seule : -16 LUFS ; avec la musique et les bruitages, le mixage vise -14
 198:         cible, plafond = (C.SON_LUFS, C.SON_TP_PLAFOND) if avec_fond else (C.VOIX_LUFS, C.VOIX_TP_PLAFOND)
 199:         mv = mesurer_voix(video)
 200:         check("son (loudness)", mv.get("lufs", 0), cible, C.VOIX_LUFS_TOLERANCE, " LUFS")
 201:         tp = mv.get("tp", 0)
 202:         bon = tp <= plafond
 203:         ok = ok and bon
 204:         lignes.append(f"  {'OK ' if bon else 'ECHEC'}  {'son (true peak)':22} {tp} dBTP "
 205:                       f"(plafond {plafond} dBTP)")
 206:     if ep is not None and bornes:
 207:         check("duree", round(B.duree(video), 2), round(bornes[-1][1] - decalage, 2), 0.1, " s")
 208:         n, manques = mesurer_surlignages(video, ep, bornes, decalage, couverture)
 209:         bon = not manques
 210:         ok = ok and bon
 211:         lignes.append(f"  {'OK ' if bon else 'ECHEC'}  {'surlignages':22} {n - len(manques)}/{n}"
 212:                       + (f" — absents : {', '.join(manques)}" if manques else ""))
 213: 
 214:     print("\nControles sur le fichier livre :")
 215:     print("\n".join(lignes))
 216:     print("  ->", "conforme" if ok else "NON CONFORME, ne pas publier en l'etat")
 217:     return ok
--- lcdg/son.py ---
   1: """
   2: Bande son du reel : voix off, musique de fond et bruitages cales sur le motion.
   3: 
   4: La musique s'efface sous la voix (compression declenchee par la voix) et suit la duree
   5: du reel. Les bruitages tombent sur les instants des animations, calcules sur les memes
   6: scenes que l'image (habillage.evenements) : ils restent synchrones quoi qu'il arrive.
   7: Musique et bruitages vivent dans assets/ (non versionnes). S'ils manquent, le reel sort
   8: avec la seule voix ; sans voix ni musique, il sort muet.
   9: """
  10: import re
  11: import subprocess
  12: import sys
  13: from pathlib import Path
  14: 
  15: import numpy as np
  16: 
  17: sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
  18: from config import charte as C
  19: from lcdg import binaires as B
  20: from lcdg import habillage as hb
  21: 
  22: SR = 48000
  23: 
  24: 
  25: def musique(ep: dict) -> Path | None:
  26:     """Morceau de fond : celui du script ("musique", un fichier de assets/audio, avec ou
  27:     sans .mp3), sinon celui de la charte ; "musique": false le retire. Un morceau nomme
  28:     par le script et introuvable arrete le rendu ; celui de la charte absent (assets/audio
  29:     n'est pas versionne) est signale, et le reel sort avec la seule voix."""
  30:     choix = ep.get("musique", C.MUSIQUE_DEFAUT)
  31:     if not choix:
  32:         return None
  33:     f = C.AUDIO / choix
  34:     if not f.suffix:
  35:         f = f.with_suffix(".mp3")
  36:     if f.exists():
  37:         return f
  38:     if "musique" in ep:
  39:         raise SystemExit(f"[!] Musique « {choix} » introuvable dans assets/audio : mets le nom "
  40:                          "d'un fichier present, ou \"musique\": false pour un reel sans musique.")
  41:     print(f"[i] Musique de la charte absente ({f.name} dans assets/audio) : le reel sort sans "
  42:           "musique.")
  43:     return None
  44: 
  45: 
  46: def _pcm(f: Path) -> np.ndarray:
  47:     brut = subprocess.run([B.FFMPEG, "-v", "error", "-i", str(f), "-ac", "2", "-ar", str(SR),
  48:                            "-f", "f32le", "-"], capture_output=True).stdout
  49:     return np.frombuffer(brut, dtype=np.float32).reshape(-1, 2).astype(np.float64)
  50: 
  51: 
  52: def _ecrire(a: np.ndarray, dest: Path) -> Path:
  53:     subprocess.run([B.FFMPEG, "-v", "error", "-f", "f32le", "-ar", str(SR), "-ac", "2",
  54:                     "-i", "-", str(dest), "-y"], input=a.astype(np.float32).tobytes(), check=True)
  55:     return dest
  56: 
  57: 
  58: def sonie(f: Path, filtre: str = "") -> float:
  59:     """Sonie integree (LUFS) d'un fichier audio, apres un filtre facultatif."""
  60:     af = (filtre + "," if filtre else "") + "ebur128=framelog=quiet"
  61:     err = subprocess.run([B.FFMPEG, "-hide_banner", "-nostats", "-i", str(f), "-af", af,
  62:                           "-f", "null", "-"], capture_output=True, text=True).stderr
  63:     mesures = re.findall(r"I:\s+(-?\d+(?:\.\d+)?) LUFS", err)
  64:     if not mesures:
  65:         raise RuntimeError(f"sonie illisible pour {f}")
  66:     return float(mesures[-1])
  67: 
  68: 
  69: def effets(ep: dict, bornes: list, total: float, dest: Path) -> Path | None:
  70:     """Piste des bruitages, de la duree du reel. None si la banque est absente."""
  71:     croix = total - (C.CROIX_DUREE + C.OUTRO_DUREE)
  72:     piste = np.zeros((int(total * SR) + SR, 2))
  73:     sons, poses = {}, 0
  74:     for t, nom in hb.evenements(ep, bornes, croix):
  75:         f = C.SFX / f"{nom}.mp3"
  76:         if not f.exists():
  77:             continue
  78:         if nom not in sons:
  79:             a = _pcm(f)
  80:             # chaque son est ramene au meme sommet, puis au niveau voulu par la charte
  81:             sons[nom] = a / (np.abs(a).max() + 1e-9) * 10 ** (C.SFX_GAINS[nom] / 20)
  82:         a = sons[nom]
  83:         i = int(max(0.0, t) * SR)
  84:         j = min(len(piste), i + len(a))
  85:         piste[i:j] += a[:j - i]
  86:         poses += 1
  87:     if not poses:
  88:         return None
  89:     return _ecrire(piste[:int(total * SR)], dest)
  90: 
  91: 
  92: def bande(episode: Path, ep: dict, bornes: list, total: float, voix: Path | None) -> Path | None:
  93:     """Mixe voix, musique (sous la voix) et bruitages en une piste stereo 48 kHz au niveau
  94:     de la charte. None si le reel n'a ni voix ni musique."""
  95:     # Gain fixe partout : une normalisation dynamique (loudnorm) au milieu du graphe
  96:     # remonte les fondus et decale la piste qu'elle traite (02/10/2026, la musique
  97:     # disparaissait 2,7 s avant la fin du reel).
  98:     fond = musique(ep)
  99:     if voix is None and fond is None:
 100:         return None
 101:     travail = episode / "voix"
 102:     travail.mkdir(parents=True, exist_ok=True)
 103:     sfx = effets(ep, bornes, total, travail / "effets.wav")
 104:     entrees, graphe, mix = [], [], []
 105:     if voix is not None:
 106:         entrees += ["-i", str(voix)]
 107:         graphe.append(f"[{len(entrees) // 2 - 1}:a]apad,atrim=0:{total:.3f},asplit=2[voix][cle]")
 108:         mix.append("[voix]")
 109:     if fond is not None:
 110:         entrees += ["-i", str(fond)]
 111:         k = len(entrees) // 2 - 1
 112:         extrait = f"aresample={SR},atrim=0:{total:.3f},asetpts=N/SR/TB"
 113:         gain = C.MUSIQUE_LUFS - sonie(fond, extrait)
 114:         graphe.append(f"[{k}:a]{extrait},volume={gain:.2f}dB,"
 115:                       f"afade=t=in:st=0:d={C.MUSIQUE_FONDU_IN},"
 116:                       f"afade=t=out:st={max(0.0, total - C.MUSIQUE_FONDU_OUT):.3f}:"
 117:                       f"d={C.MUSIQUE_FONDU_OUT}[fond]")
 118:         if voix is not None:
 119:             # la musique s'efface quand la voix parle
 120:             graphe.append(f"[fond][cle]sidechaincompress={C.MUSIQUE_DUCKING}[fond_d]")
 121:             mix.append("[fond_d]")
 122:         else:
 123:             mix.append("[fond]")
 124:     elif voix is not None:
 125:         graphe[-1] = graphe[-1].replace(",asplit=2[voix][cle]", "[voix]")
 126:     if sfx is not None:
 127:         entrees += ["-i", str(sfx)]
 128:         graphe.append(f"[{len(entrees) // 2 - 1}:a]apad,atrim=0:{total:.3f}[sfx]")
 129:         mix.append("[sfx]")
 130:     graphe.append("".join(mix) + f"amix=inputs={len(mix)}:duration=longest:normalize=0[a]")
 131:     brute = travail / f"bande_{ep['slug']}_brute.wav"
 132:     B.run([*entrees, "-filter_complex", ";".join(graphe), "-map", "[a]",
 133:            "-ar", str(SR), "-ac", "2", "-t", f"{total:.3f}", str(brute), "-y"])
 134:     # mise au niveau final : un gain fixe, puis le limiteur pour les cretes
 135:     gain = C.SON_LUFS - sonie(brute)
 136:     dest = travail / f"bande_{ep['slug']}.wav"
 137:     # "son_limite_db" : limiteur plus bas pour un reel dont l'encodage AAC depasse le plafond sur une
 138:     # attaque de voix (2 dB sur le premier mot du reel pharmacien, 05/11/2026)
 139:     limite = ep.get("son_limite_db", C.SON_TP_CIBLE)
 140:     B.run(["-i", str(brute), "-af",
 141:            f"volume={gain:.2f}dB,alimiter=limit={10 ** (limite / 20):.3f}:level=false,"
 142:            f"aresample={SR}", "-ar", str(SR), "-ac", "2", str(dest), "-y"])
 143:     brute.unlink(missing_ok=True)
 144:     return dest
--- config/charte.py ---
   1: """
   2: Charte visuelle et sonore du reel LCDG.
   3: 
   4: Toutes ces valeurs ont ete validees une par une avec Romain.
   5: Ne les modifier qu'a la demande explicite : le gabarit est fige.
   6: """
   7: from pathlib import Path
   8: 
   9: RACINE = Path(__file__).resolve().parent.parent
  10: ASSETS = RACINE / "assets"
  11: POLICE = ASSETS / "fonts" / "Montserrat.ttf"
  12: LOGO_SRC = ASSETS / "logo" / "LOGO_LCDG.png"
  13: AUDIO = ASSETS / "audio"        # musiques (non versionnees : licences)
  14: SFX = ASSETS / "sfx"            # bruitages de motion (non versionnes)
  15: EPISODES = RACINE / "episodes"
  16: 
  17: # ---------------------------------------------------------------- format
  18: LARGEUR, HAUTEUR, FPS = 1080, 1920, 30
  19: 
  20: # Zone sure 4:5. Le fil Instagram et Facebook recadre le reel en 4:5 (1080x1350,
  21: # centre) : tout ce qui doit rester lisible tient dans cette bande. Adoptee le
  22: # 17/09/2026 a la demande de Romain, le logo a 44 px du haut sortait du recadrage.
  23: # Le 9:16 est conserve pour garder le plein ecran dans l'onglet Reels.
  24: ZONE_SURE_HAUT = (HAUTEUR - LARGEUR * 5 // 4) // 2   # 285
  25: ZONE_SURE_BAS = ZONE_SURE_HAUT + LARGEUR * 5 // 4    # 1635
  26: 
  27: # ------------------------------------------------- couleurs (theme.css du site)
  28: PRIMARY = (4, 123, 191)      # --primary        #047bbf
  29: STRONG = (3, 99, 153)        # --primary-strong #036399  (reserve, non utilise au montage)
  30: NAVY = (27, 16, 70)          # --titles         #1b1046
  31: BLANC = (255, 255, 255)
  32: RADIUS = 16                  # --radius .625rem, remis a l'echelle du 1080
  33: 
  34: # Couleur de bandeau par rubrique du site. Le reel prend celle de l'article.
  35: RUBRIQUES = {
  36:     "pro": (4, 123, 191),        # #047bbf  Vie Pro & Metier
  37:     "politique": (79, 70, 229),  # #4f46e5
  38:     "clinique": (5, 150, 105),   # #059669
  39:     "numerique": (124, 58, 237), # #7c3aed
  40:     "patient": (225, 29, 72),    # #e11d48
  41: }
  42: 
  43: # ------------------------------------------------------------- typographie
  44: # Style v2, propose le 01/10/2026 : plus de contour bleu ni de filet blanc, qui
  45: # dataient le rendu. Le texte tient par une ombre douce et le voile sombre ; la
  46: # hierarchie passe par la taille et la graisse, comme les titres du site
  47: # (Montserrat 700, interlettrage resserre de -0,01 a -0,02 em).
  48: # Marge laterale : sur un telephone plus allonge que le 9:16 (19,5:9), Instagram agrandit
  49: # le reel pour remplir l'ecran et en rogne environ 100 px de chaque cote. Le logo, a 44 px
  50: # du bord, etait rogne (signale par Romain le 01/10/2026) : rien de lisible a moins de 110 px.
  51: MARGE_LATERALE = 110
  52: TEXTE_X = MARGE_LATERALE + 2   # marge gauche commune a tous les textes
  53: TEXTE_LARGEUR = 828            # colonne : a l'ecart des boutons de l'onglet Reels, a droite
  54: 
  55: ACCROCHE_PX, ACCROCHE_GRAISSE = 92, "ExtraBold"   # phrase d'ouverture (champ sous_titre)
  56: ACCROCHE_INTERLIGNE = 100
  57: ACCROCHE_APPROCHE = -0.025     # interlettrage, en fraction du corps
  58: ACCROCHE_LIGNES_MAX = 4        # au-dela, le corps de l'accroche (et des phrases fortes) diminue
