 212: VERROU_SECOUSSE = (9, 0.55, 0.4)   # amplitude (degres), delai apres l'arrivee, duree (s)
 213: CAL_W, CAL_H, CAL_TETE = 540, 460, 84
 214: CAL_BALAYAGE_DELAI = 0.55
