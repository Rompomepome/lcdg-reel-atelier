  70: 
  71: CHIFFRE_PX, CHIFFRE_GRAISSE = 230, "ExtraBold"    # bloc de type "chiffre"
  72: CHIFFRE_APPROCHE = -0.03
  73: CHIFFRE_ECART = 34             # entre la ligne de base du chiffre et la legende
  74: ANCIEN_PX, ANCIEN_GRAISSE = 76, "Bold"            # valeur precedente, barree
  75: ANCIEN_ALPHA = 0.78
  76: ANCIEN_ECART = 22              # entre la valeur barree et le haut du chiffre
  77: BARRE_PX = 9
