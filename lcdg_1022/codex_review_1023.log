   86:     flou, alpha, dy = C.INSERT_OMBRE
   87:     return hb.shadow(im, blur=max(2, int(flou * s)), alpha=alpha, offset=(0, max(1, int(dy * s))))
   88: 
   89: 
   90: def _cadre(w, h, s, couleur=C.BLANC, marge=0):
   91:     """Carte arrondie (avec une marge transparente pour l'ombre)."""
   92:     im = Image.new("RGBA", (w + 2 * marge, h + 2 * marge), (0, 0, 0, 0))
   93:     ImageDraw.Draw(im).rounded_rectangle([marge, marge, marge + w - 1, marge + h - 1],
   94:                                          radius=max(4, int(C.INSERT_RAYON * s)),
   95:                                          fill=tuple(couleur) + (255,))
   96:     return im
   97: 
   98: 
   99: def _poser(fond, im, cx, cy, k=1.0, alpha=1.0, angle=0.0):
  100:     """Colle im centre en (cx, cy), a l'echelle k, tourne de angle degres."""
  101:     if alpha <= 0.003 or k <= 0.01:
  102:         return
  103:     if abs(k - 1) > 0.01:
  104:         im = im.resize((max(1, int(im.width * k)), max(1, int(im.height * k))), Image.BICUBIC)
  105:     if abs(angle) > 0.05:
  106:         im = im.rotate(angle, resample=Image.BICUBIC, expand=True)
  107:     T.coller(fond, im, (cx - im.width / 2, cy - im.height / 2), min(1.0, alpha))
  108: 
  109: 
  110: def _nombre(v, dec):
  111:     # meme ecriture que les chiffres cles (habillage.Chiffre.nombre) : milliers separes par
  112:     # une espace fine, virgule decimale (« 3 400 », « 49,6 »)
  113:     return f"{v:,.{dec}f}".replace(",", " ").replace(".", ",")
  114: 
  115: 
  116: class _Insert:
  117:     """Placement, entree commune et sortie avec le texte du bloc."""
  118: 
  119:     def __init__(self, nom, spec, scene, bas):
  120:         self.nom, self.spec, self.scene = nom, spec, scene
  121:         self.debut, self.fin = scene.debut, scene.fin
  122:         self.instants = [scene.debut] + [p.debut for p in scene.parts[1:]]
  123:         w0, h0 = self.taille_nominale()
  124:         dispo = bas - C.INSERT_HAUT_MIN
  125:         self.s = min(1.0, dispo / h0, C.TEXTE_LARGEUR / w0)
  126:         if self.s < C.INSERT_ECHELLE_MIN:
  127:             raise SystemExit(f"[!] {nom} : pas la place pour l'insert « {spec['type']} » au-dessus "
  128:                              f"du texte ({dispo:.0f} px pour {h0} px). Raccourcis le texte du bloc "
  129:                              "ou retire l'insert.")
  130:         self.w, self.h = int(w0 * self.s), int(h0 * self.s)
  131:         self.m = int(C.INSERT_OMBRE[0] * C.INSERT_MARGE_OMBRE * self.s) + 4   # ombres
  132:         self.x, self.y = C.TEXTE_X, bas - self.h
  133:         self.rubrique = tuple(hb._RUBRIQUE)
  134: 
  135:     def px(self, v):
  136:         return max(1, int(round(v * self.s)))
  137: 
  138:     def t0(self, k=0):
  139:         return self.instants[min(max(0, k), len(self.instants) - 1)] + C.INSERT_DELAI
  140: 
  141:     def taille_nominale(self):
  142:         raise NotImplementedError
  143: 
  144:     def image(self, t, final):
  145:         raise NotImplementedError
  146: 
  147:     def sons(self):
  148:         return []
  149: 
  150:     def dessiner(self, lay, t, final=False):
  151:         so = 0.0 if final else self.scene.parts[-1]._sortie(t)
  152:         if so >= 1:
  153:             return
  154:         im = self.image(t, final)
  155:         if im is not None:
  156:             T.coller(lay, im, (self.x - self.m, self.y - self.m - C.SORTIE_MONTEE * so), 1 - so)
  157: 
  158:     def couche(self):
  159:         lay = hb._vide(); self.dessiner(lay, 0, final=True)
  160:         return lay
