 1025:     def _ecran(self, im, texte):
 1026:         g, q = C.FRIGO_GEO, self.f
 1027:         _ecrire(ImageDraw.Draw(im), (self.fw / 2, g["panneau"] * q / 2), texte, max(6, int(round(g["ecran_px"] * q))),
 1028:                 C.INSERT_GRAISSE_FORTE, _teinte(C.INSERT_VERT, 0.35) + (255,), "mm")
