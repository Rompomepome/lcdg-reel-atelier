  653:         if not final:
  654:             r0, rd = C.OUVERTURE_REFLET
  655:             q = (t - self.debut - r0) / rd
  656:             if 0 < q < 1:
  657:                 im = self._reflet(im, q)
  658:         T.coller(lay, im, (self.pos[0], self.pos[1] - C.SORTIE_MONTEE * so), 1 - so)
  659: 
  660:     def couche(self):
  661:         lay = _vide(); self.dessiner(lay, 0, final=True)
  662:         return lay
