 1104:         return self.t0(self.spec.get("temps", 0)) + C.INSERT_ENTREE * 1.2
 1105: 
 1106:     def _courbe(self, t, final):
 1107:         """La carte de la courbe, tracee jusqu'a p ; et la temperature du moment."""
 1108:         g = C.FRIGO_COURBE
 1109:         p = 1.0 if final else max(0.0, min(1.0, (t - self._t_courbe()) / g["duree"]))
 1110:         carte = self.carte_courbe.copy()
 1111:         zx0, zy0, zx1, zy1 = self.zone
 1112:         if p > 0:
 1113:             n = max(2, int(120 * p))
 1114:             pts = [(zx0 + (zx1 - zx0) * p * i / (n - 1), self._y(self._temperature(p * i / (n - 1))))
 1115:                    for i in range(n)]
 1116: 
 1117:             def dessin(d, k):
 1118:                 d.line([(x * k, y * k) for x, y in pts], fill=tuple(self.rubrique) + (255,),
 1119:                        width=max(2, int(self.px(g["trait"]) * k)), joint="curve")
 1120:                 r = self.px(g["tete"]) * k
 1121:                 x, y = pts[-1][0] * k, pts[-1][1] * k
 1122:                 d.ellipse([x - r, y - r, x + r, y + r], fill=C.BLANC + (255,), outline=tuple(self.rubrique) + (255,),
 1123:                           width=max(2, int(self.px(4) * k)))
 1124:             carte.alpha_composite(_net(carte.width, carte.height, dessin))
 1125:         # pastille rouge qui clignote : l'enregistrement ne s'arrete pas
 1126:         d = ImageDraw.Draw(carte)
 1127:         allume = final or (t * 2) % 2 < 1.3
 1128:         x, y = self.rec_xy
 1129:         r = self.rec_px * 0.36
 1130:         d.ellipse([x - 2 * r, y - r, x, y + r], fill=C.INSERT_ROUGE + (255 if allume else 60,))
 1131:         return carte, self._temperature(p)
 1132: 
 1133:     def image(self, t, final):
 1134:         u = 1.0 if final else (t - self.t0(self.spec.get("temps", 0))) / C.INSERT_ENTREE
 1135:         if u <= 0:
 1136:             return None
 1137:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 1138:         frigo = self.fond_frigo.copy()
 1139:         if self._releve():
 1140:             carte, temp = self._courbe(t, final)
 1141:             v = 1.0 if final else (t - self.t0(self.spec.get("temps", 0)) - C.INSERT_ENTREE * 0.5) / C.INSERT_ENTREE
 1142:             if v > 0:
 1143:                 dx = 0 if final else C.INSERT_MONTEE * self.s * (1 - T.lisse(v))
 1144:                 _poser(out, carte, self.cx0 + carte.width / 2 + dx, self.m + self.h / 2,
 1145:                        1.0, 1.0 if final else T.lisse(v * C.INSERT_FONDU))
 1146:             ecran = Image.new("RGBA", frigo.size, (0, 0, 0, 0))
 1147:             self._ecran_sur(ecran, f"+{temp:.1f}{NBSP}°C".replace(".", ","))
 1148:             frigo.alpha_composite(ecran)
 1149:         else:
 1150:             self._remplir(frigo, t, final)
 1151:         k = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u))
 1152:         _poser(out, frigo, self.m + self.fw / 2, self.m + self.h - self.fh / 2, k,
 1153:                1.0 if final else T.lisse(u * C.INSERT_FONDU))
 1154:         if not self._releve() and self.etiquette is not None:
 1155:             v = 1.0 if final else (t - self._t_etiquette()) / C.TAMPON_FRAPPE
 1156:             if v > 0:
 1157:                 kk = 1.0 if final or v >= 1 else C.TAMPON_ECHELLE - (C.TAMPON_ECHELLE - 1) * v * v
 1158:                 dx = 0.0
 1159:                 if not final and v > 1:
 1160:                     w2 = (t - self._t_etiquette() - C.TAMPON_FRAPPE) / C.TAMPON_SECOUSSE[1]
 1161:                     if w2 < 1:
 1162:                         dx = C.TAMPON_SECOUSSE[0] * self.s * math.sin(2 * math.pi * 4 * w2) * (1 - w2)
 1163:                 g = C.FRIGO_GEO
 1164:                 cx = self.m + self.fw - g["chevauche"] * self.s + (self.etiquette.width - 2 * self.mf) / 2 + dx
 1165:                 cy = self.m + self.h - self.fh + self.fh * g["etiquette_y"]
 1166:                 _poser(out, self.etiquette, cx, cy, kk, 1.0 if final else min(1.0, v * C.TAMPON_GEO["fondu"]))
 1167:         return out
 1168: 
 1169:     def _ecran_sur(self, im, texte):
 1170:         g, q = C.FRIGO_GEO, self.f
 1171:         _ecrire(ImageDraw.Draw(im), (self.mf + self.fw / 2, self.mf + g["panneau"] * q / 2), texte,
 1172:                 max(6, int(round(g["ecran_px"] * q))), C.INSERT_GRAISSE_FORTE, _teinte(C.INSERT_VERT, 0.35) + (255,), "mm")
 1173: 
 1174:     def sons(self):
 1175:         t0 = self.t0(self.spec.get("temps", 0))
 1176:         if self._releve():
 1177:             return [(t0, "clic"), (self._t_courbe(), "compteur")]
 1178:         out = [(self._t_boite(0), "compteur"), (self._t_piece(0), "compteur")]
 1179:         if self.etiquette is not None:
 1180:             out.append((self._t_etiquette() + C.TAMPON_FRAPPE, "impact"))
 1181:         return out
