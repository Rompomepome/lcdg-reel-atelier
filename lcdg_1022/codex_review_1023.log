  154: # ---------- scenes ----------
  155: class Texte:
  156:     """Bloc de texte. Un '|' le decoupe en temps successifs sur le meme plan.
  157:     grand=True : phrase forte, au corps de l'accroche, centree, sur fond voile."""
  158: 
  159:     def __init__(self, nom, texte, debut, fin, grand=False, instants=None, retard=0.0):
  160:         """instants : debut de chaque temps apres le premier, relatif au debut du bloc
  161:         (donnes par la voix off) ; sinon les temps se partagent le bloc au prorata des mots.
  162:         retard : le premier temps arrive plus tard (entree du reel, cf. Ouverture)."""
  163:         self.nom, self.debut, self.fin, self.grand = nom, debut, fin, grand
  164:         temps = [b.strip() for b in texte.split('|') if b.strip()]
  165:         poids = [max(1, len(b.replace('*', '').split())) for b in temps]
  166:         cales = instants is not None and len(instants) == len(temps) - 1
  167:         self.parts, t = [], debut + retard
  168:         for k, (b, p) in enumerate(zip(temps, poids)):
  169:             if k == len(temps) - 1:
  170:                 f = fin
  171:             elif cales:
  172:                 f = min(fin, debut + instants[k])
  173:             else:
  174:                 f = t + (fin - debut) * p / sum(poids)
  175:             st = style_centre(b) if grand else style_bloc()
  176:             self.parts.append(T.Cinetique(b, t, f, st, _RUBRIQUE))
  177:             t = f
  178: 
  179:     def dessiner(self, lay, t):
  180:         for c in self.parts:
--- 181-360
  181:             if c.debut <= t < c.fin:
  182:                 c.dessiner(lay, t)
  183: 
  184:     def voiler(self, lay, t):
  185:         if self.grand:
  186:             voile(lay, C.VOILE_PHRASE * T.lisse((t - self.debut) / C.VOILE_DUREE)
  187:                   * (1 - self.parts[-1]._sortie(t)))
  188: 
  189:     def couches(self):
  190:         out = []
  191:         for k, c in enumerate(self.parts):
  192:             lay = _vide(); c.dessiner(lay, 0, final=True)
  193:             out.append((self.nom + (f" (temps {k + 1})" if len(self.parts) > 1 else ""),
  194:                         lay, COLONNE))
  195:         return out
  196: 
  197: 
  198: def pastille(texte):
  199:     """Pastille du sujet : capitales blanches sur la couleur de la rubrique."""
  200:     label = texte.upper()
  201:     lw = T.largeur(label, C.SURTITRE_PX, C.SURTITRE_GRAISSE, C.SURTITRE_APPROCHE)
  202:     pw, ph = int(lw + 2 * C.SURTITRE_PAD), C.SURTITRE_H
  203:     im = Image.new('RGBA', (pw, ph), (0, 0, 0, 0))
  204:     ImageDraw.Draw(im).rounded_rectangle([0, 0, pw - 1, ph - 1], radius=C.RADIUS,
  205:                                          fill=tuple(_RUBRIQUE) + (255,))
  206:     _, gl, m = T.sprite(label, C.SURTITRE_PX, C.SURTITRE_GRAISSE, C.SURTITRE_APPROCHE)
  207:     f = T._police(C.SURTITRE_PX, C.SURTITRE_GRAISSE)
  208:     cap = f.getbbox("H")
  209:     dy = (ph - (cap[3] - cap[1])) // 2 - cap[1]
  210:     im.alpha_composite(gl, (C.SURTITRE_PAD - m, dy - m))
  211:     return im
  212: 
  213: 
  214: class Accroche:
  215:     """Ouverture : pastille du sujet (label) puis phrase d'accroche (sous_titre),
  216:     centrees ensemble dans la zone sure. Le premier mot arrive des 0,2 s."""
  217: 
  218:     def __init__(self, label, accroche, debut, fin):
  219:         self.nom, self.debut, self.fin = "accroche", debut, fin
  220:         st, n = style_ajuste(accroche)
  221:         haut = C.SURTITRE_H + C.SURTITRE_ECART + n * st["interligne"]
  222:         self.y = C.ACCROCHE_CENTRE - haut // 2
  223:         self.texte = T.Cinetique(accroche, debut + C.PASTILLE_DUREE * 0.4, fin,
  224:                                  style_accroche(self.y + C.SURTITRE_H + C.SURTITRE_ECART,
  225:                                                 st["px"]),
  226:                                  _RUBRIQUE)
  227:         self.pastille = pastille(label)
  228: 
  229:     def dessiner(self, lay, t, final=False):
  230:         so = 0.0 if final else self.texte._sortie(t)
  231:         if so >= 1:
  232:             return
  233:         p = 1.0 if final else T.lisse((t - self.debut) / C.PASTILLE_DUREE)
  234:         if p > 0:
  235:             w = max(1, int(self.pastille.width * p))
  236:             T.coller(lay, self.pastille.crop((0, 0, w, self.pastille.height)),
  237:                      (C.TEXTE_X, self.y - C.SORTIE_MONTEE * so), 1 - so)
  238:         self.texte.dessiner(lay, t, final)
  239: 
  240:     def voiler(self, lay, t):
  241:         voile(lay, C.VOILE_ACCROCHE * T.lisse((t - self.debut) / C.VOILE_DUREE)
  242:               * (1 - self.texte._sortie(t)))
  243: 
  244:     def couches(self):
  245:         lay = _vide(); self.dessiner(lay, 0, final=True)
  246:         return [(self.nom, lay, COLONNE)]
