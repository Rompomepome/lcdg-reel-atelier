  163: # ----------------------------------------------------------------- verrou
  164: class Verrou(_Insert):
  165:     """Les recommandations gardees pour le site : une carte fermee par recommandation."""
  166: 
  167:     def taille_nominale(self):
  168:         return C.TEXTE_LARGEUR, C.VERROU_CARTE_H
  169: 
  170:     def __init__(self, *a):
  171:         super().__init__(*a)
  172:         self.n = int(self.spec["n"])
  173:         g = self.px(C.INSERT_ECART_ELEMENTS)
  174:         self.cw = (self.w - (self.n - 1) * g) // self.n
  175:         self.pas = self.cw + g
  176:         self.cartes = [self._carte(i + 1) for i in range(self.n)]
  177:         self.cadenas = self._cadenas()
  178: 
  179:     def _carte(self, numero):
  180:         cw, ch, s, m = self.cw, self.h, self.s, self.m
  181:         im = _cadre(cw, ch, s, marge=m)
  182:         d = ImageDraw.Draw(im)
  183:         g = C.VERROU_GEO
  184:         r = self.px(g["rond"])
  185:         cx, cy = m + self.px(g["rond_marge"]) + r, m + self.px(g["rond_marge"]) + r
  186:         d.ellipse([cx - r, cy - r, cx + r, cy + r], fill=self.rubrique + (255,))
  187:         _ecrire(d, (cx, cy), str(numero), self.px(g["numero_px"]), C.INSERT_GRAISSE_FORTE,
  188:                 C.BLANC + (255,), "mm")
  189:         pad = self.px(g["pad"])
  190:         for k, frac in enumerate(C.VERROU_LIGNES):
  191:             y = m + self.px(g["ligne_y"]) + k * self.px(g["ligne_pas"])
  192:             d.rounded_rectangle([m + pad, y, m + pad + int((cw - 2 * pad) * frac), y + self.px(g["ligne_h"])],
  193:                                 radius=self.px(g["ligne_h"] / 2), fill=C.INSERT_GRIS + (255,))
  194:         return _ombre(im, s)
  195: 
  196:     def _cadenas(self):
  197:         s = self.s
  198:         g = C.VERROU_GEO
  199:         r = self.px(g["pastille"])                       # pastille blanche sous le cadenas
  200:         im = Image.new("RGBA", (2 * r + 8, 2 * r + 8), (0, 0, 0, 0))
  201:         d = ImageDraw.Draw(im)
  202:         c = r + 4
  203:         d.ellipse([c - r, c - r, c + r, c + r], fill=C.BLANC + (255,))
  204:         bw, bh = self.px(g["corps"][0]), self.px(g["corps"][1])
  205:         x0, y0 = c - bw / 2, c - bh / 2 + self.px(g["corps_bas"])
  206:         anse, trait = self.px(g["anse"]), self.px(g["trait"])
  207:         haut_anse = y0 - anse * 0.15                     # centre de l'arc de l'anse
  208:         d.arc([c - anse / 2, haut_anse - anse * 0.7, c + anse / 2, haut_anse + anse * 0.7],
  209:               180, 360, fill=C.NAVY + (255,), width=trait)
  210:         for xa in (c - anse / 2 + trait / 2, c + anse / 2 - trait / 2):   # les branches
  211:             d.line([(xa, haut_anse), (xa, y0 + 2)], fill=C.NAVY + (255,), width=trait)
  212:         d.rounded_rectangle([x0, y0, x0 + bw, y0 + bh], radius=self.px(g["corps_rayon"]),
  213:                             fill=C.NAVY + (255,))
  214:         k = self.px(g["trou"])
  215:         d.ellipse([c - k, y0 + bh * 0.36 - k, c + k, y0 + bh * 0.36 + k], fill=C.BLANC + (255,))
  216:         d.rectangle([c - k / 3, y0 + bh * 0.36, c + k / 3, y0 + bh * 0.72], fill=C.BLANC + (255,))
  217:         return _ombre(im, s)
  218: 
  219:     def _t(self, i):
  220:         return self.t0() + i * C.INSERT_DECALAGE
--- 221-440
  221: 
  222:     def image(self, t, final):
  223:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
  224:         for i, carte in enumerate(self.cartes):
  225:             u = 1.0 if final else (t - self._t(i)) / C.INSERT_ENTREE
  226:             if u <= 0:
  227:                 continue
  228:             k = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u))
  229:             dy = 0 if final else C.INSERT_MONTEE * self.s * (1 - T.lisse(u))
  230:             cx = self.m + i * self.pas + self.cw / 2
  231:             cy = self.m + self.h / 2 + dy
  232:             _poser(out, carte, cx, cy, k, 1.0 if final else T.lisse(u * C.INSERT_FONDU))
  233:             # le cadenas tremble une fois, quand la carte est posee
  234:             v = 1.0 if final else (t - self._t(i) - C.VERROU_SECOUSSE[1]) / C.VERROU_SECOUSSE[2]
  235:             angle = 0.0 if (final or not 0 < v < 1) else \
  236:                 C.VERROU_SECOUSSE[0] * math.sin(2 * math.pi * 3 * v) * (1 - v)
  237:             _poser(out, self.cadenas, cx, cy + self.h * C.VERROU_GEO["cadenas_y"] * k, k,
  238:                    1.0 if final else T.lisse(u * C.INSERT_FONDU), angle)
  239:         return out
  240: 
  241:     def sons(self):
  242:         return [(self._t(i), "clic") for i in range(self.n)]
