  582: def _pilule(texte, px, h, pad, fond, couleur):
  583:     w = int(T.largeur(T.normaliser(texte), px, C.INSERT_GRAISSE_FORTE, 0) + 2 * pad)
  584:     im = Image.new("RGBA", (w, h), (0, 0, 0, 0))
  585:     d = ImageDraw.Draw(im)
  586:     d.rounded_rectangle([0, 0, w - 1, h - 1], radius=h // 2, fill=tuple(fond) + (255,))
  587:     _ecrire(d, (w / 2, h / 2), texte, px, C.INSERT_GRAISSE_FORTE, tuple(couleur) + (255,), "mm")
  588:     return im
