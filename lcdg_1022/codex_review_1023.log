    1: """
    2: Registre des plans Pexels utilises, tous episodes confondus : episodes/plans_utilises.json.
    3: 
    4: Un meme plan ne sert jamais deux fois : le public le reconnait d'un reel a l'autre. Un
    5: plan du meme tournage non plus : memes acteurs, meme decor (Romain, 02/10/2026). Sur
    6: Pexels, les plans d'un tournage ont le meme auteur et des numeros proches.
    7: Cle "<dossier episode>/<bloc>", valeur {"id", "url_page", "auteur_id", "auteur"}.
    8: Le fichier est versionne : il survit a la suppression des dossiers broll/.
    9: """
   10: import json
   11: import sys
   12: from pathlib import Path
   13: 
   14: sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
   15: from config import charte as C
   16: 
   17: FICHIER = C.EPISODES / "plans_utilises.json"
   18: 
   19: 
   20: def charger() -> dict:
   21:     return json.loads(FICHIER.read_text(encoding="utf-8")) if FICHIER.exists() else {}
   22: 
   23: 
   24: def ids_utilises(sauf: str | None = None) -> dict:
   25:     """{id Pexels: [cles qui l'utilisent]}, sans la cle `sauf` (le bloc qu'on remplace)."""
   26:     out = {}
   27:     for cle, plan in charger().items():
   28:         if cle != sauf:
   29:             out.setdefault(plan["id"], []).append(cle)
   30:     return out
   31: 
   32: 
   33: def _ecrire(reg: dict):
   34:     FICHIER.write_text(json.dumps(dict(sorted(reg.items())), ensure_ascii=False, indent=1),
   35:                        encoding="utf-8")
   36: 
   37: 
   38: def inscrire(episode: str, bloc: int, candidat: dict):
   39:     reg = charger()
   40:     reg[f"{episode}/{bloc}"] = {"id": candidat["id"], "url_page": candidat["url_page"],
   41:                                "auteur_id": candidat.get("auteur_id"),
   42:                                "auteur": candidat.get("auteur", "")}
   43:     _ecrire(reg)
   44: 
   45: 
   46: def completer() -> int:
   47:     """Ajoute l'auteur Pexels aux plans inscrits avant le 02/10/2026. Un appel par plan."""
   48:     from lcdg import pexels
   49:     reg, n = charger(), 0
   50:     for plan in reg.values():
   51:         if plan.get("auteur_id") is None and isinstance(plan["id"], int):
   52:             u = pexels.video(plan["id"]).get("user", {})
   53:             plan["auteur_id"], plan["auteur"] = u.get("id"), u.get("name", "")
   54:             n += 1
   55:     if n:
   56:         _ecrire(reg)
   57:     return n
   58: 
   59: 
   60: def meme_tournage(candidat: dict, episode: str) -> list:
   61:     """Cles des plans d'autres episodes tournes avec ce candidat (meme auteur, numeros
   62:     a moins de charte.TOURNAGE_ECART). Vide si l'auteur du candidat est inconnu."""
   63:     auteur = candidat.get("auteur_id")
   64:     if auteur is None:
   65:         return []
   66: 
   67:     def proche(plan):
   68:         # un plan hors Pexels (id texte : reportage, plan fourni) est son propre tournage
   69:         if isinstance(plan["id"], int) and isinstance(candidat["id"], int):
   70:             return abs(plan["id"] - candidat["id"]) <= C.TOURNAGE_ECART
   71:         return True
   72: 
   73:     return [cle for cle, plan in charger().items()
   74:             if not cle.startswith(episode + "/") and plan.get("auteur_id") == auteur
