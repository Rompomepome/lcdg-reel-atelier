  245: # ------------------------------------------------------------- calendrier
  246: class Calendrier(_Insert):
  247:     """Le mois en carte, la periode qui compte surlignee, une etiquette a cote."""
  248: 
  249:     def taille_nominale(self):
  250:         lg = T.largeur(T.normaliser(self.spec.get("legende", "")), C.CAL_ETIQUETTE_PX,
  251:                        C.INSERT_GRAISSE_FORTE, 0)
  252:         self.etiquette_w0 = int(lg + 2 * C.CAL_ETIQUETTE_PAD) if self.spec.get("legende") else 0
  253:         w = C.CAL_W + (C.INSERT_ECART_ELEMENTS + self.etiquette_w0 if self.etiquette_w0 else 0)
  254:         return w, C.CAL_H
  255: 
  256:     def __init__(self, *a):
  257:         super().__init__(*a)
  258:         sp = self.spec
  259:         self.cw = self.px(C.CAL_W)
  260:         semaines = calendar.Calendar(0).monthdayscalendar(sp["annee"], sp["mois"])
  261:         g = C.CAL_GEO
  262:         pad, tete = self.px(g["pad"]), self.px(C.CAL_TETE)
  263:         jours_y = tete + self.px(g["jours_y"])
  264:         grille_y = jours_y + self.px(g["grille_y"])
  265:         cel_w = (self.cw - 2 * pad) / 7
  266:         cel_h = (self.h - grille_y - pad) / len(semaines)
  267:         self.cellules = {}
  268:         for li, sem in enumerate(semaines):
  269:             for co, jour in enumerate(sem):
  270:                 if jour:
  271:                     self.cellules[jour] = (pad + co * cel_w, grille_y + li * cel_h, cel_w, cel_h)
  272:         m = self.m
  273:         fond = _cadre(self.cw, self.h, self.s, marge=m)
  274:         d = ImageDraw.Draw(fond)
  275:         d.rounded_rectangle([m, m, m + self.cw - 1, m + tete], radius=max(4, int(C.INSERT_RAYON * self.s)),
  276:                             fill=self.rubrique + (255,))
  277:         d.rectangle([m, m + tete // 2, m + self.cw - 1, m + tete], fill=self.rubrique + (255,))
  278:         titre = f"{MOIS[sp['mois'] - 1]} {sp['annee']}".upper()
  279:         _ecrire(d, (m + self.cw / 2, m + tete / 2), titre, self.px(g["titre_px"]),
  280:                 C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
  281:         for co, j in enumerate(JOURS):
  282:             _ecrire(d, (m + pad + (co + 0.5) * cel_w, m + jours_y), j, self.px(g["jour_px"]),
  283:                     C.INSERT_GRAISSE_TEXTE, C.INSERT_GRIS_TEXTE + (255,), "mm")
  284:         self.chiffres_blancs = Image.new("RGBA", fond.size, (0, 0, 0, 0))
  285:         db = ImageDraw.Draw(self.chiffres_blancs)
  286:         for jour, (x, y, w, h) in self.cellules.items():
  287:             xy = (m + x + w / 2, m + y + h / 2)
  288:             _ecrire(d, xy, str(jour), self.px(g["numero_px"]), C.INSERT_GRAISSE_CHIFFRE,
  289:                     C.NAVY + (255,), "mm")
  290:             if sp["du"] <= jour <= sp["au"]:
  291:                 _ecrire(db, xy, str(jour), self.px(g["numero_px"]), C.INSERT_GRAISSE_FORTE,
  292:                         C.BLANC + (255,), "mm")
  293:         self.fond = _ombre(fond, self.s)
  294:         x0, y0, _, h0 = self.cellules[sp["du"]]
  295:         x1, _, w1, _ = self.cellules[sp["au"]]
  296:         r = self.px(g["bande_retrait"])
  297:         self.bande = (m + x0 + r, m + y0 + r, m + x1 + w1 - r, m + y0 + h0 - r)
  298:         self.etiquette = None
  299:         if self.etiquette_w0:
  300:             ew, eh = self.px(self.etiquette_w0), self.px(C.CAL_ETIQUETTE_H)
  301:             et = Image.new("RGBA", (ew, eh), (0, 0, 0, 0))
  302:             de = ImageDraw.Draw(et)
  303:             de.rounded_rectangle([0, 0, ew - 1, eh - 1], radius=eh // 2, fill=self.rubrique + (255,))
  304:             _ecrire(de, (ew / 2, eh / 2), sp["legende"], self.px(C.CAL_ETIQUETTE_PX),
  305:                     C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
  306:             self.etiquette = _ombre(et, self.s)
  307:             self.etiquette_c = (m + self.cw + self.px(C.INSERT_ECART_ELEMENTS) + ew / 2,
  308:                                 (self.bande[1] + self.bande[3]) / 2)
  309: 
  310:     def _temps(self):
  311:         t0 = self.t0()
  312:         balai = t0 + C.CAL_BALAYAGE_DELAI
  313:         return t0, balai, balai + C.INSERT_POUSSE
  314: 
  315:     def image(self, t, final):
  316:         t0, balai, fin_balai = self._temps()
  317:         u = 1.0 if final else (t - t0) / C.INSERT_ENTREE
  318:         if u <= 0:
  319:             return None
  320:         carte = self.fond.copy()
  321:         p = 1.0 if final else T.lisse((t - balai) / C.INSERT_POUSSE)
  322:         if p > 0:
  323:             x0, y0, x1, y1 = self.bande
  324:             xe = x0 + (x1 - x0) * p
  325:             ImageDraw.Draw(carte).rounded_rectangle([x0, y0, xe, y1],
  326:                                                     radius=self.px(C.CAL_GEO["bande_rayon"]),
  327:                                                     fill=self.rubrique + (255,))
  328:             masque = Image.new("L", carte.size, 0)
  329:             ImageDraw.Draw(masque).rectangle([x0, y0, xe, y1], fill=255)
  330:             # les jours de la periode passent en blanc, au rythme du balayage
  331:             blancs = self.chiffres_blancs.copy()
  332:             blancs.putalpha(Image.composite(blancs.getchannel("A"), masque, masque))
  333:             carte.alpha_composite(blancs)
  334:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
  335:         k = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u))
  336:         _poser(out, carte, carte.width / 2, carte.height / 2, k,
  337:                1.0 if final else T.lisse(u * C.INSERT_FONDU))
  338:         if self.etiquette is not None:
  339:             v = 1.0 if final else (t - fin_balai) / C.INSERT_ENTREE
  340:             if v > 0:
  341:                 ke = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(v))
  342:                 _poser(out, self.etiquette, *self.etiquette_c, ke,
  343:                        1.0 if final else T.lisse(v * C.INSERT_FONDU))
  344:         return out
  345: 
  346:     def sons(self):
  347:         t0, balai, fin_balai = self._temps()
  348:         out = [(t0, "souffle"), (balai, "clic")]
  349:         if self.etiquette is not None:
  350:             out.append((fin_balai, "clic"))
  351:         return out
  352: 
