  848: def _icone_choix(ok, diametre, trait, rubrique):
  849:     """Rond a coche (ok), a croix (non), ou « ? » a la couleur de la rubrique (ok absent : une
  850:     question encore ouverte)."""
  851:     r = diametre / 2
  852:     n = int(2 * r) + 4
  853:     im = Image.new("RGBA", (n, n), (0, 0, 0, 0))
  854:     d = ImageDraw.Draw(im)
  855:     c = n / 2
  856:     fond = rubrique if ok is None else C.INSERT_VERT if ok else C.INSERT_ROUGE
  857:     d.ellipse([c - r, c - r, c + r, c + r], fill=tuple(fond) + (255,))
  858:     if ok is None:
  859:         _ecrire(d, (c, c), "?", int(r * C.CHOIX_GEO["question"]), C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
  860:     elif ok:
  861:         d.line([(c - r * 0.45, c + r * 0.02), (c - r * 0.1, c + r * 0.36), (c + r * 0.48, c - r * 0.3)],
  862:                fill=C.BLANC + (255,), width=trait, joint="curve")
  863:     else:
  864:         k = r * 0.38
  865:         d.line([(c - k, c - k), (c + k, c + k)], fill=C.BLANC + (255,), width=trait)
  866:         d.line([(c - k, c + k), (c + k, c - k)], fill=C.BLANC + (255,), width=trait)
  867:     return im
