 1031:     def _t_boite(self, i):
 1032:         return self.t0(self.spec.get("temps", 0)) + C.INSERT_ENTREE * 0.6 + i * C.FRIGO_DECALAGE
 1033: 
 1034:     def _t_piece(self, i):
