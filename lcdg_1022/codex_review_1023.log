 1178:         out = [(self._t_boite(0), "compteur"), (self._t_piece(0), "compteur")]
 1179:         if self.etiquette is not None:
 1180:             out.append((self._t_etiquette() + C.TAMPON_FRAPPE, "impact"))
 1181:         return out
