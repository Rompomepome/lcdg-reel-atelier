 1284: class Appel(_Insert):
 1285:     """Ce qui arrive d'abord : un telephone qui sonne dans sa carte, une fleche, puis le
 1286:     courrier qui vole jusqu'a la sienne."""
 1287: 
 1288:     def taille_nominale(self):
 1289:         return C.TEXTE_LARGEUR, C.APPEL_H
 1290: 
 1291:     def __init__(self, *a):
 1292:         super().__init__(*a)
 1293:         g = C.APPEL_GEO
 1294:         self.etapes = self.spec["etapes"][:2]
 1295:         self.ecart = self.px(g["ecart"])
 1296:         self.cw = (self.w - self.ecart) // 2
 1297:         self.cartes = [self._carte(e) for e in self.etapes]
 1298:         self.icones = [self._telephone() if e.get("icone") == "telephone" else self._enveloppe() for e in self.etapes]
 1299:         self.ondes = self._ondes()
 1300: 
 1301:     def _carte(self, e):
 1302:         g, m = C.APPEL_GEO, self.m
 1303:         im = _cadre(self.cw, self.h, self.s, marge=m)
 1304:         d = ImageDraw.Draw(im)
 1305:         pad = self.px(g["pad"])
 1306:         px, pn = self.px(g["label_px"]), self.px(g["note_px"])
 1307:         lignes = _couper(e["label"], px, C.INSERT_GRAISSE_FORTE, self.cw - 2 * pad)
 1308:         note = e.get("note")
 1309:         bas = m + self.h - pad - (pn * 1.3 if note else 0)
 1310:         for i, l in enumerate(reversed(lignes)):
 1311:             _ecrire(d, (m + self.cw / 2, bas - i * px * 1.18), l, px, C.INSERT_GRAISSE_FORTE, C.NAVY + (255,), "ms")
 1312:         if note:
 1313:             _ecrire(d, (m + self.cw / 2, m + self.h - pad), note, pn, C.INSERT_GRAISSE_TEXTE,
 1314:                     C.INSERT_GRIS_TEXTE + (255,), "ms")
 1315:         return _ombre(im, self.s)
 1316: 
 1317:     def _telephone(self):
