  892:     def _hauteur_frigo(self):
  893:         return C.FRIGO_RELEVE_H if self._releve() else C.FRIGO_H
  894: 
  895:     def _etiquette(self, s):
  896:         """L'etiquette de prix, deja tournee (sans ombre)."""
  897:         g = C.FRIGO_GEO
  898:         px = max(8, int(round(g["etiquette_px"] * s)))
  899:         lignes = [T.normaliser(l) for l in self.spec.get("etiquette", [])]
  900:         lh = px * 1.18
  901:         padx, pady = g["etiquette_pad"][0] * s, g["etiquette_pad"][1] * s
  902:         h = len(lignes) * lh + 2 * pady
  903:         pointe = h * 0.42
  904:         w = max(T.largeur(l, px, C.INSERT_GRAISSE_FORTE, 0) for l in lignes) + 2 * padx + pointe
  905: 
  906:         def dessin(d, k):
  907:             W, H, P = w * k, h * k, pointe * k
  908:             rouge = C.INSERT_ROUGE + (255,)
  909:             d.rounded_rectangle([P * 0.6, 0, W, H], radius=H * 0.16, fill=rouge)
  910:             d.polygon([(P + 1, 0), (0, H / 2), (P + 1, H)], fill=rouge)
  911:             r = H * 0.085
  912:             d.ellipse([P * 0.5 - r, H / 2 - r, P * 0.5 + r, H / 2 + r], fill=(0, 0, 0, 0))
  913:         im = _net(w, h, dessin)
  914:         d = ImageDraw.Draw(im)
  915:         for i, l in enumerate(lignes):
  916:             _ecrire(d, (pointe + (w - pointe) / 2, pady + lh * (i + 0.5)), l, px, C.INSERT_GRAISSE_FORTE,
  917:                     C.BLANC + (255,), "mm")
  918:         return im.rotate(-g["etiquette_angle"], resample=Image.BICUBIC, expand=True)
  919: 
  920:     def taille_nominale(self):
  921:         fh = self._hauteur_frigo()
  922:         fw = C.FRIGO_W * fh / C.FRIGO_H
  923:         if self._releve():
