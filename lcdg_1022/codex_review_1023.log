  995:             d.rounded_rectangle([0, 0, W - 1, pan + r], radius=r, fill=C.NAVY + (255,))
  996:             d.rectangle([0, pan, W - 1, pan + r], fill=C.BLANC + (255,))
  997:             ew, eh = g["ecran"][0] * Q, g["ecran"][1] * Q
  998:             d.rounded_rectangle([(W - ew) / 2, (pan - eh) / 2, (W + ew) / 2, (pan + eh) / 2], radius=eh * 0.25,
  999:                                 fill=(8, 5, 26, 255))
 1000:             led = 5 * Q
 1001:             d.ellipse([r * 0.7 - led, pan / 2 - led, r * 0.7 + led, pan / 2 + led], fill=C.INSERT_VERT + (255,))
 1002:             d.ellipse([W - r * 0.7 - led, pan / 2 - led, W - r * 0.7 + led, pan / 2 + led],
 1003:                       fill=_teinte(C.NAVY, 0.45) + (255,))
 1004:             vx0, vy0, vx1, vy1 = x0 * k, y0 * k, x1 * k, y1 * k
 1005:             d.rounded_rectangle([vx0, vy0, vx1, vy1], radius=r * 0.5, fill=_teinte(self.rubrique, 0.86) + (255,))
 1006:             lw = vx1 - vx0
 1007:             d.polygon([(vx0 + lw * 0.58, vy0), (vx0 + lw * 0.78, vy0), (vx0 + lw * 0.38, vy1), (vx0 + lw * 0.18, vy1)],
 1008:                       fill=_teinte(self.rubrique, 0.93) + (255,))
 1009:             rang = (vy1 - vy0) / 2
 1010:             for i in range(2):
 1011:                 y = vy0 + rang * (i + 1) - g["etagere"] * Q
 1012:                 d.rectangle([vx0, y, vx1, y + g["etagere"] * Q], fill=_teinte(self.rubrique, 0.6) + (255,))
 1013:             gw, gh = g["poignee"][0] * Q, g["poignee"][1] * Q
 1014:             gx = vx1 + (W - vx1 - gw) / 2
 1015:             d.rounded_rectangle([gx, H * 0.36, gx + gw, H * 0.36 + gh], radius=gw / 2,
 1016:                                 fill=C.INSERT_GRIS + (255,))
 1017:         im = _net(w, h, dessin)
 1018:         if plein:
 1019:             for i in range(self.n):
 1020:                 im.alpha_composite(self.boite, (int(round(self.places[i][0])), int(round(self.places[i][1]))))
 1021:         if not self._releve():
