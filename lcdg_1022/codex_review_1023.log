  512: # ----------------------------------------------------------------- tampon
  513: class Tampon(_Insert):
  514:     """Un tampon qui claque sur l'image (« Export interdit »)."""
  515: 
  516:     def _sprite(self, s):
  517:         texte = T.normaliser(self.spec["texte"]).upper()
  518:         px = max(8, int(C.TAMPON_PX * s))
  519:         f = T._police(px, C.INSERT_GRAISSE_FORTE)
  520:         b = f.getbbox(texte)
  521:         tw, th = b[2] - b[0], b[3] - b[1]
  522:         g = C.TAMPON_GEO
  523:         padx, pady = int(C.TAMPON_PAD[0] * s), int(C.TAMPON_PAD[1] * s)
  524:         trait = max(2, int(g["trait"] * s))
  525:         w, h = tw + 2 * padx, th + 2 * pady
  526:         im = Image.new("RGBA", (w + 8, h + 8), (0, 0, 0, 0))
  527:         d = ImageDraw.Draw(im)
  528:         rouge = C.INSERT_ROUGE + (255,)
  529:         d.rounded_rectangle([4, 4, 4 + w, 4 + h], radius=max(4, int(g["rayon"] * s)),
  530:                             fill=C.BLANC + (C.TAMPON_FOND,), outline=rouge, width=trait)
  531:         i = trait + max(2, int(g["filet_retrait"] * s))
  532:         d.rounded_rectangle([4 + i, 4 + i, 4 + w - i, 4 + h - i], radius=max(3, int(g["filet_rayon"] * s)),
  533:                             outline=rouge, width=max(1, trait // 3))
  534:         d.text((4 + padx - b[0], 4 + pady - b[1]), texte, font=f, fill=rouge)
  535:         return im.rotate(C.TAMPON_ANGLE, resample=Image.BICUBIC, expand=True)
  536: 
  537:     def taille_nominale(self):
  538:         im = self._sprite(1.0)
  539:         return im.width, im.height
  540: 
  541:     def __init__(self, *a):
  542:         super().__init__(*a)
  543:         self.sprite = _ombre(self._sprite(self.s), self.s)
  544: 
  545:     def _t(self):
  546:         return self.t0(self.spec.get("temps", 0))
  547: 
  548:     def dessiner(self, lay, t, final=False):
  549:         """Colle le tampon directement sur le cadre : agrandi au moment de la frappe, il
  550:         deborde de sa boite."""
  551:         so = 0.0 if final else self.scene.parts[-1]._sortie(t)
  552:         u = 1.0 if final else (t - self._t()) / C.TAMPON_FRAPPE
  553:         if so >= 1 or u <= 0:
  554:             return
  555:         k = 1.0 if final or u >= 1 else C.TAMPON_ECHELLE - (C.TAMPON_ECHELLE - 1) * u * u
  556:         dx = 0.0
  557:         if not final and u > 1:
  558:             v = (t - self._t() - C.TAMPON_FRAPPE) / C.TAMPON_SECOUSSE[1]
  559:             if v < 1:
  560:                 dx = C.TAMPON_SECOUSSE[0] * self.s * math.sin(2 * math.pi * 4 * v) * (1 - v)
  561:         alpha = (1.0 if final else min(1.0, u * C.TAMPON_GEO["fondu"])) * (1 - so)
  562:         _poser(lay, self.sprite, self.x + self.w / 2 + dx,
  563:                self.y + self.h / 2 - C.SORTIE_MONTEE * so, k, alpha)
  564: 
  565:     def sons(self):
  566:         return [(self._t() + C.TAMPON_FRAPPE, "impact")]
  567: 
  568: 
  569: def _couper(texte, px, graisse, largeur):
  570:     """Decoupe un libelle en lignes qui tiennent dans largeur (mots entiers)."""
  571:     lignes, cur = [], ""
  572:     for mot in T.normaliser(texte).split(" "):
  573:         essai = f"{cur} {mot}".strip()
  574:         if cur and T.largeur(essai, px, graisse, 0) > largeur:
  575:             lignes.append(cur)
  576:             cur = mot
  577:         else:
  578:             cur = essai
  579:     return lignes + ([cur] if cur else [])
  580: 
  581: 
  582: def _pilule(texte, px, h, pad, fond, couleur):
  583:     w = int(T.largeur(T.normaliser(texte), px, C.INSERT_GRAISSE_FORTE, 0) + 2 * pad)
  584:     im = Image.new("RGBA", (w, h), (0, 0, 0, 0))
  585:     d = ImageDraw.Draw(im)
  586:     d.rounded_rectangle([0, 0, w - 1, h - 1], radius=h // 2, fill=tuple(fond) + (255,))
  587:     _ecrire(d, (w / 2, h / 2), texte, px, C.INSERT_GRAISSE_FORTE, tuple(couleur) + (255,), "mm")
  588:     return im
  589: 
  590: 
  591: def _fleche(d, x0, x1, y, p, trait, tete, couleur):
  592:     """Fleche horizontale de x0 a x1, tracee sur la fraction p (la pointe suit le trait)."""
  593:     if p <= 0:
  594:         return
  595:     xe = x0 + (x1 - x0) * min(1.0, p)
  596:     d.line([(x0, y), (max(x0, xe - tete * 0.6), y)], fill=couleur, width=trait)
  597:     d.polygon([(xe, y), (xe - tete, y - tete * 0.7), (xe - tete, y + tete * 0.7)], fill=couleur)
  598: 
  599: 
  600: # ---------------------------------------------------------------- circuit
  601: class Circuit(_Insert):
  602:     """Ce que devient l'argent, ligne par ligne : pilules reliees par des fleches, issue."""
  603: 
  604:     def _elements(self, l, s):
  605:         g = C.CIRCUIT_GEO
  606:         px, h, pad = max(8, int(C.CIRCUIT_PILULE_PX * s)), max(8, int(C.CIRCUIT_PILULE_H * s)), int(g["pilule_pad"] * s)
  607:         out = []
  608:         for e in l["etapes"]:
  609:             couleur = C.INSERT_ROUGE if e.startswith(("−", "-")) else C.INSERT_VERT if e.startswith("+") else C.NAVY
  610:             out.append(_pilule(e, px, h, pad, C.INSERT_GRIS, couleur))
  611:         if l.get("fin"):
  612:             fond = C.INSERT_VERT if l.get("ok") else C.INSERT_ROUGE
  613:             out.append(_pilule(l["fin"], max(8, int(C.CIRCUIT_FIN_PX * s)), h, pad, fond, C.BLANC))
  614:         return out
  615: 
  616:     def taille_nominale(self):
  617:         lignes = self.spec["lignes"]
  618:         larg = max(2 * C.CIRCUIT_PAD + sum(e.width for e in self._elements(l, 1.0))
  619:                    + (len(self._elements(l, 1.0)) - 1) * C.CIRCUIT_FLECHE for l in lignes)
  620:         n = len(lignes)
  621:         return max(C.TEXTE_LARGEUR, larg), n * C.CIRCUIT_LIGNE_H + (n - 1) * C.CIRCUIT_ECART
  622: 
  623:     def __init__(self, *a):
  624:         super().__init__(*a)
  625:         self.lignes = self.spec["lignes"]
  626:         self.lh = self.px(C.CIRCUIT_LIGNE_H)
  627:         self.pas = self.lh + self.px(C.CIRCUIT_ECART)
  628:         self.elements = [self._elements(l, self.s) for l in self.lignes]
  629:         self.cartes = []
  630:         for l in self.lignes:
  631:             im = _cadre(self.w, self.lh, self.s, marge=self.m)
  632:             _ecrire(ImageDraw.Draw(im), (self.m + self.px(C.CIRCUIT_PAD), self.m + self.px(C.CIRCUIT_GEO["titre_y"])),
  633:                     l.get("titre", ""), self.px(C.CIRCUIT_TITRE_PX), C.INSERT_GRAISSE_TEXTE,
  634:                     C.INSERT_GRIS_TEXTE + (255,))
  635:             self.cartes.append(_ombre(im, self.s))
  636: 
  637:     def _t(self, i):
  638:         l = self.lignes[i]
  639:         precedentes = [j for j in range(i) if self.lignes[j].get("temps", 0) == l.get("temps", 0)]
  640:         return self.t0(l.get("temps", 0)) + len(precedentes) * C.INSERT_DECALAGE * 3
  641: 
  642:     def image(self, t, final):
  643:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
  644:         g = C.CIRCUIT_GEO
  645:         trait, tete, marge = self.px(g["trait"]), self.px(g["tete"]), self.px(g["fleche_marge"])
  646:         for i, (carte, elements) in enumerate(zip(self.cartes, self.elements)):
  647:             u = 1.0 if final else (t - self._t(i)) / C.INSERT_ENTREE
  648:             if u <= 0:
  649:                 continue
  650:             dx = 0 if final else -C.INSERT_MONTEE * self.s * (1 - T.lisse(u))
  651:             top = self.m + i * self.pas
  652:             _poser(out, carte, carte.width / 2 + dx, top + self.lh / 2, 1.0,
  653:                    1.0 if final else T.lisse(u * C.INSERT_FONDU))
  654:             cy = top + self.px(g["rangee_y"]) + (self.lh - self.px(g["rangee_y"])) / 2
  655:             x = self.m + self.px(C.CIRCUIT_PAD) + dx
  656:             d = ImageDraw.Draw(out)
  657:             for k, e in enumerate(elements):
  658:                 tk = self._t(i) + C.INSERT_ENTREE * 0.5 + k * C.CIRCUIT_DECALAGE
  659:                 v = 1.0 if final else (t - tk) / C.INSERT_ENTREE
  660:                 if k > 0:                                # la fleche qui mene a cet element
--- 661-880
  661:                     p = 1.0 if final else (t - (tk - C.CIRCUIT_DECALAGE * 0.75)) / (C.CIRCUIT_DECALAGE * 0.7)
  662:                     _fleche(d, x - self.px(C.CIRCUIT_FLECHE) + marge, x - marge, cy, p, trait, tete,
  663:                             C.INSERT_GRIS_TEXTE + (255,))
  664:                 if v > 0:
  665:                     kk = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(v))
  666:                     _poser(out, e, x + e.width / 2, cy, kk, 1.0 if final else T.lisse(v * C.INSERT_FONDU))
  667:                 x += e.width + self.px(C.CIRCUIT_FLECHE)
  668:         return out
  669: 
  670:     def sons(self):
  671:         return [(self._t(i) + C.INSERT_ENTREE * 0.5 + k * C.CIRCUIT_DECALAGE, "clic")
  672:                 for i, el in enumerate(self.elements) for k in range(len(el))]
  673: 
  674: 
  675: # ------------------------------------------------------------------- duel
  676: class Duel(_Insert):
  677:     """Deux cartes datees face a face (une decision, puis son contraire), un « ≠ » entre."""
  678: 
  679:     def taille_nominale(self):
  680:         return C.TEXTE_LARGEUR, C.DUEL_H
  681: 
  682:     def __init__(self, *a):
  683:         super().__init__(*a)
  684:         g = C.DUEL_GEO
  685:         self.cartes_spec = self.spec["cartes"][:2]
  686:         self.ecart = self.px(g["ecart"])
  687:         self.cw = (self.w - self.ecart) // 2
  688:         self.cartes = [self._carte(c) for c in self.cartes_spec]
  689:         r = self.px(C.DUEL_SIGNE) // 2
  690:         im = Image.new("RGBA", (2 * r + 8, 2 * r + 8), (0, 0, 0, 0))
  691:         d = ImageDraw.Draw(im)
  692:         d.ellipse([4, 4, 4 + 2 * r, 4 + 2 * r], fill=C.NAVY + (255,))
  693:         _ecrire(d, (4 + r, 4 + r), "≠", self.px(g["signe_px"]), C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
  694:         self.signe = _ombre(im, self.s)
  695: 
  696:     def _carte(self, c):
  697:         g, m = C.DUEL_GEO, self.m
  698:         im = _cadre(self.cw, self.h, self.s, marge=m)
  699:         d = ImageDraw.Draw(im)
  700:         tete = self.px(C.DUEL_TETE)
  701:         # "ok" absent : une option neutre, a la couleur de la rubrique
  702:         couleur = (self.rubrique if "ok" not in c else C.INSERT_VERT if c["ok"] else C.INSERT_ROUGE) + (255,)
  703:         rayon = max(4, int(C.INSERT_RAYON * self.s))
  704:         d.rounded_rectangle([m, m, m + self.cw - 1, m + tete], radius=rayon, fill=couleur)
  705:         d.rectangle([m, m + tete // 2, m + self.cw - 1, m + tete], fill=couleur)
  706:         _ecrire(d, (m + self.cw / 2, m + tete / 2), c["date"], self.px(C.DUEL_DATE_PX),
  707:                 C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
  708:         px = self.px(C.DUEL_TEXTE_PX)
  709:         lignes = _couper(c["texte"], px, C.INSERT_GRAISSE_FORTE, self.cw - 2 * self.px(g["pad"]))
  710:         lh = px * g["interligne"]
  711:         y0 = m + tete + (self.h - tete - lh * len(lignes)) / 2 + lh / 2
  712:         for k, ligne in enumerate(lignes):
  713:             _ecrire(d, (m + self.cw / 2, y0 + k * lh), ligne, px, C.INSERT_GRAISSE_FORTE, C.NAVY + (255,), "mm")
  714:         return _ombre(im, self.s)
  715: 
  716:     def _t(self, i):
  717:         c = self.cartes_spec[i]
  718:         precedentes = [j for j in range(i) if self.cartes_spec[j].get("temps", 0) == c.get("temps", 0)]
  719:         return self.t0(c.get("temps", 0)) + len(precedentes) * C.DUEL_DECALAGE
  720: 
  721:     def _t_signe(self):
  722:         return max(self._t(i) for i in range(len(self.cartes))) + C.DUEL_SIGNE_DELAI
  723: 
  724:     def image(self, t, final):
  725:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
  726:         for i, carte in enumerate(self.cartes):
  727:             u = 1.0 if final else (t - self._t(i)) / C.INSERT_ENTREE
  728:             if u <= 0:
  729:                 continue
  730:             sens = -1 if i == 0 else 1
  731:             dx = 0 if final else sens * C.INSERT_MONTEE * self.s * (1 - T.lisse(u))
  732:             k = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u))
  733:             cx = self.m + i * (self.cw + self.ecart) + self.cw / 2 + dx
  734:             _poser(out, carte, cx, self.m + self.h / 2, k, 1.0 if final else T.lisse(u * C.INSERT_FONDU))
  735:         v = 1.0 if final else (t - self._t_signe()) / C.INSERT_ENTREE
  736:         if v > 0 and len(self.cartes) == 2:
  737:             k = 0.3 + 0.7 * (1.0 if final else T.rebond(v))
  738:             angle = 0.0 if (final or v >= 1) else 12 * math.sin(2 * math.pi * 2 * v) * (1 - v)
  739:             _poser(out, self.signe, self.m + self.w / 2, self.m + self.h / 2, k,
  740:                    1.0 if final else T.lisse(v * C.INSERT_FONDU), angle)
  741:         return out
  742: 
  743:     def sons(self):
  744:         return [(self._t(i), "clic") for i in range(len(self.cartes))] + [(self._t_signe(), "impact")]
  745: 
  746: 
  747: # ------------------------------------------------------------------ frise
  748: class Frise(_Insert):
  749:     """Une procedure en etapes, de haut en bas : le trait descend de noeud en noeud, chaque
  750:     libelle se pose a droite de son noeud ; une etape "alerte" en rouge."""
  751: 
  752:     def _largeur_libelle(self, e, s):
  753:         graisse = C.INSERT_GRAISSE_FORTE if e.get("alerte") else C.INSERT_GRAISSE_TEXTE
  754:         return T.largeur(T.normaliser(e["label"]), max(8, int(C.FRISE_LABEL_PX * s)), graisse, 0)
  755: 
  756:     def taille_nominale(self):
  757:         g = C.FRISE_GEO
  758:         n = len(self.spec["etapes"])
  759:         larg = 2 * C.FRISE_PAD + 2 * C.FRISE_NOEUD + g["label_x"] + max(
  760:             self._largeur_libelle(e, 1.0) for e in self.spec["etapes"])
  761:         return max(int(larg), C.CHOIX_LARGEUR_MIN), 2 * C.FRISE_PAD + n * C.FRISE_LIGNE_H
  762: 
  763:     def __init__(self, *a):
  764:         super().__init__(*a)
  765:         self.etapes = self.spec["etapes"]
  766:         self.pad = self.px(C.FRISE_PAD)
  767:         self.r = self.px(C.FRISE_NOEUD)
  768:         self.lh = self.px(C.FRISE_LIGNE_H)
  769:         self.xn = self.m + self.pad + self.r
  770:         self.ys = [self.m + self.pad + self.lh * (i + 0.5) for i in range(len(self.etapes))]
  771:         self.fond = _ombre(_cadre(self.w, self.h, self.s, marge=self.m), self.s)
  772:         self.noeuds = []
  773:         for i, e in enumerate(self.etapes):
  774:             couleur = (C.INSERT_ROUGE if e.get("alerte") else self.rubrique) + (255,)
  775:             im = Image.new("RGBA", (2 * self.r + 4, 2 * self.r + 4), (0, 0, 0, 0))
  776:             d = ImageDraw.Draw(im)
  777:             d.ellipse([2, 2, 2 + 2 * self.r, 2 + 2 * self.r], fill=couleur)
  778:             _ecrire(d, (2 + self.r, 2 + self.r), "!" if e.get("alerte") else str(i + 1),
  779:                     self.px(C.FRISE_GEO["numero_px"]), C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
  780:             self.noeuds.append(im)
  781: 
  782:     def _t(self, i):
  783:         e = self.etapes[i]
  784:         precedentes = [j for j in range(i) if self.etapes[j].get("temps", 0) == e.get("temps", 0)]
  785:         return self.t0(e.get("temps", 0)) + C.INSERT_ENTREE * 0.6 + len(precedentes) * C.FRISE_DECALAGE
  786: 
  787:     def image(self, t, final):
  788:         u = 1.0 if final else (t - self.t0()) / C.INSERT_ENTREE
  789:         if u <= 0:
  790:             return None
  791:         carte = self.fond.copy()
  792:         d = ImageDraw.Draw(carte)
  793:         g = C.FRISE_GEO
  794:         trait = self.px(g["trait"])
  795:         d.line([(self.xn, self.ys[0]), (self.xn, self.ys[-1])], fill=C.INSERT_GRIS + (255,), width=trait)
  796:         for i in range(1, len(self.ys)):         # le trait colore descend jusqu'au noeud i
  797:             p = 1.0 if final else (t - (self._t(i) - C.FRISE_TRACE)) / C.FRISE_TRACE
  798:             if p > 0:
  799:                 y1 = self.ys[i - 1] + (self.ys[i] - self.ys[i - 1]) * min(1.0, p)
  800:                 couleur = (C.INSERT_ROUGE if self.etapes[i].get("alerte") else self.rubrique) + (255,)
  801:                 d.line([(self.xn, self.ys[i - 1]), (self.xn, y1)], fill=couleur, width=trait)
  802:         px = self.px(C.FRISE_LABEL_PX)
  803:         for i, e in enumerate(self.etapes):
  804:             v = 1.0 if final else (t - self._t(i)) / C.INSERT_ENTREE
  805:             if v <= 0:
  806:                 continue
  807:             k = 0.3 + 0.7 * (1.0 if final else T.rebond(v))
  808:             _poser(carte, self.noeuds[i], self.xn, self.ys[i], k, 1.0 if final else T.lisse(v * C.INSERT_FONDU))
  809:             a = int(255 * (1.0 if final else T.lisse(v * C.INSERT_FONDU)))
  810:             dx = 0 if final else -self.px(g["glisse"]) * (1 - T.lisse(v))
  811:             couleur = (C.INSERT_ROUGE if e.get("alerte") else C.NAVY) + (a,)
  812:             graisse = C.INSERT_GRAISSE_FORTE if e.get("alerte") else C.INSERT_GRAISSE_TEXTE
  813:             _ecrire(d, (self.xn + self.r + self.px(g["label_x"]) + dx, self.ys[i]), e["label"], px, graisse,
  814:                     couleur, "lm")
  815:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
  816:         k = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u))
  817:         _poser(out, carte, carte.width / 2, carte.height / 2, k, 1.0 if final else T.lisse(u * C.INSERT_FONDU))
  818:         return out
  819: 
  820:     def sons(self):
  821:         return [(self._t(i), "impact" if e.get("alerte") else "clic") for i, e in enumerate(self.etapes)]
