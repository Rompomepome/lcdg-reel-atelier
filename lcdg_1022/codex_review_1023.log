 1283: # -------------------------------------------------------------- appel
 1284: class Appel(_Insert):
 1285:     """Ce qui arrive d'abord : un telephone qui sonne dans sa carte, une fleche, puis le
 1286:     courrier qui vole jusqu'a la sienne."""
 1287: 
 1288:     def taille_nominale(self):
 1289:         return C.TEXTE_LARGEUR, C.APPEL_H
 1290: 
 1291:     def __init__(self, *a):
 1292:         super().__init__(*a)
 1293:         g = C.APPEL_GEO
 1294:         self.etapes = self.spec["etapes"][:2]
 1295:         self.ecart = self.px(g["ecart"])
 1296:         self.cw = (self.w - self.ecart) // 2
 1297:         self.cartes = [self._carte(e) for e in self.etapes]
 1298:         self.icones = [self._telephone() if e.get("icone") == "telephone" else self._enveloppe() for e in self.etapes]
 1299:         self.ondes = self._ondes()
 1300: 
 1301:     def _carte(self, e):
 1302:         g, m = C.APPEL_GEO, self.m
 1303:         im = _cadre(self.cw, self.h, self.s, marge=m)
 1304:         d = ImageDraw.Draw(im)
 1305:         pad = self.px(g["pad"])
 1306:         px, pn = self.px(g["label_px"]), self.px(g["note_px"])
 1307:         lignes = _couper(e["label"], px, C.INSERT_GRAISSE_FORTE, self.cw - 2 * pad)
 1308:         note = e.get("note")
 1309:         bas = m + self.h - pad - (pn * 1.3 if note else 0)
 1310:         for i, l in enumerate(reversed(lignes)):
 1311:             _ecrire(d, (m + self.cw / 2, bas - i * px * 1.18), l, px, C.INSERT_GRAISSE_FORTE, C.NAVY + (255,), "ms")
 1312:         if note:
 1313:             _ecrire(d, (m + self.cw / 2, m + self.h - pad), note, pn, C.INSERT_GRAISSE_TEXTE,
 1314:                     C.INSERT_GRIS_TEXTE + (255,), "ms")
 1315:         return _ombre(im, self.s)
 1316: 
 1317:     def _telephone(self):
 1318:         g = C.APPEL_GEO
 1319:         w, h = self.px(g["telephone"][0]), self.px(g["telephone"][1])
 1320: 
--- 1321-1540
 1321:         def dessin(d, k):
 1322:             W, H = w * k, h * k
 1323:             d.rounded_rectangle([0, 0, W - 1, H - 1], radius=W * 0.2, fill=C.NAVY + (255,))
 1324:             b = W * 0.08
 1325:             d.rounded_rectangle([b, b * 1.6, W - b, H - b * 1.6], radius=W * 0.12, fill=tuple(self.rubrique) + (255,))
 1326:             r = W * 0.17
 1327:             d.ellipse([W / 2 - r, H * 0.3 - r, W / 2 + r, H * 0.3 + r], fill=_teinte(self.rubrique, 0.75) + (255,))
 1328:             rb = W * 0.11
 1329:             for x, c in ((W * 0.3, C.INSERT_ROUGE), (W * 0.7, C.INSERT_VERT)):
 1330:                 d.ellipse([x - rb, H * 0.76 - rb, x + rb, H * 0.76 + rb], fill=c + (255,))
 1331:             d.rounded_rectangle([W * 0.38, b * 0.55, W * 0.62, b * 1.05], radius=b * 0.25, fill=(8, 5, 26, 255))
 1332:         return _net(w, h, dessin)
 1333: 
 1334:     def _enveloppe(self):
 1335:         g = C.APPEL_GEO
 1336:         w, h = self.px(g["enveloppe"][0]), self.px(g["enveloppe"][1])
 1337:         tr = self.px(g["trait"])
 1338: 
 1339:         def dessin(d, k):
 1340:             W, H, e = w * k, h * k, tr * k
 1341:             d.rounded_rectangle([e / 2, e / 2, W - e / 2, H - e / 2], radius=W * 0.06, fill=C.BLANC + (255,),
 1342:                                 outline=C.NAVY + (255,), width=int(e))
 1343:             d.line([(e, e), (W / 2, H * 0.58), (W - e, e)], fill=C.NAVY + (255,), width=int(e), joint="curve")
 1344:             r = H * 0.14
 1345:             d.ellipse([W - r * 1.6 - r, -0, W - r * 1.6 + r, 2 * r], fill=C.INSERT_ROUGE + (255,))
 1346:         return _net(w, h, dessin)
 1347: 
 1348:     def _ondes(self):
 1349:         """Les ondes de la sonnerie, de part et d'autre du telephone."""
 1350:         g = C.APPEL_GEO
 1351:         tw, th = self.px(g["telephone"][0]), self.px(g["telephone"][1])
 1352:         w, h = tw * 2.2, th * 0.8
 1353:         tr = self.px(g["trait"])
 1354: 
 1355:         def dessin(d, k):
 1356:             W, H = w * k, h * k
 1357:             for i in range(g["ondes"]):
 1358:                 r = (tw * 0.62 + i * tr * 2.6) * k
 1359:                 box = [W / 2 - r, H / 2 - r, W / 2 + r, H / 2 + r]
 1360:                 for a0 in (-35, 145):
 1361:                     d.arc(box, a0, a0 + 70, fill=tuple(self.rubrique) + (255,), width=int(tr * k))
 1362:         return _net(w, h, dessin)
 1363: 
 1364:     def _t(self, i):
 1365:         t = self.t0(self.spec.get("temps", 0))
 1366:         return t if i == 0 else t + C.APPEL_GEO["courrier"]
 1367: 
 1368:     def image(self, t, final):
 1369:         g = C.APPEL_GEO
 1370:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 1371:         for i, carte in enumerate(self.cartes):
 1372:             u = 1.0 if final else (t - self._t(i)) / C.INSERT_ENTREE
 1373:             if u <= 0:
 1374:                 continue
 1375:             k = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u))
 1376:             dx = 0 if final or i == 0 else C.INSERT_MONTEE * self.s * (1 - T.lisse(u))
 1377:             cx = self.m + i * (self.cw + self.ecart) + self.cw / 2
 1378:             _poser(out, carte, cx + dx, self.m + self.h / 2, k, 1.0 if final else T.lisse(u * C.INSERT_FONDU))
 1379:             iy = self.m + self.px(g["icone_y"])
 1380:             icone, angle, ix = self.icones[i], 0.0, cx + dx
 1381:             if self.etapes[i].get("icone") == "telephone":
 1382:                 tau = 0.0 if final else t - self._t(i) - C.INSERT_ENTREE * 0.4
 1383:                 sonne = not final and 0 < tau < g["sonnerie"] and (tau % 0.65) < 0.45
 1384:                 if sonne:
 1385:                     angle = g["secousse"] * math.sin(2 * math.pi * 14 * tau)
 1386:                     _poser(out, self.ondes, ix, iy, 1.0, 0.55 + 0.45 * math.sin(2 * math.pi * 3 * tau) ** 2)
 1387:             else:                                        # le courrier arrive en vol, de la droite
 1388:                 v = 1.0 if final else (t - self._t(i) - C.INSERT_ENTREE * 0.3) / (C.INSERT_ENTREE * 1.4)
 1389:                 if v <= 0:
 1390:                     continue
 1391:                 p = 1.0 if final else T.rebond(v)
 1392:                 ix += (1 - p) * self.px(260)
 1393:                 iy -= (1 - p) * self.px(90)
 1394:                 angle = -22 * (1 - p)
 1395:             _poser(out, icone, ix, iy, k, 1.0 if final else T.lisse(u * C.INSERT_FONDU), angle)
 1396:         if len(self.cartes) == 2:                         # la fleche se trace d'une carte a l'autre
 1397:             p = 1.0 if final else (t - (self._t(1) - C.INSERT_ENTREE * 0.6)) / (C.INSERT_ENTREE * 0.6)
 1398:             x0 = self.m + self.cw + self.ecart * 0.2
 1399:             x1 = self.m + self.cw + self.ecart * 0.8
 1400:             fl = Image.new("RGBA", out.size, (0, 0, 0, 0))
 1401:             _fleche(ImageDraw.Draw(fl), x0, x1, self.m + self.h / 2, p, self.px(C.CIRCUIT_GEO["trait"]),
 1402:                     self.px(C.CIRCUIT_GEO["tete"]), C.BLANC + (255,))
 1403:             out.alpha_composite(_ombre(fl, self.s))
 1404:         return out
 1405: 
 1406:     def sons(self):
 1407:         return [(self._t(0), "clic")] + ([(self._t(1), "souffle")] if len(self.cartes) == 2 else [])
 1408: 
 1409: 
 1410: # -------------------------------------------------------------- loupe
 1411: class Loupe(_Insert):
 1412:     """Une page qu'on fouille : la recherche se tape, la loupe balaie la page, rien ne sort."""
 1413: 
 1414:     def taille_nominale(self):
 1415:         return C.TEXTE_LARGEUR, C.LOUPE_H
 1416: 
 1417:     def __init__(self, *a):
 1418:         super().__init__(*a)
 1419:         g = C.LOUPE_GEO
 1420:         m = self.m
 1421:         carte = _cadre(self.w, self.h, self.s, marge=m)
 1422:         d = ImageDraw.Draw(carte)
 1423:         barre = self.px(g["barre"])
 1424:         rayon = max(4, int(C.INSERT_RAYON * self.s))
 1425:         gris = _teinte(C.INSERT_GRIS_TEXTE, 0.82)
 1426:         d.rounded_rectangle([m, m, m + self.w - 1, m + barre], radius=rayon, fill=gris + (255,))
 1427:         d.rectangle([m, m + barre - rayon, m + self.w - 1, m + barre], fill=gris + (255,))
 1428:         r = self.px(g["point"])
 1429:         for i in range(3):
 1430:             x = m + self.px(28) + i * r * 3
 1431:             d.ellipse([x - r, m + barre / 2 - r, x + r, m + barre / 2 + r], fill=C.BLANC + (255,))
 1432:         upx = self.px(g["url_px"])
 1433:         url = T.normaliser(self.spec.get("site", ""))
 1434:         uw = T.largeur(url, upx, C.INSERT_GRAISSE_TEXTE, 0) + 2 * self.px(g["url_pad"])
