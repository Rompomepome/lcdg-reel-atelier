 1040:     def _remplir(self, frigo, t, final):
 1041:         g, q = C.FRIGO_GEO, self.f
 1042:         couche = Image.new("RGBA", self.masque_vitre.size, (0, 0, 0, 0))
 1043:         for i in range(self.n):
 1044:             v = 1.0 if final else (t - self._t_boite(i)) / C.INSERT_ENTREE
 1045:             if v <= 0:
 1046:                 continue
 1047:             x, y = self.places[i]
 1048:             if v < 1:                                   # la boite tombe, en accelerant
 1049:                 y -= g["chute"] * q * (1 - v * v)
 1050:             else:                                       # puis rebondit a peine sur l'etagere
 1051:                 w2 = 1.0 if final else (t - self._t_boite(i) - C.INSERT_ENTREE) / C.INSERT_ENTREE
 1052:                 if w2 < 1:
 1053:                     y -= 6 * q * math.sin(math.pi * w2) * (1 - w2)
 1054:             T.coller(couche, self.boite, (x, y), min(1.0, v * 4))
 1055:         couche.putalpha(ImageChops.multiply(couche.getchannel("A"), self.masque_vitre))
 1056:         frigo.alpha_composite(couche, (self.mf, self.mf))
 1057:         for i in range(self.n):
 1058:             v = 1.0 if final else (t - self._t_piece(i)) / C.INSERT_ENTREE
 1059:             if v <= 0:
 1060:                 continue
 1061:             x, y = self.places[i]
 1062:             kk = 0.3 + 0.7 * (1.0 if final else T.rebond(v))
 1063:             _poser(frigo, self.piece, self.mf + x + self.boite.width * 0.82, self.mf + y + self.boite.height * 0.12,
 1064:                    kk, 1.0 if final else T.lisse(v * C.INSERT_FONDU))
