  745: def evenements(ep, bornes, croix):
  746:     """Instants des animations qui portent un bruitage, en (secondes, nom de son). Calcules
  747:     sur les memes scenes que l'image : un bruitage ne peut pas se decaler du motion."""
  748:     from lcdg import inserts as ins          # inserts importe habillage : import ici
  749:     out = []        # aucun bruitage a l'ouverture du reel (Romain, 02/10/2026)
  750:     les_scenes = scenes(ep, bornes, croix)
  751:     for i in ins.inserts(ep, les_scenes, ouverture(ep, les_scenes)):
  752:         out += i.sons()
  753:     for sc in les_scenes:
  754:         if isinstance(sc, Accroche):
  755:             out += [(m[4], "clic") for m in sc.texte.marques]
  756:         elif isinstance(sc, Chiffre):
  757:             out.append((sc.debut, "souffle"))
  758:             if sc.compte:
  759:                 out.append((sc.debut + C.COMPTE_DELAI, "compteur"))
  760:                 out.append((sc.debut + C.COMPTE_DELAI + C.COMPTE_DUREE * C.IMPACT_COMPTE, "impact"))
  761:             out += [(m[4], "clic") for m in sc.legende.marques]
  762:         else:
  763:             out.append((sc.debut, "impact" if sc.grand else "souffle"))
  764:             for c in sc.parts:
  765:                 out += [(m[4], "clic") for m in c.marques]
  766:     out.append((croix, "transition"))
  767:     out.append((CarteFinale(croix + C.CROIX_DUREE, ep.get("appel")).t_lien, "carillon"))
