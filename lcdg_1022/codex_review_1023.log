  623:     @staticmethod
  624:     def _reflet(im, q):
  625:         """Bande de lumiere inclinee qui traverse la pastille (q de 0 a 1)."""
  626:         w, h = im.size
  627:         bande = Image.new('L', (w, h), 0)
  628:         large = h * 0.8
  629:         x = -large + (w + 2 * large) * q
  630:         ImageDraw.Draw(bande).polygon([(x, 0), (x + large * 0.55, 0),
  631:                                        (x + large * 0.55 - h * 0.45, h), (x - h * 0.45, h)],
  632:                                       fill=C.OUVERTURE_REFLET_ALPHA)
  633:         lumiere = Image.new('RGBA', (w, h), (255, 255, 255, 0))
  634:         lumiere.putalpha(ImageChops.multiply(bande, im.getchannel('A')))
  635:         out = im.copy()
  636:         out.alpha_composite(lumiere)
  637:         return out
