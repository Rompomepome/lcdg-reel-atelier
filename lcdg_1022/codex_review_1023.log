  881: # -------------------------------------------------------------- frigo
  882: class Frigo(_Insert):
  883:     """L'enceinte refrigeree du cabinet.
  884:     Mode "remplir" : les boites de vaccin tombent sur les etageres ; au temps "prix", une piece
  885:     « € » se pose sur chacune, puis une etiquette claque sur la porte (« Payées d'abord »).
  886:     Mode "releve" : le refrigerateur plein et, a cote, la courbe de temperature qui s'enregistre
  887:     dans la plage de conservation ; l'ecran du refrigerateur affiche la valeur du moment."""
  888: 
  889:     def _releve(self):
  890:         return self.spec.get("mode") == "releve"
  891: 
  892:     def _hauteur_frigo(self):
  893:         return C.FRIGO_RELEVE_H if self._releve() else C.FRIGO_H
  894: 
  895:     def _etiquette(self, s):
  896:         """L'etiquette de prix, deja tournee (sans ombre)."""
  897:         g = C.FRIGO_GEO
  898:         px = max(8, int(round(g["etiquette_px"] * s)))
  899:         lignes = [T.normaliser(l) for l in self.spec.get("etiquette", [])]
  900:         lh = px * 1.18
  901:         padx, pady = g["etiquette_pad"][0] * s, g["etiquette_pad"][1] * s
  902:         h = len(lignes) * lh + 2 * pady
  903:         pointe = h * 0.42
  904:         w = max(T.largeur(l, px, C.INSERT_GRAISSE_FORTE, 0) for l in lignes) + 2 * padx + pointe
  905: 
  906:         def dessin(d, k):
  907:             W, H, P = w * k, h * k, pointe * k
  908:             rouge = C.INSERT_ROUGE + (255,)
  909:             d.rounded_rectangle([P * 0.6, 0, W, H], radius=H * 0.16, fill=rouge)
  910:             d.polygon([(P + 1, 0), (0, H / 2), (P + 1, H)], fill=rouge)
  911:             r = H * 0.085
  912:             d.ellipse([P * 0.5 - r, H / 2 - r, P * 0.5 + r, H / 2 + r], fill=(0, 0, 0, 0))
  913:         im = _net(w, h, dessin)
  914:         d = ImageDraw.Draw(im)
  915:         for i, l in enumerate(lignes):
  916:             _ecrire(d, (pointe + (w - pointe) / 2, pady + lh * (i + 0.5)), l, px, C.INSERT_GRAISSE_FORTE,
  917:                     C.BLANC + (255,), "mm")
  918:         return im.rotate(-g["etiquette_angle"], resample=Image.BICUBIC, expand=True)
  919: 
  920:     def taille_nominale(self):
  921:         fh = self._hauteur_frigo()
  922:         fw = C.FRIGO_W * fh / C.FRIGO_H
  923:         if self._releve():
  924:             return C.TEXTE_LARGEUR, fh
  925:         ew = self._etiquette(1.0).width if self.spec.get("etiquette") else 0
  926:         return int(fw + max(0, ew - C.FRIGO_GEO["chevauche"])), fh
  927: 
  928:     def __init__(self, *a):
  929:         super().__init__(*a)
  930:         g = C.FRIGO_GEO
  931:         self.f = self.s * self._hauteur_frigo() / C.FRIGO_H        # echelle de la geometrie FRIGO_GEO
  932:         self.fh = int(round(self._hauteur_frigo() * self.s))
  933:         self.fw = int(round(C.FRIGO_W * self.f))
  934:         q = self.f
  935:         pan, vm, pied = g["panneau"] * q, g["vitre_marge"] * q, g["pied"][1] * q
  936:         self.vitre = (vm, pan + vm, self.fw - 2 * vm - g["poignee"][0] * q, self.fh - pied - vm)
  937:         x0, y0, x1, y1 = self.vitre
  938:         bw, bh = g["boite"][0] * q, g["boite"][1] * q
  939:         ecart = g["boite_ecart"] * q
  940:         rang = (y1 - y0) / 2
  941:         self.places = []                                         # coin haut-gauche de chaque boite
  942:         for r in range(2):
  943:             base = y0 + rang * (r + 1) - g["etagere"] * q
  944:             larg = 3 * bw + 2 * ecart
  945:             for c in range(3):
  946:                 self.places.append((x0 + (x1 - x0 - larg) / 2 + c * (bw + ecart), base - bh))
  947:         self.n = min(len(self.places), int(self.spec.get("doses", len(self.places))))
  948:         self.boite = self._boite(bw, bh)
  949:         self.mf = int(C.INSERT_OMBRE[0] * C.INSERT_MARGE_OMBRE * self.s) + 4     # marge d'ombre
  950:         corps = self._corps(plein=self._releve())
  951:         self.fond_frigo = _ombre_marge(corps, self.s)
  952:         self.masque_vitre = Image.new("L", corps.size, 0)
  953:         ImageDraw.Draw(self.masque_vitre).rounded_rectangle([x0, y0, x1, y1], radius=g["rayon"] * q * 0.5,
  954:                                                              fill=255)
  955:         if self._releve():
  956:             self._init_courbe()
  957:         else:
  958:             p = max(8, int(round(g["piece"] * q)))
  959:             self.piece = _net(p, p, lambda d, k: d.ellipse([0, 0, p * k - 1, p * k - 1],
  960:                                                            fill=C.INSERT_ROUGE + (255,)))
  961:             _ecrire(ImageDraw.Draw(self.piece), (p / 2, p / 2), "€", max(6, int(round(g["piece_px"] * q))),
  962:                     C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
  963:             self.etiquette = _ombre_marge(self._etiquette(self.s), self.s) if self.spec.get("etiquette") else None
  964: 
  965:     # -- dessin du refrigerateur
  966:     def _boite(self, bw, bh):
  967:         q = self.f
  968: 
  969:         def dessin(d, k):
  970:             W, H = bw * k, bh * k
  971:             d.rounded_rectangle([0, 0, W - 1, H - 1], radius=6 * q * k, fill=C.BLANC + (255,),
  972:                                 outline=C.INSERT_GRIS + (255,), width=max(1, int(2 * q * k)))
  973:             d.rounded_rectangle([0, 0, W - 1, H * 0.3], radius=6 * q * k, fill=tuple(self.rubrique) + (255,))
  974:             d.rectangle([0, H * 0.18, W - 1, H * 0.3], fill=tuple(self.rubrique) + (255,))
  975:             for i, frac in enumerate((0.7, 0.45)):
  976:                 y = H * (0.48 + i * 0.16)
  977:                 d.rounded_rectangle([W * 0.16, y, W * (0.16 + frac * 0.7), y + H * 0.07], radius=H * 0.035,
  978:                                     fill=C.INSERT_GRIS + (255,))
  979:         return _net(bw, bh, dessin)
  980: 
  981:     def _corps(self, plein):
