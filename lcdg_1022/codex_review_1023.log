 1185: class Ticket(_Insert):
 1186:     """Un ticket de facturation qui s'imprime ligne par ligne ; chaque ligne recoit une coche ou
 1187:     une croix, et sa valeur a droite (« remboursée », « pas à part »)."""
 1188: 
 1189:     def taille_nominale(self):
 1190:         g = C.TICKET_GEO
 1191:         n = len(self.spec["lignes"])
 1192:         return C.TICKET_W + 2 * g["fente_deborde"], g["fente_h"] + g["tete"] + n * g["ligne_h"] + g["pad"] + g["dents"]
 1193: 
 1194:     def __init__(self, *a):
 1195:         super().__init__(*a)
 1196:         g = C.TICKET_GEO
 1197:         self.lignes = self.spec["lignes"]
 1198:         self.pw = self.px(C.TICKET_W)
 1199:         self.fente = (self.px(g["fente_h"]), self.px(g["fente_deborde"]))
 1200:         self.tete, self.lh, self.pad = self.px(g["tete"]), self.px(g["ligne_h"]), self.px(g["pad"])
 1201:         self.dents = self.px(g["dents"])
 1202:         ph = self.tete + len(self.lignes) * self.lh + self.pad
 1203:         papier = Image.new("RGBA", (self.pw, ph), C.BLANC + (255,))
 1204:         d = ImageDraw.Draw(papier)
 1205:         _ecrire(d, (self.pw / 2, self.tete * 0.55), T.normaliser(self.spec.get("titre", "")).upper(),
 1206:                 self.px(g["titre_px"]), C.INSERT_GRAISSE_FORTE, C.INSERT_GRIS_TEXTE + (255,), "mm")
 1207:         self.icone_x = self.pad + self.px(g["icone"]) / 2
 1208:         for i, l in enumerate(self.lignes):
 1209:             y = self.tete + i * self.lh
 1210:             for x in range(self.pad, self.pw - self.pad, self.px(16)):     # pointilles d'imprimante
 1211:                 d.line([(x, y), (x + self.px(8), y)], fill=C.INSERT_GRIS + (255,), width=max(1, self.px(3)))
 1212:             cy = y + self.lh / 2
 1213:             _ecrire(d, (self.pad + self.px(g["icone"]) + self.px(18), cy), l["label"], self.px(g["label_px"]),
 1214:                     C.INSERT_GRAISSE_TEXTE, C.NAVY + (255,), "lm")
 1215:             couleur = C.INSERT_VERT if l.get("ok") else C.INSERT_ROUGE
 1216:             _ecrire(d, (self.pw - self.pad, cy), l.get("valeur", ""), self.px(g["valeur_px"]), C.INSERT_GRAISSE_FORTE,
 1217:                     couleur + (255,), "rm")
 1218:         self.papier = papier
 1219:         self.icones = [_icone_choix(l.get("ok"), self.px(g["icone"]), self.px(g["trait_icone"]), self.rubrique)
 1220:                        for l in self.lignes]
 1221:         fw, fh = self.pw + 2 * self.fente[1], self.fente[0]
 1222: 
 1223:         def dessin(d, k):
 1224:             d.rounded_rectangle([0, 0, fw * k - 1, fh * k - 1], radius=fh * k / 2, fill=C.NAVY + (255,))
 1225:             d.rounded_rectangle([fh * k * 0.6, fh * k * 0.42, (fw - fh * 0.6) * k, fh * k * 0.62], radius=fh * k * 0.1,
 1226:                                 fill=(8, 5, 26, 255))
 1227:         self.imprimante = _ombre_marge(_net(fw, fh, dessin), self.s)
 1228: 
 1229:     def _t_ligne(self, i):
 1230:         l = self.lignes[i]
 1231:         precedentes = [j for j in range(i) if self.lignes[j].get("temps", 0) == l.get("temps", 0)]
 1232:         return self.t0(l.get("temps", 0)) + C.INSERT_ENTREE + len(precedentes) * C.TICKET_GEO["avance"] * 1.3
 1233: 
 1234:     def _longueur(self, t, final):
 1235:         if final:
 1236:             return self.papier.height
 1237:         a = C.TICKET_GEO["avance"]
 1238:         L = self.tete * T.lisse((t - self.t0() - C.INSERT_ENTREE * 0.4) / a)
 1239:         for i in range(len(self.lignes)):
 1240:             L += self.lh * T.lisse((t - self._t_ligne(i)) / a)
 1241:         if len(self.lignes):
 1242:             L += self.pad * T.lisse((t - self._t_ligne(len(self.lignes) - 1) - a) / a)
 1243:         return int(round(L))
 1244: 
 1245:     def image(self, t, final):
 1246:         u = 1.0 if final else (t - self.t0()) / C.INSERT_ENTREE
 1247:         if u <= 0:
 1248:             return None
 1249:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 1250:         L = self._longueur(t, final)
 1251:         x0 = self.m + self.fente[1]
 1252:         y0 = self.m + self.fente[0] / 2
 1253:         if L > 0:
 1254:             dents = self.dents
 1255:             bande = Image.new("RGBA", (self.pw, L + dents), (0, 0, 0, 0))
 1256:             bande.alpha_composite(self.papier.crop((0, 0, self.pw, L)))
 1257:             n = max(2, self.pw // max(4, dents))
 1258: 
 1259:             def dessin(d, k):
 1260:                 pas = self.pw * k / n
 1261:                 pts = [(0, 0)]
 1262:                 for i in range(n):
 1263:                     pts += [(pas * (i + 0.5), dents * k * 0.95), (pas * (i + 1), 0)]
 1264:                 d.polygon(pts, fill=C.BLANC + (255,))
 1265:             bande.alpha_composite(_net(self.pw, dents, dessin), (0, L))
 1266:             for i, l in enumerate(self.lignes):              # l'icone tombe quand sa ligne est sortie
 1267:                 v = 1.0 if final else (t - self._t_ligne(i) - C.TICKET_GEO["avance"] * 0.8) / C.INSERT_ENTREE
 1268:                 cy = self.tete + (i + 0.5) * self.lh
 1269:                 if v > 0 and cy < L:
 1270:                     kk = C.CHOIX_GEO["icone_depart"] + (1 - C.CHOIX_GEO["icone_depart"]) * (1.0 if final else T.rebond(v))
 1271:                     _poser(bande, self.icones[i], self.icone_x, cy, kk, 1.0 if final else T.lisse(v * C.INSERT_FONDU))
 1272:             _poser(out, _ombre_marge(bande, self.s), x0 + self.pw / 2, y0 + (L + dents) / 2)
 1273:         k = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u))
 1274:         _poser(out, self.imprimante, self.m + self.w / 2, self.m + self.fente[0] / 2, k,
 1275:                1.0 if final else T.lisse(u * C.INSERT_FONDU))
 1276:         return out
 1277: 
 1278:     def sons(self):
 1279:         return [(self.t0() + C.INSERT_ENTREE * 0.4, "souffle")] + [(self._t_ligne(i), "clic")
 1280:                                                                     for i in range(len(self.lignes))]
