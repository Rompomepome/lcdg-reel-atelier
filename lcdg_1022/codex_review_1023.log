  449: # ------------------------------------------------------------------ choix
  450: class Choix(_Insert):
  451:     """Une liste ou chaque ligne recoit une coche verte ou une croix rouge."""
  452: 
  453:     def taille_nominale(self):
  454:         n = len(self.spec["lignes"])
  455:         larg = max(T.largeur(T.normaliser(l["label"]), C.CHOIX_PX, C.INSERT_GRAISSE_TEXTE, 0)
  456:                    for l in self.spec["lignes"])
  457:         w = int(C.CHOIX_PAD * 3 + C.CHOIX_ICONE + larg + C.CHOIX_PAD)
  458:         return max(w, C.CHOIX_LARGEUR_MIN), n * C.CHOIX_LIGNE_H + (n - 1) * C.CHOIX_ECART
  459: 
  460:     def __init__(self, *a):
  461:         super().__init__(*a)
  462:         self.lignes = self.spec["lignes"]
  463:         self.lh = self.px(C.CHOIX_LIGNE_H)
  464:         self.pas = self.lh + self.px(C.CHOIX_ECART)
  465:         self.cartes = [self._ligne(l) for l in self.lignes]
  466:         self.icones = [self._icone(l.get("ok")) for l in self.lignes]
  467: 
  468:     def _ligne(self, l):
  469:         m = self.m
  470:         im = _cadre(self.w, self.lh, self.s, marge=m)
  471:         d = ImageDraw.Draw(im)
  472:         x = m + self.px(C.CHOIX_PAD) * 2 + self.px(C.CHOIX_ICONE)
  473:         _ecrire(d, (x, m + self.lh / 2), l["label"], self.px(C.CHOIX_PX), C.INSERT_GRAISSE_TEXTE,
  474:                 C.NAVY + (255,), "lm")
  475:         return _ombre(im, self.s)
  476: 
  477:     def _icone(self, ok):
  478:         return _icone_choix(ok, self.px(C.CHOIX_ICONE), self.px(C.CHOIX_GEO["trait"]), self.rubrique)
  479: 
  480:     def _t(self, i):
  481:         l = self.lignes[i]
  482:         precedentes = [j for j in range(i) if self.lignes[j].get("temps", 0) == l.get("temps", 0)]
  483:         return self.t0(l.get("temps", 0)) + len(precedentes) * C.CHOIX_DECALAGE
  484: 
  485:     def image(self, t, final):
  486:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
  487:         for i, (carte, icone) in enumerate(zip(self.cartes, self.icones)):
  488:             u = 1.0 if final else (t - self._t(i)) / C.INSERT_ENTREE
  489:             if u <= 0:
  490:                 continue
  491:             dx = 0 if final else -C.INSERT_MONTEE * self.s * (1 - T.lisse(u))
  492:             cy = self.m + i * self.pas + self.lh / 2
  493:             _poser(out, carte, carte.width / 2 + dx, cy, 1.0,
  494:                    1.0 if final else T.lisse(u * C.INSERT_FONDU))
  495:             v = 1.0 if final else (t - self._t(i) - C.CHOIX_ICONE_DELAI) / C.INSERT_ENTREE
  496:             if v > 0:
  497:                 k0 = C.CHOIX_GEO["icone_depart"]
  498:                 k = k0 + (1 - k0) * (1.0 if final else T.rebond(v))
  499:                 cx = self.m + self.px(C.CHOIX_PAD) + self.px(C.CHOIX_ICONE) / 2 + dx
  500:                 # une question ouverte ne tient pas en place : son « ? » se balance
  501:                 angle = 0.0
  502:                 if not final and self.lignes[i].get("ok") is None and v > 1:
  503:                     amp, freq = C.CHOIX_GEO["balance"]
  504:                     angle = amp * math.sin(2 * math.pi * freq * (t - self._t(i)))
  505:                 _poser(out, icone, cx, cy, k, 1.0 if final else T.lisse(v * C.CHOIX_GEO["fondu_icone"]), angle)
  506:         return out
  507: 
  508:     def sons(self):
  509:         return [(self._t(i) + C.CHOIX_ICONE_DELAI, "clic") for i in range(len(self.lignes))]
  510: 
