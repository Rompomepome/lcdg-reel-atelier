 1649: def inserts(ep, scenes, ouverture=None):
 1650:     """Les inserts du reel, un ou plusieurs par bloc qui en porte (scenes : habillage.scenes)."""
 1651:     out = []
 1652:     for k, bl in enumerate(ep["blocs"]):
 1653:         specs = bl.get("insert")
 1654:         if not specs:
 1655:             continue
 1656:         specs = [specs] if isinstance(specs, dict) else specs
 1657:         if bl.get("type") in ("phrase", "chiffre") or k == 0:
 1658:             raise SystemExit(f"[!] bloc {k} : un insert se pose sur un bloc de texte (pas sur "
 1659:                              "l'accroche, une phrase forte ou un chiffre cle).")
 1660:         scene = scenes[k]
 1661:         hauts = [b[1] for b in (hb._bbox(lay) for _, lay, _ in scene.couches()) if b]
 1662:         bas = min(hauts) if hauts else C.BLOC_Y
 1663:         if ouverture is not None and ouverture.scene is scene:
 1664:             bas = ouverture.pos[1]
 1665:         premier = None
 1666:         for spec in specs:
 1667:             # "carre": false le retire de la version carree, plus basse : au bloc 1, la pastille
 1668:             # d'ouverture ne laisse pas toujours la place d'un insert (charte.CARRE)
 1669:             if spec.get("carre") is False and C.LARGEUR == C.HAUTEUR:
 1670:                 continue
 1671:             if spec.get("type") not in TYPES:
 1672:                 raise SystemExit(f"[!] bloc {k} : insert inconnu « {spec.get('type')} ». "
 1673:                                  f"Types : {', '.join(TYPES)}.")
 1674:             nom = f"insert bloc {k}" + (f" ({spec['type']})" if len(specs) > 1 else "")
 1675:             ins = TYPES[spec["type"]](nom, spec, scene, bas - C.INSERT_ECART)
 1676:             # "sur": true centre l'element sur le premier insert du bloc (un tampon sur un dessin)
 1677:             if spec.get("sur") and premier is not None:
 1678:                 ins.x = premier.x + (premier.w - ins.w) / 2
 1679:                 ins.y = premier.y + (premier.h - ins.h) / 2
 1680:             premier = premier or ins
 1681:             out.append(ins)
 1682:     return out

