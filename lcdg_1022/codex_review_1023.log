 1169:     def _ecran_sur(self, im, texte):
 1170:         g, q = C.FRIGO_GEO, self.f
 1171:         _ecrire(ImageDraw.Draw(im), (self.mf + self.fw / 2, self.mf + g["panneau"] * q / 2), texte,
 1172:                 max(6, int(round(g["ecran_px"] * q))), C.INSERT_GRAISSE_FORTE, _teinte(C.INSERT_VERT, 0.35) + (255,), "mm")
