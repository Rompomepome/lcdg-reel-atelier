  639:     def dessiner(self, lay, t, final=False):
  640:         if not final:
  641:             e = (t - self.debut) / C.OUVERTURE_ECLAIR_DUREE
  642:             if 0 <= e < 1:
  643:                 a = int(255 * C.OUVERTURE_ECLAIR * (1 - T.lisse(e)))
  644:                 if a > 1:
  645:                     lay.alpha_composite(Image.new('RGBA', (W, H), (255, 255, 255, a)))
  646:         so = 0.0 if final else self._sortie(t)
  647:         if so >= 1:
  648:             return
  649:         p = 1.0 if final else T.lisse((t - self.debut - C.OUVERTURE_BADGE_DELAI) / C.PASTILLE_DUREE)
  650:         if p <= 0:
  651:             return
