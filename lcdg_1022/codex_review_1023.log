  824: # ---------------------------------------------------- illustrations : outils
  825: def _net(w, h, dessiner):
  826:     """Forme sans escalier : tracee a INSERT_SURECHANTILLON fois sa taille, puis reduite.
  827:     dessiner(d, k) recoit le pinceau et le facteur k, a appliquer a toutes les longueurs."""
  828:     k = C.INSERT_SURECHANTILLON
  829:     w, h = max(1, int(round(w))), max(1, int(round(h)))
  830:     grand = Image.new("RGBA", (w * k, h * k), (0, 0, 0, 0))
  831:     dessiner(ImageDraw.Draw(grand), k)
  832:     return grand.resize((w, h), Image.LANCZOS)
  833: 
  834: 
  835: def _teinte(couleur, p):
  836:     """La couleur eclaircie vers le blanc (p = 1 : blanc)."""
  837:     return tuple(int(round(c + (255 - c) * p)) for c in couleur)
  838: 
  839: 
  840: def _ombre_marge(im, s):
  841:     """im entoure de la marge que demande son ombre, puis ombre (le centre ne bouge pas)."""
  842:     m = int(C.INSERT_OMBRE[0] * C.INSERT_MARGE_OMBRE * s) + 4
  843:     out = Image.new("RGBA", (im.width + 2 * m, im.height + 2 * m), (0, 0, 0, 0))
  844:     out.alpha_composite(im, (m, m))
  845:     return _ombre(out, s)
  846: 
  847: 
  848: def _icone_choix(ok, diametre, trait, rubrique):
  849:     """Rond a coche (ok), a croix (non), ou « ? » a la couleur de la rubrique (ok absent : une
  850:     question encore ouverte)."""
  851:     r = diametre / 2
  852:     n = int(2 * r) + 4
  853:     im = Image.new("RGBA", (n, n), (0, 0, 0, 0))
  854:     d = ImageDraw.Draw(im)
  855:     c = n / 2
  856:     fond = rubrique if ok is None else C.INSERT_VERT if ok else C.INSERT_ROUGE
  857:     d.ellipse([c - r, c - r, c + r, c + r], fill=tuple(fond) + (255,))
  858:     if ok is None:
  859:         _ecrire(d, (c, c), "?", int(r * C.CHOIX_GEO["question"]), C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
  860:     elif ok:
  861:         d.line([(c - r * 0.45, c + r * 0.02), (c - r * 0.1, c + r * 0.36), (c + r * 0.48, c - r * 0.3)],
  862:                fill=C.BLANC + (255,), width=trait, joint="curve")
  863:     else:
  864:         k = r * 0.38
  865:         d.line([(c - k, c - k), (c + k, c + k)], fill=C.BLANC + (255,), width=trait)
  866:         d.line([(c - k, c + k), (c + k, c - k)], fill=C.BLANC + (255,), width=trait)
  867:     return im
  868: 
  869: 
  870: def _pointilles(im, periode, plein):
  871:     """Garde un trait sur deux le long de diagonales : un contour devient pointille."""
  872:     masque = Image.new("L", im.size, 0)
  873:     d = ImageDraw.Draw(masque)
  874:     for x in range(-im.height, im.width, periode):
  875:         d.polygon([(x, 0), (x + plein, 0), (x + plein + im.height, im.height), (x + im.height, im.height)], fill=255)
  876:     out = im.copy()
  877:     out.putalpha(ImageChops.multiply(im.getchannel("A"), masque))
  878:     return out
