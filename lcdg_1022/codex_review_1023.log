  881: # -------------------------------------------------------------- frigo
  882: class Frigo(_Insert):
  883:     """L'enceinte refrigeree du cabinet.
  884:     Mode "remplir" : les boites de vaccin tombent sur les etageres ; au temps "prix", une piece
  885:     « € » se pose sur chacune, puis une etiquette claque sur la porte (« Payées d'abord »).
  886:     Mode "releve" : le refrigerateur plein et, a cote, la courbe de temperature qui s'enregistre
  887:     dans la plage de conservation ; l'ecran du refrigerateur affiche la valeur du moment."""
  888: 
  889:     def _releve(self):
  890:         return self.spec.get("mode") == "releve"
