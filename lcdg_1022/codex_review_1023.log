  248: 
  249: class Chiffre:
  250:     """Chiffre cle : la valeur defile jusqu'a sa cible, l'ancienne valeur est barree,
  251:     la legende se pose dessous a la place habituelle du texte. Avec "pictos", une boite
  252:     par unite s'allume (ou s'eteint) au rythme du compteur, au-dessus du chiffre.
  253: 
  254:     Champs du bloc : valeur, depuis (optionnel), prefixe, suffixe, decimales,
  255:     compte (defaut vrai), pictos (defaut faux), legende."""
  256: 
  257:     def __init__(self, nom, bl, debut, fin):
  258:         self.nom, self.debut, self.fin = nom, debut, fin
  259:         self.valeur = bl["valeur"]
  260:         self.depuis = bl.get("depuis")
  261:         self.compte = bl.get("compte", True)
  262:         self.dec = bl.get("decimales", 0)
  263:         suf = bl.get("suffixe", "")
  264:         # une unite en toutes lettres ("boites") passe en petit, sur la ligne de base du
  265:         # chiffre ; un symbole (EUR, %) garde le corps du chiffre, avec une espace fine :
  266:         # une espace pleine ouvrirait un trou a ce corps
  267:         self.suf_mot = sum(ch.isalpha() for ch in suf) >= 3
  268:         suf, pre = T.normaliser(suf), T.normaliser(bl.get("prefixe", ""))
  269:         self.suf = suf if self.suf_mot else suf.replace(" ", "\u2009")
  270:         self.pre = pre.replace(" ", "\u2009")
  271:         self.legende = T.Cinetique(bl.get("legende", ""),
  272:                                    debut + C.COMPTE_DELAI + C.COMPTE_DUREE * 0.5,
  273:                                    fin, style_bloc(), _RUBRIQUE)
  274:         # le compteur affiche aussi la valeur de depart : le corps se regle sur la plus large
  275:         valeurs = [self.valeur] + ([self.depuis] if self.compte and self.depuis is not None else [])
  276:         px = C.CHIFFRE_PX
  277:         while px > C.ANCIEN_PX and max(self._largeur(v, px) for v in valeurs) > C.TEXTE_LARGEUR:
  278:             px -= 4
  279:         self.px = px
  280:         self.px_suf = int(px * C.UNITE_ECHELLE) if self.suf_mot else px
  281:         f = T._police(px, C.CHIFFRE_GRAISSE)
  282:         self.asc, _ = f.getmetrics()
  283:         self.y = C.BLOC_Y - C.CHIFFRE_ECART - self.asc       # origine du trace du chiffre
  284:         haut = self.y + f.getbbox("0")[1]                    # haut visible des chiffres
  285:         if self.depuis is not None:
  286:             fa = T._police(C.ANCIEN_PX, C.ANCIEN_GRAISSE)
  287:             asc_a, _ = fa.getmetrics()
  288:             self.y_ancien = haut - C.ANCIEN_ECART - asc_a
  289:             b = fa.getbbox("0")
  290:             self.y_barre = self.y_ancien + (b[1] + b[3]) // 2
  291:             self.w_ancien = T.largeur(self.texte(self.depuis), C.ANCIEN_PX, C.ANCIEN_GRAISSE, 0)
  292:             haut = self.y_ancien + b[1]
  293:         self.pictos = self._pictos(haut) if bl.get("pictos") else None
  294: 
  295:     # -- texte du chiffre
  296:     def nombre(self, v):
  297:         return f"{v:,.{self.dec}f}".replace(",", "\u2009").replace(".", ",")
  298: 
  299:     def texte(self, v):
  300:         return self.pre + self.nombre(v) + self.suf
  301: 
  302:     def _largeur(self, v, px):
  303:         g, ap = C.CHIFFRE_GRAISSE, C.CHIFFRE_APPROCHE
  304:         w = T.largeur(self.pre + self.nombre(v), px, g, ap)
  305:         if self.suf_mot:
  306:             return w + T.largeur(self.suf, int(px * C.UNITE_ECHELLE), g, 0)
  307:         return w + T.largeur(self.suf, px, g, ap)
  308: 
  309:     def _valeur(self, lay, v, y, alpha):
  310:         """Prefixe et unite dans la couleur de la rubrique, chiffre en blanc."""
  311:         g, ap = C.CHIFFRE_GRAISSE, C.CHIFFRE_APPROCHE
  312:         x = C.TEXTE_X
  313:         for morceau, couleur in ((self.pre, _RUBRIQUE), (self.nombre(v), WHITE)):
  314:             if not morceau:
  315:                 continue
  316:             om, gl, m = T.sprite_chiffre(morceau, self.px, g, ap, tuple(couleur))
  317:             T.coller(lay, om, (x - m, y - m), alpha)
  318:             T.coller(lay, gl, (x - m, y - m), alpha)
  319:             x += T.largeur(morceau, self.px, g, ap) + ap * self.px
  320:         if self.suf:
  321:             asc_s, _ = T._police(self.px_suf, g).getmetrics()
  322:             ys = y + self.asc - asc_s                        # meme ligne de base
  323:             om, gl, m = T.sprite(self.suf, self.px_suf, g, 0 if self.suf_mot else ap,
  324:                                  tuple(_RUBRIQUE))
  325:             T.coller(lay, om, (x - m, ys - m), alpha)
  326:             T.coller(lay, gl, (x - m, ys - m), alpha)
  327: 
  328:     # -- pictogrammes
  329:     def _pictos(self, bas):
  330:         n = int(round(max(self.valeur, self.depuis or 0)))
  331:         if n < 1 or n > C.PICTO_MAX:
  332:             return None
  333:         if n <= C.PICTO_GRAND_MAX:
  334:             s, g, cols = C.PICTO_GRAND, C.PICTO_GRAND_ECART, n
  335:             # une ligne de grandes boites tient dans la colonne : au-dela de 7 boites
  336:             # (9:16), elles retrecissent
  337:             k = min(1.0, (C.TEXTE_LARGEUR + g) / (n * (s + g)))
  338:             s, g = int(s * k), int(g * k)
  339:         else:
  340:             s, g, cols = C.PICTO_PX, C.PICTO_ECART, C.PICTO_COLONNES
  341:         lignes = -(-n // cols)
  342:         haut = bas - C.PICTO_MARGE - lignes * (s + g) + g
  343:         return s, [(C.TEXTE_X + (i % cols) * (s + g), haut + (i // cols) * (s + g))
  344:                    for i in range(n)]
  345: 
  346:     def _dessiner_pictos(self, lay, v, t, a_s, dy_s, final):
  347:         s, pos = self.pictos
  348:         sp, m = picto(s)
  349:         v0 = self.depuis if self.depuis is not None else 0
  350:         t0 = self.debut + C.ENTREE_DELAI
  351:         for i, (x, y) in enumerate(pos):
  352:             allume = min(1.0, max(0.0, v - i))
  353:             if i < v0:
  354:                 # deja la au depart : apparait avec le chiffre, s'eteint si le compte descend
  355:                 e = 1.0 if final else T.lisse((t - t0 - i * C.PICTO_DECALAGE) / C.MOT_DUREE)
  356:                 a = e * (C.PICTO_ETEINT + (1 - C.PICTO_ETEINT) * allume)
  357:                 k = 1.0
  358:             else:
  359:                 # une boite qui s'allume rebondit : elle part petite et se pose a sa taille
  360:                 a = allume
--- 361-540
  361:                 k = C.PICTO_ECHELLE + (1 - C.PICTO_ECHELLE) * T.rebond(allume)
  362:             im = sp if abs(k - 1) < 0.01 else sp.resize(
  363:                 (max(1, int(sp.width * k)), max(1, int(sp.height * k))), Image.BICUBIC)
  364:             cx, cy = x - m + sp.width / 2, y - m + sp.height / 2 + dy_s
  365:             T.coller(lay, im, (cx - im.width / 2, cy - im.height / 2), min(1.0, a * a_s))
  366: 
  367:     def dessiner(self, lay, t, final=False):
  368:         so = 0.0 if final else self.legende._sortie(t)
  369:         if so >= 1:
  370:             return
  371:         a_s, dy_s = 1 - so, -C.SORTIE_MONTEE * so
  372:         t0 = self.debut + C.ENTREE_DELAI
  373:         v0 = self.depuis if self.depuis is not None else 0
  374:         k = 1.0 if (final or not self.compte) else T.lisse(
  375:             (t - (self.debut + C.COMPTE_DELAI)) / C.COMPTE_DUREE)
  376:         v_continu = v0 + (self.valeur - v0) * k if self.compte else self.valeur
  377:         if self.pictos:
  378:             self._dessiner_pictos(lay, v_continu, t, a_s, dy_s, final)
  379:         if self.depuis is not None:
  380:             e = 1.0 if final else T.lisse((t - t0) / C.MOT_DUREE)
  381:             om, gl, m = T.sprite(self.texte(self.depuis), C.ANCIEN_PX, C.ANCIEN_GRAISSE, 0)
  382:             y = self.y_ancien + C.MOT_MONTEE * (1 - e) + dy_s
  383:             T.coller(lay, om, (C.TEXTE_X - m, y - m), e * a_s)
  384:             T.coller(lay, gl, (C.TEXTE_X - m, y - m), e * a_s * C.ANCIEN_ALPHA)
  385:             p = 1.0 if final else T.lisse((t - (t0 + C.BARRE_DELAI)) / C.BARRE_DUREE)
  386:             if p > 0:
  387:                 largeur_barre = self.w_ancien + 2 * C.BARRE_DEBORD
  388:                 barre = Image.new('RGBA', (max(1, int(largeur_barre * p)), C.BARRE_PX),
  389:                                   tuple(_RUBRIQUE) + (255,))
  390:                 T.coller(lay, barre, (C.TEXTE_X - C.BARRE_DEBORD,
  391:                                       self.y_barre - C.BARRE_PX // 2 + dy_s), a_s)
  392:         e = 1.0 if final else T.lisse((t - (t0 + C.CHIFFRE_DELAI)) / C.MOT_DUREE)
  393:         if e > 0:
  394:             v = round(v_continu, self.dec) if self.dec else int(round(v_continu))
  395:             self._valeur(lay, v, self.y + C.MOT_MONTEE * (1 - e) + dy_s, e * a_s)
  396:         self.legende.dessiner(lay, t, final)
  397: 
  398:     def voiler(self, lay, t):
  399:         voile(lay, C.VOILE_CHIFFRE * T.lisse((t - self.debut) / C.VOILE_DUREE)
  400:               * (1 - self.legende._sortie(t)))
  401: 
  402:     def couches(self):
  403:         lay = _vide(); self.dessiner(lay, 0, final=True)
  404:         out = [(self.nom, lay, COLONNE)]
  405:         if self.compte and self.depuis is not None:
  406:             # le compteur part de l'ancienne valeur : elle doit tenir dans la colonne aussi
  407:             depart = _vide(); self._valeur(depart, self.depuis, self.y, 1.0)
  408:             out.append((self.nom + " (depart du compteur)", depart, COLONNE))
  409:         return out
  410: 
  411: 
  412: def _bbox(lay, marge=0):
  413:     """Boite englobante des pixels nettement visibles d'une couche (ombres legeres
  414:     exclues), elargie de marge ; None si la couche est vide."""
  415:     b = lay.getchannel("A").point(lambda v: 255 if v > 24 else 0).getbbox()
  416:     return None if b is None else (b[0] - marge, b[1] - marge, b[2] + marge, b[3] + marge)
  417: 
  418: 
  419: def _croise(a, b):
  420:     return (a is not None and b is not None
  421:             and a[0] < b[2] and b[0] < a[2] and a[1] < b[3] and b[1] < a[3])
  422: 
  423: 
  424: class Bandeau:
  425:     """Invitation a commenter, en haut a gauche, en blanc sans fond : la raison en petit
  426:     corps, l'appel (la ligne qui porte le mot cle) en plus grand, pour qu'on le voie. Le mot
  427:     cle (entre asterisques) dans un encadre de la couleur de la rubrique, en blanc,
  428:     legerement penche. Un "|" passe a la ligne. Visible du premier bloc a la croix : les
  429:     lignes glissent depuis la gauche, l'encadre s'ouvre avec un rebond, puis le tout
  430:     repart vers la gauche. Il fait de meme pour laisser la place a un bloc qui entrerait
  431:     dans sa zone (scenes), et revient apres lui."""
  432: 
  433:     def __init__(self, texte, debut, fin, scenes=()):
  434:         self.debut, self.fin = debut, fin
  435:         g = C.BANDEAU_GRAISSE
  436:         self.marge = m = C.HALO_FLOU * 2
  437:         self.lignes = []           # par ligne : mots (ombre, glyphes, x, y) et encadres (image, centre)
  438:         y = C.BANDEAU_Y
  439:         for ligne in (l.strip() for l in texte.split('|') if l.strip()):
  440:             atomes = T.atomes(ligne)
  441:             px = self._corps_appel(atomes) if any(at[1] for at in atomes) else C.BANDEAU_PX
  442:             cap = T._police(px, g).getbbox("H")
  443:             x = 0.0
  444:             mots, boites = [], []
  445:             for at in atomes:
  446:                 mot, cle = at[0], at[1]
  447:                 if mot == " ":
  448:                     x += T.largeur(" ", px, g, 0)
  449:                 elif cle:
  450:                     boite, bw = self._boite(mot, px)
  451:                     boites.append((boite, (C.TEXTE_X + x + bw / 2, y + (cap[1] + cap[3]) / 2)))
  452:                     x += bw
  453:                 else:
  454:                     om, gl, _ = T.sprite(mot, px, g, 0)
  455:                     mots.append((om, gl, C.TEXTE_X + x - m, y - m))
  456:                     x += T.largeur(mot, px, g, 0)
  457:             self.lignes.append((mots, boites))
  458:             y += round(px * C.BANDEAU_INTERLIGNE)
  459:         self.segments = self._segments(scenes)
  460: 
  461:     def _segments(self, scenes):
  462:         """Intervalles (debut, fin) ou le bandeau est visible."""
  463:         zone = _bbox(self.couche(), C.BANDEAU_ECART_BLOC)
  464:         pauses = sorted((sc.debut, sc.fin) for sc in scenes
  465:                         if any(_croise(zone, _bbox(lay)) for _, lay, _ in sc.couches()))
  466:         segs, a = [], self.debut
  467:         for p0, p1 in pauses:
  468:             if p1 <= a or p0 >= self.fin:
  469:                 continue
  470:             if p0 - a >= C.BANDEAU_SEGMENT_MIN:
  471:                 segs.append((a, p0))
  472:             a = max(a, p1)
  473:         if self.fin - a >= C.BANDEAU_SEGMENT_MIN:
  474:             segs.append((a, self.fin))
  475:         return segs
  476: 
  477:     @staticmethod
  478:     def _corps_appel(atomes):
  479:         """Corps de la ligne du mot cle : BANDEAU_ACTION_PX, moins si la ligne ne tient pas
  480:         entre la marge et le logo (ombres comprises), jamais sous BANDEAU_ACTION_PX_MIN."""
  481:         g = C.BANDEAU_GRAISSE
  482:         dispo = (watermark().getchannel("A").getbbox()[0] - C.BANDEAU_ECART_LOGO - C.TEXTE_X
  483:                  - 4)                                     # ombre de l'encadre
  484: 
  485:         def largeur(px):
  486:             total = 0.0
  487:             for at in atomes:
  488:                 mot, cle = at[0], at[1]
  489:                 if mot == " ":
  490:                     total += T.largeur(" ", px, g, 0)
  491:                 elif cle:
  492:                     total += T.largeur(mot, px, C.CLE_GRAISSE, 0) + 2 * round(px * C.BANDEAU_BOITE_PAD[0])
  493:                 else:
  494:                     total += T.largeur(mot, px, g, 0)
  495:             return total
  496: 
  497:         px = C.BANDEAU_ACTION_PX
  498:         while px > C.BANDEAU_ACTION_PX_MIN and largeur(px) > dispo:
  499:             px -= 1
  500:         return px
  501: 
  502:     @staticmethod
  503:     def _boite(mot, px):
  504:         """(encadre penche, largeur avant rotation) du mot cle, au corps de sa ligne."""
  505:         g = C.CLE_GRAISSE
  506:         f = T._police(px, g)
  507:         cap = f.getbbox("H")
  508:         pad_x, pad_y = (round(px * r) for r in C.BANDEAU_BOITE_PAD)
  509:         bw = int(T.largeur(mot, px, g, 0) + 2 * pad_x)
  510:         bh = int(cap[3] - cap[1] + 2 * pad_y)
  511:         im = Image.new('RGBA', (bw, bh), (0, 0, 0, 0))
  512:         d = ImageDraw.Draw(im)
  513:         d.rounded_rectangle([0, 0, bw - 1, bh - 1], radius=round(px * C.BANDEAU_BOITE_RAYON),
