  354: # ----------------------------------------------------------------- barres
  355: class Barres(_Insert):
  356:     """Des barres horizontales qui poussent, la valeur qui defile au bout."""
  357: 
  358:     def taille_nominale(self):
  359:         n = len(self.spec["lignes"])
  360:         return C.TEXTE_LARGEUR, 2 * C.BARRES_PAD + n * C.BARRES_LIGNE_H
  361: 
  362:     def __init__(self, *a):
  363:         super().__init__(*a)
  364:         sp = self.spec
  365:         self.unite = T.normaliser(sp.get("unite", ""))
  366:         # suffixe colle au nombre par une espace insecable : « 50 € »
  367:         self.suffixe = T.normaliser(sp.get("suffixe", "")).replace(" ", "\u00a0")
  368:         self.lignes = sp["lignes"]
  369:         self.vmax = max(l["valeur"] for l in self.lignes)
  370:         self.dec = max((len(str(l["valeur"]).split(".")[1]) if "." in str(l["valeur"]) else 0)
  371:                        for l in self.lignes)
  372:         self.depart = 1.0 if self.unite in ("×", "x") else 0.0
  373:         pad = self.px(C.BARRES_PAD)
  374:         val_w = T.largeur(f"{self.unite}{_nombre(self.vmax, self.dec)}{self.suffixe}",
  375:                           self.px(C.BARRES_VALEUR_PX), C.INSERT_GRAISSE_FORTE, 0)
  376:         self.barre_max = self.w - 2 * pad - val_w - self.px(C.BARRES_GEO["valeur_marge"])
  377:         self.pad = pad
  378:         self._fonds = {}
  379: 
  380:     def _fond(self, hc):
  381:         """Carte de hauteur hc (elle grandit a chaque nouvelle barre), gardee en cache."""
  382:         if hc not in self._fonds:
  383:             self._fonds[hc] = _ombre(_cadre(self.w, hc, self.s, marge=self.m), self.s)
  384:         return self._fonds[hc]
  385: 
  386:     def _hauteur(self, t, final):
  387:         lh = self.px(C.BARRES_LIGNE_H)
  388:         if final:
  389:             return self.h
  390:         n = sum(T.lisse((t - self._t(i)) / C.BARRES_OUVERTURE) for i in range(len(self.lignes)))
  391:         return min(self.h, int(2 * self.pad + n * lh))
  392: 
  393:     def _t(self, i):
  394:         precedentes = [j for j in range(i) if self.lignes[j].get("temps", 0) == self.lignes[i].get("temps", 0)]
  395:         return self.t0(self.lignes[i].get("temps", 0)) + C.BARRES_DELAI + len(precedentes) * C.BARRES_DECALAGE
  396: 
  397:     def image(self, t, final):
  398:         u = 1.0 if final else (t - self.t0()) / C.INSERT_ENTREE
  399:         if u <= 0:
  400:             return None
  401:         # la carte est calee en bas, sur le texte : elle grandit vers le haut, et les barres
  402:         # deja posees montent avec elle
  403:         hc = self._hauteur(t, final)
  404:         carte = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
  405:         haut = self.h - hc
  406:         carte.alpha_composite(self._fond(hc), (0, haut))
  407:         d = ImageDraw.Draw(carte)
  408:         m, pad = self.m, self.pad
  409:         for i, l in enumerate(self.lignes):
  410:             v_ = 1.0 if final else (t - self._t(i)) / C.INSERT_POUSSE
  411:             if v_ <= 0:
  412:                 continue
  413:             p = 1.0 if final else T.lisse(v_)
  414:             y = m + haut + pad + i * self.px(C.BARRES_LIGNE_H)
  415:             if y + self.px(C.BARRES_LIGNE_H) > m + haut + hc + self.px(C.BARRES_GEO["tolerance"]):
  416:                 continue                                 # pas encore de place pour cette ligne
  417:             a = int(255 * min(1.0, 1.0 if final else v_ * C.BARRES_GEO["fondu_ligne"]))
  418:             _ecrire(d, (m + pad, y), l["label"], self.px(C.BARRES_LABEL_PX), C.INSERT_GRAISSE_TEXTE,
  419:                     C.NAVY + (a,))
  420:             yb = y + self.px(C.BARRES_LABEL_PX + C.BARRES_GEO["label_ecart"])
  421:             hb_ = self.px(C.BARRES_EPAISSEUR)
  422:             # une premiere ligne a x1 (multiplicateur) est la reference : grise
  423:             reference = l.get("reference", i == 0 and self.depart == 1.0 and l["valeur"] == 1)
  424:             couleur = C.INSERT_GRIS if reference else self.rubrique
  425:             longueur = max(hb_, self.barre_max * l["valeur"] / self.vmax * p)
  426:             d.rounded_rectangle([m + pad, yb, m + pad + longueur, yb + hb_], radius=hb_ // 2,
  427:                                 fill=tuple(couleur) + (a,))
  428:             v = self.depart + (l["valeur"] - self.depart) * p
  429:             # des que l'arrondi atteint la cible, la valeur s'affiche telle quelle (« ×2 »,
  430:             # pas « ×2,0 » quelques images avant)
  431:             if p >= 1 or round(v, self.dec) == round(l["valeur"], self.dec):
  432:                 v, dec = l["valeur"], (0 if float(l["valeur"]).is_integer() else self.dec)
  433:             else:
  434:                 dec = self.dec
  435:             texte = f"{self.unite}{_nombre(v, dec)}{self.suffixe}"
  436:             _ecrire(d, (m + pad + longueur + self.px(C.BARRES_GEO["valeur_ecart"]), yb + hb_ / 2),
  437:                     texte, self.px(C.BARRES_VALEUR_PX), C.INSERT_GRAISSE_FORTE,
  438:                     (C.INSERT_GRIS_TEXTE if reference else C.NAVY) + (a,), "lm")
  439:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
  440:         k = C.INSERT_ECHELLE + (1 - C.INSERT_ECHELLE) * (1.0 if final else T.rebond(u))
--- 441-660
  441:         _poser(out, carte, carte.width / 2, carte.height / 2, k,
  442:                1.0 if final else T.lisse(u * C.INSERT_FONDU))
  443:         return out
  444: 
  445:     def sons(self):
  446:         return [(self._t(i), "clic") for i in range(len(self.lignes))]
