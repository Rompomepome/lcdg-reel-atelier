  702:         couleur = (self.rubrique if "ok" not in c else C.INSERT_VERT if c["ok"] else C.INSERT_ROUGE) + (255,)
  703:         rayon = max(4, int(C.INSERT_RAYON * self.s))
  704:         d.rounded_rectangle([m, m, m + self.cw - 1, m + tete], radius=rayon, fill=couleur)
  705:         d.rectangle([m, m + tete // 2, m + self.cw - 1, m + tete], fill=couleur)
  706:         _ecrire(d, (m + self.cw / 2, m + tete / 2), c["date"], self.px(C.DUEL_DATE_PX),
  707:                 C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
  708:         px = self.px(C.DUEL_TEXTE_PX)
  709:         lignes = _couper(c["texte"], px, C.INSERT_GRAISSE_FORTE, self.cw - 2 * self.px(g["pad"]))
  710:         lh = px * g["interligne"]
  711:         y0 = m + tete + (self.h - tete - lh * len(lignes)) / 2 + lh / 2
  712:         for k, ligne in enumerate(lignes):
  713:             _ecrire(d, (m + self.cw / 2, y0 + k * lh), ligne, px, C.INSERT_GRAISSE_FORTE, C.NAVY + (255,), "mm")
