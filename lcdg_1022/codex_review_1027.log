 1617:                 continue
 1618:             vis = seg.crop((0, 0, max(1, int(round(min(b, rempli) - a))), seg.height))
 1619:             if i == self.question and v > 0:
 1620:                 carte.alpha_composite(self.empreinte, (int(round(self.bx0 + a)), int(round(self.by))))
 1621:                 dy = -self.px(g["levee"]) * v
