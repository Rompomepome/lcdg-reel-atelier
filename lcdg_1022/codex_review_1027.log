1656: def inserts(ep, scenes, ouverture=None):
1657:     """Les inserts du reel, un ou plusieurs par bloc qui en porte (scenes : habillage.scenes)."""
1658:     out = []
1659:     for k, bl in enumerate(ep["blocs"]):
1660:         specs = bl.get("insert")
1661:         if not specs:
1662:             continue
1663:         specs = [specs] if isinstance(specs, dict) else specs
1664:         if bl.get("type") in ("phrase", "chiffre") or k == 0:
1665:             raise SystemExit(f"[!] bloc {k} : un insert se pose sur un bloc de texte (pas sur "
1666:                              "l'accroche, une phrase forte ou un chiffre cle).")
1667:         scene = scenes[k]
1668:         hauts = [b[1] for b in (hb._bbox(lay) for _, lay, _ in scene.couches()) if b]
1669:         bas = min(hauts) if hauts else C.BLOC_Y
1670:         if ouverture is not None and ouverture.scene is scene:
1671:             bas = ouverture.pos[1]
1672:         premier, haut = None, bas - C.INSERT_ECART
1673:         for spec in specs:
1674:             # "carre": false le retire de la version carree, plus basse : au bloc 1, la pastille
1675:             # d'ouverture ne laisse pas toujours la place d'un insert (charte.CARRE)
1676:             if spec.get("carre") is False and C.LARGEUR == C.HAUTEUR:
1677:                 continue
1678:             if spec.get("type") not in TYPES:
1679:                 raise SystemExit(f"[!] bloc {k} : insert inconnu « {spec.get('type')} ». "
1680:                                  f"Types : {', '.join(TYPES)}.")
1681:             nom = f"insert bloc {k}" + (f" ({spec['type']})" if len(specs) > 1 else "")
1682:             # "sur": true centre l'element sur le premier insert du bloc (un tampon sur un dessin) ;
1683:             # sinon, chaque element s'empile au-dessus du precedent
1684:             sur = spec.get("sur") and premier is not None
1685:             ins = TYPES[spec["type"]](nom, spec, scene, bas - C.INSERT_ECART if sur else haut)
1686:             if sur:
1687:                 ins.x = premier.x + (premier.w - ins.w) / 2
1688:                 ins.y = premier.y + (premier.h - ins.h) / 2
1689:             else:
1690:                 haut = ins.y - C.INSERT_ECART_ELEMENTS
1691:             premier = premier or ins
1692:             out.append(ins)
1693:     return out
