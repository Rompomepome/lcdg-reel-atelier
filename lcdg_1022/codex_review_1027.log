 1594:                 d.line([(x, y - self.px(10)), (x, y)], fill=couleur, width=tr)
 1595:             ancre, x = ("rt", self.bx0 + b) if dernier else ("lt", self.bx0 + a)
 1596:             _ecrire(d, (x, y + self.px(10)), p["label"], px,
