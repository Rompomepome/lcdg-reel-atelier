 1574:                 x = -H
 1575:                 while x < W:
 1576:                     d.line([(x, H), (x + H, 0)], fill=_teinte(self.rubrique, 0.68) + (255,), width=int(pas * 0.4))
 1577:                     x += pas
 1578:         return _net(w, h, dessin)
