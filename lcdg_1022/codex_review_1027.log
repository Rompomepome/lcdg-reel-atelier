 1629:                     _poser(carte, self.badge, self.bx0 + b - self.px(g["badge"]) * 0.6,
 1630:                            cy - self.bh / 2 - self.px(g["badge"]) * 0.7, kk, 1.0 if final else T.lisse(w2 * C.INSERT_FONDU))
 1631:             else:
