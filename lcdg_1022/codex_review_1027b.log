2106: # ------------------------------------------------------------- bascule
2107: class Bascule(_Insert):
2108:     """Un ephemeride : la page « avant » se plie vers le haut, la page « apres » apparait dessous ;
2109:     a droite, la legende de chaque page, et une pilule rouge qui claque (« Nouvelles règles »)."""
2110: 
2111:     def taille_nominale(self):
2112:         g = C.BASCULE_GEO
2113:         return C.TEXTE_LARGEUR, C.BASCULE_H
2114: 
2115:     def _page(self, p):
2116:         g = C.BASCULE_GEO
2117:         w, h = self.px(g["page"][0]), self.px(g["page"][1])
2118:         tete = self.px(g["tete"])
2119: 
2120:         def dessin(dd, k):
2121:             dd.rounded_rectangle([0, 0, w * k - 1, h * k - 1], radius=self.px(22) * k, fill=C.BLANC + (255,))
2122:             dd.rounded_rectangle([0, 0, w * k - 1, (tete + self.px(22)) * k], radius=self.px(22) * k,
2123:                                  fill=C.INSERT_ROUGE + (255,))
2124:             dd.rectangle([0, tete * k, w * k - 1, (tete + self.px(22)) * k], fill=C.BLANC + (255,))
2125:         im = _net(w, h, dessin)
2126:         d = ImageDraw.Draw(im)
2127:         _ecrire(d, (w / 2, tete / 2), T.normaliser(p["haut"]).upper(), self.px(g["mois_px"]), C.INSERT_GRAISSE_FORTE,
2128:                 C.BLANC + (255,), "mm")
2129:         _ecrire(d, (w / 2, tete + (h - tete) * 0.46), p["jour"], self.px(g["jour_px"]), C.INSERT_GRAISSE_FORTE,
2130:                 C.NAVY + (255,), "mm")
2131:         _ecrire(d, (w / 2, h - self.px(26)), p.get("bas", ""), self.px(g["bas_px"]), C.INSERT_GRAISSE_TEXTE,
2132:                 C.INSERT_GRIS_TEXTE + (255,), "mm")
2133:         return im
2134: 
2135:     def __init__(self, *a):
2136:         super().__init__(*a)
2137:         g = C.BASCULE_GEO
2138:         self.pages = [self._page(self.spec["avant"]), self._page(self.spec["apres"])]
2139:         aw, ah = self.px(g["anneau"][0]), self.px(g["anneau"][1])
2140:         self.anneau = _net(aw, ah, lambda dd, k: dd.rounded_rectangle([0, 0, aw * k - 1, ah * k - 1], radius=aw * k / 2,
2141:                                                                         fill=C.NAVY + (255,)))
2142:         self.px_x = self.m + self.px(28)                                    # gauche de la page
2143:         self.py = self.m + self.h - self.pages[0].height - self.px(26)       # haut de la page
2144:         self.carte = _ombre(_cadre(self.w, self.h, self.s, marge=self.m), self.s)
2145:         self.xl = self.px_x + self.pages[0].width + self.px(g["ecart"])
2146:         self.pilule = _ombre_marge(_bulle(self.spec.get("pilule", ""), self.px(g["pilule_px"]), self.px(g["pilule_h"]),
2147:                                           self.px(24), C.INSERT_ROUGE, queue=False), self.s)
2148: 
2149:     def _t_pli(self):
2150:         return self.t0(self.spec.get("temps", 1)) + C.INSERT_DELAI
2151: 
2152:     def image(self, t, final):
2153:         g = C.BASCULE_GEO
2154:         k, a = _entree(t, self.t0(), final)
2155:         if a <= 0:
2156:             return None
2157:         cal = self.carte.copy()
2158:         p = 1.0 if final else max(0.0, min(1.0, (t - self._t_pli()) / g["pli"]))
2159:         pw, ph = self.pages[0].size
2160:         if p > 0:
2161:             cal.alpha_composite(_ombre_marge(self.pages[1], self.s), (int(self.px_x - self.m), int(self.py - self.m)))
2162:         if p < 1:                                         # la page « avant » se replie vers le haut
2163:             hh = max(1, int(ph * (1 - T.lisse(p))))
2164:             plie = self.pages[0].resize((pw, hh), Image.BICUBIC)
2165:             if p > 0:
2166:                 ombre = Image.new("RGBA", plie.size, (0, 0, 0, int(90 * p)))
2167:                 ombre.putalpha(ImageChops.multiply(ombre.getchannel("A"), plie.getchannel("A")))
2168:                 plie.alpha_composite(ombre)
2169:             cal.alpha_composite(_ombre_marge(plie, self.s), (int(self.px_x - self.m), int(self.py - self.m)))
2170:         aw = self.anneau.width
2171:         for fx in (0.28, 0.72):
2172:             cal.alpha_composite(self.anneau, (int(self.px_x + pw * fx - aw / 2), int(self.py - self.anneau.height * 0.6)))
2173:         d = ImageDraw.Draw(cal)
2174:         lp = self.px(g["legende_px"])
2175:         for i, cle in enumerate(("legende_avant", "legende_apres")):
2176:             texte = self.spec.get(cle, "")
2177:             q = 1 - min(1.0, p * 2) if i == 0 else max(0.0, p * 2 - 1)      # l'une s'efface, puis l'autre
2178:             if not texte or q <= 0:
2179:                 continue
2180:             al = int(255 * q)
2181:             lignes = _couper(texte, lp, C.INSERT_GRAISSE_FORTE, self.m + self.w - self.xl)
2182:             for j, l in enumerate(lignes):
2183:                 _ecrire(d, (self.xl, self.py + self.px(30) + j * lp * 1.2), l, lp, C.INSERT_GRAISSE_FORTE,
2184:                         C.NAVY + (al,))
2185:         v = 1.0 if final else (t - self._t_pli() - g["pli"]) / C.TAMPON_FRAPPE
2186:         if v > 0:
2187:             kk = 1.0 if final or v >= 1 else C.TAMPON_ECHELLE - (C.TAMPON_ECHELLE - 1) * v * v
2188:             _poser(cal, self.pilule, self.xl + (self.pilule.width - 2 * self.m) / 2,
2189:                    self.py + self.pages[0].height - self.px(g["pilule_h"]) / 2 - self.px(6), kk,
2190:                    1.0 if final else min(1.0, v * 2), -4)
2191:         out = Image.new("RGBA", cal.size, (0, 0, 0, 0))
2192:         _poser(out, cal, cal.width / 2, cal.height / 2, k, a)
2193:         return out
2194: 
2195:     def sons(self):
2196:         g = C.BASCULE_GEO
2197:         return [(self.t0(), "clic"), (self._t_pli(), "souffle"), (self._t_pli() + g["pli"] + C.TAMPON_FRAPPE, "impact")]
2198: 
2199: 
2200: # -------------------------------------------------------------- icones
2201: class Icones(_Insert):
2202:     """Des cartes a icone dessinee (repere, lune, casque), qui arrivent l'une apres l'autre ; un
2203:     « ? » se balance au coin de chacune : une question encore ouverte."""
2204: 
2205:     def taille_nominale(self):
2206:         return C.TEXTE_LARGEUR, C.ICONES_H
2207: 
2208:     def __init__(self, *a):
2209:         super().__init__(*a)
2210:         g = C.ICONES_GEO
2211:         self.items = self.spec["cartes"]
2212:         n = len(self.items)
2213:         self.ecart = self.px(g["ecart"])
