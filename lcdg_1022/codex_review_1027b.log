1870:             return None
1871:         carte = self.fond.copy()
1872:         rev, pen = self._niveaux(t, final)
1873:         for cx, niveau, couleur in ((self.cx[0], rev, C.INSERT_VERT), (self.cx[1], pen, self.rubrique)):
1874:             v = self._contenu(niveau, couleur, 0 if final else t)
1875:             carte.alpha_composite(v, (int(round(cx - self.vw / 2)), int(round(self.fond_y - self.vh))))
1876:         d = ImageDraw.Draw(carte)
1877:         if not final:                                    # les « +1 € » et « −1 € » s'envolent
1878:             n = int(g["remplissage"] / g["envol_pas"])
1879:             for i in range(n):
1880:                 ti = self._t() + i * g["envol_pas"]
1881:                 w2 = (t - ti) / g["envol"]
1882:                 if 0 < w2 < 1:
1883:                     al = int(255 * min(1.0, w2 * 4) * (1 - w2))
1884:                     dy = self.px(60) * T.lisse(w2)
1885:                     y = self.fond_y - self.vh * 0.35 - dy
1886:                     ecart = self.vw / 2 + self.px(16)
1887:                     _ecrire(d, (self.cx[0] - ecart, y), f"+1{NBSP}€", self.px(g["envol_px"]), C.INSERT_GRAISSE_FORTE,
1888:                             C.INSERT_VERT + (al,), "rs")
1889:                     _ecrire(d, (self.cx[1] + ecart, y), f"−1{NBSP}€", self.px(g["envol_px"]), C.INSERT_GRAISSE_FORTE,
1890:                             C.INSERT_ROUGE + (al,), "ls")
1891:         _ecrire(d, ((self.cx[0] + self.cx[1]) / 2, self.fond_y - self.vh * 0.55), "=", self.px(64),
1892:                 C.INSERT_GRAISSE_FORTE, C.INSERT_GRIS_TEXTE + (255,), "mm")
1893:         if self.spec.get("ajout") and not final:         # le jeton tombe dans le bocal des revenus
1894:             w2 = (t - self._t_ajout()) / g["chute"]
1895:             if 0 < w2 < 1.4:
1896:                 y0 = self.fond_y - self.vh - self.px(70)
1897:                 y1 = self.fond_y - self.vh * (rev + 0.1)
1898:                 y = y0 + (y1 - y0) * min(1.0, w2) ** 2
1899:                 _poser(carte, self.jeton, self.cx[0], y, 1.0, min(1.0, (1.4 - w2) * 3))
1900:         carte = _ombre(carte, self.s)
1901:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
1902:         _poser(out, carte, carte.width / 2, carte.height / 2, k, a)
1903:         return out
1904: 
1905:     def sons(self):
1906:         out = [(self._t(), "compteur")]
1907:         if self.spec.get("ajout"):
1908:             out.append((self._t_ajout() + C.VASES_GEO["chute"], "clic"))
1909:         return out
1910: 
