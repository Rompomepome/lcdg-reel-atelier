2016: # ---------------------------------------------------------------- part
2017: class Part(_Insert):
2018:     """La part d'une activite : au temps 0, une pastille (« Cumul intégral, sans plafond ») ; au
2019:     temps "temps_part", l'anneau se remplit (le reste de l'activite), puis la part plafonnee se
2020:     detache en vert, son pourcentage au centre, la legende a droite."""
2021: 
2022:     def taille_nominale(self):
2023:         return C.TEXTE_LARGEUR, C.PART_H
2024: 
2025:     def __init__(self, *a):
2026:         super().__init__(*a)
2027:         g, m = C.PART_GEO, self.m
2028:         carte = _cadre(self.w, self.h, self.s, marge=m)
2029:         self.fond = carte
2030:         self.r, self.ep = self.px(g["rayon"]), self.px(g["epaisseur"])
2031:         self.c = (m + self.px(g["pad"]) + self.r + self.ep / 2, m + self.h / 2)
2032:         self.part = self.spec["part"]
2033:         self.xl = self.c[0] + self.r + self.ep / 2 + self.px(36)            # colonne de droite
2034:         self.pastille = _ombre_marge(_bulle(self.spec.get("pastille", ""), self.px(g["pilule_px"]),
2035:                                             self.px(g["pilule_h"]), self.px(18), C.INSERT_VERT, queue=False), self.s)
2036: 
2037:     def _t_part(self):
2038:         return self.t0(self.spec.get("temps_part", 1)) + C.INSERT_DELAI
2039: 
2040:     def _anneau(self, p_reste, p_part, eclat):
2041:         g = C.PART_GEO
2042:         W, H = self.fond.size
2043:         cx, cy, r, e = self.c[0], self.c[1], self.r, self.ep
2044:         part = self.part / 100
2045: 
2046:         def dessin(dd, k):
2047:             box = [(cx - r) * k, (cy - r) * k, (cx + r) * k, (cy + r) * k]
2048:             dd.arc(box, 0, 360, fill=C.INSERT_GRIS + (255,), width=int(e * k))
2049:             if p_reste > 0:
2050:                 debut = -90 + 360 * part
2051:                 dd.arc(box, debut, debut + 360 * (1 - part) * p_reste, fill=tuple(self.rubrique) + (255,),
2052:                        width=int(e * k))
2053:             if p_part > 0:
2054:                 mil = math.radians(-90 + 180 * part)
2055:                 ox, oy = math.cos(mil) * eclat * k, math.sin(mil) * eclat * k
2056:                 b2 = [box[0] + ox, box[1] + oy, box[2] + ox, box[3] + oy]
2057:                 dd.arc(b2, -90, -90 + 360 * part * p_part, fill=C.INSERT_VERT + (255,), width=int(e * k))
2058:         return _net(W, H, dessin)
2059: 
2060:     def image(self, t, final):
2061:         g = C.PART_GEO
2062:         k, a = _entree(t, self.t0(), final)
2063:         if a <= 0:
2064:             return None
2065:         carte = self.fond.copy()
2066:         tp = self._t_part()
2067:         p_reste = 1.0 if final else T.lisse((t - tp) / g["remplissage"])
2068:         u = 1.0 if final else (t - tp - g["remplissage"]) / g["part_duree"]
2069:         p_part = 1.0 if final else T.lisse(u)
2070:         eclat = self.px(g["eclat"]) * (1.0 if final else T.rebond(u) if u > 0 else 0)
2071:         carte.alpha_composite(self._anneau(p_reste, p_part, eclat))
2072:         d = ImageDraw.Draw(carte)
2073:         cx, cy = self.c
2074:         if p_part > 0:
2075:             _ecrire(d, (cx, cy - self.px(6)), f"{int(round(self.part * p_part))}{NBSP}%", self.px(g["centre_px"]),
2076:                     C.INSERT_GRAISSE_FORTE, C.INSERT_VERT + (255,), "mm")
2077:             _ecrire(d, (cx, cy + self.px(g["centre_px"]) * 0.62), self.spec.get("centre", ""), self.px(g["petit_px"]),
2078:                     C.INSERT_GRAISSE_TEXTE, C.INSERT_GRIS_TEXTE + (255,), "mm")
2079:         v = 1.0 if final else (t - self.t0() - C.INSERT_ENTREE * 0.5) / C.INSERT_ENTREE
2080:         if v > 0:                                         # la pastille, en haut a droite
2081:             kk = 0.3 + 0.7 * (1.0 if final else T.rebond(v))
2082:             _poser(carte, self.pastille, self.xl + (self.pastille.width - 2 * self.m) / 2,
2083:                    self.m + self.px(g["pad"]) + self.px(g["pilule_h"]) / 2, kk, 1.0 if final else T.lisse(v * 2))
2084:         lp = self.px(g["legende_px"])
2085:         for i, (texte, couleur) in enumerate(((self.spec.get("legende_part", ""), C.INSERT_VERT),
2086:                                               (self.spec.get("legende_reste", ""), tuple(self.rubrique)))):
2087:             w2 = 1.0 if final else (t - tp - (g["remplissage"] + g["part_duree"] * 0.5 if i == 0 else 0.3)) / 0.4
2088:             if w2 <= 0:
2089:                 continue
2090:             al = int(255 * min(1.0, w2))
2091:             y = cy + self.px(18) + i * lp * 1.7
2092:             r = self.px(g["point"])
2093:             d.ellipse([self.xl, y - r, self.xl + 2 * r, y + r], fill=couleur + (al,))
2094:             _ecrire(d, (self.xl + 2 * r + self.px(14), y), texte, lp, C.INSERT_GRAISSE_FORTE, C.NAVY + (al,), "lm")
2095:         carte = _ombre(carte, self.s)
2096:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
2097:         _poser(out, carte, carte.width / 2, carte.height / 2, k, a)
2098:         return out
2099: 
2100:     def sons(self):
2101:         g = C.PART_GEO
2102:         return [(self.t0() + C.INSERT_ENTREE * 0.5, "clic"), (self._t_part(), "souffle"),
2103:                 (self._t_part() + g["remplissage"], "impact")]
2104: 
