1912: # -------------------------------------------------------------- pieces
1913: class Pieces(_Insert):
1914:     """Deux piles de pieces : a chaque cycle, deux pieces s'empilent a gauche (vos revenus au-dela du
1915:     seuil), une piece s'envole de la pile de droite (votre pension) ; les compteurs suivent."""
1916: 
1917:     def taille_nominale(self):
1918:         return C.TEXTE_LARGEUR, C.PIECES_H
1919: 
1920:     def __init__(self, *a):
1921:         super().__init__(*a)
1922:         g, m = C.PIECES_GEO, self.m
1923:         carte = _cadre(self.w, self.h, self.s, marge=m)
1924:         d = ImageDraw.Draw(carte)
1925:         _ecrire(d, (m + self.w / 2, m + self.px(g["pad"])), self.spec.get("titre", ""), self.px(g["titre_px"]),
1926:                 C.INSERT_GRAISSE_FORTE, C.NAVY + (255,), "mt")
1927:         self.sol = m + self.px(g["sol_y"])
1928:         self.cx = [m + self.w * c for c in g["col"]]
1929:         for cx, lab in zip(self.cx, (self.spec.get("gauche", ""), self.spec.get("droite", ""))):
1930:             _ecrire(d, (cx, self.sol + self.px(14)), lab, self.px(g["label_px"]), C.INSERT_GRAISSE_FORTE,
1931:                     C.NAVY + (255,), "mt")
1932:         self.fond = carte
1933:         self.pas = self.px(g["epaisseur"])
1934:         self.pieces = {c: self._piece(c) for c in ("vert", "bleu", "rouge")}
1935: 
1936:     def _piece(self, ton):
1937:         g = C.PIECES_GEO
1938:         w, h, e = self.px(g["piece"][0]), self.px(g["piece"][1]), self.px(g["epaisseur"])
1939:         couleur = {"vert": C.INSERT_VERT, "rouge": C.INSERT_ROUGE}.get(ton, tuple(self.rubrique))
1940:         fonce = tuple(int(c * 0.72) for c in couleur)
1941: 
1942:         def dessin(dd, k):
1943:             dd.rounded_rectangle([0, h * k / 2, w * k - 1, (h / 2 + e) * k], radius=2 * k, fill=fonce + (255,))
1944:             dd.ellipse([0, e * k, w * k - 1, (h + e) * k - 1], fill=fonce + (255,))
1945:             dd.ellipse([0, 0, w * k - 1, h * k - 1], fill=couleur + (255,))
1946:             dd.ellipse([w * k * 0.2, h * k * 0.2, w * k * 0.8, h * k * 0.8], outline=_teinte(couleur, 0.4) + (255,),
1947:                        width=max(1, int(2 * k)))
1948:         return _net(w, h + e, dessin)
1949: 
1950:     def _cycles(self):
1951:         g = C.PIECES_GEO
1952:         t0 = self.t0(self.spec.get("temps", 1)) + C.INSERT_DELAI
1953:         return [t0 + i * g["cycle"] for i in range(g["cycles"])]
1954: 
1955:     def image(self, t, final):
1956:         g = C.PIECES_GEO
1957:         k, a = _entree(t, self.t0(), final)
1958:         if a <= 0:
1959:             return None
1960:         carte = self.fond.copy()
1961:         cycles = self._cycles()
1962:         gagne = perdu = 0
1963:         chutes, envols = [], []
1964:         for tc in cycles:
1965:             for j in range(2):                            # deux pieces gagnees
1966:                 tj = tc + j * g["chute"] * 0.55
1967:                 w2 = 1.0 if final else (t - tj) / g["chute"]
1968:                 if w2 >= 1:
1969:                     gagne += 1
1970:                 elif w2 > 0:
1971:                     chutes.append(w2)
1972:             tp = tc + g["chute"] * 1.4                    # puis une piece de pension s'envole
1973:             w2 = 1.0 if final else (t - tp) / g["envol"]
1974:             if w2 >= 1:
1975:                 perdu += 1
1976:             elif w2 > 0:
1977:                 envols.append(w2)
1978:         ph = self.pieces["vert"].height
1979:         pile_d = self.spec.get("pension", g["pension"]) - perdu - len(envols)
1980:         for i in range(gagne):
1981:             carte.alpha_composite(self.pieces["vert"], (int(self.cx[0] - self.pieces["vert"].width / 2),
1982:                                                         int(self.sol - ph - i * self.pas)))
1983:         for w2 in chutes:                                 # une piece tombe sur la pile
1984:             y_fin = self.sol - ph - gagne * self.pas
1985:             y = y_fin - self.px(150) * (1 - w2 * w2)
1986:             T.coller(carte, self.pieces["vert"], (self.cx[0] - self.pieces["vert"].width / 2, y), min(1.0, w2 * 3))
1987:             gagne += 1
1988:         for i in range(pile_d):
1989:             carte.alpha_composite(self.pieces["bleu"], (int(self.cx[1] - self.pieces["bleu"].width / 2),
1990:                                                         int(self.sol - ph - i * self.pas)))
1991:         for w2 in envols:                                 # la piece du haut s'envole, rougit
1992:             y0 = self.sol - ph - pile_d * self.pas
1993:             x = self.cx[1] + self.px(90) * T.lisse(w2)
1994:             y = y0 - self.px(120) * T.lisse(w2)
1995:             T.coller(carte, self.pieces["rouge"], (x - self.pieces["rouge"].width / 2, y), 1 - w2)
1996:         d = ImageDraw.Draw(carte)
1997:         cp = self.px(g["compteur_px"])
1998:         y_c = self.sol - ph - (g["pension"] + 1) * self.pas - self.px(10)
1999:         if gagne:
2000:             _ecrire(d, (self.cx[0], y_c), f"+{gagne}{NBSP}€", cp, C.INSERT_GRAISSE_FORTE, C.INSERT_VERT + (255,), "ms")
2001:         if perdu:
2002:             _ecrire(d, (self.cx[1], y_c), f"−{perdu}{NBSP}€", cp, C.INSERT_GRAISSE_FORTE, C.INSERT_ROUGE + (255,), "ms")
2003:         carte = _ombre(carte, self.s)
2004:         out = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
2005:         _poser(out, carte, carte.width / 2, carte.height / 2, k, a)
2006:         return out
2007: 
2008:     def sons(self):
2009:         g = C.PIECES_GEO
2010:         out = []
2011:         for tc in self._cycles():
2012:             out += [(tc + g["chute"], "clic"), (tc + g["chute"] * 1.55, "clic"), (tc + g["chute"] * 1.4, "souffle")]
2013:         return out
2014: 
