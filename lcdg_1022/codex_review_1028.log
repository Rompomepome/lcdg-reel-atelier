    def dessiner(self, lay, t, final=False):
        a = 1.0 if final else min(T.lisse((t - self.debut) / C.CREDIT_FONDU),
                                  T.lisse((self.fin - t) / C.CREDIT_FONDU))
        if a <= 0.003:
