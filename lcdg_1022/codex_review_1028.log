1: """
2: Voix off de synthese (ElevenLabs) : la narration pilote le rythme du reel.
3: 
4: Chaque bloc du script porte son texte lu dans le champ "voix". La narration entiere est
5: generee d'un seul appel, pour garder une prosodie continue ; l'horodatage de chaque
6: caractere renvoye par l'API sert ensuite a caler chaque plan sur sa phrase, et chaque
7: temps d'un texte ("|") sur le moment ou la voix le prononce.
8: 
9: Les generations sont gardees en cache dans episodes/<dossier>/voix/ : une narration deja
10: payee n'est jamais regeneree, ni pour la version carree, ni pour un nouveau rendu.
11: """
12: import base64
13: import hashlib
14: import json
15: import os
16: import sys
17: from pathlib import Path
18: 
19: import requests
20: 
21: sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
22: from config import charte as C
23: from lcdg import binaires as B
24: 
25: API = "https://api.elevenlabs.io/v1"
26: 
27: 
28: def _cle() -> str:
29:     cle = os.environ.get("ELEVENLABS_API_KEY", "").strip()
30:     if not cle:
31:         raise SystemExit("[!] ELEVENLABS_API_KEY absente de .env (voir .env.example).")
32:     return cle
33: 
34: 
35: def corps(texte: str, modele: str | None = None, reglages: dict | None = None) -> dict:
36:     modele = modele or C.VOIX_MODELE
37:     if reglages:
38:         pass                                  # reglages propres a la voix (VOIX_CATALOGUE)
39:     elif modele.startswith("eleven_v3"):
40:         # v3 : le jeu passe par les indications entre crochets du texte, pas par les reglages
41:         reglages = {"stability": C.VOIX_STABILITE, "similarity_boost": C.VOIX_SIMILARITE}
42:     else:
43:         reglages = {"stability": C.VOIX_STABILITE, "similarity_boost": C.VOIX_SIMILARITE,
44:                     "style": C.VOIX_STYLE, "use_speaker_boost": True, "speed": C.VOIX_VITESSE}
45:     return {"text": texte, "model_id": modele, "voice_settings": reglages}
46: 
47: 
48: def chemins(texte: str, voice_id: str, dossier: Path, modele: str | None = None,
49:             reglages: dict | None = None) -> tuple[Path, Path]:
50:     """(mp3, alignement json) de ce texte lu par cette voix, dans le cache."""
51:     requete = corps(texte, modele, reglages)
52:     cle = hashlib.sha256(json.dumps([voice_id, requete], sort_keys=True,
53:                                     ensure_ascii=False).encode("utf-8")).hexdigest()[:16]
54:     return dossier / f"{cle}.mp3", dossier / f"{cle}.json"
55: 
56: 
57: def synthese(texte: str, voice_id: str, dossier: Path, modele: str | None = None,
58:              reglages: dict | None = None) -> tuple[Path, dict]:
59:     """(mp3, alignement par caractere) de la narration, depuis le cache si elle existe."""
60:     requete = corps(texte, modele, reglages)
61:     mp3, js = chemins(texte, voice_id, dossier, modele, reglages)
62:     if mp3.exists() and js.exists():
63:         return mp3, json.loads(js.read_text(encoding="utf-8"))
64:     dossier.mkdir(parents=True, exist_ok=True)
65:     r = requests.post(f"{API}/text-to-speech/{voice_id}/with-timestamps",
66:                       params={"output_format": "mp3_44100_128"},
67:                       headers={"xi-api-key": _cle()}, json=requete, timeout=300)
68:     if not r.ok:
69:         raise SystemExit(f"[!] ElevenLabs a refuse la generation ({r.status_code}) : {r.text[:300]}")
70:     reponse = r.json()
71:     alignement = reponse["alignment"]
72:     if len(alignement["characters"]) != len(texte):
73:         raise SystemExit("[!] ElevenLabs : l'horodatage ne correspond pas au texte envoye "
74:                          f"({len(alignement['characters'])} caracteres pour {len(texte)}).")
75:     mp3.write_bytes(base64.b64decode(reponse["audio_base64"]))
76:     js.write_text(json.dumps(alignement, ensure_ascii=False), encoding="utf-8")
77:     return mp3, alignement
78: 
79: 
80: def choix(ep: dict) -> dict:
81:     """Voix du reel : "voix_off" est une cle de charte.VOIX_CATALOGUE ou un dict
82:     (id, modele, reglages) ; a defaut, la voix par defaut de la charte."""
83:     v = ep.get("voix_off") or {}
84:     if isinstance(v, str):
85:         if v not in C.VOIX_CATALOGUE:
86:             raise SystemExit(f"[!] voix_off inconnue : « {v} ». Voix validees : "
87:                              + ", ".join(C.VOIX_CATALOGUE))
88:         if not C.VOIX_CATALOGUE[v].get("id"):
89:             raise SystemExit(f"[!] voix_off « {v} » : {C.VOIX_CATALOGUE[v]['nom']} n'est pas "
90:                              "encore enregistree dans l'espace ElevenLabs.")
91:         v = C.VOIX_CATALOGUE[v]
92:     return v
93: 
94: 
95: def active(ep: dict) -> bool:
96:     """Le reel a une voix des qu'un bloc porte un texte lu."""
97:     return any((bl.get("voix") or "").strip() for bl in ep["blocs"])
98: 
99: 
100: def _decouper(texte: str) -> tuple[str, list[int]]:
101:     """Texte lu sans les '|', et position du debut de chaque temps apres le premier."""
102:     propre, debuts = "", []
103:     for i, morceau in enumerate(texte.split("|")):
104:         morceau = morceau.strip()
105:         if i:
106:             propre += " "
107:             debuts.append(len(propre))
108:         propre += morceau
109:     return propre, debuts
110: 
111: 
112: def textes(ep: dict) -> tuple[bool, list[tuple[str, list[int]]]]:
113:     """(bloc 0 muet, [(texte lu, debut de chaque temps)] des blocs parlants).
114: 
115:     Accroche en couverture : le bloc 0 n'a pas de voix, la narration commence au bloc 1.
116:     La narration envoyee a ElevenLabs est ces textes joints par une espace."""
117:     blocs = ep["blocs"]
118:     muet = C.ACCROCHE_COUVERTURE and not (blocs[0].get("voix") or "").strip()
119:     parlants = blocs[1:] if muet else blocs
120:     return muet, [_decouper((bl.get("voix") or "").strip()) for bl in parlants]
121: 
122: 
123: def preparer(episode: Path, ep: dict) -> Path:
124:     """Genere (ou reprend) la narration et cale le reel dessus.
125: 
126:     Fixe en memoire la duree de chaque bloc (une coupe juste avant chaque phrase) et
127:     les instants de ses temps ("temps", relatifs au debut du bloc). Retourne la piste
128:     voix (wav 48 kHz) calee sur la video et mise au niveau de la charte."""
129:     blocs = ep["blocs"]
130:     muet, morceaux = textes(ep)
131:     if C.ACCROCHE_COUVERTURE and not muet:
132:         print("[i] bloc 0 : sa voix est coupee avec l'accroche, qui ne sert qu'a la couverture. "
133:               "Dans un nouveau script, ne mets pas de voix au bloc 0 : elle consomme le quota "
134:               "pour rien.")
135:     vides = [k + muet for k, (t, _) in enumerate(morceaux) if not t]
136:     if vides:
137:         raise SystemExit(f"[!] Bloc(s) sans texte lu (champ voix) : {vides}")
138:     texte = " ".join(t for t, _ in morceaux)
139:     v = choix(ep)
140:     mp3, al = synthese(texte, v.get("id") or C.VOIX_ID, episode / "voix",
141:                        v.get("modele"), v.get("reglages"))
142:     modele = v.get("modele") or C.VOIX_MODELE
143:     tempo = C.VOIX_TEMPO_V3 if modele.startswith("eleven_v3") else 1.0
144:     deb = [x / tempo for x in al["character_start_times_seconds"]]
145:     fin = [x / tempo for x in al["character_end_times_seconds"]]
146: 
147:     d0 = C.VOIX_DEBUT + (C.ACCROCHE_COUVERTURE_DUREE if muet else 0.0)
148:     pos, phrases = 0, []
149:     for t, debuts in morceaux:
150:         phrases.append((d0 + deb[pos], d0 + fin[pos + len(t) - 1],
151:                         [d0 + deb[pos + i] for i in debuts]))
152:         pos += len(t) + 1
153:     coupes = ([0.0, C.ACCROCHE_COUVERTURE_DUREE] if muet else [0.0])
154:     coupes += [max(0.0, a - C.VOIX_AVANCE) for a, _, _ in phrases[1:]]
155:     coupes.append(phrases[-1][1] + C.VOIX_TENUE)
156:     if muet:
157:         phrases.insert(0, (0.0, 0.0, []))
158:     for k, bl in enumerate(blocs):
159:         bl["duree"] = round(coupes[k + 1] - coupes[k], 3)
160:         bl["temps"] = [round(t - C.VOIX_AVANCE - coupes[k], 3) for t in phrases[k][2]]
161: 
162:     wav = episode / "voix" / f"voix_{ep['slug']}.wav"
163:     # correction propre a la voix (charte.VOIX_CATALOGUE) : filtres fixes ("traitement") et
164:     # anti-resonance mesuree sur cette narration ("anti_resonance"), avant tout le reste
