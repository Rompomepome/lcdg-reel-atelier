 191: # caractères lus par seconde, mesurés le 05/11/2026 sur les rendus de ces reels (fin de reel comprise)
 192: CARS_PAR_SECONDE = {"femme_agee": 15.8, "femme_jeune": 14.6}
 193: # le registre des plans est indexé « épisode/bloc » : chaque entrée suit son fichier quand l'ordre des blocs change
 194: REGISTRE = EP / "plans_utilises.json"
 195: registre = json.loads(REGISTRE.read_text(encoding="utf-8"))
 196: for ep in (COTISATION, INSTALLATIONS):
 197:     d = EP / f"{ep['date']}-{ep['slug']}"
 198:     f = d / "script.json"
 199:     blocs_avant = json.loads(f.read_text(encoding="utf-8"))["blocs"]
 200:     par_fichier = {b["fichier"]: registre[f"{d.name}/{i}"] for i, b in enumerate(blocs_avant)
 201:                    if f"{d.name}/{i}" in registre}
 202:     for cle in [c for c in registre if c.startswith(d.name + "/")]:
 203:         del registre[cle]
 204:     for j, b in enumerate(ep["blocs"]):
 205:         if b["fichier"] in par_fichier:
 206:             registre[f"{d.name}/{j}"] = par_fichier[b["fichier"]]
 207:         elif not (d / "broll" / b["fichier"]).exists():
 208:             print(f"[!] {d.name} bloc {j} : {b['fichier']} manque")
 209:     # garder, plan par plan, le recadrage et le crédit déjà faits : le fichier du plan sert de clé
 210:     ancien = {a["fichier"]: a for a in blocs_avant}
 211:     for b in ep["blocs"]:
 212:         a = ancien.get(b["fichier"])
 213:         if a:
 214:             b["requete"] = a.get("requete", b["requete"])
 215:             for cle in ("cadrage", "credit"):
 216:                 if cle in a:
 217:                     b[cle] = a[cle]
 218:     f.write_text(json.dumps(ep, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
 219:     lu = re.sub(r"\[[a-z-]+\]\s*", "", " ".join((b.get("voix") or "") for b in ep["blocs"])).replace(" | ", " ")
 220:     s = len(lu) / CARS_PAR_SECONDE[ep["voix_off"]]
 221:     print(f"{d.name} : {len(ep['blocs']) - 1} plans, {len(lu)} caractères lus, environ {s // 60:.0f} min {s % 60:02.0f} s, "
