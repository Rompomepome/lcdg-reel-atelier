 succeeded in 332ms:
   1: """Version publicite (environ 30 s) du reel « minimum de patients » (16/10/2026).
   2: 
   3: Blocs : 1 (la Cour veut un minimum obligatoire), 2 (500 par medecin traitant), 3 (les 8 553),
   4: puis un bloc qui joint « Rassurez-vous : rien de tout cela ne s'applique aujourd'hui » (bloc 6)
   5: et « Et sous le seuil, que risqueriez-vous ? » (bloc 7), puis l'appel du bloc 9.
   6: 
   7: La narration n'est pas relue : elle est decoupee dans celle du reel complet, aux silences entre
   8: les phrases (meme prise, meme intonation, aucun credit), et entre dans le cache de voix.py sous
   9: la cle du texte de la publicite : render.py la reprend comme une narration ordinaire.
  10: 
  11:     python version_pub.py"""
  12: import json
  13: import os
  14: import shutil
  15: import subprocess
  16: import sys
  17: from pathlib import Path
  18: 
  19: import numpy as np
  20: 
  21: R = Path(r"C:\Users\NR SMART\tools\lcdg-reel")
  22: sys.path.insert(0, str(R))
  23: from config import charte as C
  24: from lcdg import binaires as B, voix
  25: 
  26: SRC = R / "episodes" / "2026-10-13-minimum-patients"
  27: DST = R / "episodes" / "2026-10-13-minimum-patients-pub"
  28: TAUX = 44100
  29: FONDU = 0.01
  30: NB, AP = "\u00a0", "\u2019"
  31: 
  32: 
  33: def pcm(f):
  34:     r = subprocess.run([B.FFMPEG, "-v", "error", "-i", str(f), "-f", "f32le", "-ac", "1", "-ar", str(TAUX), "-"],
  35:                        capture_output=True, check=True)
  36:     return np.frombuffer(r.stdout, dtype="<f4").copy()
  37: 
  38: 
  39: # ---------------------------------------------------------------- script de la publicite
  40: ep = json.loads((SRC / "script.json").read_text(encoding="utf-8"))
  41: b = ep["blocs"]
  42: v6 = b[6]["voix"].split("|")[0].strip()          # « [reassuring] Rassurez-vous : ... aujourd'hui. »
  43: v7 = b[7]["voix"].split("|")[1].strip()          # « [concerned] Et sous le seuil, que risqueriez-vous ? »
  44: assert v6.startswith("[reassuring]") and v7.startswith("[concerned]"), (v6, v7)
  45: pub = {k: v for k, v in ep.items() if k != "blocs"}
  46: pub["slug"] = "minimum-patients-pub"
  47: correspondance = [(0, "B0.mp4"), (1, "B1.mp4"), (2, "B2.mp4"), (3, "B3.mp4"), (6, "B4.mp4"), (9, "B5.mp4")]
  48: blocs = []
  49: for k, (src, fichier) in enumerate(correspondance):
  50:     bl = json.loads(json.dumps(b[src]))
  51:     bl.pop("temps", None)
  52:     bl["fichier"] = fichier
  53:     if src == 6:
  54:         # texte normal : en style « phrase », « risqueriez-vous » surligne sort de la colonne
  55:         bl.pop("type", None)
  56:         bl.update({"texte": f"Rien ne s{AP}applique aujourd{AP}hui. | Et sous le seuil, *que risqueriez-vous*{NB}?",
  57:                    "voix": f"{v6} | {v7}"})
  58:     blocs.append(bl)
  59: pub["blocs"] = blocs
  60: (DST / "broll").mkdir(parents=True, exist_ok=True)
  61: for src, fichier in correspondance:
  62:     shutil.copyfile(SRC / "broll" / b[src]["fichier"], DST / "broll" / fichier)
  63: (DST / "script.json").write_text(json.dumps(pub, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
  64: 
  65: # ---------------------------------------------------------------- narration decoupee
  66: vx = voix.choix(ep)
  67: _, m_src = voix.textes(ep)
  68: tv = [t for t, _ in m_src]
  69: texte_src = " ".join(tv)
  70: mp3_s, js_s = voix.chemins(texte_src, vx["id"], SRC / "voix", vx.get("modele"), vx.get("reglages"))
  71: if not (mp3_s.exists() and js_s.exists()):
  72:     raise SystemExit("[!] narration du reel complet absente du cache : rends-le d'abord")
  73: al = json.loads(js_s.read_text(encoding="utf-8"))
  74: assert "".join(al["characters"]) == texte_src
  75: deb, fin = al["character_start_times_seconds"], al["character_end_times_seconds"]
  76: son = pcm(mp3_s)
  77: pos = []
  78: p = 0
  79: for t in tv:
  80:     pos.append(p)
  81:     p += len(t) + 1
  82: 
  83: 
  84: def lettres(a, z):
  85:     """Premier et dernier caractere alphanumerique de [a, z) hors indications de jeu."""
  86:     dans, idx = False, []
  87:     for i in range(a, z):
  88:         c = texte_src[i]
  89:         if c == "[":
  90:             dans = True
  91:         elif c == "]":
  92:             dans = False
  93:         elif not dans and c.isalnum():
  94:             idx.append(i)
  95:     return idx[0], idx[-1]
  96: 
  97: 
  98: def raccord(fin_a, debut_b):
  99:     """Point le plus calme du blanc entre deux phrases."""
 100:     a, z = fin_a + C.VOIX_RACCORD_GARDE, debut_b - C.VOIX_RACCORD_GARDE
 101:     n = int(C.VOIX_RACCORD_PAS * TAUX)
 102:     i0, i1 = int(a * TAUX), min(int(z * TAUX), len(son))
 103:     if i1 - i0 < 2 * n:
 104:         raise SystemExit(f"[!] pas de blanc entre {fin_a:.2f} s et {debut_b:.2f} s")
 105:     f = son[i0:i1 - (i1 - i0) % n].reshape(-1, n)
 106:     db = 10 * np.log10((f ** 2).mean(axis=1) + 1e-12)
 107:     k = int(np.argmin(db))
 108:     print(f"      raccord dans le blanc {fin_a:.2f}-{debut_b:.2f} s : {(i0 + k * n + n // 2) / TAUX:.2f} s "
 109:           f"({db[k]:.0f} dB)")
 110:     return (i0 + k * n + n // 2) / TAUX
 111: 
 112: 
 113: def coupe(fin_texte, debut_texte):
 114:     """Raccord entre le texte qui finit a fin_texte (exclu) et celui qui commence a debut_texte."""
 115:     _, der = lettres(fin_texte - 200 if fin_texte > 200 else 0, fin_texte)
 116:     pre, _ = lettres(debut_texte, len(texte_src))
 117:     return raccord(fin[der], deb[pre])
 118: 
 119: 
 120: # segments : (debut, fin exclue) dans le texte du reel complet
 121: s2 = (pos[5], pos[5] + len(v6))
 122: a7 = tv[6].index("[concerned]")
 123: s3 = (pos[6] + a7, pos[6] + a7 + len(v7))
 124: segments = [(pos[0], pos[2] + len(tv[2])), s2, s3, (pos[8], len(texte_src))]
 125: assert texte_src[s2[0]:s2[1]] == v6 and texte_src[s3[0]:s3[1]] == v7
 126: bornes = []
 127: for k, (a, z) in enumerate(segments):
 128:     t0 = 0.0 if a == 0 else coupe(a - 1, a)
 129:     t1 = len(son) / TAUX if z == len(texte_src) else coupe(z, z + 1)
 130:     bornes.append((t0, t1))
 131:     print(f"    segment {k} : {t0:6.2f} -> {t1:6.2f} s  « {texte_src[a:z][:60]}… »")
 132: 
 133: morceaux, car, debs, fins_, n = [], [], [], [], 0
 134: for k, ((a, z), (t0, t1)) in enumerate(zip(segments, bornes)):
 135:     i0, i1 = int(round(t0 * TAUX)), int(round(t1 * TAUX))
 136:     m = son[i0:i1].copy()
 137:     if k > 0:
 138:         m[:int(FONDU * TAUX)] *= np.linspace(0, 1, int(FONDU * TAUX), dtype=np.float32)
 139:     if k < len(segments) - 1:
 140:         m[-int(FONDU * TAUX):] *= np.linspace(1, 0, int(FONDU * TAUX), dtype=np.float32)
 141:     decal = n / TAUX - i0 / TAUX
 142:     if k > 0:                                       # l'espace entre deux segments : le blanc
 143:         car.append(" ")
 144:         debs.append(fins_[-1])
 145:         fins_.append(max(fins_[-1], deb[a] + decal))
 146:     for q in range(a, z):
 147:         car.append(texte_src[q])
 148:         debs.append(max(0.0, deb[q] + decal))
 149:         fins_.append(max(0.0, fin[q] + decal))
 150:     morceaux.append(m)
 151:     n += len(m)
 152: 
 153: _, m_pub = voix.textes(pub)
 154: texte_pub = " ".join(t for t, _ in m_pub)
 155: assert "".join(car) == texte_pub, ("".join(car)[:200], texte_pub[:200])
 156: mp3_p, js_p = voix.chemins(texte_pub, vx["id"], DST / "voix", vx.get("modele"), vx.get("reglages"))
 157: mp3_p.parent.mkdir(parents=True, exist_ok=True)
 158: tmp = mp3_p.with_name(mp3_p.stem + ".tmp.mp3")
 159: r = subprocess.run([B.FFMPEG, "-v", "error", "-f", "f32le", "-ar", str(TAUX), "-ac", "1", "-i", "-",
 160:                     "-c:a", "libmp3lame", "-b:a", "192k", "-f", "mp3", str(tmp), "-y"],
 161:                    input=np.concatenate(morceaux).astype("<f4").tobytes(), capture_output=True)
 162: if r.returncode:
 163:     raise SystemExit(r.stderr.decode("utf-8", "replace")[-600:])
 164: js_p.write_text(json.dumps({"characters": car,
 165:                             "character_start_times_seconds": [round(x, 4) for x in debs],
 166:                             "character_end_times_seconds": [round(x, 4) for x in fins_]},
 167:                            ensure_ascii=False), encoding="utf-8")
 168: os.replace(tmp, mp3_p)
 169: print(f"narration de la publicite : {n / TAUX:.2f} s, en cache sous {mp3_p.name}")
