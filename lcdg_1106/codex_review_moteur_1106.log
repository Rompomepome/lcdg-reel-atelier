16:# ------------------------------------------------------------------ 1. base
17:def _source(src: Path) -> tuple[float, float]:
18:    """(images par seconde, duree en s) de la piste video d'un plan."""
19:    B.exiger()
20:    r = subprocess.run([B.FFPROBE, "-v", "error", "-select_streams", "v:0",
21:                        "-show_entries", "stream=avg_frame_rate,r_frame_rate,duration",
22:                        "-show_entries", "format=duration", "-of", "json", str(src)],
23:                       capture_output=True, text=True)
24:    if r.returncode:
25:        raise SystemExit(f"[!] ffprobe ne lit pas {src} :\n{r.stderr[-400:]}")
26:    infos = json.loads(r.stdout)
27:    pistes = infos.get("streams") or []
28:    if not pistes:
29:        raise SystemExit(f"[!] {src} n'a pas de piste video.")
30:    piste = pistes[0]
31:    cadence = 0.0
32:    for champ in ("avg_frame_rate", "r_frame_rate"):
33:        n, _, d = (piste.get(champ) or "0/0").partition("/")
34:        if float(n or 0) > 0 and float(d or 1) > 0:
35:            cadence = float(n) / float(d or 1)
36:            break
37:    duree = float(piste.get("duration") or infos.get("format", {}).get("duration") or 0)
38:    if cadence <= 0 or duree <= 0:
39:        raise SystemExit(f"[!] {src} : cadence ou duree illisible.")
40:    return cadence, duree
