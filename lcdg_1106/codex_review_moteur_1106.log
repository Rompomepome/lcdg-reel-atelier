1:"""Montage : normalisation des B-rolls, rendu de l'habillage, sortie sans piste audio."""
2:import json
3:import subprocess
4:import sys
5:from pathlib import Path
6:
7:from PIL import Image
8:
9:sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
10:from config import charte as C
11:from lcdg import binaires as B
12:from lcdg import habillage as hb
