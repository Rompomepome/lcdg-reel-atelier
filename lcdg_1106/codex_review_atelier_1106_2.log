 109:          "avec l’accroche dès la première seconde. Le 13 (soins chez le pharmacien) est abandonné.",
 110:          "Ceux qui restent de la série précédente : 9 et 10 (vaccins, cumul",
 111:          "emploi-retraite) et 12 (accès direct aux IPA, avant le 1er décembre). Les reels 1 à 8 sont publiés.",
 112:          "Grippe (5) et fluoxétine (1) : leur date conseillée est passée (13 octobre, mi-octobre).",
 113:          "S’ils ne sont pas encore en ligne, les faire revoir avant de les publier.",
 114:          "",
 115:          "Un dossier par reel. Dans chaque dossier :",
 116:          "- reel_9x16_instagram_facebook.mp4 : le reel pour Instagram et Facebook ;",
 117:          "- couverture_9x16_instagram_facebook.jpg : à choisir comme couverture du reel",
 118:          "  (Instagram : « Modifier la couverture », puis « Ajouter depuis la pellicule ») ;",
 119:          "- couverture_4x5.jpg : la même, recadrée pour le fil et la grille du profil, si la",
 120:          "  plateforme te demande une image 4:5 ;",
 121:          "- reel_1x1_linkedin.mp4 et couverture_1x1_linkedin.jpg : la vidéo LinkedIn et sa",
 122:          "  miniature ;",
 123:          "- legende_instagram_facebook.txt et legende_linkedin.txt : les textes à copier-coller ;",
 124:          "- reels 7 à 15 : publicite_9x16.mp4 et publicite_1x1.mp4, la version courte pour la",
 125:          "  publicité, et legende_publicite_meta.txt, ses textes dans le gestionnaire de publicités Meta.",
 126:          "",
 127:          "À la racine du dossier : PROMPT_correction_articles.md, le prompt à coller dans Claude pour",
 128:          "corriger les articles du site (mode d’emploi en tête du fichier).",
 129:          "",
 130:          "Pour tous les reels :",
 131:          "- activer l’étiquette « Info IA » sur Instagram et Facebook (voix de synthèse) ;",
 132:          "- le jour de la publication, mettre le lien de l’article dans la bio Instagram (lien",
 133:          "  ci-dessous, il porte le suivi « instagram ») ;",
 134:          "- reels 1 à 7 : répondre en message privé, avec le lien de l’article, à ceux qui commentent",
 135:          "  le mot clé. Depuis le reel 8, plus de mot clé : le bandeau renvoie au site.",
 136:          ""]
 137: for dossier, ep, slug, titre, mot, quand in REELS:
 138:     src = E / ep / "final"
 139:     dst = KIT / dossier
 140:     dst.mkdir()
 141:     for a, b in ((f"reel_{slug}_9x16.mp4", "reel_9x16_instagram_facebook.mp4"),
 142:                  (f"reel_{slug}_1x1.mp4", "reel_1x1_linkedin.mp4"),
 143:                  (f"couverture_{slug}_9x16.jpg", "couverture_9x16_instagram_facebook.jpg"),
 144:                  (f"couverture_{slug}_4x5.jpg", "couverture_4x5.jpg"),
 145:                  (f"couverture_{slug}_1x1.jpg", "couverture_1x1_linkedin.jpg")):
 146:         shutil.copyfile(src / a, dst / b)
 147:     if dossier in PUB:
 148:         ep_pub, slug_pub = PUB[dossier]
 149:         for a, b in ((f"reel_{slug_pub}_9x16.mp4", "publicite_9x16.mp4"),
 150:                      (f"reel_{slug_pub}_1x1.mp4", "publicite_1x1.mp4")):
 151:             shutil.copyfile(E / ep_pub / "final" / a, dst / b)
 152:     a_faire, insta, linkedin, bio, pub = sections((E / ep / "legendes.md").read_text(encoding="utf-8"))
 153:     (dst / "legende_instagram_facebook.txt").write_text(insta + "\n", encoding="utf-8")
 154:     (dst / "legende_linkedin.txt").write_text(linkedin + "\n", encoding="utf-8")
 155:     if pub:
 156:         (dst / "legende_publicite_meta.txt").write_text(pub + "\n", encoding="utf-8")
 157:     lisez += [titre, "-" * len(titre), f"Quand : {quand}"]
 158:     if mot:
 159:         lisez.append(f"Mot clé à commenter : {mot}")
 160:     lisez.append(f"Lien de la bio Instagram : {bio}")
 161:     points = propres(a_faire)
 162:     if points:
 163:         lisez += ["À faire :"] + points
 164:     lisez.append("")
 165: (KIT / "LISEZ-MOI.txt").write_text("\n".join(lisez) + "\n", encoding="utf-8")
 166: for f in sorted(KIT.rglob("*")):
 167:     if f.is_file():
 168:         print(f"{f.stat().st_size // 1024:>7} Ko  {f.relative_to(KIT)}")
