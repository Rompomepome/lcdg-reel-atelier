  56:      "Puis en publicité : version d’environ 30 s (textes dans legende_publicite_meta.txt)."),
  57: ]
  58: # version publicite d'un reel (episode a part, monte depuis la meme narration)
  59: PUB = {"7_Minimum_patients": ("2026-10-13-minimum-patients-pub", "minimum-patients-pub"),
  60:        "8_Arrets_de_travail_MSO": ("2026-10-22-arrets-travail-mso-pub", "arrets-travail-mso-pub"),
  61:        "9_Vaccins_au_cabinet": ("2026-10-22-vaccins-cabinet-pub", "vaccins-cabinet-pub"),
  62:        "10_Cumul_emploi_retraite": ("2026-10-22-cumul-emploi-retraite-pub", "cumul-emploi-retraite-pub"),
  63:        "11_Docteurs_juniors": ("2026-10-28-docteurs-juniors-pub", "docteurs-juniors-pub"),
  64:        "12_Acces_direct_IPA": ("2026-10-28-acces-direct-ipa-pub", "acces-direct-ipa-pub"),
  65:        # reels 14 et 15 refaits le 06/11/2026 en phrases construites (environ 1 min 55) ; publicites
  66:        # d'environ 30 s decoupees dans la nouvelle narration (Romain : « les versions pub je veux bien »)
  67:        "14_Cotisation_Ordre_en_societe": ("2026-11-04-cotisation-ordre-pub", "cotisation-ordre-pub"),
  68:        "15_Premieres_installations": ("2026-11-04-premieres-installations-pub", "premieres-installations-pub")}
  69: # rappels deja donnes pour tous les reels : on ne les repete pas reel par reel
  70: COMMUNS = ("- étiquette « Info IA »", "- réponse en message privé")
  71: 
  72: 
  73: def sections(md):
  74:     """(a faire, instagram, linkedin, lien de bio, publicite ou None) d'un legendes.md."""
  75:     a_faire = re.search(r"avant de publier :\n(.*?)\n\n## ", md, re.S).group(1).strip()
  76:     insta = re.search(r"## Instagram[^\n]*\n(.*?)\n## ", md, re.S).group(1).strip()
  77:     # jusqu'a la section suivante : la publicite Meta, quand il y en a une, vient juste apres
  78:     linkedin = re.search(r"## LinkedIn[^\n]*\n(.*?)\n## ", md, re.S).group(1).strip()
  79:     bio = re.search(r"## Lien de la bio[^\n]*\n(.*)", md, re.S).group(1).strip()
  80:     pub = re.search(r"## Publicité[^\n]*\n(.*?)\n## ", md, re.S)
  81:     return a_faire, insta, linkedin, bio, pub.group(1).strip() if pub else None
  82: 
  83: 
  84: def propres(a_faire):
  85:     """Les points propres a ce reel (un point peut tenir sur plusieurs lignes)."""
  86:     points, courant = [], []
  87:     for ligne in a_faire.splitlines():
  88:         if ligne.startswith("- ") and courant:
  89:             points.append(courant); courant = []
  90:         courant.append(ligne)
  91:     if courant:
  92:         points.append(courant)
  93:     return ["\n".join(p) for p in points if not p[0].startswith(COMMUNS)]
  94: 
  95: 
  96: # on ne vide que ce que ce script produit : les autres fichiers du dossier (le prompt de
  97: # correction des articles) sont conserves
  98: KIT.mkdir(parents=True, exist_ok=True)
  99: # reels abandonnes : leur dossier sort du kit, pour qu'on ne les publie pas par erreur
 100: ABANDONNES = ("13_Soins_chez_le_pharmacien",)   # 06/11/2026, Romain : « supprime le dossier 13 »
 101: for dossier in [d for d, *_ in REELS] + list(ABANDONNES):
 102:     if (KIT / dossier).exists():
 103:         shutil.rmtree(KIT / dossier)
 104: lisez = ["REELS LCDG À PUBLIER",
 105:          "====================",
