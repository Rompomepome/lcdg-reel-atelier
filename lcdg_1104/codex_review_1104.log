                dd.line([(S * 0.5, S * 0.5), (S * 0.7, S * 0.62)], fill=rub, width=int(e * 0.8))
                r = S * 0.06
                dd.ellipse([S * 0.5 - r, S * 0.5 - r, S * 0.5 + r, S * 0.5 + r], fill=navy)
            else:                                         # le casque de la regulation
