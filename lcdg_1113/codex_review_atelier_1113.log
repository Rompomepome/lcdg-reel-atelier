3907: # -------------------------------------------------------------- formulaire
3908: class Formulaire(_Insert):
3909:     """Un formulaire et ceux qui peuvent le remplir, en grille : a son temps, chaque case se coche en vert ; une
3910:     ligne "ferme" se teinte de rouge et recoit un cadenas, qui tremble."""
3911: 
3912:     def taille_nominale(self):
3913:         g = C.FORMULAIRE_GEO
3914:         rangs = -(-len(self.spec["lignes"]) // g["colonnes"])
3915:         return C.TEXTE_LARGEUR, g["tete"] + g["pad"] + rangs * g["cellule_h"] + (rangs - 1) * g["ecart"] + g["pad"]
3916: 
3917:     def __init__(self, *a):
3918:         super().__init__(*a)
3919:         g = C.FORMULAIRE_GEO
3920:         self.lignes = self.spec["lignes"]
3921:         self.tete, self.pad, self.ecart = self.px(g["tete"]), self.px(g["pad"]), self.px(g["ecart"])
3922:         self.cols = g["colonnes"]
3923:         self.cw = (self.w - 2 * self.pad - (self.cols - 1) * self.ecart) // self.cols
3924:         self.ch = self.px(g["cellule_h"])
3925:         self.case = self.px(g["case"])
3926:         ra = max(4, int(C.INSERT_RAYON * self.s))
3927:         m = self.m
3928:         carte = _cadre(self.w, self.h, self.s, marge=m)
3929:         d = ImageDraw.Draw(carte)
3930:         d.rounded_rectangle([m, m, m + self.w - 1, m + self.tete + ra], radius=ra, fill=C.NAVY + (255,))
3931:         d.rectangle([m, m + self.tete, m + self.w - 1, m + self.tete + ra], fill=C.BLANC + (255,))
3932:         _ecrire(d, (m + self.pad, m + self.tete / 2), self.spec.get("titre", ""), self.px(g["titre_px"]),
3933:                 C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "lm")
3934:         self.cellules = [self._cellule(l, False) for l in self.lignes]
3935:         self.fermees = [self._cellule(l, True) if l.get("ferme") else None for l in self.lignes]
3936:         for i, im in enumerate(self.cellules):
3937:             carte.alpha_composite(im, self._xy(i))
3938:         self.carte = _ombre(carte, self.s)
3939:         self.coche = _icone_choix(True, self.case, self.px(g["case_trait"]) + 1, self.rubrique)
3940:         self.cadenas = self._cadenas(self.px(g["cadenas"]))
3941: 
3942:     def _xy(self, i):
3943:         col, rang = i % self.cols, i // self.cols
3944:         return (int(self.m + self.pad + col * (self.cw + self.ecart)),
3945:                 int(self.m + self.tete + self.pad + rang * (self.ch + self.ecart)))
3946: 
3947:     def _centre_case(self, i):
3948:         x, y = self._xy(i)
3949:         return x + self.px(C.FORMULAIRE_GEO["label_x"]) + self.case / 2, y + self.ch / 2
3950: 
3951:     def _cellule(self, l, ferme):
3952:         g = C.FORMULAIRE_GEO
3953:         w, h, case = self.cw, self.ch, self.case
3954:         fond = _teinte(C.INSERT_ROUGE, g["teinte_ferme"]) if ferme else _teinte(C.NAVY, g["teinte"])
3955:         x0 = self.px(g["label_x"])
3956: 
3957:         def dessin(dd, k):
3958:             dd.rounded_rectangle([0, 0, w * k - 1, h * k - 1], radius=self.px(g["rayon"]) * k, fill=fond + (255,))
