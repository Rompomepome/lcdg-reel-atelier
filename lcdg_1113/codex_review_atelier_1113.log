4598: def inserts(ep, scenes, ouverture=None):
4599:     """Les inserts du reel, un ou plusieurs par bloc qui en porte (scenes : habillage.scenes)."""
4600:     out = []
4601:     for k, bl in enumerate(ep["blocs"]):
4602:         specs = bl.get("insert")
4603:         if not specs:
4604:             continue
4605:         specs = [specs] if isinstance(specs, dict) else specs
4606:         if bl.get("type") in ("phrase", "chiffre") or k == 0:
4607:             raise SystemExit(f"[!] bloc {k} : un insert se pose sur un bloc de texte (pas sur "
4608:                              "l'accroche, une phrase forte ou un chiffre cle).")
4609:         scene = scenes[k]
4610:         hauts = [b[1] for b in (hb._bbox(lay) for _, lay, _ in scene.couches()) if b]
4611:         bas = min(hauts) if hauts else C.BLOC_Y
4612:         if ouverture is not None and ouverture.scene is scene:
4613:             bas = ouverture.pos[1]
4614:         premier, haut = None, bas - C.INSERT_ECART
4615:         for spec in specs:
4616:             # "carre": false le retire de la version carree, plus basse : au bloc 1, la pastille
4617:             # d'ouverture ne laisse pas toujours la place d'un insert (charte.CARRE)
4618:             if spec.get("carre") is False and C.LARGEUR == C.HAUTEUR:
4619:                 continue
4620:             if spec.get("type") not in TYPES:
4621:                 raise SystemExit(f"[!] bloc {k} : insert inconnu « {spec.get('type')} ». "
4622:                                  f"Types : {', '.join(TYPES)}.")
4623:             nom = f"insert bloc {k}" + (f" ({spec['type']})" if len(specs) > 1 else "")
4624:             # "sur": true centre l'element sur le premier insert du bloc (un tampon sur un dessin) ;
4625:             # sinon, chaque element s'empile au-dessus du precedent
4626:             sur = spec.get("sur") and premier is not None
4627:             ins = TYPES[spec["type"]](nom, spec, scene, bas - C.INSERT_ECART if sur else haut)
4628:             if sur:
4629:                 ins.x = premier.x + (premier.w - ins.w) / 2
4630:                 ins.y = premier.y + (premier.h - ins.h) / 2
4631:             else:
4632:                 haut = ins.y - C.INSERT_ECART_ELEMENTS
4633:             premier = premier or ins
4634:             out.append(ins)
4635:     return out

