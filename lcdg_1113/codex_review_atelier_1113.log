4069:     def _fraction(self, t, final):
4070:         """Part du delai ecoulee : il court, puis, au retour, revient a zero et repart, en boucle."""
4071:         g = C.DELAI_GEO
4072:         tr = self._t_cle("temps_retour")
4073:         if final:
4074:             return 1.0 if tr is None else 0.0
4075:         f = T.lisse((t - self._t_dep()) / g["course"])
4076:         if tr is None or t < tr:
4077:             return f
4078:         tour, phase = divmod(t - tr, g["boucle"])
4079:         depart = T.lisse((tr - self._t_dep()) / g["course"]) if tour == 0 else 1.0
4080:         if phase < g["retour"]:
4081:             return depart * (1 - T.lisse(phase / g["retour"]))
4082:         return T.lisse((phase - g["retour"]) / g["course"])
4083: 
