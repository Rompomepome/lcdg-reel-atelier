4518:             d.rectangle([mo * k, eh * k, (cw - mo) * k, (ch - tb) * k],
4519:                         fill=_teinte(self.rubrique, g["vitre_teinte"]) + (255,))
4520:         im = _net(cw, ch, fenetre)
4521:         vitre = im.crop((mo, eh, cw - mo, ch - tb))      # le medecin, derriere la vitre, coupe par la tablette
4522:         vitre.alpha_composite(_personnage(pw, ph, _teinte(C.NAVY, 0.35)),
4523:                               ((cw - 2 * mo - pw) // 2, (ch - tb - eh) - int(ph * 0.92)))
4524:         im.paste(vitre, (mo, eh))
