4027:         self.py, self.pe = m + self.px(g["piste_y"]), self.px(g["piste_h"])
4028:         L, pe = self.x1 - self.x0, self.pe
4029:         carte = _cadre(self.w, self.h, self.s, marge=m)
4030:         _ecrire(ImageDraw.Draw(carte), (self.x0, m + self.pad), T.normaliser(self.spec.get("titre", "")).upper(),
4031:                 self.px(g["titre_px"]), C.INSERT_GRAISSE_FORTE, C.INSERT_GRIS_TEXTE + (255,), "la")
4032: 
4033:         def piste(couleur):
4034:             return _net(L, pe, lambda d, k: d.rounded_rectangle([0, 0, L * k - 1, pe * k - 1], radius=pe * k / 2,
4035:                                                                 fill=tuple(couleur) + (255,)))
4036:         carte.alpha_composite(piste(C.INSERT_GRIS), (int(self.x0), int(self.py)))
4037:         self.plein = piste(self.rubrique)
4038:         self.carte = _ombre(carte, self.s)
4039:         c, tr = self.px(g["curseur"]), self.px(g["curseur_trait"])
4040:         self.curseur = _net(c, c, lambda d, k: d.ellipse([0, 0, c * k - 1, c * k - 1], fill=C.BLANC + (255,),
4041:                                                          outline=self.rubrique + (255,), width=int(tr * k)))
4042:         self.drapeau = self.question = None
4043:         if self.spec.get("fin"):
4044:             self.drapeau = _bulle(self.spec["fin"], self.px(g["drapeau_px"]), self.px(g["drapeau_h"]),
4045:                                   self.px(g["drapeau_pad"]), C.INSERT_VERT, queue=False)
4046:         if self.spec.get("retour"):
4047:             self.question = _bulle(self.spec["retour"], self.px(g["question_px"]), self.px(g["question_h"]),
4048:                                    self.px(g["question_pad"]), C.INSERT_ROUGE, queue=False)
4049:         self.fleche = self._fleche(L)
4050: 
4051:     def _fleche(self, L):
4052:         """La fleche du retour : un arc qui passe sous la piste, de droite a gauche, et remonte a zero."""
4053:         g = C.DELAI_GEO
4054:         h, tr = self.px(g["fleche_h"]), self.px(g["fleche_trait"])
4055:         rouge = C.INSERT_ROUGE + (255,)
4056: 
4057:         def dessin(d, k):
4058:             d.arc([tr * k * 2, (tr - h) * k, (L - tr * 2) * k, (h - tr) * k], 0, 180, fill=rouge, width=int(tr * k))
4059:             x = tr * k * 2.5
4060:             d.polygon([(x - tr * k * 2, tr * k * 2.6), (x + tr * k * 2, tr * k * 2.6), (x, 0)], fill=rouge)
4061:         return _net(L, h, dessin)
