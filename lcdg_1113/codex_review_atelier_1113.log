 294: # caractères lus par seconde, mesurés le 05/11/2026 sur les rendus (fin de reel comprise)
 295: CARS_PAR_SECONDE = {"homme_age": 14.1, "femme_agee": 15.8, "femme_jeune": 14.6}
 296: # le registre des plans est indexé « épisode/bloc » : chaque entrée suit son fichier quand l'ordre des blocs change
 297: REGISTRE = EP / "plans_utilises.json"
 298: registre = json.loads(REGISTRE.read_text(encoding="utf-8"))
 299: for ep in (MALADIE_PRO, TDAH):
 300:     d = EP / f"{ep['date']}-{ep['slug']}"
 301:     (d / "broll").mkdir(parents=True, exist_ok=True)
 302:     f = d / "script.json"
 303:     if f.exists():
 304:         blocs_avant = json.loads(f.read_text(encoding="utf-8"))["blocs"]
 305:         par_fichier = {b["fichier"]: registre[f"{d.name}/{i}"] for i, b in enumerate(blocs_avant)
 306:                        if f"{d.name}/{i}" in registre}
 307:         for cle in [c for c in registre if c.startswith(d.name + "/")]:
 308:             del registre[cle]
 309:         for j, b in enumerate(ep["blocs"]):
 310:             if b["fichier"] in par_fichier:
 311:                 registre[f"{d.name}/{j}"] = par_fichier[b["fichier"]]
 312:             elif (d / "broll" / b["fichier"]).exists():
 313:                 print(f"[!] {d.name} bloc {j} : {b['fichier']} absent du registre des plans, à réinscrire")
 314:             else:
 315:                 print(f"[ ] {d.name} bloc {j} : {b['fichier']} à choisir")
 316:         ancien = {a["fichier"]: a for a in blocs_avant}   # le recadrage et le crédit suivent le fichier du plan
 317:         for b in ep["blocs"]:
 318:             for cle in ("cadrage", "credit"):
 319:                 if cle in ancien.get(b["fichier"], {}):
 320:                     b[cle] = ancien[b["fichier"]][cle]
 321:     f.write_text(json.dumps(ep, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
 322:     lu = re.sub(r"\[[a-z-]+\]\s*", "", " ".join((b.get("voix") or "") for b in ep["blocs"])).replace(" | ", " ")
 323:     s = len(lu) / CARS_PAR_SECONDE[ep["voix_off"]]
 324:     print(f"{d.name} : {len(ep['blocs']) - 1} plans, {len(lu)} caractères lus, environ {s // 60:.0f} min {s % 60:02.0f} s, "
 325:           f"environ {len(lu) * 300 / 1400:.0f} crédits")
 326: REGISTRE.write_text(json.dumps(dict(sorted(registre.items())), ensure_ascii=False, indent=1), encoding="utf-8")
