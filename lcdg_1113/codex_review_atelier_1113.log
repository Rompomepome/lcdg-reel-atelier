4149:                 self.px(g["titre_px"]), C.INSERT_GRAISSE_FORTE, C.INSERT_GRIS_TEXTE + (255,), "la")
4150:         R, e = self.px(g["rayon"]), self.px(g["epaisseur"])
4151:         self.cx, self.cy = m + self.w * g["centre"][0], m + self.px(g["centre"][1])
