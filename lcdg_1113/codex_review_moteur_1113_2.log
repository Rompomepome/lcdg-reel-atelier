 4316: # ---------------------------------------------------------------- addition
 4317: class Addition(_Insert):
 4318:     """Des boites de medicament qui tombent une a une dans leur grille ; a droite, le total grimpe a chaque boite et
 4319:     fait une bosse. "total" remplace le nombre calcule, une fois toutes les boites posees (l'arrondi de l'article)."""
 4320: 
 4321:     def taille_nominale(self):
 4322:         return C.TEXTE_LARGEUR, C.ADDITION_H
 4323: 
 4324:     def __init__(self, *a):
 4325:         super().__init__(*a)
 4326:         g = C.ADDITION_GEO
 4327:         m = self.m
 4328:         self.pad = self.px(g["pad"])
 4329:         self.n, self.prix = int(self.spec["boites"]), float(self.spec["prix"])
 4330:         carte = _cadre(self.w, self.h, self.s, marge=m)
 4331:         d = ImageDraw.Draw(carte)
 4332:         _ecrire(d, (m + self.pad, m + self.pad), T.normaliser(self.spec.get("titre", "")).upper(),
 4333:                 self.px(g["titre_px"]), C.INSERT_GRAISSE_FORTE, C.INSERT_GRIS_TEXTE + (255,), "la")
 4334:         self.tx = m + self.w * g["total_x"]
 4335:         _ecrire(d, (self.tx, m + self.px(g["legende_y"])), self.spec.get("legende", ""), self.px(g["legende_px"]),
 4336:                 C.INSERT_GRAISSE_TEXTE, C.INSERT_GRIS_TEXTE + (255,), "mm")
 4337:         self.carte = _ombre(carte, self.s)
 4338:         self.boite = self._boite()
 4339: 
 4340:     def _boite(self):
 4341:         g = C.ADDITION_GEO
 4342:         w, h, b = self.px(g["boite"][0]), self.px(g["boite"][1]), self.px(g["bande"])
 4343:         rub, pale = self.rubrique + (255,), _teinte(self.rubrique, 0.84) + (255,)
 4344: 
 4345:         def dessin(d, k):
 4346:             ra = w * k * 0.16
 4347:             d.rounded_rectangle([0, 0, w * k - 1, h * k - 1], radius=ra, fill=pale)
 4348:             d.rounded_rectangle([0, 0, w * k - 1, b * k + ra], radius=ra, fill=rub)
 4349:             d.rectangle([0, b * k, w * k - 1, b * k + ra], fill=pale)
 4350:             cx, cy, L, e = w * k / 2, (b + (h - b) * 0.52) * k, w * k * 0.58, (h - b) * k * 0.26   # une gelule
 4351:             d.rounded_rectangle([cx - L / 2, cy - e / 2, cx + L / 2, cy + e / 2], radius=e / 2, fill=C.BLANC + (255,))
 4352:             d.rounded_rectangle([cx, cy - e / 2, cx + L / 2, cy + e / 2], radius=e / 2, fill=rub)
 4353:             d.rectangle([cx, cy - e / 2, cx + e / 2, cy + e / 2], fill=rub)
 4354:         return _net(w, h, dessin)
 4355: 
 4356:     def _t(self, i):
 4357:         return self.t0(self.spec.get("temps", 0)) + C.INSERT_ENTREE * 0.7 + i * C.ADDITION_GEO["cadence"]
 4358: 
 4359:     def image(self, t, final):
 4360:         g = C.ADDITION_GEO
 4361:         k, a = _entree(t, self.t0(), final)
 4362:         if a <= 0:
 4363:             return None
 4364:         cadre = self.carte.copy()
 4365:         bw, bh, ec = self.px(g["boite"][0]), self.px(g["boite"][1]), self.px(g["ecart"])
 4366:         somme, derniere = 0.0, None
 4367:         for i in range(self.n):
 4368:             u = 1.0 if final else (t - self._t(i)) / g["duree"]
 4369:             if u <= 0:
 4370:                 continue
 4371:             col, rang = i % g["colonnes"], i // g["colonnes"]
 4372:             chute = 0 if final else self.px(g["chute"]) * (1 - T.lisse(u))
 4373:             T.coller(cadre, self.boite, (self.m + self.pad + col * (bw + ec),
 4374:                                          self.m + self.px(g["grille_y"]) + rang * (bh + ec) - chute),
 4375:                      1.0 if final else T.lisse(u * 2))
 4376:             somme += self.prix * min(1.0, u)
 4377:             if u >= 1:
 4378:                 derniere = i
 4379:         complet = final or derniere == self.n - 1
 4380:         texte = T.normaliser(self.spec["total"] if complet and self.spec.get("total")
 4381:                              else f"{_nombre(round(somme), 0)}{NBSP}€")
 4382:         kk = 1.0
 4383:         if not final and derniere is not None:           # le total fait une bosse a chaque boite posee
 4384:             dt, (amp, duree) = t - self._t(derniere) - g["duree"], g["bosse"]
 4385:             if 0 <= dt < duree:
 4386:                 kk = 1 + amp * (1 - dt / duree)
 4387:         px = self.px(g["total_px"])
 4388:         tw = int(T.largeur(texte, px, C.INSERT_GRAISSE_FORTE, 0)) + 8
 4389:         im = Image.new("RGBA", (tw, int(px * 1.3)), (0, 0, 0, 0))
 4390:         _ecrire(ImageDraw.Draw(im), (tw / 2, px * 0.65), texte, px, C.INSERT_GRAISSE_FORTE, C.INSERT_ROUGE + (255,), "mm")
 4391:         _poser(cadre, im, self.tx, self.m + self.px(g["total_y"]), kk)
 4392:         out = Image.new("RGBA", cadre.size, (0, 0, 0, 0))
 4393:         _poser(out, cadre, cadre.width / 2, cadre.height / 2, k, a)
 4394:         return out
 4395: 
 4396:     def sons(self):
 4397:         # un clic a chaque boite posee (le total fait sa bosse au meme instant), l'impact sur la derniere
 4398:         # (review Codex du 13/11/2026 : les boites du milieu tombaient sans bruit)
 4399:         pose = C.ADDITION_GEO["duree"]
 4400:         return [(self._t(i) + pose, "impact" if i == self.n - 1 else "clic") for i in range(self.n)]
 4401: 
 4402: 
 4403: # ------------------------------------------------------------------ renvoi
 4404: class Renvoi(_Insert):
 4405:     """Un patient qu'on renvoie de l'un a l'autre : son jeton saute de station en station, sa trace en pointilles
 4406:     derriere lui ; la station "question" le recoit avec un « ? » qui se balance."""
 4407: 
 4408:     def taille_nominale(self):
 4409:         return C.TEXTE_LARGEUR, C.RENVOI_H
 4410: 
 4411:     def __init__(self, *a):
 4412:         super().__init__(*a)
 4413:         g = C.RENVOI_GEO
 4414:         self.st = self.spec["etapes"]
 4415:         n = len(self.st)
 4416:         self.sw, self.sh = self.px(g["station"][0]), self.px(g["station"][1])
 4417:         ec = self.px(g["ecart"])
 4418:         x0 = self.m + (self.w - n * self.sw - (n - 1) * ec) / 2
 4419:         self.sx = [x0 + i * (self.sw + ec) + self.sw / 2 for i in range(n)]
 4420:         self.sy = self.m + self.px(g["station_y"])
 4421:         self.cartes = [self._station(s) for s in self.st]
 4422:         j = self.px(g["jeton"])
 4423: 
 4424:         def jeton(d, k):                                 # un rond a la couleur de la rubrique, une silhouette blanche
 4425:             J = j * k
 4426:             d.ellipse([0, 0, J - 1, J - 1], fill=self.rubrique + (255,))
 4427:             d.ellipse([J * 0.36, J * 0.18, J * 0.64, J * 0.46], fill=C.BLANC + (255,))
 4428:             d.pieslice([J * 0.22, J * 0.52, J * 0.78, J * 1.08], 180, 360, fill=C.BLANC + (255,))
 4429:         self.jeton = _ombre_marge(_net(j, j, jeton), self.s)
 4430:         self.badge = _icone_choix(None, int(j * 0.62), max(2, self.px(C.CHOIX_GEO["trait"]) - 1), C.INSERT_ROUGE)
 4431: 
 4432:     def _station(self, s):
 4433:         g = C.RENVOI_GEO
 4434:         w, h, question = self.sw, self.sh, s.get("question")
 4435:         fond = (_teinte(C.INSERT_ROUGE, g["teinte"]) if question else C.BLANC) + (255,)
 4436:         im = _net(w, h, lambda d, k: d.rounded_rectangle([0, 0, w * k - 1, h * k - 1], radius=self.px(g["rayon"]) * k,
 4437:                                                          fill=fond))
 4438:         texte, px = T.normaliser(s["label"]), self.px(g["label_px"])
 4439:         while px > self.px(g["label_px_min"]) and \
 4440:                 T.largeur(texte, px, C.INSERT_GRAISSE_FORTE, 0) > w - 2 * self.px(g["pad"]):
 4441:             px -= 1
 4442:         _ecrire(ImageDraw.Draw(im), (w / 2, h * 0.6), texte, px, C.INSERT_GRAISSE_FORTE,
 4443:                 (C.INSERT_ROUGE if question else C.NAVY) + (255,), "mm")
 4444:         return _ombre_marge(im, self.s)
 4445: 
 4446:     def _t(self, i):
 4447:         """Depart du saut vers la station i (i >= 1)."""
 4448:         g = C.RENVOI_GEO
 4449:         tps = self.st[i].get("temps", 0)
 4450:         avant = [j for j in range(1, i) if self.st[j].get("temps", 0) == tps]
 4451:         return self.t0(tps) + C.INSERT_ENTREE * 0.9 + len(avant) * (g["duree"] + g["attente"])
 4452: 
 4453:     def image(self, t, final):
 4454:         g = C.RENVOI_GEO
 4455:         k, a = _entree(t, self.t0(self.spec.get("temps", 0)), final)
 4456:         if a <= 0:
 4457:             return None
 4458:         cadre = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 4459:         n, saut = len(self.st), self.px(g["saut"])
 4460:         base = self.sy - self.px(g["jeton"]) * 0.3       # le jeton est pose sur le bord de la station
 4461:         for i in range(n):
 4462:             kk = 1.0
 4463:             if i >= 1 and not final:                     # la station fait une bosse quand le jeton s'y pose
 4464:                 dt, (amp, duree) = t - self._t(i) - g["duree"], g["bosse"]
 4465:                 if 0 <= dt < duree:
 4466:                     kk = 1 + amp * (1 - dt / duree)
 4467:             _poser(cadre, self.cartes[i], self.sx[i], self.sy + self.sh / 2, kk)
 4468:         d = ImageDraw.Draw(cadre)
 4469:         jx, jy, arrive = self.sx[0], base, 0
 4470:         points, rp = g["point"][0], self.px(g["point"][1]) / 2
 4471:         for i in range(1, n):
 4472:             u = 1.0 if final else (t - self._t(i)) / g["duree"]
 4473:             if u <= 0:
 4474:                 break
 4475:             u = min(1.0, u)
 4476:             for q in range(1, points):                   # la trace : des points le long du saut, jusqu'au jeton
 4477:                 v = q / points
 4478:                 if v > u:
 4479:                     break
 4480:                 x = self.sx[i - 1] + (self.sx[i] - self.sx[i - 1]) * v
 4481:                 y = base - saut * 4 * v * (1 - v)
 4482:                 d.ellipse([x - rp, y - rp, x + rp, y + rp], fill=C.INSERT_GRIS_TEXTE + (255,))
 4483:             jx = self.sx[i - 1] + (self.sx[i] - self.sx[i - 1]) * u
 4484:             jy = base - saut * 4 * u * (1 - u)
 4485:             if u >= 1:
 4486:                 arrive = i
 4487:         question = self.st[-1].get("question") and (final or arrive == n - 1)
 4488:         tq = self._t(n - 1) + g["duree"]
 4489:         amp, freq = g["balance"]
 4490:         angle = amp * math.sin(2 * math.pi * freq * (t - tq)) if question and not final else 0.0
 4491:         _poser(cadre, self.jeton, jx, jy, 1.0, 1.0, angle)
 4492:         if question:
 4493:             kq, aq = _entree(t, tq, final)
 4494:             _poser(cadre, self.badge, jx + self.px(g["jeton"]) * 0.44, jy - self.px(g["jeton"]) * 0.44, kq, aq, angle)
 4495:         out = Image.new("RGBA", cadre.size, (0, 0, 0, 0))
 4496:         _poser(out, cadre, cadre.width / 2, cadre.height / 2, k, a)
 4497:         return out
 4498: 
 4499:     def sons(self):
 4500:         g = C.RENVOI_GEO
 4501:         return [x for i in range(1, len(self.st)) for x in ((self._t(i), "souffle"), (self._t(i) + g["duree"], "clic"))]
 4502: 
 4503: 
 4504: # ----------------------------------------------------------------- guichet
 4505: class Guichet(_Insert):
 4506:     """Un guichet : derriere la vitre, le medecin ; un formulaire glisse vers lui, bute sur un cadenas et repart,
 4507:     en boucle. Il est au guichet d'une regle qu'il ne peut pas appliquer."""
 4508: 
 4509:     def taille_nominale(self):
 4510:         return C.TEXTE_LARGEUR, C.GUICHET_H
 4511: 
 4512:     def __init__(self, *a):
 4513:         super().__init__(*a)
 4514:         g = C.GUICHET_GEO
 4515:         cw, ch = self.px(g["cadre"][0]), self.px(g["cadre"][1])
 4516:         mo, eh, tb = self.px(g["montant"]), self.px(g["enseigne_h"]), self.px(g["tablette"])
 4517:         pw, ph = self.px(g["personnage"][0]), self.px(g["personnage"][1])
 4518: 
 4519:         def fenetre(d, k):
 4520:             d.rounded_rectangle([0, 0, cw * k - 1, ch * k - 1], radius=mo * k, fill=C.NAVY + (255,))
 4521:             d.rectangle([mo * k, eh * k, (cw - mo) * k, (ch - tb) * k],
 4522:                         fill=_teinte(self.rubrique, g["vitre_teinte"]) + (255,))
 4523:         im = _net(cw, ch, fenetre)
 4524:         vitre = im.crop((mo, eh, cw - mo, ch - tb))      # le medecin, derriere la vitre, coupe par la tablette
 4525:         vitre.alpha_composite(_personnage(pw, ph, _teinte(C.NAVY, 0.35)),
 4526:                               ((cw - 2 * mo - pw) // 2, (ch - tb - eh) - int(ph * 0.92)))
 4527:         im.paste(vitre, (mo, eh))
 4528:         _ecrire(ImageDraw.Draw(im), (cw / 2, eh / 2), T.normaliser(self.spec.get("enseigne", "")).upper(),
 4529:                 self.px(g["enseigne_px"]), C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
 4530:         self.fenetre = _ombre_marge(im, self.s)
 4531:         self.gx, self.gy, self.cw, self.ch = self.m + self.px(g["pad"]), self.m + (self.h - ch) / 2, cw, ch
 4532:         self.papier = _ombre_marge(self._papier(), self.s)
 4533:         c = self.px(g["cadenas"])
 4534:         rond = _net(c, c, lambda d, k: d.ellipse([0, 0, c * k - 1, c * k - 1], fill=C.BLANC + (255,)))
 4535:         cad = _cadenas_rouge(int(c * 0.6))
 4536:         rond.alpha_composite(cad, ((c - cad.width) // 2, (c - cad.height) // 2))
 4537:         self.cadenas = _ombre_marge(rond, self.s)
 4538: 
 4539:     def _papier(self):
 4540:         g = C.GUICHET_GEO
 4541:         w, h, pad = self.px(g["papier"][0]), self.px(g["papier"][1]), self.px(g["papier_pad"])
 4542:         px, lh = self.px(g["papier_px"]), self.px(g["ligne_h"])
 4543: 
 4544:         def dessin(d, k):
 4545:             d.rounded_rectangle([0, 0, w * k - 1, h * k - 1], radius=self.px(g["papier_rayon"]) * k, fill=C.BLANC + (255,))
 4546:             for i, frac in enumerate(g["lignes"]):
