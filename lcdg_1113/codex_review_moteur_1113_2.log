  25: def musique(ep: dict) -> Path | None:
  26:     """Morceau de fond : celui du script ("musique", un fichier de assets/audio, avec ou
  27:     sans .mp3), sinon celui de la charte ; "musique": false le retire. Un morceau nomme
  28:     par le script et introuvable arrete le rendu ; celui de la charte absent (assets/audio
  29:     n'est pas versionne) est signale, et le reel sort avec la seule voix."""
  30:     choix = ep.get("musique", C.MUSIQUE_DEFAUT)
  31:     if not choix:
  32:         return None
  33:     f = C.AUDIO / choix
  34:     if not f.suffix:
  35:         f = f.with_suffix(".mp3")
  36:     if f.exists():
  37:         return f
  38:     if "musique" in ep:
  39:         raise SystemExit(f"[!] Musique « {choix} » introuvable dans assets/audio : mets le nom "
  40:                          "d'un fichier present, ou \"musique\": false pour un reel sans musique.")
  41:     print(f"[i] Musique de la charte absente ({f.name} dans assets/audio) : le reel sort sans "
  42:           "musique.")
  43:     return None
