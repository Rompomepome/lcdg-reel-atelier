  92: def boucle_passages(nom: str, duree: float, total: float) -> list:
  93:     """Les passages du morceau a enchainer pour couvrir total secondes : [(debut, fin), ...]. Un seul passage, le
  94:     morceau entier, s'il suffit ; sinon le premier va du debut au point de sortie de la boucle, les suivants
  95:     repartent du point d'entree, chacun recouvrant le precedent de MUSIQUE_BOUCLE_FONDU (fondu enchaine)."""
  96:     entree, sortie = C.MUSIQUE_BOUCLES.get(nom, (C.MUSIQUE_FONDU_IN, duree - C.MUSIQUE_BOUCLE_MARGE))
  97:     sortie = min(sortie, duree)
  98:     if total <= sortie:
  99:         return [(0.0, duree)]
 100:     f = C.MUSIQUE_BOUCLE_FONDU
 101:     if sortie - entree <= 2 * f:
 102:         raise SystemExit(f"[!] Musique {nom} : boucle trop courte ({entree} s a {sortie} s).")
 103:     passages, couvert = [(0.0, sortie)], sortie
 104:     while couvert < total:
 105:         passages.append((entree, sortie))
 106:         couvert += sortie - entree - f
 107:     return passages
 108: 
 109: 
 110: def _boucle(fond: Path, k: int, total: float, graphe: list) -> str:
 111:     """Etiquette de la musique a monter : l'entree k telle quelle, ou ses passages enchaines en fondu
 112:     (le graphe recoit les filtres de la boucle)."""
 113:     passages = boucle_passages(fond.name, B.duree(fond), total)
 114:     if len(passages) == 1:
 115:         return f"[{k}:a]"
 116:     n = len(passages)
 117:     graphe.append(f"[{k}:a]asplit={n}" + "".join(f"[mb{i}]" for i in range(n)))
 118:     for i, (a, b) in enumerate(passages):
 119:         graphe.append(f"[mb{i}]atrim={a:.3f}:{b:.3f},asetpts=N/SR/TB[mp{i}]")
 120:     prec = "[mp0]"
 121:     for i in range(1, n):
 122:         # courbes a puissance constante : pas de creux de volume au raccord
 123:         graphe.append(f"{prec}[mp{i}]acrossfade=d={C.MUSIQUE_BOUCLE_FONDU}:c1=qsin:c2=qsin[mx{i}]")
 124:         prec = f"[mx{i}]"
 125:     return prec
 126: 
 127: 
 128: def bande(episode: Path, ep: dict, bornes: list, total: float, voix: Path | None) -> Path | None:
 129:     """Mixe voix, musique (sous la voix) et bruitages en une piste stereo 48 kHz au niveau
 130:     de la charte. None si le reel n'a ni voix ni musique."""
 131:     # Gain fixe partout : une normalisation dynamique (loudnorm) au milieu du graphe
 132:     # remonte les fondus et decale la piste qu'elle traite (02/10/2026, la musique
 133:     # disparaissait 2,7 s avant la fin du reel).
 134:     fond = musique(ep)
 135:     if voix is None and fond is None:
 136:         return None
 137:     travail = episode / "voix"
 138:     travail.mkdir(parents=True, exist_ok=True)
 139:     sfx = effets(ep, bornes, total, travail / "effets.wav")
 140:     entrees, graphe, mix = [], [], []
 141:     if voix is not None:
 142:         entrees += ["-i", str(voix)]
 143:         graphe.append(f"[{len(entrees) // 2 - 1}:a]apad,atrim=0:{total:.3f},asplit=2[voix][cle]")
 144:         mix.append("[voix]")
 145:     if fond is not None:
 146:         entrees += ["-i", str(fond)]
 147:         k = len(entrees) // 2 - 1
 148:         extrait = f"aresample={SR},atrim=0:{total:.3f},asetpts=N/SR/TB"
 149:         gain = C.MUSIQUE_LUFS - sonie(fond, extrait)
 150:         source = _boucle(fond, k, total, graphe)
 151:         graphe.append(f"{source}{extrait},volume={gain:.2f}dB,"
 152:                       f"afade=t=in:st=0:d={C.MUSIQUE_FONDU_IN},"
 153:                       f"afade=t=out:st={max(0.0, total - C.MUSIQUE_FONDU_OUT):.3f}:"
 154:                       f"d={C.MUSIQUE_FONDU_OUT}[fond]")
 155:         if voix is not None:
 156:             # la musique s'efface quand la voix parle
 157:             graphe.append(f"[fond][cle]sidechaincompress={C.MUSIQUE_DUCKING}[fond_d]")
 158:             mix.append("[fond_d]")
 159:         else:
 160:             mix.append("[fond]")
 161:     elif voix is not None:
 162:         graphe[-1] = graphe[-1].replace(",asplit=2[voix][cle]", "[voix]")
 163:     if sfx is not None:
 164:         entrees += ["-i", str(sfx)]
 165:         graphe.append(f"[{len(entrees) // 2 - 1}:a]apad,atrim=0:{total:.3f}[sfx]")
 166:         mix.append("[sfx]")
 167:     graphe.append("".join(mix) + f"amix=inputs={len(mix)}:duration=longest:normalize=0[a]")
 168:     brute = travail / f"bande_{ep['slug']}_brute.wav"
 169:     B.run([*entrees, "-filter_complex", ";".join(graphe), "-map", "[a]",
 170:            "-ar", str(SR), "-ac", "2", "-t", f"{total:.3f}", str(brute), "-y"])
 171:     # mise au niveau final : un gain fixe, puis le limiteur pour les cretes
 172:     gain = C.SON_LUFS - sonie(brute)
 173:     dest = travail / f"bande_{ep['slug']}.wav"
 174:     # "son_limite_db" : limiteur plus bas pour un reel dont l'encodage AAC depasse le plafond sur une
 175:     # attaque de voix (2 dB sur le premier mot du reel pharmacien, 05/11/2026)
 176:     limite = ep.get("son_limite_db", C.SON_TP_CIBLE)
 177:     B.run(["-i", str(brute), "-af",
 178:            f"volume={gain:.2f}dB,alimiter=limit={10 ** (limite / 20):.3f}:level=false,"
 179:            f"aresample={SR}", "-ar", str(SR), "-ac", "2", str(dest), "-y"])
 180:     brute.unlink(missing_ok=True)
 181:     return dest
