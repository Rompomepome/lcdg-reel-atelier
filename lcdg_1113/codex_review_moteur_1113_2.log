 4584:     def sons(self):
 4585:         # un impact a chaque fois que le formulaire bute, jusqu'a la fin de la scene (il en sonnait deux, puis le
 4586:         # mouvement continuait sans bruit : review Codex du 13/11/2026)
 4587:         g = C.GUICHET_GEO
 4588:         out, i = [], 0
 4589:         while self._t_depart() + (i + g["aller"]) * g["cycle"] < self.fin:
 4590:             out.append((self._t_depart() + (i + g["aller"]) * g["cycle"], "impact"))
 4591:             i += 1
 4592:         return out
