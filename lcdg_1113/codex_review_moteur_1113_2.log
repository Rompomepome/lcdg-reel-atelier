 4558:     def image(self, t, final):
 4559:         g = C.GUICHET_GEO
 4560:         k, a = _entree(t, self.t0(), final)
 4561:         if a <= 0:
 4562:             return None
 4563:         cadre = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
