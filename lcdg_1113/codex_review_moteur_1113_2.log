 4011: # ------------------------------------------------------------------- delai
 4012: class Delai(_Insert):
 4013:     """Un delai qui court : le compteur de jours monte et la piste se remplit ; au temps "temps_fin", un drapeau
 4014:     vert se pose au bout (ce qui arrive a l'echeance) ; au temps "temps_retour", une fleche rouge ramene tout a
 4015:     zero, une pilule pose la question, et le delai repart, en boucle."""
 4016: 
 4017:     def taille_nominale(self):
 4018:         return C.TEXTE_LARGEUR, C.DELAI_H
 4019: 
 4020:     def __init__(self, *a):
 4021:         super().__init__(*a)
 4022:         g = C.DELAI_GEO
 4023:         m = self.m
 4024:         self.pad = self.px(g["pad"])
 4025:         self.jours = int(self.spec["jours"])
 4026:         self.x0, self.x1 = m + self.pad, m + self.w - self.pad
 4027:         self.py, self.pe = m + self.px(g["piste_y"]), self.px(g["piste_h"])
 4028:         L, pe = self.x1 - self.x0, self.pe
 4029:         carte = _cadre(self.w, self.h, self.s, marge=m)
 4030:         _ecrire(ImageDraw.Draw(carte), (self.x0, m + self.pad), T.normaliser(self.spec.get("titre", "")).upper(),
 4031:                 self.px(g["titre_px"]), C.INSERT_GRAISSE_FORTE, C.INSERT_GRIS_TEXTE + (255,), "la")
 4032: 
 4033:         def piste(couleur):
 4034:             return _net(L, pe, lambda d, k: d.rounded_rectangle([0, 0, L * k - 1, pe * k - 1], radius=pe * k / 2,
 4035:                                                                 fill=tuple(couleur) + (255,)))
 4036:         carte.alpha_composite(piste(C.INSERT_GRIS), (int(self.x0), int(self.py)))
 4037:         self.plein = piste(self.rubrique)
 4038:         self.carte = _ombre(carte, self.s)
 4039:         c, tr = self.px(g["curseur"]), self.px(g["curseur_trait"])
 4040:         self.curseur = _net(c, c, lambda d, k: d.ellipse([0, 0, c * k - 1, c * k - 1], fill=C.BLANC + (255,),
 4041:                                                          outline=self.rubrique + (255,), width=int(tr * k)))
 4042:         self.drapeau = self.question = None
 4043:         if self.spec.get("fin"):
 4044:             self.drapeau = _bulle(self.spec["fin"], self.px(g["drapeau_px"]), self.px(g["drapeau_h"]),
 4045:                                   self.px(g["drapeau_pad"]), C.INSERT_VERT, queue=False)
 4046:         if self.spec.get("retour"):
 4047:             self.question = _bulle(self.spec["retour"], self.px(g["question_px"]), self.px(g["question_h"]),
 4048:                                    self.px(g["question_pad"]), C.INSERT_ROUGE, queue=False)
 4049:         self.fleche = self._fleche(L)
 4050: 
 4051:     def _fleche(self, L):
 4052:         """La fleche du retour : un arc qui passe sous la piste, de droite a gauche, et remonte a zero."""
 4053:         g = C.DELAI_GEO
 4054:         h, tr = self.px(g["fleche_h"]), self.px(g["fleche_trait"])
 4055:         rouge = C.INSERT_ROUGE + (255,)
 4056: 
 4057:         def dessin(d, k):
 4058:             d.arc([tr * k * 2, (tr - h) * k, (L - tr * 2) * k, (h - tr) * k], 0, 180, fill=rouge, width=int(tr * k))
 4059:             x = tr * k * 2.5
 4060:             d.polygon([(x - tr * k * 2, tr * k * 2.6), (x + tr * k * 2, tr * k * 2.6), (x, 0)], fill=rouge)
 4061:         return _net(L, h, dessin)
 4062: 
 4063:     def _t_dep(self):
 4064:         return self.t0(self.spec.get("temps", 0)) + C.INSERT_ENTREE * 0.8
 4065: 
 4066:     def _t_cle(self, cle):
 4067:         return self.t0(self.spec[cle]) + C.INSERT_ENTREE * 0.5 if cle in self.spec else None
 4068: 
 4069:     def _fraction(self, t, final):
 4070:         """Part du delai ecoulee : il court, puis, au retour, revient a zero et repart, en boucle."""
 4071:         g = C.DELAI_GEO
 4072:         tr = self._t_cle("temps_retour")
 4073:         if final:
 4074:             return 1.0 if tr is None else 0.0
 4075:         f = T.lisse((t - self._t_dep()) / g["course"])
 4076:         if tr is None or t < tr:
 4077:             return f
 4078:         tour, phase = divmod(t - tr, g["boucle"])
 4079:         depart = T.lisse((tr - self._t_dep()) / g["course"]) if tour == 0 else 1.0
 4080:         if phase < g["retour"]:
 4081:             return depart * (1 - T.lisse(phase / g["retour"]))
 4082:         return T.lisse((phase - g["retour"]) / g["course"])
 4083: 
 4084:     def image(self, t, final):
 4085:         g = C.DELAI_GEO
 4086:         k, a = _entree(t, self.t0(), final)
 4087:         if a <= 0:
 4088:             return None
 4089:         cadre = self.carte.copy()
 4090:         d = ImageDraw.Draw(cadre)
 4091:         f, L = self._fraction(t, final), self.x1 - self.x0
 4092:         n = int(round(f * self.jours))
 4093:         base, px = self.m + self.px(g["compteur_y"]), self.px(g["compteur_px"])
 4094:         _ecrire(d, (self.x0, base), str(n), px, C.INSERT_GRAISSE_FORTE, C.NAVY + (255,), "ls")
 4095:         _ecrire(d, (self.x0 + T.largeur(str(n), px, C.INSERT_GRAISSE_FORTE, 0) + self.px(g["unite_ecart"]), base),
 4096:                 "jours" if n > 1 else "jour", self.px(g["unite_px"]), C.INSERT_GRAISSE_TEXTE,
 4097:                 C.INSERT_GRIS_TEXTE + (255,), "ls")
 4098:         if L * f > self.pe:
 4099:             cadre.alpha_composite(self.plein.crop((0, 0, int(L * f), self.pe)), (int(self.x0), int(self.py)))
 4100:         _poser(cadre, self.curseur, self.x0 + max(self.pe / 2, min(L - self.pe / 2, L * f)), self.py + self.pe / 2)
 4101:         if self.drapeau is not None:
 4102:             tf = self._t_cle("temps_fin")
 4103:             kk, aa = _frappe(t, tf if tf is not None else self._t_dep() + g["course"], final)
 4104:             if aa > 0:
 4105:                 _poser(cadre, self.drapeau, self.x1 - self.drapeau.width / 2,
 4106:                        self.py - self.px(g["drapeau_dy"]) - self.drapeau.height / 2, kk, aa, C.PILULE_GEO["angle"])
 4107:         tr = self._t_cle("temps_retour")
 4108:         if tr is not None:
 4109:             p = 1.0 if final else T.lisse((t - tr) / g["retour"])
 4110:             y = self.py + self.pe + self.px(g["fleche_dy"])
 4111:             if p > 0:
 4112:                 x = int(L * (1 - p))
 4113:                 cadre.alpha_composite(self.fleche.crop((x, 0, L, self.fleche.height)), (int(self.x0) + x, int(y)))
 4114:             if self.question is not None:
 4115:                 kk, aa = _frappe(t, tr + g["retour"] * 0.7, final)
 4116:                 if aa > 0:
 4117:                     _poser(cadre, self.question, self.m + self.w / 2, y + self.fleche.height * 0.62, kk, aa,
 4118:                            C.PILULE_GEO["angle"])
 4119:         out = Image.new("RGBA", cadre.size, (0, 0, 0, 0))
 4120:         _poser(out, cadre, cadre.width / 2, cadre.height / 2, k, a)
 4121:         return out
 4122: 
 4123:     def sons(self):
 4124:         s = [(self._t_dep(), "compteur")]
 4125:         tf, tr = self._t_cle("temps_fin"), self._t_cle("temps_retour")
 4126:         if self.drapeau is not None and tf is not None:
 4127:             s.append((tf + C.TAMPON_FRAPPE, "impact"))
 4128:         if tr is not None:
 4129:             s += [(tr, "souffle"), (tr + C.DELAI_GEO["retour"] * 0.7 + C.TAMPON_FRAPPE, "impact")]
 4130:         return s
