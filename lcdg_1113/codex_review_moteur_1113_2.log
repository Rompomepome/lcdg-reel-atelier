 4606: def inserts(ep, scenes, ouverture=None):
 4607:     """Les inserts du reel, un ou plusieurs par bloc qui en porte (scenes : habillage.scenes)."""
 4608:     out = []
 4609:     for k, bl in enumerate(ep["blocs"]):
 4610:         specs = bl.get("insert")
 4611:         if not specs:
 4612:             continue
 4613:         specs = [specs] if isinstance(specs, dict) else specs
 4614:         if bl.get("type") in ("phrase", "chiffre") or k == 0:
 4615:             raise SystemExit(f"[!] bloc {k} : un insert se pose sur un bloc de texte (pas sur "
 4616:                              "l'accroche, une phrase forte ou un chiffre cle).")
 4617:         scene = scenes[k]
 4618:         hauts = [b[1] for b in (hb._bbox(lay) for _, lay, _ in scene.couches()) if b]
 4619:         bas = min(hauts) if hauts else C.BLOC_Y
 4620:         if ouverture is not None and ouverture.scene is scene:
 4621:             bas = ouverture.pos[1]
 4622:         premier, haut = None, bas - C.INSERT_ECART
 4623:         for spec in specs:
 4624:             # "carre": false le retire de la version carree, plus basse : au bloc 1, la pastille
 4625:             # d'ouverture ne laisse pas toujours la place d'un insert (charte.CARRE)
 4626:             if spec.get("carre") is False and C.LARGEUR == C.HAUTEUR:
 4627:                 continue
 4628:             if spec.get("type") not in TYPES:
 4629:                 raise SystemExit(f"[!] bloc {k} : insert inconnu « {spec.get('type')} ». "
 4630:                                  f"Types : {', '.join(TYPES)}.")
 4631:             nom = f"insert bloc {k}" + (f" ({spec['type']})" if len(specs) > 1 else "")
 4632:             # "sur": true centre l'element sur le premier insert du bloc (un tampon sur un dessin) ;
 4633:             # sinon, chaque element s'empile au-dessus du precedent
 4634:             sur = spec.get("sur") and premier is not None
 4635:             ins = TYPES[spec["type"]](nom, spec, scene, bas - C.INSERT_ECART if sur else haut)
 4636:             if sur:
 4637:                 ins.x = premier.x + (premier.w - ins.w) / 2
 4638:                 ins.y = premier.y + (premier.h - ins.h) / 2
 4639:             else:
 4640:                 haut = ins.y - C.INSERT_ECART_ELEMENTS
 4641:             premier = premier or ins
 4642:             out.append(ins)
 4643:     return out
