  69: def effets(ep: dict, bornes: list, total: float, dest: Path) -> Path | None:
  70:     """Piste des bruitages, de la duree du reel. None si la banque est absente."""
  71:     croix = total - (C.CROIX_DUREE + C.OUTRO_DUREE)
  72:     piste = np.zeros((int(total * SR) + SR, 2))
  73:     sons, poses = {}, 0
  74:     for t, nom in hb.evenements(ep, bornes, croix):
  75:         f = C.SFX / f"{nom}.mp3"
  76:         if not f.exists():
  77:             continue
  78:         if nom not in sons:
  79:             a = _pcm(f)
  80:             # chaque son est ramene au meme sommet, puis au niveau voulu par la charte
  81:             sons[nom] = a / (np.abs(a).max() + 1e-9) * 10 ** (C.SFX_GAINS[nom] / 20)
  82:         a = sons[nom]
  83:         i = int(max(0.0, t) * SR)
  84:         j = min(len(piste), i + len(a))
  85:         piste[i:j] += a[:j - i]
  86:         poses += 1
  87:     if not poses:
  88:         return None
  89:     return _ecrire(piste[:int(total * SR)], dest)
