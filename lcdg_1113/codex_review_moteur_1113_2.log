 4565:         ts, dep = self._t_depart(), self.px(g["depart"])
 4566:         dx, angle = (0.0, 0.0) if final else (dep, 0.0)
 4567:         if not final and t >= ts:
 4568:             u = ((t - ts) % g["cycle"]) / g["cycle"]
 4569:             if u < g["aller"]:
 4570:                 dx = dep * (1 - (u / g["aller"]) ** 2)    # le formulaire accelere vers le guichet
 4571:             else:
 4572:                 dx = dep * T.lisse((u - g["aller"]) / (1 - g["aller"]) * 1.5)   # il bute, et repart
 4573:                 ti, (amp, duree) = (u - g["aller"]) * g["cycle"], g["secousse"]
 4574:                 if ti < duree:
 4575:                     angle = amp * math.sin(2 * math.pi * 5 * ti) * (1 - ti / duree)
 4576:         cy = self.gy + self.ch * 0.56
 4577:         x0 = self.gx + self.cw + self.px(g["butee"])
 4578:         _poser(cadre, self.papier, x0 + dx + self.px(g["papier"][0]) / 2, cy, 1.0, 1.0, -g["penche"] * dx / dep)
 4579:         _poser(cadre, self.cadenas, self.gx + self.cw + self.px(g["butee"]) * 0.35, cy, 1.0, 1.0, angle)
 4580:         out = Image.new("RGBA", cadre.size, (0, 0, 0, 0))
 4581:         _poser(out, cadre, cadre.width / 2, cadre.height / 2, k, a)
 4582:         return out
