  197: def _poser(fond, im, cx, cy, k=1.0, alpha=1.0, angle=0.0):
  198:     """Colle im centre en (cx, cy), a l'echelle k, tourne de angle degres."""
  199:     if alpha <= 0.003 or k <= 0.01:
  200:         return
  201:     if abs(k - 1) > 0.01:
  202:         im = im.resize((max(1, int(im.width * k)), max(1, int(im.height * k))), Image.BICUBIC)
  203:     if abs(angle) > 0.05:
  204:         im = im.rotate(angle, resample=Image.BICUBIC, expand=True)
  205:     T.coller(fond, im, (cx - im.width / 2, cy - im.height / 2), min(1.0, alpha))
  206: 
