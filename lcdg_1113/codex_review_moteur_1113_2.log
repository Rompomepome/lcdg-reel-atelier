 3877:         cadre = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 3878:         cadre.alpha_composite(self.fond)
 3879:         deb = self.px(g["deborde"])
 3880:         if self.irm is not None:
 3881:             p0 = 1.0 if final else T.lisse((t - self._t(0)) / g["trace"])
 3882:             cadre.alpha_composite(self._dessin_irm(t, p0, final), (self.m + self.pad, int(self.m + self.irm_y)))
 3883:         for i, (bleu, gris, trait) in enumerate(self.sprites):
 3884:             p = 1.0 if final else T.lisse((t - self._t(i)) / g["trace"])
 3885:             x, cy = self.m + self.tx, self.m + self.y0 + (i + 0.5) * self.lh
 3886:             T.coller(cadre, bleu, (x, cy - bleu.height / 2), 1 - p)
 3887:             T.coller(cadre, gris, (x, cy - gris.height / 2), p)
