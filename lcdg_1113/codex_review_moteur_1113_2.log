 4229: # ----------------------------------------------------------------- dossier
 4230: class Dossier(_Insert):
 4231:     """Le dossier d'un patient : ses notes sortent de la chemise en eventail ; au temps "temps_question", un « ? »
 4232:     va et vient au-dessus d'elles, et la note qu'il survole se souleve (laquelle ?)."""
 4233: 
 4234:     def taille_nominale(self):
 4235:         return C.TEXTE_LARGEUR, C.DOSSIER_H
 4236: 
 4237:     def __init__(self, *a):
 4238:         super().__init__(*a)
 4239:         g = C.DOSSIER_GEO
 4240:         cw, ch = self.px(g["chemise"][0]), self.px(g["chemise"][1])
 4241:         ow, oh, ra = self.px(g["onglet"][0]), self.px(g["onglet"][1]), self.px(g["rayon"])
 4242:         self.cx, self.haut = self.m + self.w / 2, self.m + self.h - ch
 4243:         self.cw, self.ch, self.oh, self.rh = cw, ch, oh, int(ch * g["rabat"])
 4244:         fonce, clair = _teinte(C.NAVY, 0.12) + (255,), _teinte(C.NAVY, 0.32) + (255,)
 4245: 
 4246:         def dos(d, k):
 4247:             d.rounded_rectangle([0, 0, ow * k, (oh + 2 * ra) * k], radius=ra * k, fill=fonce)
 4248:             d.rounded_rectangle([0, oh * k, cw * k - 1, (oh + ch) * k - 1], radius=ra * k, fill=fonce)
 4249:         self.dos = _net(cw, oh + ch, dos)
 4250:         rh = self.rh
 4251:         rabat = _net(cw, rh, lambda d, k: d.rounded_rectangle([0, 0, cw * k - 1, rh * k - 1], radius=ra * k, fill=clair))
 4252:         _ecrire(ImageDraw.Draw(rabat), (cw / 2, rh / 2), self.spec.get("titre", ""), self.px(g["titre_px"]),
 4253:                 C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
 4254:         self.rabat = _ombre_marge(rabat, self.s)
 4255:         self.note = _ombre_marge(self._note(), self.s)
 4256:         self.badge = _icone_choix(None, self.px(g["badge"]), self.px(C.CHOIX_GEO["trait"]), self.rubrique)
 4257: 
 4258:     def _note(self):
 4259:         g = C.DOSSIER_GEO
 4260:         w, h, pad = self.px(g["note"][0]), self.px(g["note"][1]), self.px(g["note_pad"])
 4261:         dw, dh, lh = self.px(g["date"][0]), self.px(g["date"][1]), self.px(g["ligne_h"])
 4262: 
 4263:         def dessin(d, k):
 4264:             d.rounded_rectangle([0, 0, w * k - 1, h * k - 1], radius=self.px(g["note_rayon"]) * k, fill=C.BLANC + (255,),
 4265:                                 outline=C.INSERT_GRIS + (255,), width=int(max(1, self.px(2)) * k))
 4266:             d.rounded_rectangle([pad * k, pad * k, (pad + dw) * k, (pad + dh) * k], radius=dh * k / 2,
 4267:                                 fill=_teinte(self.rubrique, 0.45) + (255,))
 4268:             for i, frac in enumerate(g["lignes"]):
 4269:                 y = (pad + dh + self.px(g["date_ecart"]) + i * self.px(g["ligne_pas"])) * k
 4270:                 d.rounded_rectangle([pad * k, y, (pad + (w - 2 * pad) * frac) * k, y + lh * k], radius=lh * k / 2,
 4271:                                     fill=C.INSERT_GRIS + (255,))
 4272:         return _net(w, h, dessin)
 4273: 
 4274:     def _t_question(self):
 4275:         return self.t0(self.spec["temps_question"]) + C.INSERT_ENTREE * 0.5 if "temps_question" in self.spec else None
 4276: 
 4277:     def image(self, t, final):
 4278:         g = C.DOSSIER_GEO
 4279:         k, a = _entree(t, self.t0(), final)
 4280:         if a <= 0:
 4281:             return None
 4282:         cadre = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 4283:         cadre.alpha_composite(self.dos, (int(self.cx - self.cw / 2), int(self.haut - self.oh)))
 4284:         tq, ex = self._t_question(), self.px(g["ecart_x"])
 4285:         bx = None                                        # ou est le « ? », par rapport au centre
 4286:         if tq is not None and (final or t >= tq):
 4287:             bx = 0.0 if final else ex * math.sin(2 * math.pi * g["va_et_vient"] * (t - tq))
 4288:         y0 = self.haut + self.px(g["note_y"])
 4289:         for i, angle in enumerate(g["eventail"]):
 4290:             u = 1.0 if final else T.lisse((t - self.t0() - C.INSERT_ENTREE * 0.6 - i * g["decalage"]) / g["duree"])
 4291:             dx = (i - (len(g["eventail"]) - 1) / 2) * ex
 4292:             y = y0 - self.px(g["sortie"]) * u
 4293:             if bx is not None:                           # la note que le « ? » survole se souleve
 4294:                 y -= self.px(g["levee"]) * max(0.0, 1 - abs(bx - dx) / ex)
 4295:             _poser(cadre, self.note, self.cx + dx * u, y, 1.0, 1.0, -angle * u)
 4296:         cadre.alpha_composite(self.rabat, (int(self.cx - self.cw / 2 - self.m),
 4297:                                            int(self.haut + self.ch - self.rh - self.m)))
 4298:         if bx is not None:
 4299:             kk, aa = _entree(t, tq, final)
 4300:             amp, freq = g["balance"]
 4301:             _poser(cadre, self.badge, self.cx + bx,
 4302:                    y0 - self.px(g["sortie"]) - self.px(g["note"][1]) / 2 - self.px(g["levee"]) + self.px(g["badge"]) * 0.2,
 4303:                    kk, aa, 0.0 if final else amp * math.sin(2 * math.pi * freq * (t - tq)))
 4304:         out = Image.new("RGBA", cadre.size, (0, 0, 0, 0))
 4305:         _poser(out, cadre, cadre.width / 2, cadre.height / 2, k, a)
 4306:         return out
 4307: 
 4308:     def sons(self):
 4309:         g = C.DOSSIER_GEO
 4310:         s = [(self.t0() + C.INSERT_ENTREE * 0.6 + i * g["decalage"], "souffle") for i in range(len(g["eventail"]))]
 4311:         if self._t_question() is not None:
 4312:             s.append((self._t_question(), "clic"))
 4313:         return s
 4314: 
