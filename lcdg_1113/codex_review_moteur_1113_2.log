  208: def _nombre(v, dec):
  209:     # meme ecriture que les chiffres cles (habillage.Chiffre.nombre) : milliers separes par
  210:     # une espace fine, virgule decimale (« 3 400 », « 49,6 »)
  211:     return f"{v:,.{dec}f}".replace(",", " ").replace(".", ",")
