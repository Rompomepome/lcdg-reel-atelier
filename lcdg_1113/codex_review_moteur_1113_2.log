  214: class _Insert:
  215:     """Placement, entree commune et sortie avec le texte du bloc."""
  216: 
  217:     def __init__(self, nom, spec, scene, bas):
  218:         self.nom, self.spec, self.scene = nom, spec, scene
  219:         self.debut, self.fin = scene.debut, scene.fin
  220:         self.instants = [scene.debut] + [p.debut for p in scene.parts[1:]]
  221:         w0, h0 = self.taille_nominale()
  222:         dispo = bas - C.INSERT_HAUT_MIN
  223:         self.s = min(1.0, dispo / h0, C.TEXTE_LARGEUR / w0)
  224:         if self.s < C.INSERT_ECHELLE_MIN:
  225:             raise SystemExit(f"[!] {nom} : pas la place pour l'insert « {spec['type']} » au-dessus "
  226:                              f"du texte ({dispo:.0f} px pour {h0} px). Raccourcis le texte du bloc "
  227:                              "ou retire l'insert.")
  228:         self.w, self.h = int(w0 * self.s), int(h0 * self.s)
  229:         self.m = int(C.INSERT_OMBRE[0] * C.INSERT_MARGE_OMBRE * self.s) + 4   # ombres
  230:         self.x, self.y = C.TEXTE_X, bas - self.h
  231:         self.rubrique = tuple(hb._RUBRIQUE)
  232: 
  233:     def px(self, v):
  234:         return max(1, int(round(v * self.s)))
  235: 
  236:     def t0(self, k=0):
  237:         return self.instants[min(max(0, k), len(self.instants) - 1)] + C.INSERT_DELAI
  238: 
  239:     def taille_nominale(self):
  240:         raise NotImplementedError
  241: 
  242:     def image(self, t, final):
  243:         raise NotImplementedError
  244: 
  245:     def sons(self):
  246:         return []
  247: 
  248:     def dessiner(self, lay, t, final=False):
  249:         so = 0.0 if final else self.scene.parts[-1]._sortie(t)
  250:         if so >= 1:
  251:             return
  252:         im = self.image(t, final)
  253:         if im is not None:
  254:             T.coller(lay, im, (self.x - self.m, self.y - self.m - C.SORTIE_MONTEE * so), 1 - so)
  255: 
  256:     def couche(self):
  257:         lay = hb._vide(); self.dessiner(lay, 0, final=True)
  258:         return lay
  259: 
