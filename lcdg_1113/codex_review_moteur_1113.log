 4297:                                            int(self.haut + self.ch - self.rh - self.m)))
 4298:         if bx is not None:
 4299:             kk, aa = _entree(t, tq, final)
 4300:             amp, freq = g["balance"]
 4301:             _poser(cadre, self.badge, self.cx + bx,
 4302:                    y0 - self.px(g["sortie"]) - self.px(g["note"][1]) / 2 - self.px(g["levee"]) + self.px(g["badge"]) * 0.2,
 4303:                    kk, aa, 0.0 if final else amp * math.sin(2 * math.pi * freq * (t - tq)))
 4304:         out = Image.new("RGBA", cadre.size, (0, 0, 0, 0))
