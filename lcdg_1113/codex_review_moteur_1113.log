 4501: # ----------------------------------------------------------------- guichet
 4502: class Guichet(_Insert):
 4503:     """Un guichet : derriere la vitre, le medecin ; un formulaire glisse vers lui, bute sur un cadenas et repart,
 4504:     en boucle. Il est au guichet d'une regle qu'il ne peut pas appliquer."""
 4505: 
 4506:     def taille_nominale(self):
 4507:         return C.TEXTE_LARGEUR, C.GUICHET_H
 4508: 
 4509:     def __init__(self, *a):
 4510:         super().__init__(*a)
 4511:         g = C.GUICHET_GEO
 4512:         cw, ch = self.px(g["cadre"][0]), self.px(g["cadre"][1])
 4513:         mo, eh, tb = self.px(g["montant"]), self.px(g["enseigne_h"]), self.px(g["tablette"])
 4514:         pw, ph = self.px(g["personnage"][0]), self.px(g["personnage"][1])
 4515: 
 4516:         def fenetre(d, k):
 4517:             d.rounded_rectangle([0, 0, cw * k - 1, ch * k - 1], radius=mo * k, fill=C.NAVY + (255,))
 4518:             d.rectangle([mo * k, eh * k, (cw - mo) * k, (ch - tb) * k],
 4519:                         fill=_teinte(self.rubrique, g["vitre_teinte"]) + (255,))
 4520:         im = _net(cw, ch, fenetre)
 4521:         vitre = im.crop((mo, eh, cw - mo, ch - tb))      # le medecin, derriere la vitre, coupe par la tablette
 4522:         vitre.alpha_composite(_personnage(pw, ph, _teinte(C.NAVY, 0.35)),
 4523:                               ((cw - 2 * mo - pw) // 2, (ch - tb - eh) - int(ph * 0.92)))
 4524:         im.paste(vitre, (mo, eh))
 4525:         _ecrire(ImageDraw.Draw(im), (cw / 2, eh / 2), T.normaliser(self.spec.get("enseigne", "")).upper(),
 4526:                 self.px(g["enseigne_px"]), C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
 4527:         self.fenetre = _ombre_marge(im, self.s)
 4528:         self.gx, self.gy, self.cw, self.ch = self.m + self.px(g["pad"]), self.m + (self.h - ch) / 2, cw, ch
 4529:         self.papier = _ombre_marge(self._papier(), self.s)
 4530:         c = self.px(g["cadenas"])
 4531:         rond = _net(c, c, lambda d, k: d.ellipse([0, 0, c * k - 1, c * k - 1], fill=C.BLANC + (255,)))
 4532:         cad = _cadenas_rouge(int(c * 0.6))
 4533:         rond.alpha_composite(cad, ((c - cad.width) // 2, (c - cad.height) // 2))
 4534:         self.cadenas = _ombre_marge(rond, self.s)
 4535: 
 4536:     def _papier(self):
 4537:         g = C.GUICHET_GEO
 4538:         w, h, pad = self.px(g["papier"][0]), self.px(g["papier"][1]), self.px(g["papier_pad"])
 4539:         px, lh = self.px(g["papier_px"]), self.px(g["ligne_h"])
 4540: 
 4541:         def dessin(d, k):
 4542:             d.rounded_rectangle([0, 0, w * k - 1, h * k - 1], radius=self.px(g["papier_rayon"]) * k, fill=C.BLANC + (255,))
 4543:             for i, frac in enumerate(g["lignes"]):
 4544:                 y = (pad + px * 1.8 + i * self.px(g["ligne_pas"])) * k
 4545:                 d.rounded_rectangle([pad * k, y, (pad + (w - 2 * pad) * frac) * k, y + lh * k], radius=lh * k / 2,
 4546:                                     fill=C.INSERT_GRIS + (255,))
 4547:         im = _net(w, h, dessin)
 4548:         _ecrire(ImageDraw.Draw(im), (pad, pad), self.spec.get("papier", ""), px, C.INSERT_GRAISSE_FORTE,
 4549:                 C.NAVY + (255,), "la")
--- 4540-4629 ---
 4540: 
 4541:         def dessin(d, k):
 4542:             d.rounded_rectangle([0, 0, w * k - 1, h * k - 1], radius=self.px(g["papier_rayon"]) * k, fill=C.BLANC + (255,))
 4543:             for i, frac in enumerate(g["lignes"]):
 4544:                 y = (pad + px * 1.8 + i * self.px(g["ligne_pas"])) * k
 4545:                 d.rounded_rectangle([pad * k, y, (pad + (w - 2 * pad) * frac) * k, y + lh * k], radius=lh * k / 2,
 4546:                                     fill=C.INSERT_GRIS + (255,))
 4547:         im = _net(w, h, dessin)
 4548:         _ecrire(ImageDraw.Draw(im), (pad, pad), self.spec.get("papier", ""), px, C.INSERT_GRAISSE_FORTE,
 4549:                 C.NAVY + (255,), "la")
 4550:         return im
 4551: 
 4552:     def _t_depart(self):
 4553:         return self.t0(self.spec.get("temps", 0)) + C.INSERT_ENTREE
 4554: 
 4555:     def image(self, t, final):
 4556:         g = C.GUICHET_GEO
 4557:         k, a = _entree(t, self.t0(), final)
 4558:         if a <= 0:
 4559:             return None
 4560:         cadre = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 4561:         _poser(cadre, self.fenetre, self.gx + self.cw / 2, self.gy + self.ch / 2)
 4562:         ts, dep = self._t_depart(), self.px(g["depart"])
 4563:         dx, angle = (0.0, 0.0) if final else (dep, 0.0)
 4564:         if not final and t >= ts:
 4565:             u = ((t - ts) % g["cycle"]) / g["cycle"]
 4566:             if u < g["aller"]:
 4567:                 dx = dep * (1 - (u / g["aller"]) ** 2)    # le formulaire accelere vers le guichet
 4568:             else:
 4569:                 dx = dep * T.lisse((u - g["aller"]) / (1 - g["aller"]) * 1.5)   # il bute, et repart
 4570:                 ti, (amp, duree) = (u - g["aller"]) * g["cycle"], g["secousse"]
 4571:                 if ti < duree:
 4572:                     angle = amp * math.sin(2 * math.pi * 5 * ti) * (1 - ti / duree)
 4573:         cy = self.gy + self.ch * 0.56
