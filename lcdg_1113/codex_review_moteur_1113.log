 3960:                 dd.rounded_rectangle([x0 * k, (h - case) / 2 * k, (x0 + case) * k, (h + case) / 2 * k],
 3961:                                      radius=self.px(g["case_rayon"]) * k, fill=C.BLANC + (255,),
 3962:                                      outline=C.INSERT_GRIS_TEXTE + (255,), width=int(self.px(g["case_trait"]) * k))
