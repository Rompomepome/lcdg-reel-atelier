 4316: # ---------------------------------------------------------------- addition
 4317: class Addition(_Insert):
 4318:     """Des boites de medicament qui tombent une a une dans leur grille ; a droite, le total grimpe a chaque boite et
 4319:     fait une bosse. "total" remplace le nombre calcule, une fois toutes les boites posees (l'arrondi de l'article)."""
 4320: 
 4321:     def taille_nominale(self):
 4322:         return C.TEXTE_LARGEUR, C.ADDITION_H
 4323: 
 4324:     def __init__(self, *a):
 4325:         super().__init__(*a)
 4326:         g = C.ADDITION_GEO
 4327:         m = self.m
 4328:         self.pad = self.px(g["pad"])
 4329:         self.n, self.prix = int(self.spec["boites"]), float(self.spec["prix"])
 4330:         carte = _cadre(self.w, self.h, self.s, marge=m)
 4331:         d = ImageDraw.Draw(carte)
 4332:         _ecrire(d, (m + self.pad, m + self.pad), T.normaliser(self.spec.get("titre", "")).upper(),
 4333:                 self.px(g["titre_px"]), C.INSERT_GRAISSE_FORTE, C.INSERT_GRIS_TEXTE + (255,), "la")
 4334:         self.tx = m + self.w * g["total_x"]
 4335:         _ecrire(d, (self.tx, m + self.px(g["legende_y"])), self.spec.get("legende", ""), self.px(g["legende_px"]),
 4336:                 C.INSERT_GRAISSE_TEXTE, C.INSERT_GRIS_TEXTE + (255,), "mm")
 4337:         self.carte = _ombre(carte, self.s)
 4338:         self.boite = self._boite()
 4339: 
 4340:     def _boite(self):
 4341:         g = C.ADDITION_GEO
 4342:         w, h, b = self.px(g["boite"][0]), self.px(g["boite"][1]), self.px(g["bande"])
 4343:         rub, pale = self.rubrique + (255,), _teinte(self.rubrique, 0.84) + (255,)
 4344: 
 4345:         def dessin(d, k):
 4346:             ra = w * k * 0.16
 4347:             d.rounded_rectangle([0, 0, w * k - 1, h * k - 1], radius=ra, fill=pale)
 4348:             d.rounded_rectangle([0, 0, w * k - 1, b * k + ra], radius=ra, fill=rub)
 4349:             d.rectangle([0, b * k, w * k - 1, b * k + ra], fill=pale)
 4350:             cx, cy, L, e = w * k / 2, (b + (h - b) * 0.52) * k, w * k * 0.58, (h - b) * k * 0.26   # une gelule
 4351:             d.rounded_rectangle([cx - L / 2, cy - e / 2, cx + L / 2, cy + e / 2], radius=e / 2, fill=C.BLANC + (255,))
 4352:             d.rounded_rectangle([cx, cy - e / 2, cx + L / 2, cy + e / 2], radius=e / 2, fill=rub)
 4353:             d.rectangle([cx, cy - e / 2, cx + e / 2, cy + e / 2], fill=rub)
 4354:         return _net(w, h, dessin)
 4355: 
 4356:     def _t(self, i):
 4357:         return self.t0(self.spec.get("temps", 0)) + C.INSERT_ENTREE * 0.7 + i * C.ADDITION_GEO["cadence"]
 4358: 
 4359:     def image(self, t, final):
 4360:         g = C.ADDITION_GEO
 4361:         k, a = _entree(t, self.t0(), final)
 4362:         if a <= 0:
 4363:             return None
 4364:         cadre = self.carte.copy()
 4365:         bw, bh, ec = self.px(g["boite"][0]), self.px(g["boite"][1]), self.px(g["ecart"])
 4366:         somme, derniere = 0.0, None
 4367:         for i in range(self.n):
 4368:             u = 1.0 if final else (t - self._t(i)) / g["duree"]
 4369:             if u <= 0:
 4370:                 continue
 4371:             col, rang = i % g["colonnes"], i // g["colonnes"]
 4372:             chute = 0 if final else self.px(g["chute"]) * (1 - T.lisse(u))
 4373:             T.coller(cadre, self.boite, (self.m + self.pad + col * (bw + ec),
 4374:                                          self.m + self.px(g["grille_y"]) + rang * (bh + ec) - chute),
 4375:                      1.0 if final else T.lisse(u * 2))
 4376:             somme += self.prix * min(1.0, u)
 4377:             if u >= 1:
 4378:                 derniere = i
 4379:         complet = final or derniere == self.n - 1
 4380:         texte = T.normaliser(self.spec["total"] if complet and self.spec.get("total")
 4381:                              else f"{_nombre(round(somme), 0)}{NBSP}€")
 4382:         kk = 1.0
 4383:         if not final and derniere is not None:           # le total fait une bosse a chaque boite posee
 4384:             dt, (amp, duree) = t - self._t(derniere) - g["duree"], g["bosse"]
 4385:             if 0 <= dt < duree:
 4386:                 kk = 1 + amp * (1 - dt / duree)
 4387:         px = self.px(g["total_px"])
 4388:         tw = int(T.largeur(texte, px, C.INSERT_GRAISSE_FORTE, 0)) + 8
 4389:         im = Image.new("RGBA", (tw, int(px * 1.3)), (0, 0, 0, 0))
--- 4380-4469 ---
 4380:         texte = T.normaliser(self.spec["total"] if complet and self.spec.get("total")
 4381:                              else f"{_nombre(round(somme), 0)}{NBSP}€")
 4382:         kk = 1.0
 4383:         if not final and derniere is not None:           # le total fait une bosse a chaque boite posee
 4384:             dt, (amp, duree) = t - self._t(derniere) - g["duree"], g["bosse"]
 4385:             if 0 <= dt < duree:
 4386:                 kk = 1 + amp * (1 - dt / duree)
 4387:         px = self.px(g["total_px"])
 4388:         tw = int(T.largeur(texte, px, C.INSERT_GRAISSE_FORTE, 0)) + 8
 4389:         im = Image.new("RGBA", (tw, int(px * 1.3)), (0, 0, 0, 0))
 4390:         _ecrire(ImageDraw.Draw(im), (tw / 2, px * 0.65), texte, px, C.INSERT_GRAISSE_FORTE, C.INSERT_ROUGE + (255,), "mm")
 4391:         _poser(cadre, im, self.tx, self.m + self.px(g["total_y"]), kk)
 4392:         out = Image.new("RGBA", cadre.size, (0, 0, 0, 0))
 4393:         _poser(out, cadre, cadre.width / 2, cadre.height / 2, k, a)
 4394:         return out
 4395: 
 4396:     def sons(self):
 4397:         return [(self._t(0), "compteur"), (self._t(self.n - 1) + C.ADDITION_GEO["duree"], "impact")]
