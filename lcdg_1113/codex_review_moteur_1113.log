 3846:             im = Image.new("RGBA", (tw, th), (0, 0, 0, 0))
 3847:             _ecrire(ImageDraw.Draw(im), (0, th / 2), texte, px, C.INSERT_GRAISSE_TEXTE, couleur + (255,), "lm")
