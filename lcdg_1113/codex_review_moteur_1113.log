 3998:                 w = 1.0 if final else (t - self._t(i) - delai) / duree
 3999:                 angle = amp * math.sin(2 * math.pi * 3 * w) * (1 - w) if 0 < w < 1 else 0.0
 4000:                 _poser(cadre, self.cadenas, cx, cy, kk, alpha, angle)
 4001:             else:
