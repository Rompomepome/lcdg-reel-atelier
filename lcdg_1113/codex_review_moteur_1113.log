  149:         gain = C.MUSIQUE_LUFS - sonie(fond, extrait)
  150:         source = _boucle(fond, k, total, graphe)
  151:         graphe.append(f"{source}{extrait},volume={gain:.2f}dB,"
  152:                       f"afade=t=in:st=0:d={C.MUSIQUE_FONDU_IN},"
  153:                       f"afade=t=out:st={max(0.0, total - C.MUSIQUE_FONDU_OUT):.3f}:"
  154:                       f"d={C.MUSIQUE_FONDU_OUT}[fond]")
  155:         if voix is not None:
  156:             # la musique s'efface quand la voix parle
  157:             graphe.append(f"[fond][cle]sidechaincompress={C.MUSIQUE_DUCKING}[fond_d]")
  158:             mix.append("[fond_d]")
  159:         else:
  160:             mix.append("[fond]")
  161:     elif voix is not None:
  162:         graphe[-1] = graphe[-1].replace(",asplit=2[voix][cle]", "[voix]")
  163:     if sfx is not None:
  164:         entrees += ["-i", str(sfx)]
  165:         graphe.append(f"[{len(entrees) // 2 - 1}:a]apad,atrim=0:{total:.3f}[sfx]")
  166:         mix.append("[sfx]")
  167:     graphe.append("".join(mix) + f"amix=inputs={len(mix)}:duration=longest:normalize=0[a]")
  168:     brute = travail / f"bande_{ep['slug']}_brute.wav"
  169:     B.run([*entrees, "-filter_complex", ";".join(graphe), "-map", "[a]",
  170:            "-ar", str(SR), "-ac", "2", "-t", f"{total:.3f}", str(brute), "-y"])
  171:     # mise au niveau final : un gain fixe, puis le limiteur pour les cretes
  172:     gain = C.SON_LUFS - sonie(brute)
  173:     dest = travail / f"bande_{ep['slug']}.wav"
  174:     # "son_limite_db" : limiteur plus bas pour un reel dont l'encodage AAC depasse le plafond sur une
  175:     # attaque de voix (2 dB sur le premier mot du reel pharmacien, 05/11/2026)
  176:     limite = ep.get("son_limite_db", C.SON_TP_CIBLE)
  177:     B.run(["-i", str(brute), "-af",
  178:            f"volume={gain:.2f}dB,alimiter=limit={10 ** (limite / 20):.3f}:level=false,"
  179:            f"aresample={SR}", "-ar", str(SR), "-ac", "2", str(dest), "-y"])
  180:     brute.unlink(missing_ok=True)
  181:     return dest

