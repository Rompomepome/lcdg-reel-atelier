 4400: # ------------------------------------------------------------------ renvoi
 4401: class Renvoi(_Insert):
 4402:     """Un patient qu'on renvoie de l'un a l'autre : son jeton saute de station en station, sa trace en pointilles
 4403:     derriere lui ; la station "question" le recoit avec un « ? » qui se balance."""
 4404: 
 4405:     def taille_nominale(self):
 4406:         return C.TEXTE_LARGEUR, C.RENVOI_H
 4407: 
 4408:     def __init__(self, *a):
 4409:         super().__init__(*a)
 4410:         g = C.RENVOI_GEO
 4411:         self.st = self.spec["etapes"]
 4412:         n = len(self.st)
 4413:         self.sw, self.sh = self.px(g["station"][0]), self.px(g["station"][1])
 4414:         ec = self.px(g["ecart"])
 4415:         x0 = self.m + (self.w - n * self.sw - (n - 1) * ec) / 2
 4416:         self.sx = [x0 + i * (self.sw + ec) + self.sw / 2 for i in range(n)]
 4417:         self.sy = self.m + self.px(g["station_y"])
 4418:         self.cartes = [self._station(s) for s in self.st]
 4419:         j = self.px(g["jeton"])
 4420: 
 4421:         def jeton(d, k):                                 # un rond a la couleur de la rubrique, une silhouette blanche
 4422:             J = j * k
 4423:             d.ellipse([0, 0, J - 1, J - 1], fill=self.rubrique + (255,))
 4424:             d.ellipse([J * 0.36, J * 0.18, J * 0.64, J * 0.46], fill=C.BLANC + (255,))
 4425:             d.pieslice([J * 0.22, J * 0.52, J * 0.78, J * 1.08], 180, 360, fill=C.BLANC + (255,))
 4426:         self.jeton = _ombre_marge(_net(j, j, jeton), self.s)
 4427:         self.badge = _icone_choix(None, int(j * 0.62), max(2, self.px(C.CHOIX_GEO["trait"]) - 1), C.INSERT_ROUGE)
 4428: 
 4429:     def _station(self, s):
 4430:         g = C.RENVOI_GEO
 4431:         w, h, question = self.sw, self.sh, s.get("question")
 4432:         fond = (_teinte(C.INSERT_ROUGE, g["teinte"]) if question else C.BLANC) + (255,)
 4433:         im = _net(w, h, lambda d, k: d.rounded_rectangle([0, 0, w * k - 1, h * k - 1], radius=self.px(g["rayon"]) * k,
 4434:                                                          fill=fond))
 4435:         texte, px = T.normaliser(s["label"]), self.px(g["label_px"])
 4436:         while px > self.px(g["label_px_min"]) and \
 4437:                 T.largeur(texte, px, C.INSERT_GRAISSE_FORTE, 0) > w - 2 * self.px(g["pad"]):
 4438:             px -= 1
 4439:         _ecrire(ImageDraw.Draw(im), (w / 2, h * 0.6), texte, px, C.INSERT_GRAISSE_FORTE,
 4440:                 (C.INSERT_ROUGE if question else C.NAVY) + (255,), "mm")
 4441:         return _ombre_marge(im, self.s)
 4442: 
 4443:     def _t(self, i):
 4444:         """Depart du saut vers la station i (i >= 1)."""
 4445:         g = C.RENVOI_GEO
 4446:         tps = self.st[i].get("temps", 0)
 4447:         avant = [j for j in range(1, i) if self.st[j].get("temps", 0) == tps]
 4448:         return self.t0(tps) + C.INSERT_ENTREE * 0.9 + len(avant) * (g["duree"] + g["attente"])
 4449: 
 4450:     def image(self, t, final):
 4451:         g = C.RENVOI_GEO
 4452:         k, a = _entree(t, self.t0(self.spec.get("temps", 0)), final)
 4453:         if a <= 0:
 4454:             return None
 4455:         cadre = Image.new("RGBA", (self.w + 2 * self.m, self.h + 2 * self.m), (0, 0, 0, 0))
 4456:         n, saut = len(self.st), self.px(g["saut"])
 4457:         base = self.sy - self.px(g["jeton"]) * 0.3       # le jeton est pose sur le bord de la station
 4458:         for i in range(n):
 4459:             kk = 1.0
 4460:             if i >= 1 and not final:                     # la station fait une bosse quand le jeton s'y pose
 4461:                 dt, (amp, duree) = t - self._t(i) - g["duree"], g["bosse"]
 4462:                 if 0 <= dt < duree:
 4463:                     kk = 1 + amp * (1 - dt / duree)
 4464:             _poser(cadre, self.cartes[i], self.sx[i], self.sy + self.sh / 2, kk)
 4465:         d = ImageDraw.Draw(cadre)
 4466:         jx, jy, arrive = self.sx[0], base, 0
 4467:         points, rp = g["point"][0], self.px(g["point"][1]) / 2
 4468:         for i in range(1, n):
 4469:             u = 1.0 if final else (t - self._t(i)) / g["duree"]
--- 4460-4549 ---
 4460:             if i >= 1 and not final:                     # la station fait une bosse quand le jeton s'y pose
 4461:                 dt, (amp, duree) = t - self._t(i) - g["duree"], g["bosse"]
 4462:                 if 0 <= dt < duree:
 4463:                     kk = 1 + amp * (1 - dt / duree)
 4464:             _poser(cadre, self.cartes[i], self.sx[i], self.sy + self.sh / 2, kk)
 4465:         d = ImageDraw.Draw(cadre)
 4466:         jx, jy, arrive = self.sx[0], base, 0
 4467:         points, rp = g["point"][0], self.px(g["point"][1]) / 2
 4468:         for i in range(1, n):
 4469:             u = 1.0 if final else (t - self._t(i)) / g["duree"]
 4470:             if u <= 0:
 4471:                 break
 4472:             u = min(1.0, u)
 4473:             for q in range(1, points):                   # la trace : des points le long du saut, jusqu'au jeton
 4474:                 v = q / points
 4475:                 if v > u:
 4476:                     break
 4477:                 x = self.sx[i - 1] + (self.sx[i] - self.sx[i - 1]) * v
 4478:                 y = base - saut * 4 * v * (1 - v)
 4479:                 d.ellipse([x - rp, y - rp, x + rp, y + rp], fill=C.INSERT_GRIS_TEXTE + (255,))
 4480:             jx = self.sx[i - 1] + (self.sx[i] - self.sx[i - 1]) * u
 4481:             jy = base - saut * 4 * u * (1 - u)
 4482:             if u >= 1:
 4483:                 arrive = i
 4484:         question = self.st[-1].get("question") and (final or arrive == n - 1)
 4485:         tq = self._t(n - 1) + g["duree"]
 4486:         amp, freq = g["balance"]
 4487:         angle = amp * math.sin(2 * math.pi * freq * (t - tq)) if question and not final else 0.0
 4488:         _poser(cadre, self.jeton, jx, jy, 1.0, 1.0, angle)
 4489:         if question:
 4490:             kq, aq = _entree(t, tq, final)
 4491:             _poser(cadre, self.badge, jx + self.px(g["jeton"]) * 0.44, jy - self.px(g["jeton"]) * 0.44, kq, aq, angle)
 4492:         out = Image.new("RGBA", cadre.size, (0, 0, 0, 0))
 4493:         _poser(out, cadre, cadre.width / 2, cadre.height / 2, k, a)
 4494:         return out
 4495: 
 4496:     def sons(self):
 4497:         g = C.RENVOI_GEO
 4498:         return [x for i in range(1, len(self.st)) for x in ((self._t(i), "souffle"), (self._t(i) + g["duree"], "clic"))]
