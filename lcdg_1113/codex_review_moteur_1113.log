 4133: # ------------------------------------------------------------------- jauge
 4134: class Jauge(_Insert):
 4135:     """Un cadran : chaque ticket qui tombe a gauche (un arret de travail) fait monter l'aiguille vers la zone
 4136:     rouge ; arrivee, elle tremble. Aucun chiffre : le cadran montre un mecanisme."""
 4137: 
 4138:     def taille_nominale(self):
 4139:         return C.TEXTE_LARGEUR, C.JAUGE_H
 4140: 
 4141:     def __init__(self, *a):
 4142:         super().__init__(*a)
 4143:         g = C.JAUGE_GEO
 4144:         m = self.m
 4145:         self.pad = self.px(g["pad"])
 4146:         self.tickets = self.spec["tickets"]
 4147:         carte = _cadre(self.w, self.h, self.s, marge=m)
 4148:         _ecrire(ImageDraw.Draw(carte), (m + self.pad, m + self.pad), T.normaliser(self.spec.get("titre", "")).upper(),
 4149:                 self.px(g["titre_px"]), C.INSERT_GRAISSE_FORTE, C.INSERT_GRIS_TEXTE + (255,), "la")
 4150:         R, e = self.px(g["rayon"]), self.px(g["epaisseur"])
 4151:         self.cx, self.cy = m + self.w * g["centre"][0], m + self.px(g["centre"][1])
 4152:         a0, a1 = g["angles"]
 4153:         ar = a0 + (a1 - a0) * g["zone_rouge"]
 4154: 
 4155:         def cadran(d, k):
 4156:             boite = [0, 0, 2 * R * k - 1, 2 * R * k - 1]
 4157:             d.arc(boite, a0, a1, fill=C.INSERT_GRIS + (255,), width=int(e * k))
 4158:             d.arc(boite, ar, a1, fill=C.INSERT_ROUGE + (255,), width=int(e * k))
 4159:         carte.alpha_composite(_net(2 * R, 2 * R, cadran), (int(self.cx - R), int(self.cy - R)))
 4160:         self.carte = _ombre(carte, self.s)
 4161:         al, ae, mo = self.px(g["aiguille"][0]), self.px(g["aiguille"][1]), self.px(g["moyeu"])
 4162: 
 4163:         def aiguille(d, k):                              # elle pointe a droite ; le moyeu est au centre de l'image
 4164:             c = al * k
 4165:             d.polygon([(c, c - ae * k / 2), (2 * c - 2, c), (c, c + ae * k / 2)], fill=C.NAVY + (255,))
 4166:             d.ellipse([c - mo * k, c - mo * k, c + mo * k, c + mo * k], fill=C.NAVY + (255,))
 4167:             d.ellipse([c - mo * k * 0.4, c - mo * k * 0.4, c + mo * k * 0.4, c + mo * k * 0.4], fill=C.BLANC + (255,))
 4168:         self.aiguille = _net(2 * al, 2 * al, aiguille)
 4169:         self.sprites = [self._ticket(tk) for tk in self.tickets]
 4170: 
 4171:     def _ticket(self, tk):
 4172:         g = C.JAUGE_GEO
 4173:         w, h = self.px(g["ticket"][0]), self.px(g["ticket"][1])
 4174:         ton = _ton(tk, self.rubrique)
 4175: 
 4176:         def dessin(d, k):
 4177:             d.rounded_rectangle([0, 0, w * k - 1, h * k - 1], radius=h * k / 2, fill=_teinte(ton, 0.86) + (255,))
 4178:             r = h * k * 0.2
 4179:             d.ellipse([h * k * 0.5 - r, h * k / 2 - r, h * k * 0.5 + r, h * k / 2 + r], fill=tuple(ton) + (255,))
 4180:         im = _net(w, h, dessin)
 4181:         _ecrire(ImageDraw.Draw(im), (h * 0.95, h / 2), tk["label"], self.px(g["ticket_px"]), C.INSERT_GRAISSE_TEXTE,
 4182:                 C.NAVY + (255,), "lm")
 4183:         return im
 4184: 
 4185:     def _t(self, i):
 4186:         tps = self.tickets[i].get("temps", 0)
 4187:         avant = [j for j in range(i) if self.tickets[j].get("temps", 0) == tps]
 4188:         return self.t0(tps) + C.INSERT_ENTREE * 0.7 + len(avant) * C.JAUGE_GEO["pas_duree"]
 4189: 
 4190:     def _pos(self, t, final):
 4191:         """Position de l'aiguille sur le cadran, de 0 a 1 : un pas par ticket pose, puis elle tremble."""
 4192:         g = C.JAUGE_GEO
 4193:         if final:
 4194:             return g["cible"]
 4195:         n = len(self.tickets)
 4196:         p = g["depart"]
 4197:         for i in range(n):
 4198:             p += (g["cible"] - g["depart"]) / n * T.rebond((t - self._t(i) - C.INSERT_ENTREE * 0.6) / g["pas_duree"])
 4199:         fin = self._t(n - 1) + C.INSERT_ENTREE * 0.6 + g["pas_duree"]
 4200:         if t > fin:
 4201:             amp, freq = g["tremble"]
 4202:             p += amp / 100 * math.sin(2 * math.pi * freq * (t - fin))
 4203:         return p
 4204: 
 4205:     def image(self, t, final):
 4206:         g = C.JAUGE_GEO
 4207:         k, a = _entree(t, self.t0(), final)
 4208:         if a <= 0:
 4209:             return None
 4210:         cadre = self.carte.copy()
 4211:         pas = self.px(g["ticket"][1]) + self.px(g["ticket_ecart"])
 4212:         for i, im in enumerate(self.sprites):
 4213:             u = 1.0 if final else (t - self._t(i)) / C.INSERT_ENTREE
 4214:             if u <= 0:
 4215:                 continue
 4216:             dy = 0 if final else self.px(g["chute"]) * (1 - T.lisse(u))
 4217:             T.coller(cadre, im, (self.m + self.pad, self.m + self.px(g["ticket_y"]) + i * pas - dy),
 4218:                      1.0 if final else T.lisse(u * C.INSERT_FONDU))
 4219:         a0, a1 = g["angles"]
 4220:         _poser(cadre, self.aiguille, self.cx, self.cy, 1.0, 1.0, -(a0 + (a1 - a0) * self._pos(t, final)))
 4221:         out = Image.new("RGBA", cadre.size, (0, 0, 0, 0))
 4222:         _poser(out, cadre, cadre.width / 2, cadre.height / 2, k, a)
 4223:         return out
 4224: 
 4225:     def sons(self):
 4226:         return [(self._t(i) + C.INSERT_ENTREE * 0.6, "clic") for i in range(len(self.tickets))]
