 4290:             u = 1.0 if final else T.lisse((t - self.t0() - C.INSERT_ENTREE * 0.6 - i * g["decalage"]) / g["duree"])
 4291:             dx = (i - (len(g["eventail"]) - 1) / 2) * ex
 4292:             y = y0 - self.px(g["sortie"]) * u
 4293:             if bx is not None:                           # la note que le « ? » survole se souleve
 4294:                 y -= self.px(g["levee"]) * max(0.0, 1 - abs(bx - dx) / ex)
 4295:             _poser(cadre, self.note, self.cx + dx * u, y, 1.0, 1.0, -angle * u)
