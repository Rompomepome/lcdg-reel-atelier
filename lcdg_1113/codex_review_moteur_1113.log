 4252:         _ecrire(ImageDraw.Draw(rabat), (cw / 2, rh / 2), self.spec.get("titre", ""), self.px(g["titre_px"]),
 4253:                 C.INSERT_GRAISSE_FORTE, C.BLANC + (255,), "mm")
