 4390:         _ecrire(ImageDraw.Draw(im), (tw / 2, px * 0.65), texte, px, C.INSERT_GRAISSE_FORTE, C.INSERT_ROUGE + (255,), "mm")
 4391:         _poser(cadre, im, self.tx, self.m + self.px(g["total_y"]), kk)
 4392:         out = Image.new("RGBA", cadre.size, (0, 0, 0, 0))
 4393:         _poser(out, cadre, cadre.width / 2, cadre.height / 2, k, a)
 4394:         return out
